  skos:definition "स्म\t/sma/\t\t/сма/\tsma expl. или выразительная частица, придающая наст. вр. значеніе прошедшаго вр. — sma эпич. иногда = smas.\tс. 283"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
