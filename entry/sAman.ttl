  skos:definition "सामन् III /sāman/ m., n. мягкость, доброта"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/sAman/dict/koch/3> a ontolex:LexicalSense ;
