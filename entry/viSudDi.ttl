  skos:definition "विशुद्धि\t/viśuddhi/\t/vizuddhi/\t/вишуддхи/\tviśuddhi f. очищеніе (M. 69 для очищенія отъ нихъ sc. за смерть, причиненную имъ).\tс. 267"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
