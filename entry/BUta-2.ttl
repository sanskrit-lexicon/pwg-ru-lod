<https://w3id.org/sanskrit-lexicon/repwg/entry/BUta-2> a ontolex:LexicalEntry ;
  rdfs:label "bhūta"@sa-Latn ;
  dct:isPartOf <https://w3id.org/sanskrit-lexicon/repwg/lexicon/pwg-ru> ;
  ontolex:canonicalForm <https://w3id.org/sanskrit-lexicon/repwg/lemma/BUta> ;
