<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/viS/tr/vi_x5f_s_x7e__x7e_h0_x5f_26_x5f_ni_x5f_0/1_x29__x20_hineingehen_x2c__x20_heimgehen_x3b__x20_sich_x20_zur_x20_Ruhe_x20_begeben_x2c__x20_sich_x20_legen_x3b__x20_sich_x20_lagern> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\"> 1) {%входить, идти домой%} (в дом, лагерь, гнездо); {%отходить ко сну, ложиться; располагаться лагерем%}: {#nya^viSranpatayi\\zRava^H#}\n<ls>ṚV. 8,17,12.</ls> <ls n=\"ṚV.\">10,127,4.</ls> {#ni grAmA^so avikzata\\ ni pa\\dvanta^H#}\n<ls n=\"ṚV. 10,127,\">5.</ls> <ls n=\"ṚV. 10,\">37,2.</ls> <ls n=\"ṚV. 10,37,\">9.</ls> <ls n=\"ṚV.\">1,164,22.</ls> {#mayi gozWe niviSaDvam#}\n<ls>ĀŚV. GṚHY. 2,10,6.</ls>\n<ls>ŚAT. BR. 2,3,1,8.</ls> <ls n=\"ŚAT. BR.\">4,1,5,2.</ls> {#nya1^\\nyA a\\rkama\\Bito^ viviSre#} {%расположиться лагерем вокруг%}\n<ls>ṚV. 8,90,14.</ls> {#padmena cEva vyUhena niviSeta#}\n<ls>M. 7,188.</ls>\n<ls>MBH. 1,5893.</ls> <ls n=\"MBH. 1,\">6960</ls> (<ab>act.</ab>). <ls n=\"MBH.\">3,16364.</ls> <ls n=\"MBH.\">5,7049.</ls> <ls>HARIV. 8047.</ls> {#veSmAni#} {%вступать в%}\n<ls>MBH. 1,7566.</ls> {#saM sArakArAgfhe#}\n<ls>Spr. 1039.</ls> {#dvAri#}\n<ls>BHĀG. P. 3,15,29</ls> (<ab>act.</ab>). {#rAmaSAlAm#}\n<ls>BHAṬṬ. 4,28.</ls> {#makarAlayam#}\n<ls n=\"BHAṬṬ.\">8,7.</ls> {#kUrmasyANgAni kUrmaSarIre#}\n<ls>SARVADARŚANAS. 150,20.</ls> {#SilImuKAH — nyaviSanta rasAtalam#} {%проникали в%}\n<ls>R. 3,31,20.</ls> {#mahIM niviSate raviH#} {%солнце проникает%} (своими лучами) {%в землю%}\n<ls>MBH. 3,136.</ls> {#tO cApi keSO niviSetAM yadUnAM kule striyO devakIM rohiRIM ca#} {%вошли в%}\n<ls n=\"MBH.\">1,7308.</ls> <ls>WILSON, SĀṂKHYAK. S. 62.</ls> {#jYeyapade#} {%вступать в область познаваемого%}\n<ls>SARVADARŚANAS. 101,7. 8.</ls> {#dehasyApacayo matO niviSate#} {%проникает в разум%}, так что <ab>v. a.</ab> {%доходит до сознания%}\n<ls>Spr. 1973.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\"> 1) {%hineingehen, heimgehen%} (in's Haus, Lager, Nest); {%sich zur Ruhe begeben, sich legen; sich lagern%}: {#nya^viSranpatayi\\zRava^H#}\n<ls>ṚV. 8,17,12.</ls> <ls n=\"ṚV.\">10,127,4.</ls> {#ni grAmA^so avikzata\\ ni pa\\dvanta^H#}\n<ls n=\"ṚV. 10,127,\">5.</ls> <ls n=\"ṚV. 10,\">37,2.</ls> <ls n=\"ṚV. 10,37,\">9.</ls> <ls n=\"ṚV.\">1,164,22.</ls> {#mayi gozWe niviSaDvam#}\n<ls>ĀŚV. GṚHY. 2,10,6.</ls>\n<ls>ŚAT. BR. 2,3,1,8.</ls> <ls n=\"ŚAT. BR.\">4,1,5,2.</ls> {#nya1^\\nyA a\\rkama\\Bito^ viviSre#} {%sich lagern um%}\n<ls>ṚV. 8,90,14.</ls> {#padmena cEva vyUhena niviSeta#}\n<ls>M. 7,188.</ls>\n<ls>MBH. 1,5893.</ls> <ls n=\"MBH. 1,\">6960</ls> (<ab>act.</ab>). <ls n=\"MBH.\">3,16364.</ls> <ls n=\"MBH.\">5,7049.</ls> <ls>HARIV. 8047.</ls> {#veSmAni#} {%hineintreten in%}\n<ls>MBH. 1,7566.</ls> {#saM sArakArAgfhe#}\n<ls>Spr. 1039.</ls> {#dvAri#}\n<ls>BHĀG. P. 3,15,29</ls> (<ab>act.</ab>). {#rAmaSAlAm#}\n<ls>BHAṬṬ. 4,28.</ls> {#makarAlayam#}\n<ls n=\"BHAṬṬ.\">8,7.</ls> {#kUrmasyANgAni kUrmaSarIre#}\n<ls>SARVADARŚANAS. 150,20.</ls> {#SilImuKAH — nyaviSanta rasAtalam#} {%drangen in%}\n<ls>R. 3,31,20.</ls> {#mahIM niviSate raviH#} {%die Sonne dringt%} (mit ihren Strahlen) {%in die Erde%}\n<ls>MBH. 3,136.</ls> {#tO cApi keSO niviSetAM yadUnAM kule striyO devakIM rohiRIM ca#} {%gingen ein in%}\n<ls n=\"MBH.\">1,7308.</ls> <ls>WILSON, SĀṂKHYAK. S. 62.</ls> {#jYeyapade#} {%in den Bereich des Erkennbaren treten%}\n<ls>SARVADARŚANAS. 101,7. 8.</ls> {#dehasyApacayo matO niviSate#} {%dringt in den Geist%} so <ab>v. a.</ab> {%kommt zum Bewusstsein%}\n<ls>Spr. 1973.</ls>"@de ;
  pwglex:senseTag "1) hineingehen, heimgehen; sich zur Ruhe begeben, sich legen; sich lagern" ;
