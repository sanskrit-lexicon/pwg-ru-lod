  skos:definition "<div n=\"1\">— 3) {%располагаться, — укладываться, — отходить ко сну%} <ls>ŚAT. BR. 8,2,4,20.</ls> <ls n=\"ŚAT. BR.\">11,6,1,7.</ls> <ls n=\"ŚAT. BR.\">13,4,1,9.</ls> {#patnyA#} <ls>KĀṬH. 14,8.</ls> <ls>LĀṬY. 3,4,4. 5,10,6.</ls> <ls>ĀŚV. GṚHY. 2,3,7. 9,5.</ls> {#gfhezu#} <ls>ŚR. 2,5,17.</ls> <ls>AIT. BR. 8,28.</ls> {#carmaRi vA sTaRqile vA#} <ls>CHĀND. UP. 5,2,8.</ls> {#saMvekzyan#} (так следует читать <ab>st.</ab> {#saMveSyan#}) {#jAyAyE#} <ls>KAUṢ. UP. 2,10.</ls> <ls>M. 2,194.</ls> <ls n=\"M.\">4,55.</ls> <ls n=\"M. 4,\">76.</ls> <ls n=\"M.\">7,225.</ls> <ls>YĀJÑ. 1,114.</ls> <ls n=\"YĀJÑ. 1,\">330.</ls> <ls>MBH. 1,688.</ls> <ls n=\"MBH. 1,\">4299.</ls> {#SayanIye mayA saha#} <ls n=\"MBH. 1,\">4712</ls> (<ab>med.</ab>). {#caramaM saMviSati yA praTamaM pratibuDyate#} <ls n=\"MBH.\">2,2177.</ls> <ls n=\"MBH.\">3,13149.</ls> <ls n=\"MBH.\">13,1456.</ls> <ls n=\"MBH. 13,\">2745.</ls> <ls>R. 2,53,5.</ls> <ls>R. GORR. 2,8,56.</ls> <ls n=\"R. GORR. 2,\">53,7.</ls> <ls n=\"R. GORR.\">4,34,3.</ls> <ls n=\"R. GORR. 4,\">55,16.</ls> <ls n=\"R. GORR. 4,55,\">20. fg.</ls> <ls n=\"R. GORR.\">5,92,19.</ls> <ls>SUŚR. 2,165,11.</ls> <ls>KATHĀS. 56,316.</ls> <ls>BHĀG. P. 4,26,11.</ls> <ls n=\"BHĀG. P.\">7,13,26.</ls> <ls n=\"BHĀG. P.\">10,15,46.</ls> {#SAdvalopari#} <ls n=\"BHĀG. P. 10,\">20,30.</ls> {#vyADitErna saMviSet#} {%пусть не спит с больными%} <ls>YĀJÑ. 1,138.</ls> {#SayyAm#} {%лечь в постель%} <ls>R. 2,46,14</ls> (<ls n=\"GORR. 2,\">44,14</ls> <ls>GORR.</ls>). {#saMvizwa#} {%отошедший ко сну, спящий, покоящийся%} <ls>MBH. 1,693.</ls> <ls n=\"MBH. 1,\">5924.</ls> {#tfRezu#} <ls>R. 2,86,11.</ls> <ls>R. GORR. 2,48,10.</ls> <ls n=\"R. GORR. 2,\">94,12.</ls> <ls n=\"R. GORR.\">5,14,13</ls> ({#hastin#}).{# kuSaSayane#} <ls>RAGH. 1,95.</ls> {#uruSAKA˚#} <ls>KATHĀS. 42,43.</ls> <ls n=\"KATHĀS.\">54,162.</ls> {#ratnapIWe#} <ls>Verz. d. Oxf. H. 28,b,33.</ls> <ls>MĀRK. P. 34,59.</ls> {#bfsI˚#} <ls>PRAB. 21,5.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3) {%sich niederlassen, — niederlegen, — zur Ruhe begeben%} <ls>ŚAT. BR. 8,2,4,20.</ls> <ls n=\"ŚAT. BR.\">11,6,1,7.</ls> <ls n=\"ŚAT. BR.\">13,4,1,9.</ls> {#patnyA#} <ls>KĀṬH. 14,8.</ls> <ls>LĀṬY. 3,4,4. 5,10,6.</ls> <ls>ĀŚV. GṚHY. 2,3,7. 9,5.</ls> {#gfhezu#} <ls>ŚR. 2,5,17.</ls> <ls>AIT. BR. 8,28.</ls> {#carmaRi vA sTaRqile vA#} <ls>CHĀND. UP. 5,2,8.</ls> {#saMvekzyan#} (so ist <ab>st.</ab> {#saMveSyan#} zu lesen) {#jAyAyE#} <ls>KAUṢ. UP. 2,10.</ls> <ls>M. 2,194.</ls> <ls n=\"M.\">4,55.</ls> <ls n=\"M. 4,\">76.</ls> <ls n=\"M.\">7,225.</ls> <ls>YĀJÑ. 1,114.</ls> <ls n=\"YĀJÑ. 1,\">330.</ls> <ls>MBH. 1,688.</ls> <ls n=\"MBH. 1,\">4299.</ls> {#SayanIye mayA saha#} <ls n=\"MBH. 1,\">4712</ls> (<ab>med.</ab>). {#caramaM saMviSati yA praTamaM pratibuDyate#} <ls n=\"MBH.\">2,2177.</ls> <ls n=\"MBH.\">3,13149.</ls> <ls n=\"MBH.\">13,1456.</ls> <ls n=\"MBH. 13,\">2745.</ls> <ls>R. 2,53,5.</ls> <ls>R. GORR. 2,8,56.</ls> <ls n=\"R. GORR. 2,\">53,7.</ls> <ls n=\"R. GORR.\">4,34,3.</ls> <ls n=\"R. GORR. 4,\">55,16.</ls> <ls n=\"R. GORR. 4,55,\">20. fg.</ls> <ls n=\"R. GORR.\">5,92,19.</ls> <ls>SUŚR. 2,165,11.</ls> <ls>KATHĀS. 56,316.</ls> <ls>BHĀG. P. 4,26,11.</ls> <ls n=\"BHĀG. P.\">7,13,26.</ls> <ls n=\"BHĀG. P.\">10,15,46.</ls> {#SAdvalopari#} <ls n=\"BHĀG. P. 10,\">20,30.</ls> {#vyADitErna saMviSet#} {%er schlafe nicht mit Kranken%} <ls>YĀJÑ. 1,138.</ls> {#SayyAm#} {%sich auf's Bett legen%} <ls>R. 2,46,14</ls> (<ls n=\"GORR. 2,\">44,14</ls> <ls>GORR.</ls>). {#saMvizwa#} {%zur Ruhe gegangen, schlafend, ruhend%} <ls>MBH. 1,693.</ls> <ls n=\"MBH. 1,\">5924.</ls> {#tfRezu#} <ls>R. 2,86,11.</ls> <ls>R. GORR. 2,48,10.</ls> <ls n=\"R. GORR. 2,\">94,12.</ls> <ls n=\"R. GORR.\">5,14,13</ls> ({#hastin#}).{# kuSaSayane#} <ls>RAGH. 1,95.</ls> {#uruSAKA˚#} <ls>KATHĀS. 42,43.</ls> <ls n=\"KATHĀS.\">54,162.</ls> {#ratnapIWe#} <ls>Verz. d. Oxf. H. 28,b,33.</ls> <ls>MĀRK. P. 34,59.</ls> {#bfsI˚#} <ls>PRAB. 21,5.</ls>"@de ;
