<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/viS/tr/vi_x5f_s_x7e__x7e_h0_x5f_23_x5f_pratyupa/sich_x20_gegen_x20_Jmd_x20_setzen_x20__xe2__x80__xa6__x20_nicht_x20_von_x20_seiner_x20_Seite_x20_weichen_x20__xe2__x80__xa6__x20_Jmd_x20_entgegentreten_x2c__x20_Opposition_x20_machen> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#pratyupa#} {%садиться напротив кого-л.%} (<ab>acc.</ab>) {%и не отходить от него, принуждая его к уступчивости%} (так <ab>v. a.</ab>); {%тот, кто хочет вырвать у другого что-л., и тот, кто дает к тому повод%}, {#pratyupavizwo yaSca pratyupaveSayate tAvantaM kAlam#}; <ls>ĀPAST. 1,19,1.</ls> <ab>caus.</ab> ({#˚veSya#}) также <ls>R. 5,80,7</ls> в знач. <ab>Bed.</ab> {%выступать против кого-л.%} (<ab>acc.</ab>), {%оппозиционировать.%}\n<ls>MBH. 2,1156.</ls> <ls n=\"MBH.\">10,589.</ls> {#AryaM pratyupavekzyAmi yAvanme na prasIdati#}\n<ls>R. 2,111,13</ls> (<ls n=\"GORR. 2,\">120,13</ls> <ls>GORR.</ls>). {#kiM mAM kurvARaM pratyupavekzyase#}\n<ls n=\"R. 2,111,\">16</ls> ({#˚vekzyasi#}\n<ls>GORR.</ls>).\n<div n=\"v\">— <ab>Vgl.</ab> {#pratyupaveSa#} ."@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#pratyupa#} {%sich gegen Jmd%} (<ab>acc.</ab>) {%setzen%} so <ab>v. a.</ab> {%nicht von seiner Seite weichen um ihn zur Nachgiebigkeit zu zwingen%}\n<ls>MBH. 2,1156.</ls> <ls n=\"MBH.\">10,589.</ls> {#AryaM pratyupavekzyAmi yAvanme na prasIdati#}\n<ls>R. 2,111,13</ls> (<ls n=\"GORR. 2,\">120,13</ls> <ls>GORR.</ls>). {#kiM mAM kurvARaM pratyupavekzyase#}\n<ls n=\"R. 2,111,\">16</ls> ({#˚vekzyasi#}\n<ls>GORR.</ls>). {#pratyupavizwo yaSca pratyupaveSayate tAvantaM kAlam#} {%derjenige, der einem Andern Etwas abtrotzen will und derjenige, welcher die Veranlassung dazu giebt%},\n<ls>ĀPAST. 1,19,1.</ls> <ab>caus.</ab> ({#˚veSya#}) auch\n<ls>R. 5,80,7</ls> in der <ab>Bed.</ab> {%Jmd%} (<ab>acc.</ab>) {%entgegentreten, Opposition machen.%}\n<div n=\"v\">— <ab>Vgl.</ab> {#pratyupaveSa#} ."@de ;
  pwglex:senseTag "sich gegen Jmd setzen … nicht von seiner Seite weichen … Jmd entgegentreten, Opposition machen" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
