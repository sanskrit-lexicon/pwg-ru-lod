  skos:definition "<div n=\"1\">— 5) <ab>partic.</ab> {#Avizwa#}\n<div n=\"2\"> a) в <ab>act.</ab> <ab>Bed.</ab>\n<div n=\"3\"> α) {%вошедший, проникший%}: {#karRAvizwa#}\n<ls>BHĀG. P. 11,30,3.</ls>\n<ls>MAITRYUP. 6,31.</ls> {#BoginaH kaYcukAvizwaH#} {%застрявший в%}\n<ls>Spr. 2074.</ls> {#yanmfgezu paya Avizwam#}\n<ls>KAUŚ. 115.</ls> {#arDAvizwayA girA#} {%с полузаглохшим голосом%}\n<ls>KATHĀS. 14,46.</ls> {#BagavatyAvizwAtmA#}\n<ls>BHĀG. P. 4,31,8</ls> (<ab>vgl.</ab>\n<lang n=\"greek\">γ)</lang>. {#AvizwaliNgA jAtiH#} {%прочно сидящий%} так <ab>v. a.</ab> {%constant%}\n<ls>PAT.</ls> у <ls>GOLD.</ls> <ls>MĀN. 155,b</ls> (по <ls>KAIYY.</ls> <ab>pass.</ab>: {#AvizwaM liNgaM yayA sAvizwaliNgA niyataliNgetyarTaH)#}.{# AvizwaliNgatva#} <ab>Comm.</ab> к <ls>BHĀG. P. 4,7,37.</ls>\n<div n=\"3\">— β) {%сидящий на%} (<ab>loc.</ab>), о птицах\n<ls>BHĀG. P. 10,41,22.</ls> {%парящий в воздухе%} (= {#AkASasaMbadDa#} <ab>Comm.</ab>): {#aBra#}\n<ls>R. 7,31,14.</ls>\n<div n=\"3\">— γ) {%целиком погруженный во что-л., всецело преданный чему-л.%} ({#tatpara#})\n<ls>AK. 3,1,9</ls>, <ab>v. l.</ab>\n<div n=\"2\">— b) с <ab>pass.</ab> <ab>Bed.</ab>\n<div n=\"3\"> α) {%обитаемый, наполненный%}: {#bahulAvizwa#} {%густо заселенный%}\n<ls>AIT. BR. 3,44.</ls> {#tErdurAtmaBirAvizwamASramam#}\n<ls>R. 3,1,27.</ls>\n<div n=\"3\">— β) {%пораженный%}: {#manmaTaSarAvizwa#}\n<ls>R. 3,52,20.</ls> {#Avizwa iva tatrasTadevIdAhezuRAgninA#}\n<ls>KATHĀS. 16,50.</ls>\n<div n=\"3\">— γ) {%охваченный —, одержимый —, пораженный —, подавленный —, находящийся во власти%}: {#kalinA#}\n<ls>MBH. 3,2270.</ls> {#AvizweyaM mayA bAlA#}\n<ls>HARIV. 8729.</ls> {#sattvenAvizwacetanaH#}\n<ls>R. GORR. 2,33,11. fg.</ls> <ls>MĀRK. P. 51,100.</ls> без дополнения так <ab>v. a.</ab> {%одержимый злым духом%}\n<ls>TRIK. 3,1,3.</ls>\n<ls>H. 491.</ls>\n<ls>HĀR. 66.</ls> {#AvizwA iva yuDyante#}\n<ls>MBH. 6,1759.</ls>\n<ls>HARIV. 4311.</ls>\n<ls>R. 5,21,8.</ls>\n<ls>KATHĀS. 17,130.</ls> <ls n=\"KATHĀS.\">70,62.</ls>\n<ls>PRAB. 75,10.</ls> {#jarayA#}\n<ls>R. 3,1,9.</ls> {#kzuDA#}\n<ls>MBH. 3,2420.</ls> <ls n=\"MBH.\">12,4274.</ls>\n<ls>PAÑCAT. 69,4.</ls> {#CardyAvizwa#}\n<ls>KĀTY. ŚR. 25,11,31.</ls> {#vedanayA#} ({%боль%} и {%знание%})\n<ls>Spr. 2896.</ls> {#hfcCayAvizwacetanA#}\n<ls>MBH. 3,2106.</ls> {#manmaTAvizwahfdaya#}\n<ls>BRAHMA-P. in LA. (III) 54,10.</ls> {#upadravAvizwa#}\n<ls>SUŚR. 1,120,2.</ls> {#manyunA#}\n<ls>MBH. 5,5996.</ls> <ls n=\"MBH.\">13,184.</ls> {#rozeRa mahatA#}\n<ls>R. 2,74,1.</ls>\n<ls>R. GORR. 1,68,20.</ls> {#rozAvizwacitta#}\n<ls>PAÑCAT. 186,5.</ls> {#kopena#}\n<ls>MĀRK. P. 112,15.</ls>\n{#kopAvizwa#}\n<ls>PAÑCAT. 40,18.</ls> <ls n=\"PAÑCAT.\">55,7.</ls>\n<ls>ŚUK. in LA. (III) 34,14.</ls> {#duHKena mahatA#}\n<ls>R. 1,57,7.</ls>\n<ls>Spr. (II) 1042.</ls> {#SokaduHKAByAm#}\n<ls>MBH. 3,2957.</ls> {#SokAvizwa#}\n<ls>HIT. 126,17.</ls> {#cintayA#}\n<ls>R. 1,55,8.</ls> {#Bayena mahatA#}\n<ls>MBH. 5,7446.</ls> {#kaSmalAvizwa#}\n<ls n=\"MBH. 5,\">7177.</ls> {#tamasA#}\n<ls>HARIV. 2518.</ls>\n<ls>BHĀG. P. 4,28,25.</ls> {#tapasA#}\n<ls>HARIV. 2522.</ls> {#aDarmeRa#}\n<ls>MBH. 13,1304.</ls> {#dozEH#}\n<ls>R. GORR. 2,109,66.</ls> {#vismayAvizwa#}\n<ls>BHAG. 11,14.</ls>\n<ls>MBH. 3,2831.</ls> {#kfpayA#}\n<ls n=\"MBH.\">5,7159.</ls> {#karuRAvizwa#}\n<ls>RĀJA-TAR. 2,43.</ls> {#harzeRa mahatA#}\n<ls>R. 5,14,33.</ls> {#javena mahatA#} {%охваченный великой поспешностью%}\n<ls n=\"R.\">3,60,1.</ls> {#tvarAvizwa#}\n<ls n=\"R.\">2,111,44.</ls> {#snehapASErbahuviDErAvizwavizayA janAH#} {%отягощенный%}\n<ls>MBH. 12,6480.</ls> <ab>Vgl.</ab> {#BUtAvizwa#} (также\n<ls>KATHĀS. 73,293</ls>)."@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 5) <ab>partic.</ab> {#Avizwa#}\n<div n=\"2\"> a) in <ab>act.</ab> <ab>Bed.</ab>\n<div n=\"3\"> α) {%hineingegangen, eingedrungen%}: {#karRAvizwa#}\n<ls>BHĀG. P. 11,30,3.</ls>\n<ls>MAITRYUP. 6,31.</ls> {#BoginaH kaYcukAvizwaH#} {%steckend in%}\n<ls>Spr. 2074.</ls> {#yanmfgezu paya Avizwam#}\n<ls>KAUŚ. 115.</ls> {#arDAvizwayA girA#} {%mit halb stockender Stimme%}\n<ls>KATHĀS. 14,46.</ls> {#BagavatyAvizwAtmA#}\n<ls>BHĀG. P. 4,31,8</ls> (<ab>vgl.</ab>\n<lang n=\"greek\">γ)</lang>. {#AvizwaliNgA jAtiH#} {%fest sitzend%} so <ab>v. a.</ab> {%constant%}\n<ls>PAT.</ls> bei <ls>GOLD.</ls> <ls>MĀN. 155,b</ls> (nach <ls>KAIYY.</ls> <ab>pass.</ab>: {#AvizwaM liNgaM yayA sAvizwaliNgA niyataliNgetyarTaH)#}.{# AvizwaliNgatva#} <ab>Comm.</ab> zu <ls>BHĀG. P. 4,7,37.</ls>\n<div n=\"3\">— β) {%sitzend auf%} (<ab>loc.</ab>), von Vögeln\n<ls>BHĀG. P. 10,41,22.</ls> {%in der Luft schwebend%} (= {#AkASasaMbadDa#} <ab>Comm.</ab>): {#aBra#}\n<ls>R. 7,31,14.</ls>\n<div n=\"3\">— γ) {%ganz in Etwas steckend, einer Sache ganz hingegeben%} ({#tatpara#})\n<ls>AK. 3,1,9</ls>, <ab>v. l.</ab>\n<div n=\"2\">— b) mit <ab>pass.</ab> <ab>Bed.</ab>\n<div n=\"3\"> α) {%bewohnt, erfüllt von%}: {#bahulAvizwa#} {%dicht bewohnt%}\n<ls>AIT. BR. 3,44.</ls> {#tErdurAtmaBirAvizwamASramam#}\n<ls>R. 3,1,27.</ls>\n<div n=\"3\">— β) {%getroffen von%}: {#manmaTaSarAvizwa#}\n<ls>R. 3,52,20.</ls> {#Avizwa iva tatrasTadevIdAhezuRAgninA#}\n<ls>KATHĀS. 16,50.</ls>\n<div n=\"3\">— γ) {%ergriffen von —, besessen von —, befallen —, überwältigt —, in der Gewalt stehend von%}: {#kalinA#}\n<ls>MBH. 3,2270.</ls> {#AvizweyaM mayA bAlA#}\n<ls>HARIV. 8729.</ls> {#sattvenAvizwacetanaH#}\n<ls>R. GORR. 2,33,11. fg.</ls> <ls>MĀRK. P. 51,100.</ls> ohne Ergänzung so <ab>v. a.</ab> {%von einem bösen Geiste besessen%}\n<ls>TRIK. 3,1,3.</ls>\n<ls>H. 491.</ls>\n<ls>HĀR. 66.</ls> {#AvizwA iva yuDyante#}\n<ls>MBH. 6,1759.</ls>\n<ls>HARIV. 4311.</ls>\n<ls>R. 5,21,8.</ls>\n<ls>KATHĀS. 17,130.</ls> <ls n=\"KATHĀS.\">70,62.</ls>\n<ls>PRAB. 75,10.</ls> {#jarayA#}\n<ls>R. 3,1,9.</ls> {#kzuDA#}\n<ls>MBH. 3,2420.</ls> <ls n=\"MBH.\">12,4274.</ls>\n<ls>PAÑCAT. 69,4.</ls> {#CardyAvizwa#}\n<ls>KĀTY. ŚR. 25,11,31.</ls> {#vedanayA#} ({%Schmerz%} und {%Wissen%})\n<ls>Spr. 2896.</ls> {#hfcCayAvizwacetanA#}\n<ls>MBH. 3,2106.</ls> {#manmaTAvizwahfdaya#}\n<ls>BRAHMA-P. in LA. (III) 54,10.</ls> {#upadravAvizwa#}\n<ls>SUŚR. 1,120,2.</ls> {#manyunA#}\n<ls>MBH. 5,5996.</ls> <ls n=\"MBH.\">13,184.</ls> {#rozeRa mahatA#}\n<ls>R. 2,74,1.</ls>\n<ls>R. GORR. 1,68,20.</ls> {#rozAvizwacitta#}\n<ls>PAÑCAT. 186,5.</ls> {#kopena#}\n<ls>MĀRK. P. 112,15.</ls>\n{#kopAvizwa#}\n<ls>PAÑCAT. 40,18.</ls> <ls n=\"PAÑCAT.\">55,7.</ls>\n<ls>ŚUK. in LA. (III) 34,14.</ls> {#duHKena mahatA#}\n<ls>R. 1,57,7.</ls>\n<ls>Spr. (II) 1042.</ls> {#SokaduHKAByAm#}\n<ls>MBH. 3,2957.</ls> {#SokAvizwa#}\n<ls>HIT. 126,17.</ls> {#cintayA#}\n<ls>R. 1,55,8.</ls> {#Bayena mahatA#}\n<ls>MBH. 5,7446.</ls> {#kaSmalAvizwa#}\n<ls n=\"MBH. 5,\">7177.</ls> {#tamasA#}\n<ls>HARIV. 2518.</ls>\n<ls>BHĀG. P. 4,28,25.</ls> {#tapasA#}\n<ls>HARIV. 2522.</ls> {#aDarmeRa#}\n<ls>MBH. 13,1304.</ls> {#dozEH#}\n<ls>R. GORR. 2,109,66.</ls> {#vismayAvizwa#}\n<ls>BHAG. 11,14.</ls>\n<ls>MBH. 3,2831.</ls> {#kfpayA#}\n<ls n=\"MBH.\">5,7159.</ls> {#karuRAvizwa#}\n<ls>RĀJA-TAR. 2,43.</ls> {#harzeRa mahatA#}\n<ls>R. 5,14,33.</ls> {#javena mahatA#} {%von grosser Eile ergriffen%}\n<ls n=\"R.\">3,60,1.</ls> {#tvarAvizwa#}\n<ls n=\"R.\">2,111,44.</ls> {#snehapASErbahuviDErAvizwavizayA janAH#} {%behaftet mit%}\n<ls>MBH. 12,6480.</ls> <ab>Vgl.</ab> {#BUtAvizwa#} (auch\n<ls>KATHĀS. 73,293</ls>)."@de ;
