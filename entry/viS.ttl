  skos:definition "<div n=\"p\">— {#saMpra#} <div n=\"1\"> 1) {%вступать —, входить —, въезжать в%}: {#gfham, veSma#} <ls>ĀŚV. GṚHY. 4,6,7</ls> ({#˚vizwa#}) . <ls>R. 3,61,3.</ls> {#kuwIm#} <ls n=\"R.\">2,123,24.</ls> {#nagaram, puram#} <ls>MBH. 1,3303.</ls> <ls n=\"MBH.\">3,15140.</ls> <ls n=\"MBH.\">4,1156.</ls> <ls>R. 5,9,45.</ls> {#svarAzwram#} <ls>RĀJA-TAR. 4,342</ls> ({#˚vizwa#}).{# yenEva saMpravizwaH sa paTA tenEva niryayO#} <ls>R. 7,23,1,89.</ls> <ls>VARĀH. BṚH. S. 91,3.</ls> <ls>RĀJA-TAR. 6,171.</ls> {#pUrvAdrim#} <ls n=\"RĀJA-TAR.\">4,514.</ls> {#sarasvatI . devasya vadane sAkzAtsaMpravizwA#} <ls>KATHĀS. 6,140.</ls> {#samudram#} <ls>MBH. 1,3339.</ls> {#jalam#} <ls n=\"MBH.\">13,2646.</ls> {#jvalitaM jAtavedasam#} <ls n=\"MBH.\">7,2606.</ls> {#yadasya vArijaM kiMcidapastatsaMpravekzyati#} <ls n=\"MBH.\">14,796.</ls> {#aditiM devAH sarve#} <ls>HARIV. 173</ls> = <ls>VP.</ls> у <ls>MUIR, ST. 4,104.</ls> <ls>MBH. 13,2291.</ls> {#gAtrARi#} (так <ls>ed. Bomb.</ls>) {#gAtrErasyAhaM saMpravekzye hi rakzitum#} <ls n=\"MBH. 13,\">2293.</ls> {#CinnABrARIva saMpetuH saMpraviSya parasparam (mAtaNgAH)#} <ls>MBH. 7,838.</ls> {#mAnasam#} {%проникнуть в чье-л. сердце%} <ls>RĀJA-TAR. 8,1614.</ls> {#DyAnam#} {%прийти на мысль%} <ls>R. 7,26,52.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#saMpra#} <div n=\"1\"> 1) {%eintreten —, hineingehen —, fahren in%}: {#gfham, veSma#} <ls>ĀŚV. GṚHY. 4,6,7</ls> ({#˚vizwa#}) . <ls>R. 3,61,3.</ls> {#kuwIm#} <ls n=\"R.\">2,123,24.</ls> {#nagaram, puram#} <ls>MBH. 1,3303.</ls> <ls n=\"MBH.\">3,15140.</ls> <ls n=\"MBH.\">4,1156.</ls> <ls>R. 5,9,45.</ls> {#svarAzwram#} <ls>RĀJA-TAR. 4,342</ls> ({#˚vizwa#}).{# yenEva saMpravizwaH sa paTA tenEva niryayO#} <ls>R. 7,23,1,89.</ls> <ls>VARĀH. BṚH. S. 91,3.</ls> <ls>RĀJA-TAR. 6,171.</ls> {#pUrvAdrim#} <ls n=\"RĀJA-TAR.\">4,514.</ls> {#sarasvatI . devasya vadane sAkzAtsaMpravizwA#} <ls>KATHĀS. 6,140.</ls> {#samudram#} <ls>MBH. 1,3339.</ls> {#jalam#} <ls n=\"MBH.\">13,2646.</ls> {#jvalitaM jAtavedasam#} <ls n=\"MBH.\">7,2606.</ls> {#yadasya vArijaM kiMcidapastatsaMpravekzyati#} <ls n=\"MBH.\">14,796.</ls> {#aditiM devAH sarve#} <ls>HARIV. 173</ls> = <ls>VP.</ls> bei <ls>MUIR, ST. 4,104.</ls> <ls>MBH. 13,2291.</ls> {#gAtrARi#} (so die <ls>ed. Bomb.</ls>) {#gAtrErasyAhaM saMpravekzye hi rakzitum#} <ls n=\"MBH. 13,\">2293.</ls> {#CinnABrARIva saMpetuH saMpraviSya parasparam (mAtaNgAH)#} <ls>MBH. 7,838.</ls> {#mAnasam#} {%in Jmdes Herz sich Eingang verschaffen%} <ls>RĀJA-TAR. 8,1614.</ls> {#DyAnam#} {%in Gedanken gerathen%} <ls>R. 7,26,52.</ls>"@de ;
