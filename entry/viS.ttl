  skos:definition "6) приступать к чему-л.: {#dIkzAm#}\n<ls>R. 1,11,20.</ls> {#SivadIkzAyAm#}\n<ls>BHĀG. P. 4,2,29.</ls> заниматься чем-л.: {#paSuByaH#} (zur Erklärung von {#vESya#})\n<ls>MBH. 12,6955.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 6) {%an Etwas gehen%}: {#dIkzAm#}\n<ls>R. 1,11,20.</ls> {#SivadIkzAyAm#}\n<ls>BHĀG. P. 4,2,29.</ls> {%sich zu schaffen machen mit%}: {#paSuByaH#} (zur Erklärung von {#vESya#})\n<ls>MBH. 12,6955.</ls>"@de ;
  pwglex:senseTag "6" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
