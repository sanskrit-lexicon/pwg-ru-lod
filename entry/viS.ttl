  skos:definition "<div n=\"p\">— {#nis#}\n<div n=\"1\"> 1) {%войти в, вступить в%} (<ab>acc.</ab> и <ab>loc.</ab>): {#BarturaNkaM (aNke#} <ls>ed. Calc.</ls>) {#nirviSatIM BayAt#}\n<ls>RAGH. 12,38.</ls> {#nizkrAmatI nirviSatI#}\n<ls>BHĀG. P. 4,4,1.</ls> {#tatra#}\n<ls n=\"BHĀG. P.\">5,17,15.</ls> {#vrajam#}\n<ls n=\"BHĀG. P.\">10,22,28.</ls> {#gartam#}\n<ls n=\"BHĀG. P. 10,\">25,22.</ls> {#gfhezu#} (так <ab>v. a.</ab> {%стать домохозяином%})\n<ls n=\"BHĀG. P. 10,\">29,34.</ls> <ls n=\"BHĀG. P.\">5,1,18.</ls> {#nirviSanti GanA yasya kakudi#}\n<ls n=\"BHĀG. P.\">10,36,4.</ls> {#yAM#} {#(purIM) nirviSya samAvasat#}\n<ls n=\"BHĀG. P.\">3,22,32.</ls> {#pulinam#}\n<ls n=\"BHĀG. P.\">10,32,11.</ls> <ls n=\"BHĀG. P. 10,\">52,37.</ls> <ab>med.</ab> <ls n=\"BHĀG. P.\">3,18,1.</ls> <ls n=\"BHĀG. P.\">8,19,10.</ls> <ls n=\"BHĀG. P.\">10,89,51.</ls> {#nirvizwa#} {%вошедший, находящийся внутри%}\n<ls n=\"BHĀG. P.\">1,2,33.</ls> <ls n=\"BHĀG. P.\">3,16,34.</ls> <ls n=\"BHĀG. P.\">4,24,56.</ls> {%сидящий%}\n<ls>RAGH. 12,68</ls> ({#nivizwa#} <ls>ed. Calc.</ls>)."@ru ;
