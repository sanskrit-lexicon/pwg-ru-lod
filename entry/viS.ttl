  skos:definition "<hom>1.</hom> {#viS#} ¦ с {#pra#} <ab>Caus.</ab> VI. {#ahaM dArakaM praveSitA#} так <ab>v. a.</ab> {%я беременна мальчиком%} <ls>DIVYĀVAD. 541,28</ls>. — С {#manas#} {%направлять свои мысли на%} (<ab>Loc.</ab>) <ls>R. ed. Bomb. 3,68,38</ls>."@ru ;
