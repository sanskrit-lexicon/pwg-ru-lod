  skos:definition "<div n=\"1\">— 1〉 {%поселяться, входить —, вступать —, вселяться —, проникать внутрь —, вползать —, врываться —, погружаться —, сливаться с%} (<ab>Loc.</ab> или <ab>Acc.</ab>); также с добавлением {#antar#} (<ls n=\"Chr.\">299,26</ls>). {#agnim#} <ab>u. s. w.</ab> {%всходить на погребальный костер%}. В <ab>Astr.</ab> {%вступать в соединение с%} (<ab>Acc.</ab>). Без дополнения {%входить в дом%} <ab>u. s. w.</ab>, {%выступать на сцене, появляться%}."@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 1〉 {%sich niederlassen, hineintreten —, eingehen —, einziehen —, sich hineinbegeben —, hineinschlüpfen —, eindringen —, versinken —, aufgehen in%} (<ab>Loc.</ab> oder <ab>Acc.</ab>); auch mit hinzugefügtem {#antar#} (<ls n=\"Chr.\">299,26</ls>). {#agnim#} <ab>u. s. w.</ab> {%den Scheiterhaufen besteigen%}. In der <ab>Astr.</ab> {%in Conjunction kommen mit%} (<ab>Acc.</ab>). Ohne Ergänzung {%hineintreten inʼs Haus%} <ab>u. s. w.</ab>, {%auftreten auf der Schaubühne, erscheinen%}."@de ;
  pwglex:senseTag "1-body" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Синонимический ряд движения-внутрь (сесть/войти/вселиться/проникнуть/погрузиться/слиться) передан рядом того же кардинального числа, ср. корпусные формы viveśa, viśanti — базовое значение «входить, вступать»."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
