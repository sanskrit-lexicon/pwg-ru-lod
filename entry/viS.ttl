  pwglex:differentia "Метафорический «переход» к деятельности; «приступать» передаёт начинательный оттенок точнее, чем «заниматься», которое используется для подзначения с sich zu schaffen machen."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-06-29T14:09:50Z"^^xsd:dateTime ;
