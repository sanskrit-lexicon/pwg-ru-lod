  skos:definition "वायु I /vāyu/ m. 1) ветер 2) воздух 3) дыхание 4) nom. pr. бог ветра, хранитель Северо-Запада 5) ветер, газы (как один из трех составных элементов тела)"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

