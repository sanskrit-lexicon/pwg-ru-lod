<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_45_x5f_upa/c_x29_> a ontolex:LexicalSense ;
  skos:definition "<div n=\"2\"> — c) снабженный, украшенный (чем-л.) (<ab>instr.</ab>): {#hemnEvopagataM maRim#} — оправленный в золото; <ls>MBH. 12,1545.</ls> — <ab>caus.</ab>, заставить подойти, призвать к себе: {#enAmupagamayya#}; <ls>DAŚAK. 137,18.</ls> — <ab>desid.</ab>, желающий шествовать (пешком идти): {#tasya mahAnuBAvasyAnupaTam — kaH — upajigamizati#}; <ls>BHĀG. P. 5,24,26</ls>; <ab>vgl.</ab> {#upajigamizu#} к (<ab>acc.</ab>) — желающий пойти: <ls>MEGH. 43.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"2\">— c) {%versehen mit%} (<ab>instr.</ab>): {#hemnEvopagataM maRim#} {%in Gold gefasst%}\n<ls>MBH. 12,1545.</ls> — <ab>caus.</ab> {%herbeikommen lassen%}: {#enAmupagamayya#}\n<ls>DAŚAK. 137,18.</ls> — <ab>desid.</ab> {%zu wandeln begehren%}: {#tasya mahAnuBAvasyAnupaTam — kaH — upajigamizati#}\n<ls>BHĀG. P. 5,24,26</ls>; <ab>vgl.</ab> {#upajigamizu#} {%zu%} (<ab>acc.</ab>) — {%zu gehen wünschend%}\n<ls>MEGH. 43.</ls>"@de ;
  pwglex:senseTag "c)" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Четыре подпункта различаются семантически: 'versehen mit' — статальное значение снабжённости/обладания признаком; 'herbeikommen lassen' — каузативное значение (заставить приблизиться); 'zu wandeln begehren' и 'zu gehen wünschend' — дечидеративные формы (желание идти/шествовать), различающиеся лишь глаголом-опорой (wandeln 'шествовать' vs gehen 'идти')."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-03T16:34:44Z"^^xsd:dateTime ;
  dct:references <https://w3id.org/sanskrit-lexicon/repwg/citation/BH_xc4__x80_G_x2e__x2d_P_x2e__x2d_5_x2c_24_x2c_26>, <https://w3id.org/sanskrit-lexicon/repwg/citation/DA_xc5__x9a_AK_x2e__x2d_137_x2c_18_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/MBH_x2e__x2d_12_x2c_1545_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/MEGH_x2e__x2d_43_x2e_> ;
  prov:wasAttributedTo <https://w3id.org/sanskrit-lexicon/repwg/prov/export-lod> .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_45_x5f_upa/_xd1__x8d__xd1__x82__xd0__xb8__xd0__xbc__xd0__xbe__xd0__xbb__xd0__xbe__xd0__xb3__xd0__xb8__xd1__x87__xd0__xb5__xd1__x81__xd0__xba__xd0__xbe__xd0__xb5__x20__xd0__xbf__xd1__x80__xd0__xb8__xd0__xbc__xd0__xb5__xd1__x87__xd0__xb0__xd0__xbd__xd0__xb8__xd0__xb5_> a ontolex:LexicalSense ;
  skos:definition "<div n=\"v\"> — <ab>Vgl.</ab> {#upaga, upagata#} <ab>fgg.</ab>, {#upagAmin#} и выше — {#upA#}, куда могли бы быть отнесены также аугментированные формы (отмеченные звездочкой * после цитаты), поскольку <ab>z. B.</ab> {#upAgamat#} также разложимо на {#upa + A + agamat#}."@ru ;
  pwglex:sourceGloss "<div n=\"v\">— <ab>Vgl.</ab> {#upaga, upagata#} <ab>fgg.</ab>, {#upagAmin#} und oben — {#upA#}, wohin die augmentirten Formen (durch * nach dem Citat bezeichnet) gleichfalls gestellt werden könnten, da <ab>z. B.</ab> {#upAgamat#} auch in {#upa + A + agamat#} zerlegbar ist."@de ;
  pwglex:senseTag "этимологическое примечание" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "mixed" ;
  pwglex:differentia "Не самостоятельное значение, а грамматическое примечание составителей о возможности иной группировки аугментированных форм ввиду разложимости формы на составляющие."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-03T16:34:44Z"^^xsd:dateTime ;
  prov:wasAttributedTo <https://w3id.org/sanskrit-lexicon/repwg/prov/export-lod> .

