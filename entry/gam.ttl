  skos:definition "<div n=\"1\">— 3) {%наталкиваться на, находить%}: {#kva nu nAma vayam — taM naram . samAgacCema yo nastadrUpamApAdayetpunaH ..#}\n<ls>MBH. 1,7873.</ls> {#zaqindriyARi vizayaM samAgacCanti vE yadA#}\n<ls n=\"MBH.\">3,113.</ls> — <ab>caus.</ab> {%кого-л.%} (<ab>acc.</ab>) {%сводить, соединять с%} (<ab>instr.</ab> <ab>loc.</ab>): {#samAgamaya vEdehyA rAmam#}\n<ls>R. 5,6,29.</ls> {#tAM kOmudImiva samAgamayendubimbe#}\n<ls>VIKR. 34.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3) {%stossen auf, finden%}: {#kva nu nAma vayam — taM naram . samAgacCema yo nastadrUpamApAdayetpunaH ..#}\n<ls>MBH. 1,7873.</ls> {#zaqindriyARi vizayaM samAgacCanti vE yadA#}\n<ls n=\"MBH.\">3,113.</ls> — <ab>caus.</ab> {%Jmd%} (<ab>acc.</ab>) {%zusammenführen mit%} (<ab>instr.</ab> <ab>loc.</ab>): {#samAgamaya vEdehyA rAmam#}\n<ls>R. 5,6,29.</ls> {#tAM kOmudImiva samAgamayendubimbe#}\n<ls>VIKR. 34.</ls>"@de ;
