<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_63_x5f_sam_x5f_0/4_x29_> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 4) {%подходить друг к другу, соответствовать, совпадать%}: {#asminvAkye (tattvam) nIlamutpalamiti vAkyavadvAkyArTo na saMgacCate#}\n<ls>VEDĀNTAS. 55. 56.</ls> {#sarvaM saMgatamevEtat#}\n<ls>KATHĀS. 2,67.</ls>\n<ls>AK. 1,2,3,43.</ls> {#bahusaMgataM vacaH#}\n<ls>R. 2,95,19.</ls> {#saMgata#} (о речи) = {#hfdayaMgama#}\n<ls>AK. 1,1,5,19.</ls>\n<ls>H. 268.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 4) {%zusammenpassen, zutreffen, entsprechen%}: {#asminvAkye (tattvam) nIlamutpalamiti vAkyavadvAkyArTo na saMgacCate#}\n<ls>VEDĀNTAS. 55. 56.</ls> {#sarvaM saMgatamevEtat#}\n<ls>KATHĀS. 2,67.</ls>\n<ls>AK. 1,2,3,43.</ls> {#bahusaMgataM vacaH#}\n<ls>R. 2,95,19.</ls> {#saMgata#} (von einer Rede) = {#hfdayaMgama#}\n<ls>AK. 1,1,5,19.</ls>\n<ls>H. 268.</ls>"@de ;
  pwglex:senseTag "4)" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "'zusammenpassen' (взаимное соответствие двух вещей друг другу) vs 'zutreffen'/'entsprechen' (соответствие утверждения/речи действительности) — рендерятся синонимическим рядом, т.к. немецкий даёт их через запятую как взаимозаменяемые в рамках одного значения."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-03T16:34:44Z"^^xsd:dateTime ;
  dct:references <https://w3id.org/sanskrit-lexicon/repwg/citation/AK_x2e__x2d_1_x2c_1_x2c_5_x2c_19_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/AK_x2e__x2d_1_x2c_2_x2c_3_x2c_43_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/H_x2e__x2d_268_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/KATH_xc4__x80_S_x2e__x2d_2_x2c_67_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/R_x2e__x2d_2_x2c_95_x2c_19_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/VED_xc4__x80_NTAS_x2e__x2d_55_x2e__x2d_56_x2e_> ;
