<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_45_x5f_upa/7a> a ontolex:LexicalSense ;
  skos:definition "<div n=\"2\"> a) {%граничащий, находящийся поблизости%}: {#upagatA daSa yezAm = upadaSAH#} {%почти десять%}\n<ls>VOP. 6,22.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"2\"> a) {%angränzend, in der Nähe befindlich%}: {#upagatA daSa yezAm = upadaSAH#} {%beinahe zehn%}\n<ls>VOP. 6,22.</ls>"@de ;
  pwglex:senseTag "7a" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "граничащий = смежный, примыкающий (пространственная смежность, 'angränzend'); находящийся поблизости = расположенный рядом (близость, 'in der Nähe befindlich') — синонимическая пара PWG сохранена как две единицы, соединённые запятой."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-03T16:34:44Z"^^xsd:dateTime ;
  dct:references <https://w3id.org/sanskrit-lexicon/repwg/citation/VOP_x2e__x2d_6_x2c_22_x2e_> ;
  prov:wasAttributedTo <https://w3id.org/sanskrit-lexicon/repwg/prov/export-lod> .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_45_x5f_upa/7b> a ontolex:LexicalSense ;
  skos:definition "<div n=\"2\">— b) {%скончавшийся, умерший%}\n<ls>H. 374.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"2\">— b) {%heimgegangen, todt%}\n<ls>H. 374.</ls>"@de ;
  pwglex:senseTag "7b" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "скончавшийся = эвфемистическое 'ушедший, почивший' (буквально 'heimgegangen' = 'ушедший домой'); умерший = нейтральное 'мёртвый, покойный' (todt) — эвфемистически-нейтральная пара PWG сохранена без слияния."@ru ;
