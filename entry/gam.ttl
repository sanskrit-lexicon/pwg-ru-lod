<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_63_x5f_sam_x5f_0/1_x29_> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\"> 1) сходиться, — встречаться; сходиться с кем-л., соединяться с кем-л., связываться с кем-л.; дружественно, враждебно, в половом отношении: {#yenA^ sa\\MgacCA\\ upa^ mA\\ sa Si^kzAt#} <ls>AV. 7,12,1.</ls> {#yatra^ de\\vAH sa\\maga^cCanta\\ viSve^#} <ls>ṚV. 10,82,6.</ls> <ls n=\"ṚV.\">1,185,5.</ls> <ls n=\"ṚV.\">10,97,6.</ls> <ls n=\"ṚV. 10,\">191,2.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\"> 1) {%zusammenkommen, — treffen; zusammenkommen mit, sich vereinigen mit, sich verbinden mit%}; freundlich, feindlich, geschlechtlich: {#yenA^ sa\\MgacCA\\ upa^ mA\\ sa Si^kzAt#} <ls>AV. 7,12,1.</ls> {#yatra^ de\\vAH sa\\maga^cCanta\\ viSve^#} <ls>ṚV. 10,82,6.</ls> <ls n=\"ṚV.\">1,185,5.</ls> <ls n=\"ṚV.\">10,97,6.</ls> <ls n=\"ṚV. 10,\">191,2.</ls>"@de ;
  pwglex:senseTag "1)" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Запятая внутри «сходиться, — встречаться» отмечает взаимозаменяемые синонимы нейтральной встречи; точка с запятой перед «сходиться с..., соединяться с..., связываться с...» вводит отдельное, более тесное значение (объединение/союз), уточняемое далее контекстными наречиями «дружественно, враждебно, в половом отношении» и иллюстрируется примерами."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-03T16:34:44Z"^^xsd:dateTime ;
