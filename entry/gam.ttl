<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_zz_x5f_pw04/1> a ontolex:LexicalSense ;
  skos:definition "√{#gam#}¦ с {#aBi#} <ab>Caus.</ab> II. 5.\n<div n=\"p\">— С {#A#} II. {#Agamya#} <ab>Absol.</ab> так <ab>v. a.</ab> {%для, ради;%} с <ab>Acc.</ab> <ls>DIVYĀVAD. 95,10</ls>. с <ab>Gen.</ab> <ls n=\"DIVYĀVAD.\">405,10</ls>.\n<div n=\"p\">— С {#aByud#} II. 3.\n<div n=\"p\">— С {#nis#} <ab>Caus.</ab> II. 5.\n<div n=\"p\">— С {#upanis#} {%выходить к%} (<ab>Acc.</ab>) <ls>JĀTAKAM. 31</ls>.<info n=\"sup_7\"/>"@ru ;
  pwglex:sourceGloss "√{#gam#}¦ mit {#aBi#} <ab>Caus.</ab> II. 5.\n<div n=\"p\">— Mit {#A#} II. {#Agamya#} <ab>Absol.</ab> so <ab>v. a.</ab> {%für, behufs;%} mit <ab>Acc.</ab> <ls>DIVYĀVAD. 95,10</ls>. mit <ab>Gen.</ab> <ls n=\"DIVYĀVAD.\">405,10</ls>.\n<div n=\"p\">— Mit {#aByud#} II. 3.\n<div n=\"p\">— Mit {#nis#} <ab>Caus.</ab> II. 5.\n<div n=\"p\">— Mit {#upanis#} {%hinausgehen zu%} (<ab>Acc.</ab>) <ls>JĀTAKAM. 31</ls>.<info n=\"sup_7\"/>"@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«для, ради» — фиксированный перевод für, behufs (предложное значение при абсолютиве); «выходить к» для hinausgehen zu (Akk.) как отдельного упасарга-значения."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
