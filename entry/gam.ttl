<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_63_x5f_sam_x5f_0/5_x29_> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 5) <ab>trans.</ab> <ab>act.</ab> {%идти к, посещать%}: {#grAmaM saMgacCate#}\n<ls>P. 1,3,29</ls>, <ab>Sch.</ab>\n<ls>VOP. 23,14.</ls> {%иметь половую связь (с кем-л.)%}: {#saMgacCa pOMsni strERaM mAM yuvAnam#}\n<ls>BHAṬṬ. 5,91.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 5) <ab>trans.</ab> <ab>act.</ab> {%gehen zu, besuchen%}: {#grAmaM saMgacCate#}\n<ls>P. 1,3,29</ls>, <ab>Sch.</ab>\n<ls>VOP. 23,14.</ls> {%beschlafen%}: {#saMgacCa pOMsni strERaM mAM yuvAnam#}\n<ls>BHAṬṬ. 5,91.</ls>"@de ;
  pwglex:senseTag "5)" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "'gehen zu, besuchen' — нейтральное 'идти к, посещать'; следующее 'beschlafen' — эвфемизм («посетить» женщину = вступить в половую связь), передан отдельным пояснительным толкованием, а не тем же нейтральным глаголом, чтобы сохранить эвфемистический сдвиг значения немецкого текста."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-03T16:34:44Z"^^xsd:dateTime ;
