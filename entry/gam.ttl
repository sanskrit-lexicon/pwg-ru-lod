<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_38_x5f_sam_x5f_a/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#samA#}\n<div n=\"1\"> 1) {%сойтись, встретиться, соединиться, объединиться с%} (<ab>loc.</ab>), {%с%} (<ab>instr.</ab> одно или вместе с {#saha, sArGam#}) {%сойтись с кем-л.%} (дружественно или враждебно), {%вступить в половую связь%}\n<ls>ŚAT. BR. 10,6,2,1.</ls> {#yaddvO raTO mfditO samAgacCetAm#}\n<ls n=\"ŚAT. BR.\">12,5,1,5.</ls> {#kAmyake pARqavaM drazwuM samAjagmuH#}\n<ls>MBH. 3,8476.</ls>\n<ls>R. 4,28,31.</ls>\n<ls>PAÑCAT. II,17.</ls> {#amantrayansamAgamya sarve#}\n<ls>R. 1,63,17.</ls> {#taddAsEreva dAtavyaM samAgamya#}\n<ls>M. 8,408.</ls> <ls n=\"M.\">7,148.</ls>\n<ls>MBH.</ls> в <ls>BENF. Chr. 43. 23.</ls> <ls>PAÑCAT. 77,18.</ls> {#samAgacCantyayatnena saMgamaM ca parasparam#} {%вступить друг с другом в союз%}\n<ls>R. 4,44,78.</ls> {%сойтись%}, о светилах так <ab>v. a.</ab> {%занять такое положение, что одна звезда закрывает другую%},\n<ls>VARĀH. BṚH. S. 5,11.</ls> <ls n=\"VARĀH. BṚH. S. 5,\">34.</ls> {#yadA vE miTunO samAgacCataH#} (плотски)\n<ls>CHĀND. UP. 1,1,6.</ls> {#samAgata#} {%сошедшиеся, собравшиеся, соединившиеся%}\n<ls>MBH.</ls> в <ls>BENF. Chr. 4,15. 19,15.</ls> <ls>BHAG. 1,23.</ls> <ls>N. 3,5.</ls> <ls n=\"N.\">4,10.</ls> <ls n=\"N. 4,\">22.</ls> <ls n=\"N.\">13,19.</ls> <ls>R. 3,35,114.</ls> <ls>ŚĀK. 188.</ls> {#aruRa OpaveSO samAjagmuH#}\n<ls>ŚAT. BR. 10,6,1,1.</ls> {#brAhmaRErDAvayadBiH samAjagAma#}\n<ls n=\"ŚAT. BR.\">11,6,2,1.</ls> {#yaTArhamfziBiH sarvEH samAgamya#}\n<ls>R. 1,50,9.</ls> <ls n=\"R.\">2,70,2.</ls> {#mantriBiH samAgataH#}\n<ls>YĀJÑ. 1,328.</ls>\n<ls>DRAUP. 5,22.</ls>\n<ls>R. 1,1,58.</ls> <ls n=\"R. 1,1,\">67</ls> {#api kftyaM kftaM tAta rAmeRa ca samAgatam#}\n<ls n=\"R.\">2,113,7.</ls> {#pareRa samAgatam#} (враждебно)\n<ls>M. 7,92.</ls>\n<ls>MBH. 1,5996.</ls>\n<ls>BENF. Chr. 33,1.</ls> {#samAgamya dvijEH sArDam#}\n<ls>MBH. 7,2389.</ls>\n<ls>R. 6,8,20.</ls> {#sA tvaM mayA samAgacCa#} (плотски)\n<ls>MBH. 3,17097.</ls> <ls n=\"MBH.\">13,1462.</ls>\n[Page2-0679]"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#samA#}\n<div n=\"1\"> 1) {%zusammenkommen, zusammentreffen, sich verbinden, bei%} (<ab>loc.</ab>), {%mit%} (<ab>instr.</ab> allein oder mit {#saha, sArGam#}) {%Jmd zusammenkommen%} (freundlich oder feindlich), {%sich geschlechtlich verbinden%}\n<ls>ŚAT. BR. 10,6,2,1.</ls> {#yaddvO raTO mfditO samAgacCetAm#}\n<ls n=\"ŚAT. BR.\">12,5,1,5.</ls> {#kAmyake pARqavaM drazwuM samAjagmuH#}\n<ls>MBH. 3,8476.</ls>\n<ls>R. 4,28,31.</ls>\n<ls>PAÑCAT. II,17.</ls> {#amantrayansamAgamya sarve#}\n<ls>R. 1,63,17.</ls> {#taddAsEreva dAtavyaM samAgamya#}\n<ls>M. 8,408.</ls> <ls n=\"M.\">7,148.</ls>\n<ls>MBH.</ls> in <ls>BENF. Chr. 43. 23.</ls> <ls>PAÑCAT. 77,18.</ls> {#samAgacCantyayatnena saMgamaM ca parasparam#} {%eine Verbindung unter einander eingehen%}\n<ls>R. 4,44,78.</ls> {%zusammenkommen%}, von Sternen so <ab>v. a.</ab> {%in eine solche Stellung kommen, dass der eine Stern den andern verdeckt%},\n<ls>VARĀH. BṚH. S. 5,11.</ls> <ls n=\"VARĀH. BṚH. S. 5,\">34.</ls> {#yadA vE miTunO samAgacCataH#} (fleischlich)\n<ls>CHĀND. UP. 1,1,6.</ls> {#samAgata#} {%zusammengekommen, versammelt. vereinigt%}\n<ls>MBH.</ls> in <ls>BENF. Chr. 4,15. 19,15.</ls> <ls>BHAG. 1,23.</ls> <ls>N. 3,5.</ls> <ls n=\"N.\">4,10.</ls> <ls n=\"N. 4,\">22.</ls> <ls n=\"N.\">13,19.</ls> <ls>R. 3,35,114.</ls> <ls>ŚĀK. 188.</ls> {#aruRa OpaveSO samAjagmuH#}\n<ls>ŚAT. BR. 10,6,1,1.</ls> {#brAhmaRErDAvayadBiH samAjagAma#}\n<ls n=\"ŚAT. BR.\">11,6,2,1.</ls> {#yaTArhamfziBiH sarvEH samAgamya#}\n<ls>R. 1,50,9.</ls> <ls n=\"R.\">2,70,2.</ls> {#mantriBiH samAgataH#}\n<ls>YĀJÑ. 1,328.</ls>\n<ls>DRAUP. 5,22.</ls>\n<ls>R. 1,1,58.</ls> <ls n=\"R. 1,1,\">67</ls> {#api kftyaM kftaM tAta rAmeRa ca samAgatam#}\n<ls n=\"R.\">2,113,7.</ls> {#pareRa samAgatam#} (feindlich)\n<ls>M. 7,92.</ls>\n<ls>MBH. 1,5996.</ls>\n<ls>BENF. Chr. 33,1.</ls> {#samAgamya dvijEH sArDam#}\n<ls>MBH. 7,2389.</ls>\n<ls>R. 6,8,20.</ls> {#sA tvaM mayA samAgacCa#} (fleischlich)\n<ls>MBH. 3,17097.</ls> <ls n=\"MBH.\">13,1462.</ls>\n[Page2-0679]"@de ;
