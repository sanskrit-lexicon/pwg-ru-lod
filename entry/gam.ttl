  skos:definition "<div n=\"1\">— 5) {%приходить, впадать в некое состояние, положение, отношение; становиться причастным чему-л., обретать%}: {#ja\\ri\\mARa^m#}\n<ls>ṚV. 1,116,25.</ls> {#dIrGAyutvam#}\n<ls>ŚĀṄKH. ŚR. 14,12,5.</ls> {#mA\\turheqa^m#}\n<ls>AV. 12,4,32.</ls> {#tamA^Msi#}\n<ls n=\"AV.\">2,25,5.</ls> {#ADi^patyam#}\n<ls n=\"AV.\">18,4,54.</ls> {#aga^nnidra\\ Sravo^ bf\\hat#}\n<ls>ṚV. 3,37,10.</ls> {#gama^nna\\ indra^H sa\\KyA vaya^Sca#}\n<ls n=\"ṚV. 3,\">178,2.</ls> {#juzwiM te gameyam#}\n<ls>LĀṬY. 3,6,3.</ls> {#yo yajYasya saMsTAmagan#}\n<ls>ŚAT. BR. 1,1,1,3.</ls> {#SUdratvam#}\n<ls>M. 2,168.</ls> {#amaralokatAm#}\n<ls n=\"M. 2,\">5.</ls> {#aByarhaRIyatAm#}\n<ls n=\"M.\">9,23.</ls> {#vaDyatAm#}\n<ls>N. 9,8.</ls> {#upahAsyatAm#}\n<ls>RAGH. 1,3.</ls> {#vEklavyam#}\n<ls>N. 23,21.</ls> {#AnfRyam#} <ls>M. 4,257.</ls>\n<ls n=\"M.\">9,229.</ls> {#utkarzaM cApakarzam#}\n<ls n=\"M.\">10,42.</ls> {#kulasaMKyAm#}\n<ls n=\"M.\">3,66.</ls> {#nASam#}\n<ls n=\"M.\">8,17.</ls> <ls>HIT. I,59.</ls> {#pralayam#}\n<ls>MATSYOP. 27.</ls> {#kzayam#}\n<ls>R. 2,109,11.</ls> {#dizwAntam#}\n<ls n=\"R. 2,\">66,12.</ls> {#jarAm#}\n<ls n=\"R.\">3,53,59.</ls> {#vizAdam#}\n<ls n=\"R. 2,\">68,5.</ls> <ls>MBH. 1,7677.</ls> <ls>VID. 154.</ls> {#vismayam#}\n<ls>PAÑCAT. 192,2.</ls> {#paritozam#}\n<ls>R. 1,58,21.</ls> {#kroDam#}\n<ls n=\"R. 1,\">64,18.</ls> {#Bayam#}\n<ls>MBH. 1,7629.</ls> {#Artim#}\n<ls n=\"MBH. 1,\">7679.</ls> {#nirvedam#}\n<ls>BHAG. 2,52.</ls> {#niScayam#}\n<ls>R. 1,42,27.</ls> {#pratizWAm#}\n<ls n=\"R. 1,\">2,18.</ls> {#nidrAm#}\n<ls>MEGH. 110.</ls> {#umAKyAm#} {%имя%} <is>Umā</is> {%получить%}\n<ls>KUMĀRAS. 1,26.</ls> {#pOruzam . lokavfttiprakASena jYAnamArgeRa gamyate#}\n<ls>MBH. 3,13935.</ls>"@ru ;
