<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_63_x5f_sam_x5f_0/1> a ontolex:LexicalSense ;
  skos:definition "<ls>ŚĀK. 88</ls>, <ab>v. l.</ab>\n<ls>VID. 153.</ls>\n<ls>KATHĀS. 2,19.</ls> {#ratnaM ratnena saMgacCate#} {%жемчужина нанизывается на жемчужину%} пословично: так <ab>v. a.</ab> {%подобное соединяется с подобным%}\n<ls>MṚCCH. 14,5.</ls> {#mantrisaMgata#}\n<ls>YĀJÑ. 1,327.</ls> {#parasaMgata#} (враждебно)\n<ls n=\"YĀJÑ. 1,\">325.</ls> {#saMgacCasva mayA sArDamekenEkaH#} (враждебно)\n<ls>MBH. 1,5989.</ls> {#BrAtfBiH saha saMgataH#}\n<ls>ARJ. 3,1.</ls>\n<ls>N. 24,46.</ls>\n<ls>R. 2,50,3.</ls>\n<ls>RĀJA-TAR. 5,257.</ls> в половом отношении: {#tvayA saMgamya#}\n<ls>MBH. 3,17085.</ls>\n<ls>R. 1,48,22.</ls> <ls n=\"R. 1,\">37,23.</ls> {#yasya BAryA ca parasaMgatA#}\n<ls>PAÑCAT. I,234.</ls> {#saMgamizye tvayA saha#}\n<ls>MBH. 3,17119.</ls> {#icCantyA saha saMgataH#}\n<ls>M. 8,378.</ls> {#matkEH saMgacCasva vanEH SuBEH#} так <ab>v. a.</ab> {%приди в мои леса%}\n<ls>BHAṬṬ. 8,16.</ls> Для <ab>act.</ab> у нас имеются следующие места; {#saM sUrya^sya\\ jyoti^pAganma#}"@ru ;
  pwglex:sourceGloss "<ls>ŚĀK. 88</ls>, <ab>v. l.</ab>\n<ls>VID. 153.</ls>\n<ls>KATHĀS. 2,19.</ls> {#ratnaM ratnena saMgacCate#} {%Perle reiht sich an Perle%} sprüchwörtlich so <ab>v. a.</ab> {%Gleiches gesellt sich zu Gleichem%}\n<ls>MṚCCH. 14,5.</ls> {#mantrisaMgata#}\n<ls>YĀJÑ. 1,327.</ls> {#parasaMgata#} (feindlich)\n<ls n=\"YĀJÑ. 1,\">325.</ls> {#saMgacCasva mayA sArDamekenEkaH#} (feindlich)\n<ls>MBH. 1,5989.</ls> {#BrAtfBiH saha saMgataH#}\n<ls>ARJ. 3,1.</ls>\n<ls>N. 24,46.</ls>\n<ls>R. 2,50,3.</ls>\n<ls>RĀJA-TAR. 5,257.</ls> geschlechtlich: {#tvayA saMgamya#}\n<ls>MBH. 3,17085.</ls>\n<ls>R. 1,48,22.</ls> <ls n=\"R. 1,\">37,23.</ls> {#yasya BAryA ca parasaMgatA#}\n<ls>PAÑCAT. I,234.</ls> {#saMgamizye tvayA saha#}\n<ls>MBH. 3,17119.</ls> {#icCantyA saha saMgataH#}\n<ls>M. 8,378.</ls> {#matkEH saMgacCasva vanEH SuBEH#} so <ab>v. a.</ab> {%komm in meine Wälder%}\n<ls>BHAṬṬ. 8,16.</ls> Für das <ab>act.</ab> haben wir folgende Stellen; {#saM sUrya^sya\\ jyoti^pAganma#}"@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:differentia "Одна общая нить значения «сходиться, соединяться» (иллюстрируется поговоркой о нанизывании жемчужин и о том, что подобное соединяется с подобным); внутри неё дважды отдельно помечен враждебный оттенок встречи/столкновения «(враждебно)», а также отдельно — половой оттенок соединения «в половом отношении»; финальная ремарка вводит подборку мест (цитат) для рассматриваемой формы."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-03T16:34:44Z"^^xsd:dateTime ;
