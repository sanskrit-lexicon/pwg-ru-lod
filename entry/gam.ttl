  skos:definition "<div n=\"p\">— {#upa#}\n<div n=\"1\"> 1) {%приходить, присоединяться; подходить к, приступать к, идти в некое место, достигать; посещать; достигать, встречать%}: {#raTe^ dA\\SvAMsa\\mupa^ gacCatam#}\n<ls>ṚV. 1,47,3.</ls> <ls n=\"ṚV. 1,\">151,7.</ls> <ls n=\"ṚV.\">6,52,8.</ls> {#havA^mahe\\ tvopa^ganta\\vA u^#}\n<ls n=\"ṚV.\">10,160,5.</ls> <ls n=\"ṚV.\">9,67,29.</ls> <ls n=\"ṚV. 9,\">92,2.</ls> {#u\\tASi^ta\\mupa^ gacCanti mf\\tyava^H#}\n<ls n=\"ṚV.\">10,117,1.</ls> <ls n=\"ṚV. 10,117,\">2.</ls> <ls n=\"ṚV.\">1,53,9.</ls> {#upa^ vA\\mava^H Sara\\RaM ga^meyam#}\n<ls n=\"ṚV. 1,\">158,3.</ls> <ls>ŚAT. BR. 2,1,1,8.</ls> {#agneH priyaM DAmopajagAma#}\n<ls n=\"ŚAT. BR.\">2,2,3,4.</ls> <ls n=\"ŚAT. BR.\">9,1,1,22.</ls> <ls n=\"ŚAT. BR.\">14,1,4,13.</ls>\n[Page2-0680]\n{#pratirUpaM hEvEnamupagacCati#}\n<ls n=\"ŚAT. BR.\">14,5,1,8.</ls> — {#upagacCetsvayaM ca yaH (putraH)#}\n<ls>MBH. 1,4673.</ls> <ls n=\"MBH.\">3,2681.</ls>\n<ls>R. 3,4,32.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#upa#}\n<div n=\"1\"> 1) {%hinzukommen; herankommen an, hinzutreten zu, an einen Ort hingehen, gelangen zu; besuchen; erreichen, treffen%}: {#raTe^ dA\\SvAMsa\\mupa^ gacCatam#}\n<ls>ṚV. 1,47,3.</ls> <ls n=\"ṚV. 1,\">151,7.</ls> <ls n=\"ṚV.\">6,52,8.</ls> {#havA^mahe\\ tvopa^ganta\\vA u^#}\n<ls n=\"ṚV.\">10,160,5.</ls> <ls n=\"ṚV.\">9,67,29.</ls> <ls n=\"ṚV. 9,\">92,2.</ls> {#u\\tASi^ta\\mupa^ gacCanti mf\\tyava^H#}\n<ls n=\"ṚV.\">10,117,1.</ls> <ls n=\"ṚV. 10,117,\">2.</ls> <ls n=\"ṚV.\">1,53,9.</ls> {#upa^ vA\\mava^H Sara\\RaM ga^meyam#}\n<ls n=\"ṚV. 1,\">158,3.</ls> <ls>ŚAT. BR. 2,1,1,8.</ls> {#agneH priyaM DAmopajagAma#}\n<ls n=\"ŚAT. BR.\">2,2,3,4.</ls> <ls n=\"ŚAT. BR.\">9,1,1,22.</ls> <ls n=\"ŚAT. BR.\">14,1,4,13.</ls>\n[Page2-0680]\n{#pratirUpaM hEvEnamupagacCati#}\n<ls n=\"ŚAT. BR.\">14,5,1,8.</ls> — {#upagacCetsvayaM ca yaH (putraH)#}\n<ls>MBH. 1,4673.</ls> <ls n=\"MBH.\">3,2681.</ls>\n<ls>R. 3,4,32.</ls>"@de ;
