  skos:definition "<div n=\"p\">— <ab>caus.</ab> {#gama/yati#}\n<ls>P. 2,4,46.</ls>\n<ls>VOP. 18,22.</ls>\n<div n=\"1\"> 1) побуждать {%кого-л.%} (<ab>acc.</ab>) {%идти%} или {%приходить; доставлять к кому-л.%} (<ab>dat.</ab>) {%; приводить кого-л.%} (<ab>acc.</ab>) {%в какое-л. место%} (<ab>acc.</ab>) {%%} (\n<ls>P. 1,4,52</ls>); {%приводить в какое-л. состояние%} (<ab>acc.</ab>): {#gamayati devadattaM yajYadattaH#}\n<ls>P. 1,4,52</ls>, <ab>Sch.</ab>\n{#svayaM ha raTena yAtI3 . upADyAyaM padAtiM gamayati#}\n<ls n=\"P.\">8,1,60</ls>, <ab>Sch.</ab> {#tena tvamevaM gamito mayA#}\n<ls>MBH. 18,95.</ls> {#asraM gamayati pretAnkopo 'rInanftaM SunaH#}\n<ls>M. 3,230.</ls> {#tasmA^ enadgamayAmaH#}\n<ls>AV. 16,6,4.</ls> {#asU^npi\\tfByo^ gama\\yAM ca^kAra#}\n<ls n=\"AV.\">18,2,27.</ls> {#sUryaM cakzurgamayatAt#}\n<ls>AIT. BR. 2,6.</ls> {#pa\\rA\\vata^M sa\\patnI^m#}\n<ls>ṚV. 10,145,4.</ls> <ls n=\"ṚV. 10,\">152,4.</ls>\n<ls>AV. 2,25,5.</ls> {#tatra^ ha\\vyAni^ gAmaya#} (<is>Padap</is>.: {#gamaya#})\n<ls>ṚV. 5,5,10.</ls> {#pi\\tf\\lo\\kam#}\n<ls>AV. 18,4,64.</ls> <ls n=\"AV.\">12,3,34.</ls>\n<ls>VS. 8,44.</ls>\n<ls>ŚAT. BR. 13,2,9,7.</ls> <ls n=\"ŚAT. BR.\">14,4,1,11.</ls> <ls n=\"ŚAT. BR. 14,\">9,1,18.</ls> {#asato mA sadgamaya tamaso mA jyotirgamaya#}\n<ls>ŚAT. BR. 14,4,1,30.</ls> <ls>PRAŚNOP. 4,4.</ls> {#tAm — samudraM gamayizyati#}\n<ls>MBH. 3,493.</ls> {#vEvasvatakzayam#}\n<ls n=\"MBH.\">2,2557.</ls> <ls>DAŚAK.</ls> в <ls>BENF. Chr. 201,13.</ls> {#gamayizye#}\n<ls>MBH. 3,625.</ls> {#gamita#} так <ab>v. a.</ab> {#gamito yamakzayam#}\n<ls n=\"MBH.\">12,1042.</ls> {#kowaram — gamite#}\n<ls>MĀLAV. 60.</ls> {#SarIraM nihatyAvidyAM gamayitvA#}\n<ls>ŚAT. BR. 14,7,2,4.</ls> {#sa e\\vEna\\M BUti^M gamayati#}\n<ls>TS. 2,1,1,1.</ls> {#jyEzWyaM SrEzwyaM rAjyamADipatyam#}\n<ls>CHĀND. UP. 5,2,6.</ls> {#ekatAm#}\n<ls n=\"CHĀND. UP.\">6,9,1.</ls> {#uttamAM gatim#}\n<ls>M. 5,42.</ls> {#vilayam#}\n<ls>MBH. 1,8280.</ls> {#dAsyam#}\n<ls n=\"MBH.\">3,1360.</ls> {#parABavam#} (<ab>med.</ab>)\n