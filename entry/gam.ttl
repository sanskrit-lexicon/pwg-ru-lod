<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_63_x5f_sam_x5f_0/_xd0__xb3__xd1__x80__xd0__xb0__xd0__xbc__x2e_> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#sam#} <ab>med.</ab>, редко <ab>act.</ab> (якобы как <ab>trans.</ab> <ls>P. 1,3,29</ls>, <ab>Sch.</ab> <ls>VOP. 23,14</ls>); засвидетельствовано в более древнем языке: {#gacCE, gamemahi, jagme, ajagmiran#} (<ls>ṚV. 10,27,15</ls>), {#agata#} <ls n=\"ṚV. 10,27,\">3.</ls> <ab>sg.</ab>, {#aganmahi, agasmahi#} ?(<ls>ṚV. 1,23,23</ls> = <ls n=\"ṚV.\">9,9,9.</ls>, тогда как <ls>LĀṬY. 2,12,13</ls> {#agaMsmahi#} читает), {#gmizIya, ˚gatya#}.{# saMgmIya#} 3. <ab>sg.</ab> <ab>pot.</ab> <ls>PAT.</ls> к <ls>P. 1,1,62.</ls> {#samagata#} и {#samagaMsta, saMgasIzwa#} и {#saMgaMsIzwa, saMgaMsyate#} <ls>P. 1,2,13</ls>, <ls>Sch. 7,2,58</ls>, <ab>Sch.</ab> <is>Vārtt</is>. 2, <ab>Sch.</ab> <ls>VOP. 8,132.</ls> <ls n=\"VOP.\">23,14.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#sam#} <ab>med.</ab>, selten <ab>act.</ab> (angeblich als <ab>trans.</ab> <ls>P. 1,3,29</ls>, <ab>Sch.</ab> <ls>VOP. 23,14</ls>); zu belegen in der älteren Sprache: {#gacCE, gamemahi, jagme, ajagmiran#} (<ls>ṚV. 10,27,15</ls>), {#agata#} <ls n=\"ṚV. 10,27,\">3.</ls> <ab>sg.</ab>, {#aganmahi, agasmahi#} ?(<ls>ṚV. 1,23,23</ls> = <ls n=\"ṚV.\">9,9,9.</ls> während <ls>LĀṬY. 2,12,13</ls> {#agaMsmahi#} liest), {#gmizIya, ˚gatya#}.{# saMgmIya#} 3. <ab>sg.</ab> <ab>pot.</ab> <ls>PAT.</ls> zu <ls>P. 1,1,62.</ls> {#samagata#} und {#samagaMsta, saMgasIzwa#} und {#saMgaMsIzwa, saMgaMsyate#} <ls>P. 1,2,13</ls>, <ls>Sch. 7,2,58</ls>, <ab>Sch.</ab> <is>Vārtt</is>. 2, <ab>Sch.</ab> <ls>VOP. 8,132.</ls> <ls n=\"VOP.\">23,14.</ls>"@de ;
  pwglex:senseTag "грам." ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "mixed" ;
  pwglex:differentia "Формальное/грамматическое замечание о редкой форме и текстуальной засвидетельствованности в более древнем языке, с указанием на разночтение; предшествует смысловому делению на значения."@ru ;
