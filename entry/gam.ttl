  skos:definition "<div n=\"p\">— {#nis#}\n<div n=\"1\"> 1) {%выходить, выступать наружу, появляться, уходить из дома, отправляться в путь%}: {#ti\\ra\\ScatA^ pA\\rSvAnnirga^mARi#}\n<ls>ṚV. 4,18,2.</ls> {#ni\\rja\\ga\\nvAntama^so\\ jyoti\\zAgA^t#}\n<ls n=\"ṚV.\">10,1,1.</ls> <ls>KAUŚ. 129. 135.</ls> {#aDivinnA tu yA nArI nirgacCedruzitA gfhAt#}\n<ls>M. 9,83.</ls> {#nirgatya nagarAt#}\n<ls>MBH. 1,5874.</ls>\n<ls>R. 3,28,35.</ls> <ls n=\"R.\">4,52,22.</ls>\n<ls>PAÑCAT. II,86.</ls> <ls>ŚĀK. 74.</ls> <ls>ṚT. 1,27.</ls> <ls>VID. 41.</ls> <ls n=\"VID.\">142.</ls> {#nirgamya taTEva yamunAjalAt#}\n<ls>MĀRK. P. 22,47.</ls> {#(garBaH) girjagAma — tadaNgataH#}\n<ls>BRAHMA-P. 59,13.</ls> {#(vitastAyAH) nirgatAyA mahApadmasalilAt#}\n<ls>RĀJA-TAR. 5,118.</ls> {#(AjYA) nirgatA muKAt#}\n<ls n=\"RĀJA-TAR. 5,\">395.</ls> {#grAmanirgata#}\n<ls>P. 2,1,37</ls>, <is>Vārtt</is>. {#SiKA pradIpasya — saMDimuKena nirgatA#}\n<ls>MṚCCH. 48,11.</ls> {#manuzyARAM praviSadeva padaM paSyati na ca nirgacCat#}\n<ls>PAÑCAT. 255,17.</ls> {#anilaH saSabdo nirgacCati#}\n<ls>SUŚR. 1,30,10.</ls> {#arSAMsi nirgatAni#}\n<ls n=\"SUŚR.\">2,48,1.</ls> {#nirgacCati gudaM bahiH#}\n<ls n=\"SUŚR.\">1,298,1.</ls> {#nirgamya ca bahiH#}\n<ls>MĀRK. P. 22,46.</ls> {#prakASaM nirgataH#}\n<ls>ŚĀK. 46,7.</ls> {#mfgayAM nirgato nfpaH#}\n<ls>MBH. 3,14055.</ls> {#(sEnayoH) nirgacCamAnayoH saMKye#}\n<ls n=\"MBH.\">6,3848.</ls> в том же смысле без {#saMKye#}\n<ls>DAŚAK.</ls> в <ls>BENF. Chr. 201,2.</ls> {#na kutracidapi nirgatA#}\n<ls>PAÑCAT. 36,23.</ls> {#mArgezu #}\n[Page2-0682]\n{# nirgataH#}\n<ls>RĀJA-TAR. 5,452.</ls> {#kAryArTaM nirgataM cApi BartAraM gfhamAgatam#}\n<ls>MBH. 13,5870.</ls>\n<ls>PAÑCAT. I,21.</ls> <ls>AMAR. 61.</ls> {#nirgamyatAM SIGram#}\n<ls>BHĀG. P. 1,13,17.</ls> <ls n=\"BHĀG. P. 1,\">7,1.</ls>\n<ls>INDR. 5,5.</ls>\n<ls>MBH. 3,15233.</ls> <ls n=\"MBH. 3,\">16654.</ls>\n<ls>R. 1,64,15.</ls> <ls n=\"R.\">2,40,33</ls> <ls n=\"R.\">3,28,39.</ls>\n<ls>VID. 96.</ls> <ls n=\"VID.\">178.</ls> {%появиться, показа