<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_zz_x5f_pw04/1> a ontolex:LexicalSense ;
  skos:definition "√{#gam#}¦ с {#aBi#} <ab>Caus.</ab> также {%давать причитающееся, предоставлять%} <ls>SĀY. zu ṚV. 9,1,4</ls>.\n<div n=\"p\">— С {#nis#} <ab>Caus.</ab> также {%терять, лишаться%} <ls>CAMPAKA 396</ls>. <ls n=\"CAMPAKA\">484</ls>.<info n=\"sup_5\"/>"@ru ;
  pwglex:sourceGloss "√{#gam#}¦ mit {#aBi#} <ab>Caus.</ab> auch {%zukommen lassen%} <ls>SĀY. zu ṚV. 9,1,4</ls>.\n<div n=\"p\">— Mit {#nis#} <ab>Caus.</ab> auch {%verlieren, einbüssen%} <ls>CAMPAKA 396</ls>. <ls n=\"CAMPAKA\">484</ls>.<info n=\"sup_5\"/>"@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«давать причитающееся, предоставлять» для zukommen lassen (передать кому-то следуемое); «терять, лишаться» для verlieren, einbüssen — два разных упасарга-значения в одном PW-подпункте, соответствие сохранено по порядку."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-03T16:34:44Z"^^xsd:dateTime ;
  dct:references <https://w3id.org/sanskrit-lexicon/repwg/citation/CAMPAKA_x2d_396>, <https://w3id.org/sanskrit-lexicon/repwg/citation/CAMPAKA_x2d_484>, <https://w3id.org/sanskrit-lexicon/repwg/citation/S_xc4__x80_Y_x2e__x2d_zu_x2d__xe1__xb9__x9a_V_x2e__x2d_9_x2c_1_x2c_4> ;
