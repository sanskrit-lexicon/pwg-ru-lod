  skos:definition "<div n=\"p\">— {#upA#}\n<div n=\"1\"> 1) {%приходить, приближаться к кому-л.%} или {%куда-л., посещать%}: {#upa\\ prayo^Bi\\rA ga^tam#}\n<ls>ṚV. 1,2,4.</ls> {#(A no) devA^sa\\ upa^ gantana#}\n<ls n=\"ṚV.\">8,7,27.</ls> {#upa^ na\\H sava\\nA ga^hi#}\n<ls n=\"ṚV.\">1,4,2.</ls> <ls n=\"ṚV. 1,\">91,10.</ls> <ls n=\"ṚV. 1,\">107,2.</ls> <ls n=\"ṚV.\">2,32,5.</ls> <ls>AV. 19,4,3.</ls> {#upAgamya damayantyE nyavedayat#}\n<ls>N. 7,11.</ls> {#taponiDiM vetsi na mAmupAgatam#}\n<ls>ŚĀK. 76</ls>, <ab>v. l.</ab>\n<ls>AMAR. 29.</ls>\n<ls>VID. 130.</ls> {#kaTamApadupAgatA#}\n<ls>MBH. 2,2609.</ls> {#vanAdasmAdupAgataH (ganDaH)#}\n<ls>R. 3,16,7.</ls> {#taM deSamupAgamya#}\n<ls n=\"R.\">1,9,23.</ls> <ls n=\"R.\">3,10,11.</ls> <ls>N. 19,11.</ls> {#tasyAByarRam#}\n<ls>RĀJA-TAR. 5,145.</ls> {#astamupAgataH (AdityaH)#}\n<ls>PAÑCAT. 134,5.</ls> {#samudramaDye tadyAnapAtramupAgatam#}\n<ls>VID. 226.</ls> {%наступать, появляться%}: {#ezAmapi sarvezAmEkamatyamupAgatam#}\n<ls>R. 4,51,40.</ls> {%выпадать на долю%}: {#aDyagnyupAgata (Dana)#}\n<ls>YĀJÑ. 2,143.</ls> {#dAyAdupAgataH (dAsaH)#} {%доставшийся по наследству%}\n<ls>MIT. 268,1.</ls> {%возвращаться%}\n<ls>VID. 332.</ls>"@ru ;
  pwglex:sourceGloss "{%herbeikommen, zu Jmd%} oder {%irgendwohin kommen, besuchen%}: {#upa\\ prayo^Bi\\rA ga^tam#} <ls>ṚV. 1,2,4.</ls> {#(A no) devA^sa\\ upa^ gantana#} <ls n=\"ṚV.\">8,7,27.</ls> {#upa^ na\\H sava\\nA ga^hi#} <ls n=\"ṚV.\">1,4,2.</ls> <ls n=\"ṚV. 1,\">91,10.</ls> <ls n=\"ṚV. 1,\">107,2.</ls> <ls n=\"ṚV.\">2,32,5.</ls> <ls>AV. 19,4,3.</ls> {#upAgamya damayantyE nyavedayat#} <ls>N. 7,11.</ls> {#taponiDiM vetsi na mAmupAgatam#} <ls>ŚĀK. 76</ls>, <ab>v. l.</ab> <ls>AMAR. 29.</ls> <ls>VID. 130.</ls> {#kaTamApadupAgatA#} <ls>MBH. 2,2609.</ls> {#vanAdasmAdupAgataH (ganDaH)#} <ls>R. 3,16,7.</ls> {#taM deSamupAgamya#} <ls n=\"R.\">1,9,23.</ls> <ls n=\"R.\">3,10,11.</ls> <ls>N. 19,11.</ls> {#tasyAByarRam#} <ls>RĀJA-TAR. 5,145.</ls> {#astamupAgataH (AdityaH)#} <ls>PAÑCAT. 134,5.</ls> {#samudramaDye tadyAnapAtramupAgatam#} <ls>VID. 226.</ls> {%sich einstellen%}: {#ezAmapi sarvezAmEkamatyamupAgatam#} <ls>R. 4,51,40.</ls> {%zufallen%}: {#aDyagnyupAgata (Dana)#} <ls>YĀJÑ. 2,143.</ls> {#dAyAdupAgataH (dAsaH)#} {%durch Erbschaft zugefallen%} <ls>MIT. 268,1.</ls> {%zurückkehren%} <ls>VID. 332.</ls>"@de ;
