  skos:definition "<div n=\"p\">— {#ud#}\n<div n=\"1\"> 1) {%подниматься вверх, восходить, вздыматься, вздыбливаться%}; о светилах\n<ls>VARĀH. BṚH. S. 7,19.</ls> <ls n=\"VARĀH. BṚH. S.\">8,1.</ls> {#Sakrasyodgamya caraRaM prasTito janamejayaH#}\n<ls>MBH. 13,330.</ls>\n<ls>PAÑCAT. 47,18.</ls> {#vAtodgatareRu#}\n<ls>ṚT. 1,10</ls>, <ab>v. l.</ab> {#SAlapota ivodgataH#}\n<ls>MBH. 3,11690.</ls> <ls n=\"MBH.\">1,5942</ls>; <ab>vgl.</ab> {#SAlamiva pravfdDam#}\n<ls n=\"MBH.\">3,15703.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#ud#}\n<div n=\"1\"> 1) {%in die Höhe gehen, aufgehen, sich erheben, aufschiessen%}; von Gestirnen\n<ls>VARĀH. BṚH. S. 7,19.</ls> <ls n=\"VARĀH. BṚH. S.\">8,1.</ls> {#Sakrasyodgamya caraRaM prasTito janamejayaH#}\n<ls>MBH. 13,330.</ls>\n<ls>PAÑCAT. 47,18.</ls> {#vAtodgatareRu#}\n<ls>ṚT. 1,10</ls>, <ab>v. l.</ab> {#SAlapota ivodgataH#}\n<ls>MBH. 3,11690.</ls> <ls n=\"MBH.\">1,5942</ls>; <ab>vgl.</ab> {#SAlamiva pravfdDam#}\n<ls n=\"MBH.\">3,15703.</ls>"@de ;
  pwglex:senseTag "1" ;
