<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/gam/tr/gam_x7e__x7e_h0_x5f_45_x5f_upa/6> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 6) {%уступать. соглашаться, признавать%}: {#sa vE sarvamavApnoti vedAntopagataM Palam#}\n<ls>M. 2,160.</ls> {#dfzwAntopagata#}\n<ls>MBH. 13,2629.</ls> {#upagata = pratijYAta#} <ab>u. s. w.</ab>\n<ls>AK. 3,2,58.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 6) {%einräumen. zugestehen, anerkennen%}: {#sa vE sarvamavApnoti vedAntopagataM Palam#}\n<ls>M. 2,160.</ls> {#dfzwAntopagata#}\n<ls>MBH. 13,2629.</ls> {#upagata = pratijYAta#} <ab>u. s. w.</ab>\n<ls>AK. 3,2,58.</ls>"@de ;
  pwglex:senseTag "6" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "уступать = уступать в споре/признавать чужую правоту (einräumen, концессивное значение); соглашаться = давать согласие (zugestehen); признавать = констатировать/признавать факт (anerkennen) — три близких синонима PWG, разделённые точкой/запятой, сохранены как самостоятельный ряд, а не слиты в один."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-03T16:34:44Z"^^xsd:dateTime ;
  dct:references <https://w3id.org/sanskrit-lexicon/repwg/citation/AK_x2e__x2d_3_x2c_2_x2c_58_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/MBH_x2e__x2d_13_x2c_2629_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/M_x2e__x2d_2_x2c_160_x2e_> ;
