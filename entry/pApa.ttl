<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/pApa/dict/kna/2> a ontolex:LexicalSense ;
  skos:definition "पाप\t/pāpa/\t/pApa/\t/папа/\tpāpa adj. subst., f. ā и ī, дурной, злой; n. зло, бѣдствіе, грѣхъ, несчастье.\tс. 240"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

