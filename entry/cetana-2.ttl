  skos:definition "चेतन\t/cetana/\t\t/четана/\tcētana n. явленіе, N. 2, 3 bah. обнаруживающая чувства полныя любви.\tс. 222"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
