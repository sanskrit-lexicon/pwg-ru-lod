<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/yojana/dict/fri/2> a ontolex:LexicalSense ;
  skos:definition "yojana n.; запряжка, упряжка, езда, езда без перемены лошадей, определенное расстояние (приблизительно 9 миль)"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
