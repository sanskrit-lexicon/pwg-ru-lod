  dct:source "smirnov" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/Buj/tr/_x5f_buj_x7e__x7e_h0_x5f_00_x5f_pwg00/1> a ontolex:LexicalSense ;
  skos:definition "1. {#Buj#}¦, {#Buja/ti#} «гнуть, сгибать»\n<ls>DHĀTUP. 28,124.</ls> <ab>partic.</ab> {#Bugna#}\n<ls>P. 8,2,45.</ls>\n<ls>VOP. 26,88. fg.</ls> «согнутый, изогнутый, кривой»\n<ls>AK. 3,2,21.</ls> <ls n=\"AK. 3,2,\">40.</ls>\n<ls>H. 1457.</ls> <ls n=\"H.\">1483.</ls>\n<ls>HALĀY. 4,11.</ls> {#darBAndviguRAnBugnAn#}\n<ls>ĀŚV. GṚHY. 4,7,8.</ls> {#vAyuBugnANga#}\n<ls>MBH. 13,2281.</ls> {#kzuDA BugnaH#}\n<ls n=\"MBH.\">12,4265.</ls> {#BaraBugnavitatabAhu#}\n<ls>VĀSAVAD. 2,4.</ls> {#nyubjo Bugne rujA#}\n<ls>AK. 2,6,2,12.</ls> {#pARiruha#}\n<ls>BHAṬṬ. 11,8.</ls> {#BruvO ca BugnO#} (<ab>masc.</ab>!) «бороздчатый, изборожденный»\n<ls>Spr. 4036.</ls> «отодвинутый в сторону»\n<ls n=\"Spr.\">777.</ls> {#˚netra#} «вывернутые (закатившиеся) глаза»\n<ls>Verz. d. Oxf. H. 319,a,8. b, No. 758</ls> {#(Bagnanetra#} <ab>gedr.</ab>). {#Bugna#} означает «<is>Saṃdhi</is> от {#o#} и {#O#} перед нелабиальными гласными»\n<ls>ṚV. PRĀT. 2,11.</ls>\n<div n=\"v\">— <ab>Vgl.</ab> {#Buji, Bujyu#}, 1. {#Boga#} ."@ru ;
  pwglex:sourceGloss "1. {#Buj#}¦, {#Buja/ti#} {%biegen%}\n<ls>DHĀTUP. 28,124.</ls> <ab>partic.</ab> {#Bugna#}\n<ls>P. 8,2,45.</ls>\n<ls>VOP. 26,88. fg.</ls> {%gebogen, gekrümmt, krumm%}\n<ls>AK. 3,2,21.</ls> <ls n=\"AK. 3,2,\">40.</ls>\n<ls>H. 1457.</ls> <ls n=\"H.\">1483.</ls>\n<ls>HALĀY. 4,11.</ls> {#darBAndviguRAnBugnAn#}\n<ls>ĀŚV. GṚHY. 4,7,8.</ls> {#vAyuBugnANga#}\n<ls>MBH. 13,2281.</ls> {#kzuDA BugnaH#}\n<ls n=\"MBH.\">12,4265.</ls> {#BaraBugnavitatabAhu#}\n<ls>VĀSAVAD. 2,4.</ls> {#nyubjo Bugne rujA#}\n<ls>AK. 2,6,2,12.</ls> {#pARiruha#}\n<ls>BHAṬṬ. 11,8.</ls> {#BruvO ca BugnO#} (<ab>masc.</ab>!) {%gefurcht%}\n<ls>Spr. 4036.</ls> {%zur Seite gedrängt%}\n<ls n=\"Spr.\">777.</ls> {#˚netra#} {%verdrehte Augen%}\n<ls>Verz. d. Oxf. H. 319,a,8. b, No. 758</ls> {#(Bagnanetra#} <ab>gedr.</ab>). {#Bugna#} heisst {%der%} <is>Saṃdhi</is> {%von%} {#o#} {%und%} {#O#} {%vor nicht-labialen Vocalen%}\n<ls>ṚV. PRĀT. 2,11.</ls>\n<div n=\"v\">— <ab>Vgl.</ab> {#Buji, Bujyu#}, 1. {#Boga#} ."@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Физическое действие «гнуть, сгибать», в отличие от bhuj/2 (наслаждаться, пользоваться). PPP: «согнутый» — пространственная деформация; «бороздчатый» — о бровях (следы изгиба); «отодвинутый в сторону» — боковое смещение; «с закатившимися глазами» — вращение/выворачивание."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-06-30T05:05:08Z"^^xsd:dateTime ;
