<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/Buj/tr/_x5f_buj_x7e__x7e_h0_x5f_zz_x5f_pw/PW4_x2d_def> a ontolex:LexicalSense ;
  skos:definition "<hom>4.</hom> {#Bu/j#}¦\n<div n=\"1\">— 1〉 <lex>f.</lex> {%принесение пользы, содействие благу, служение на благо; наслаждение, выгода, польза; обладание, имущество%}. <ab>Dat.</ab> {#Bje/#} также как <ab>Infin.</ab>\n<div n=\"1\">— 2〉 <lex>Adj.</lex> в конце <ab>Comp.</ab>\n<div n=\"2\">— a〉 {%наслаждающийся, вкушающий, приобщающийся, плотски наслаждающийся%}. В сочетании со словами, обозначающими землю, — то есть <ab>v. a.</ab> {%властвующий, государь, царь%}.\n<div n=\"2\">— b〉 {%пожинающий плоды чего-либо%}.\n<div n=\"2\">— c〉 {%приносящий пользу, содействующий благу%}.\n<div n=\"2\">— d〉 {%проходящий, наполняющий%} (о времени)."@ru ;
  pwglex:sourceGloss "<hom>4.</hom> {#Bu/j#}¦\n<div n=\"1\">— 1〉 <lex>f.</lex> {%das Nutzenbringen, Zugutekommen, Frommen; Genuss, Vortheil, Nutzen; das Haben, die Habe%}. <ab>Dat.</ab> {#Bje/#} auch als <ab>Infin.</ab>\n<div n=\"1\">— 2〉 <lex>Adj.</lex> am Ende eines <ab>Comp.</ab>\n<div n=\"2\">— a〉 {%geniessend, essend, theilhaftig, fleischlich geniessend%}. In Verbindung mit Wörtern, die Erde bedeuten, so <ab>v. a.</ab> {%beherrschend, Fürst, König%}.\n<div n=\"2\">— b〉 {%den Lohn für Etwas geniessend%}.\n<div n=\"2\">— c〉 {%Nutzen bringend, frommend%}.\n<div n=\"2\">— d〉 {%durchlaufend, erfüllend%} (von der Zeit)."@de ;
  pwglex:senseTag "PW4-def" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Номинальное производное от bhuj/2. 1〉 — абстрактное существительное (польза, наслаждение, имущество); 2〉 — причастное прилагательное в четырёх значениях, соответствующих четырём значениям глагола."@ru ;
