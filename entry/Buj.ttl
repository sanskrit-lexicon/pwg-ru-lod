  skos:definition "<div n=\"1\">— 3〉 <ab>Act.</ab> {%быть полезным кому-либо%} (<ab>Acc.</ab>), {%идти на пользу, приносить благо, служить%}. Единожды <ab>v. l.</ab> <ab>Med.</ab>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3〉 <ab>Act.</ab> {%Jmd%} (<ab>Acc.</ab>) {%zu [Page4-270-b] Nutzen sein, zu Gute kommen, frommen, dienen%}. Einmal <ab>v. l.</ab> <ab>Med.</ab>"@de ;
