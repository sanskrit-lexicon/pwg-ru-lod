<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/lih/dict/kna/2> a ontolex:LexicalSense ;
  skos:definition "लिह्\t/lih/\t\t/лих/\tlih (lēḍhi, pp. līḍha) лизать. — ava облизывать, ardhāvalīḍha полусъѣденный. — [λείχω, лат. lingō, гот. laigōn „lecke“, лит. lëžiu, цсл. ližą „лижу“].\tс. 261"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
