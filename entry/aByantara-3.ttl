  skos:definition "अभ्यन्तर\t/abhyantara/\t\t/абхьянтара/\tabnyantara внутренній; n. внутренность, промежутокъ времени, loc. (о врем.) по истеченіи, черезъ, (о мѣстѣ) внутри, въ (такъ и въ слож. сл.).\tс. 199"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
