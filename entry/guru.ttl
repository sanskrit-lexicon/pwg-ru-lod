<https://w3id.org/sanskrit-lexicon/repwg/entry/guru> a ontolex:LexicalEntry ;
  rdfs:label "guru"@sa-Latn ;
  dct:isPartOf <https://w3id.org/sanskrit-lexicon/repwg/lexicon/pwg-ru> ;
  ontolex:canonicalForm <https://w3id.org/sanskrit-lexicon/repwg/lemma/guru> ;
