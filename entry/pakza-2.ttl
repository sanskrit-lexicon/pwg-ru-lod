<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/pakza-2/dict/fri/3> a ontolex:LexicalSense ;
  skos:definition "pakṣa m.; крыло, бок или сторона тела, половина, пол лунарного месяца, сторона, группа, взгляд, мнение"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
