  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vid-2/dict/koch/4> a ontolex:LexicalSense ;
  skos:definition "विद् II /vid/ (U. pr. /vindati/ /vindate/ — Vl- fut. /vetṣyati/ /vetsyate/- pf. /viveda/ /vivide/- aor. /avidat/ /avitta/, /avediṣṭa/- pp. /vinna/, /vitta/) 1) находить- отыскивать 2) открывать 3) чувствовать 4) предусматривать 5) жениться 6) А. быть, случаться"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vid-2/dict/kna/5> a ontolex:LexicalSense ;
  skos:definition "विद्\t/vid/\t\t/вид/\t1. vid (vētti, 2. sg. imp. viddhi, pp. vidita, ger. viditvā; pf. vēda, 2. sg. vēttha, 3. pl. vidur; ppfa. vidvaṅs см. отд.; c. vēdayati, °tē, f. vēdayiṣyati, pp. vēdita, pn. vēdya, ger. °vēdya) вѣдать, знать, pp. извѣстный; c. давать знать, увѣдомлять, извѣщать, повѣдать, объявлять. — ā c. извѣщать, предлагать. — ni c. давать, знать, увѣдомлять, извѣщать, называть, разсказывать; объявлять, предлагать въ см. передавать (S. 1, 27). — [ἰδεῖν, οἶδα, лат. vidēre, гот. wait „weiss“, лит. veizdmi, цсл, viděti, věděti „видѣть, вѣдать“].\tс. 265"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vid-2/dict/kna/6> a ontolex:LexicalSense ;
  skos:definition "विद्\t/vid/\t\t/вид/\t2. vid (vind: vindati 6, pp. vitta и vinna; aor. avidat, pf. vivēda) находить, пріобрѣтать, снискать, постигать; p. vidyatē есть, vidyantē суть.\tс. 266"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vid-2/dict/kna/7> a ontolex:LexicalSense ;
  skos:definition "॰विद्\t/-vid/\t\t/-вид/\t3. °vid свѣдущій, знающій, знатокъ.\tс. 266"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vid-2/dict/fri/8> a ontolex:LexicalSense ;
  skos:definition "III vid (-°) ; знающий, находящий"@ru ;
