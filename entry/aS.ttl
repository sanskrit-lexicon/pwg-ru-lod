  skos:definition "<div n=\"1\">— 2) <ab>instr.</ab> {#AsA/#} <lex>adv.</lex> употребляется в <ab>Bedd.</ab>, близко совпадающих по значению с лат. coram: лицом к лицу, устно; лично, в присутствии, во плоти; посему\n<ls>NAIGH. 2,16</ls> причисляется к словам со значением «близко». {#tvaM hotA\\ manu^rhito\\ vahni^rA\\sA vi\\duzwa^raH . agne\\ yakzi^ di\\vo viSa^H#}\n<ls>ṚV. 6,16,9.</ls> {#sa ma\\ndrayA^ ca ji\\hvayA\\ vahni^rA\\sA vi\\duzwa^raH . agne^ ra\\yiM ma\\Gava^dByo na\\ A va^ha#}\n<ls n=\"ṚV.\">7,16,9.</ls> {#pra\\jAva^tA\\ vaca^sA\\ vahni^rA\\sA ca^ huve ni ca^ satsI\\ha de\\vEH#} coram vehens\n<ls n=\"ṚV.\">1,76,4.</ls> <ls n=\"ṚV. 1,\">129,5.</ls> <ls n=\"ṚV.\">10,115,3.</ls> {#tve a^gne\\ viSve^ a\\mftA^so a\\druha^ A\\sA de\\vA ha\\vira^da\\ntyAhu^tam#} лично присутствующий\n<ls n=\"ṚV.\">2,1,14.</ls> {#viSvA\\ yaSca^rza\\RIra\\ByA\\3^\\sA vAje^zu sA\\saha^t#} cominus, муж против мужа\n<ls n=\"ṚV.\">5,23,1.</ls> {#Basa\\daSvo\\ na ya^masA\\na A\\sA#} он жует, словно конь, которого ведут за поводья спереди,\n<ls n=\"ṚV.\">6,3,4.</ls> {#aDa^ dyutA\\naH pi\\troH sacA\\sAma^nuta\\ guhya\\M cAru\\ pfSne^H#}\n<ls n=\"ṚV.\">4,5,10.</ls> {#asya\\ hi svaya^Sastara A\\sA vi^Darma\\nmanya^se#}\n<ls n=\"ṚV.\">5,17,2.</ls> {#nU na\\ idDi vArya^mA\\sA sa^cante sU\\raya^H#}\n<ls n=\"ṚV. 5,17,\">5.</ls> {#vacA^MsyA\\sA sTavi^rAya takzam#} лицом к лицу, непосредственно\n<ls n=\"ṚV.\">6,32,1.</ls> {#a\\nyasyA\\sA ji\\hvayA\\ jenyo\\ vfzA^#}\n<ls n=\"ṚV.\">1,140,2.</ls> {#A\\sAvi^vAsa\\nnadi^timuruzyet#}\n<ls n=\"ṚV. 1,\">152,6.</ls> {#A\\sA gAvo\\ vandyA^so\\ nokzaRa^H#}\n<ls n=\"ṚV. 1,\">168,2.</ls> <ls n=\"ṚV.\">10,1,3.</ls> <ls n=\"ṚV. 10,\">20,3.</ls> <ls n=\"ṚV. 10,\">40,6.</ls> <ls n=\"ṚV. 10,\">67,10.</ls> <ab>Vgl.</ab> {#AsayA#} . — В <ab>comp.</ab> <ab>s.</ab> {#AdaGna, AspAtra, anAs, svAs#}; <ab>vgl.</ab> также еще {#Asan#} и {#Asya#} ."@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) <ab>instr.</ab> {#AsA/#} <lex>adv.</lex> gebraucht in <ab>Bedd.</ab>, welche mit {%coram%} nahe zusammentreffen: {%vor und von Angesicht, mündlich; persönlich, gegenwärtig, leibhaftig%}; daher\n<ls>NAIGH. 2,16</ls> unter den Wörten für {%nahe%} aufgezählt. {#tvaM hotA\\ manu^rhito\\ vahni^rA\\sA vi\\duzwa^raH . agne\\ yakzi^ di\\vo viSa^H#}\n<ls>ṚV. 6,16,9.</ls> {#sa ma\\ndrayA^ ca ji\\hvayA\\ vahni^rA\\sA vi\\duzwa^raH . agne^ ra\\yiM ma\\Gava^dByo na\\ A va^ha#}\n<ls n=\"ṚV.\">7,16,9.</ls> {#pra\\jAva^tA\\ vaca^sA\\ vahni^rA\\sA ca^ huve ni ca^ satsI\\ha de\\vEH#} {%coram vehens%}\n<ls n=\"ṚV.\">1,76,4.</ls> <ls n=\"ṚV. 1,\">129,5.</ls> <ls n=\"ṚV.\">10,115,3.</ls> {#tve a^gne\\ viSve^ a\\mftA^so a\\druha^ A\\sA de\\vA ha\\vira^da\\ntyAhu^tam#} {%persönlich gegenwärtig%}\n<ls n=\"ṚV.\">2,1,14.</ls> {#viSvA\\ yaSca^rza\\RIra\\ByA\\3^\\sA vAje^zu sA\\saha^t#} {%cominus, Mann gegen Mann%}\n<ls n=\"ṚV.\">5,23,1.</ls> {#Basa\\daSvo\\ na ya^masA\\na A\\sA#} {%er kaut wie ein Ross, das man von vorn am Zügel hält%},\n<ls n=\"ṚV.\">6,3,4.</ls> {#aDa^ dyutA\\naH pi\\troH sacA\\sAma^nuta\\ guhya\\M cAru\\ pfSne^H#}\n<ls n=\"ṚV.\">4,5,10.</ls> {#asya\\ hi svaya^Sastara A\\sA vi^Darma\\nmanya^se#}\n<ls n=\"ṚV.\">5,17,2.</ls> {#nU na\\ idDi vArya^mA\\sA sa^cante sU\\raya^H#}\n<ls n=\"ṚV. 5,17,\">5.</ls> {#vacA^MsyA\\sA sTavi^rAya takzam#} {%von Angesicht, unmittelbar%}\n<ls n=\"ṚV.\">6,32,1.</ls> {#a\\nyasyA\\sA ji\\hvayA\\ jenyo\\ vfzA^#}\n<ls n=\"ṚV.\">1,140,2.</ls> {#A\\sAvi^vAsa\\nnadi^timuruzyet#}\n<ls n=\"ṚV. 1,\">152,6.</ls> {#A\\sA gAvo\\ vandyA^so\\ nokzaRa^H#}\n<ls n=\"ṚV. 1,\">168,2.</ls> <ls n=\"ṚV.\">10,1,3.</ls> <ls n=\"ṚV. 10,\">20,3.</ls> <ls n=\"ṚV. 10,\">40,6.</ls> <ls n=\"ṚV. 10,\">67,10.</ls> <ab>Vgl.</ab> {#AsayA#} . — Im <ab>comp.</ab> <ab>s.</ab> {#AdaGna, AspAtra, anAs, svAs#}; <ab>vgl.</ab> auch noch {#Asan#} und {#Asya#} ."@de ;
