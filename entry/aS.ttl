  skos:definition "<div n=\"1\">— 6) форма {#A/san#}\n<ls>ṚV. 1,109,7</ls> : {#yeBi^H sapi\\tvaM pi\\taro^ na\\ Asa^n#} представляет собой <ab>unregelm.</ab> написание и относится к 1. {#aS#}; ср. выше <ab>u.</ab> 4, {%b%} и чередование форм {#As#} и {#aS#} в\n<ls>SV. II,3,1,7,2. 4,2,1,10. 5,2,3,2</ls> и соответствующих местах\n<ls>ṚV.</ls> — <ab>partic.</ab> {#Asita#}"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 6) die Form {#A/san#}\n<ls>ṚV. 1,109,7</ls> : {#yeBi^H sapi\\tvaM pi\\taro^ na\\ Asa^n#} ist eine <ab>unregelm.</ab> Schreibung und zu 1. {#aS#} zu ziehen; man <ab>vgl.</ab> oben <ab>u.</ab> 4, {%b%} und den Wechsel zwischen Formen von {#As#} und {#aS#} in\n<ls>SV. II,3,1,7,2. 4,2,1,10. 5,2,3,2</ls> und die entsprechenden Stellen des\n<ls>ṚV.</ls> — <ab>partic.</ab> {#Asita#}"@de ;
