<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/As/tr/_x5f_as_x7e__x7e_h1_x5f_06_x5f_upa/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#upa#}\n<div n=\"1\"> 1) сидеть рядом, садиться рядом, садиться возле кого-л. (<ab>acc.</ab>), или сидеть, или садиться (как знак подчинения и готовности служить): {#upa ca tizWata upa cAste#}\n<ls>ŚAT. BR. 2,3,2,4.</ls> {#tasmAduparyAsInaM kzatriyamaDastAdimAH prajA upAsate#}\n<ls n=\"ŚAT. BR.\">1,3,4,15.</ls> <ls n=\"ŚAT. BR.\">3,2,3,16.</ls> <ls n=\"ŚAT. BR. 3,\">3,2,5.</ls> <ls n=\"ŚAT. BR. 3,\">9,3,7.</ls> <ls>AV. 10,7,21.</ls> {#yaTeha kzuDitA bAlA mAtaraM paryupAsata evaM sarvARi BUtAnyagnihotramupAsate#} (<ab>vgl.</ab> <ab>u.</ab> 7)\n<ls>CHĀND. UP. 5. 24,5.</ls> {#vAyuvaccAnugacCanti taTAsInAnupAsate#}\n<ls>M. 3,189.</ls> <ls n=\"M.\">4,154.</ls>\n<ls>MBH. 1,6320.</ls>\n<ls>R. 2,91,52.</ls> <ls n=\"R.\">3,4,1.</ls> <ls n=\"R. 3,4,\">2.</ls> {#yaH saMsadi prakftiBirBavedyukta upAsitum . vanyErmfgErupAsInaH#} (с <ab>pass.</ab> <ab>Bed.</ab>) {#so 'yamAste mamAgrajaH#}\n<ls n=\"R.\">2,100,29.</ls>\n[Page1-0733]\n{#rAkzasIBirupAsyantIM#} (<ab>pass.</ab>) {#samAsInAM SilAtale#}\n<ls>MBH. 3,16167.</ls> {#upAsito guruM BavAn, upAsito gururBavatA . upAsitaM BavatA#}\n<ls>P. 3,4,72</ls>, <ab>Sch.</ab>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#upa#}\n<div n=\"1\"> 1) {%daneben sitzen, sich daneben setzen, neben Jmd%} (<ab>acc.</ab>) {%sitzen%} oder {%sich setzen%} (als Zeichen der Unterordnung und Dienstbereitheit): {#upa ca tizWata upa cAste#}\n<ls>ŚAT. BR. 2,3,2,4.</ls> {#tasmAduparyAsInaM kzatriyamaDastAdimAH prajA upAsate#}\n<ls n=\"ŚAT. BR.\">1,3,4,15.</ls> <ls n=\"ŚAT. BR.\">3,2,3,16.</ls> <ls n=\"ŚAT. BR. 3,\">3,2,5.</ls> <ls n=\"ŚAT. BR. 3,\">9,3,7.</ls> <ls>AV. 10,7,21.</ls> {#yaTeha kzuDitA bAlA mAtaraM paryupAsata evaM sarvARi BUtAnyagnihotramupAsate#} (<ab>vgl.</ab> <ab>u.</ab> 7)\n<ls>CHĀND. UP. 5. 24,5.</ls> {#vAyuvaccAnugacCanti taTAsInAnupAsate#}\n<ls>M. 3,189.</ls> <ls n=\"M.\">4,154.</ls>\n<ls>MBH. 1,6320.</ls>\n<ls>R. 2,91,52.</ls> <ls n=\"R.\">3,4,1.</ls> <ls n=\"R. 3,4,\">2.</ls> {#yaH saMsadi prakftiBirBavedyukta upAsitum . vanyErmfgErupAsInaH#} (mit <ab>pass.</ab> <ab>Bed.</ab>) {#so 'yamAste mamAgrajaH#}\n<ls n=\"R.\">2,100,29.</ls>\n[Page1-0733]\n{#rAkzasIBirupAsyantIM#} (<ab>pass.</ab>) {#samAsInAM SilAtale#}\n<ls>MBH. 3,16167.</ls> {#upAsito guruM BavAn, upAsito gururBavatA . upAsitaM BavatA#}\n<ls>P. 3,4,72</ls>, <ab>Sch.</ab>"@de ;
