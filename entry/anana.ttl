<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/Anana/tr/_x5f_anana/1> a ontolex:LexicalSense ;
  skos:definition "{#Anana#}¦ (от <hom>2.</hom> {#an#}) <lex>n.</lex> рот, лицо (о людях и животных) <ls>AK. 2,6,2,40</ls>. <ls>H. 572</ls>. <ls>BHAG. 11,24</ls>. <ls>BRĀHMAṆ. 1,13</ls>. <ls>HIḌ. 2,7</ls>. <ls n=\"HIḌ.\">3,13</ls>. <ls>R. 1,8,20</ls>. <ls>SUŚR. 1,42,6</ls>. <ls n=\"SUŚR. 1,\">110,4</ls>. <ls>ŚĀK. 30</ls>. <ls n=\"ŚĀK.\">58</ls>. <ls>RAGH. 1,41</ls>. <ls n=\"RAGH.\">3,3</ls>. <ls n=\"RAGH. 3,\">17</ls>. <ls>MEGH. 66</ls>. <ls n=\"MEGH.\">101</ls>. <ls>ṚT. 1,14</ls>. <ls>VID. 80</ls>. <ls n=\"VID.\">285</ls>. {#gfDradIptAnanAn#} (о стрелах) <ls>R. 6,79,69</ls>. В конце <ab>adj. comp.</ab> <lex>f.</lex> {#A#} <ls>INDR. 5,37</ls>. <ls>N. 11,30</ls>. <ls n=\"N.\">16,22</ls>. <ls n=\"N.\">24,40</ls>. <ls>R. 3,5,4</ls>. <ls n=\"R. 3,\">51,37</ls>."@ru ;
  pwglex:sourceGloss "{#Anana#}¦ (von <hom>2.</hom> {#an#}) <lex>n.</lex> {%Mund, Gesicht%} (von Menschen und Thieren) <ls>AK. 2,6,2,40</ls>. <ls>H. 572</ls>. <ls>BHAG. 11,24</ls>. <ls>BRĀHMAṆ. 1,13</ls>. <ls>HIḌ. 2,7</ls>. <ls n=\"HIḌ.\">3,13</ls>. <ls>R. 1,8,20</ls>. <ls>SUŚR. 1,42,6</ls>. <ls n=\"SUŚR. 1,\">110,4</ls>. <ls>ŚĀK. 30</ls>. <ls n=\"ŚĀK.\">58</ls>. <ls>RAGH. 1,41</ls>. <ls n=\"RAGH.\">3,3</ls>. <ls n=\"RAGH. 3,\">17</ls>. <ls>MEGH. 66</ls>. <ls n=\"MEGH.\">101</ls>. <ls>ṚT. 1,14</ls>. <ls>VID. 80</ls>. <ls n=\"VID.\">285</ls>. {#gfDradIptAnanAn#} (von Pfeilen) <ls>R. 6,79,69</ls>. Am Ende eines <ab>adj. comp.</ab> <lex>f.</lex> {#A#} <ls>INDR. 5,37</ls>. <ls>N. 11,30</ls>. <ls n=\"N.\">16,22</ls>. <ls n=\"N.\">24,40</ls>. <ls>R. 3,5,4</ls>. <ls n=\"R. 3,\">51,37</ls>."@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h?" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "mixed" ;
  pwglex:differentia "«рот, лицо» — нейтральный видовой термин для органа/части лица человека и животного; расширительно, «о стрелах» — переносно об остром переднем конце (наконечнике); указание «в конце сложного слова» отмечает употребление в качестве второго члена сложения."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-08-28T15:21:25Z"^^xsd:dateTime ;
