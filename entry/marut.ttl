<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/marut/dict/koch/1> a ontolex:LexicalSense ;
  skos:definition "मरुत् /marut/ m. 1) ветер 2) воздух 3) дыхание 4) nom. pr. бог ветра 5) pl. группа богов бурь и ветров, помощников Индры- см. इन्द्र 1"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/marut/dict/kna/2> a ontolex:LexicalSense ;
  skos:definition "मरुत्\t/marut/\t\t/марут/\tmarut m. вѣтеръ, pl. nom. pr. божествъ, сопровождающихъ Индру.\tс. 251"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
