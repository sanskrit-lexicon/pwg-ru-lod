<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/hA/tr/h_x5f_a_x7e__x7e_h0_x5f_05_x5f_ud/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#ud#}\n<div n=\"1\"> 1) {%вскакивать, выпрямляться, подниматься%}: волк\n<ls>ṚV. 1,105,8.</ls> травы после дождя\n<ls n=\"ṚV.\">5,83,4.</ls> <ls>AV. 8,7,21.</ls> <ls>VS. 11,38.</ls> {#uda\\gnayo^ jihatA\\M jyoti^zA bf\\hat#}\n<ls>ṚV. 10,35,6.</ls> <ls n=\"ṚV. 10,\">142,6.</ls>\n<ls>TBR. 2,5,4,5.</ls> {%вскакивать%} так же <ab>v. a.</ab> {%раскрываться%}: двери\n<ls>ṚV. 9,5,5.</ls> {#SirasA yUpamujjihIte#} {%вздымается головой выше%} <is>Yūpa</is>\n<ls>KĀTY. ŚR. 14,5,10.</ls> — {#BUmerujjihIte#}\n[Page7-1587]\nили {#BUmita u˚#} {%поднимается от земли%}\n<ls>P. 5,4,45</ls>, <ab>Schol.</ab> {#ujjihIze tvaM na kiM punaH#}\n<ls>BHAṬṬ. 18,27.</ls> {#purastAdyato rajaH pArTivamujjihIte#}\n<ls>RAGH. 13,64.</ls> {#ujjihAne sUryamaRqale#}\n<ls>BHĀG. P. 5,7,12.</ls> {#ujjihAnamivoqupam#}\n<ls n=\"BHĀG. P.\">10,51,1.</ls> <ls>NAIṢ. 22,45. 55.</ls> {#kolAhalo lokasyodajihIta#}\n<ls>DAŚAK. 66,3.</ls> {#ujjihAnajIvitA#} {%чья жизнь хочет вырваться — уйти%}\n<ls>MĀLATĪM. 163,11.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#ud#}\n<div n=\"1\"> 1) {%auffahren, sich aufrichten, sich erheben%}: der Wolf\n<ls>ṚV. 1,105,8.</ls> Kräuter nach Regen\n<ls n=\"ṚV.\">5,83,4.</ls> <ls>AV. 8,7,21.</ls> <ls>VS. 11,38.</ls> {#uda\\gnayo^ jihatA\\M jyoti^zA bf\\hat#}\n<ls>ṚV. 10,35,6.</ls> <ls n=\"ṚV. 10,\">142,6.</ls>\n<ls>TBR. 2,5,4,5.</ls> {%auffahren%} so <ab>v. a.</ab> {%sich aufthun%}: Thüren\n<ls>ṚV. 9,5,5.</ls> {#SirasA yUpamujjihIte#} {%hebt sich mit dem Kopfe über den%} <is>Yūpa</is> {%hinaus%}\n<ls>KĀTY. ŚR. 14,5,10.</ls> — {#BUmerujjihIte#}\n[Page7-1587]\noder {#BUmita u˚#} {%erhebt sich von der Erde%}\n<ls>P. 5,4,45</ls>, <ab>Schol.</ab> {#ujjihIze tvaM na kiM punaH#}\n<ls>BHAṬṬ. 18,27.</ls> {#purastAdyato rajaH pArTivamujjihIte#}\n<ls>RAGH. 13,64.</ls> {#ujjihAne sUryamaRqale#}\n<ls>BHĀG. P. 5,7,12.</ls> {#ujjihAnamivoqupam#}\n<ls n=\"BHĀG. P.\">10,51,1.</ls> <ls>NAIṢ. 22,45. 55.</ls> {#kolAhalo lokasyodajihIta#}\n<ls>DAŚAK. 66,3.</ls> {#ujjihAnajIvitA#} {%deren Leben hinausfahren —; entweichen will%}\n<ls>MĀLATĪM. 163,11.</ls>"@de ;
