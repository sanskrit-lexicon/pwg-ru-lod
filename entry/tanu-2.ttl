<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/tanu-2/dict/koch/1> a ontolex:LexicalSense ;
  skos:definition "तनु /tanu/ 1. 1) слабый 2) тонкий, худой- худощавый 3) маленький, малый 2. f. 1) тело 2) лицо, особа"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
