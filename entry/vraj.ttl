  skos:definition "4) впадать в состояние, положение, отношение: {#jarAm#} стареть\n<ls>MBH. 3,16541</ls> (<ab>med.</ab>). {#mftyum#} умирать\n<ls>MĀRK. P. 26,39</ls> (<ab>med.</ab>). {#yadi vyApAraM vrajasi me SarIre 'smin#} приниматься за\n<ls>VIKR. 58.</ls> {#viSvAsaM strIzu#} доверять\n<ls>KĀM. NĪTIS. 7,50.</ls> <ls>Spr. 1986</ls> ({#viSvAsam#} <ab>Conj.</ab> вм. {#viSvAse)#}.{# vinASam#}\n<ls>M. 3,179.</ls> <ls n=\"M.\">4,71.</ls> <ls n=\"M.\">8,346.</ls> {#nASam#}\n<ls>VARĀH. BṚH. S. 5,68.</ls> {#vilayam#}\n<ls>R. 5,56,117.</ls> {#praDvaMsam#}\n<ls>Spr. (II) 3217.</ls> {#DvaMsam#}\n<ls>VARĀH. BṚH. S. 5,71.</ls> {#kzayam#}\n<ls n=\"VARĀH. BṚH. S.\">9,40.</ls> <ls n=\"VARĀH. BṚH. S.\">47,12.</ls> {#udayam#}\n<ls n=\"VARĀH. BṚH. S.\">7,1.</ls> {#darSanam#}\n<ls n=\"VARĀH. BṚH. S.\">9,36.</ls> {#mahatIM pIqAm#}\n<ls n=\"VARĀH. BṚH. S.\">17,22.</ls> <ls n=\"VARĀH. BṚH. S.\">31,4.</ls> {#saMsargaM sadBiH#}\n<ls>M. 11,47.</ls> {#Sozam#}\n<ls>R. GORR. 2,15,29.</ls> {#SAntim#}\n<ls>SUŚR. 2,381,13.</ls> {#Samam#}\n<ls>MĀRK. P. 99,14.</ls> {#pAkam#}\n<ls>ṚT. 4,10.</ls> {#upayogam#}\n<ls>KUMĀRAS. 1,7.</ls> {#udvegam#}\n<ls>RAGH. 8,7.</ls> {#nirvftim#}\n<ls>VIKR. 28.</ls> {#saMDAnam, vyaktim#}\n<ls>ŚĀK. 167</ls>, <ab>v. l.</ab> {#puzwiM paramAm#}\n<ls>Spr. 2951.</ls> {#Kedam#}\n<ls>KATHĀS. 32,21.</ls> {#paSutAm#}\n<ls>M. 3,104.</ls> <ls n=\"M. 3,\">190.</ls> {#viklavatAm#}\n<ls>R. 6,82,22.</ls> {#sopAnatvam#}\n<ls>MEGH. 61.</ls>\n<ls>RAGH. 18,16.</ls>\n<ls>KĀM. NĪTIS. 4,13. 80.</ls> <ls>ŚĀK. 9.</ls> <ls>VARĀH. BṚH. 11,20. 24 (22),3.</ls> <ls>SĀH. D. 43,12.</ls> <ls n=\"SĀH. D.\">63,15.</ls> <ls>MĀRK. P. 25,14</ls> (<ab>med.</ab>). {#Basmatvam#} (так следует соединять)\n<ls n=\"MĀRK. P.\">115,2.</ls> <ls>BHĀG. P. 1,18,22.</ls> <ls>PAÑCAT. 33,7.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 4) {%in einen Zustand —, in eine Lage —, in ein Verhältniss gerathen%}: {#jarAm#} {%alt werden%}\n<ls>MBH. 3,16541</ls> (<ab>med.</ab>). {#mftyum#} {%sterben%}\n<ls>MĀRK. P. 26,39</ls> (<ab>med.</ab>). {#yadi vyApAraM vrajasi me SarIre 'smin#} {%sich machen an%}\n<ls>VIKR. 58.</ls> {#viSvAsaM strIzu#} {%vertrauen%}\n<ls>KĀM. NĪTIS. 7,50.</ls> <ls>Spr. 1986</ls> ({#viSvAsam#} <ab>Conj.</ab> für {#viSvAse)#}.{# vinASam#}\n<ls>M. 3,179.</ls> <ls n=\"M.\">4,71.</ls> <ls n=\"M.\">8,346.</ls> {#nASam#}\n<ls>VARĀH. BṚH. S. 5,68.</ls> {#vilayam#}\n<ls>R. 5,56,117.</ls> {#praDvaMsam#}\n<ls>Spr. (II) 3217.</ls> {#DvaMsam#}\n<ls>VARĀH. BṚH. S. 5,71.</ls> {#kzayam#}\n<ls n=\"VARĀH. BṚH. S.\">9,40.</ls> <ls n=\"VARĀH. BṚH. S.\">47,12.</ls> {#udayam#}\n<ls n=\"VARĀH. BṚH. S.\">7,1.</ls> {#darSanam#}\n<ls n=\"VARĀH. BṚH. S.\">9,36.</ls> {#mahatIM pIqAm#}\n<ls n=\"VARĀH. BṚH. S.\">17,22.</ls> <ls n=\"VARĀH. BṚH. S.\">31,4.</ls> {#saMsargaM sadBiH#}\n<ls>M. 11,47.</ls> {#Sozam#}\n<ls>R. GORR. 2,15,29.</ls> {#SAntim#}\n<ls>SUŚR. 2,381,13.</ls> {#Samam#}\n<ls>MĀRK. P. 99,14.</ls> {#pAkam#}\n<ls>ṚT. 4,10.</ls> {#upayogam#}\n<ls>KUMĀRAS. 1,7.</ls> {#udvegam#}\n<ls>RAGH. 8,7.</ls> {#nirvftim#}\n<ls>VIKR. 28.</ls> {#saMDAnam, vyaktim#}\n<ls>ŚĀK. 167</ls>, <ab>v. l.</ab> {#puzwiM paramAm#}\n<ls>Spr. 2951.</ls> {#Kedam#}\n<ls>KATHĀS. 32,21.</ls> {#paSutAm#}\n<ls>M. 3,104.</ls> <ls n=\"M. 3,\">190.</ls> {#viklavatAm#}\n<ls>R. 6,82,22.</ls> {#sopAnatvam#}\n<ls>MEGH. 61.</ls>\n<ls>RAGH. 18,16.</ls>\n<ls>KĀM. NĪTIS. 4,13. 80.</ls> <ls>ŚĀK. 9.</ls> <ls>VARĀH. BṚH. 11,20. 24 (22),3.</ls> <ls>SĀH. D. 43,12.</ls> <ls n=\"SĀH. D.\">63,15.</ls> <ls>MĀRK. P. 25,14</ls> (<ab>med.</ab>). {#Basmatvam#} (so ist zu verbinden)\n<ls n=\"MĀRK. P.\">115,2.</ls> <ls>BHĀG. P. 1,18,22.</ls> <ls>PAÑCAT. 33,7.</ls>"@de ;
