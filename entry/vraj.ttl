<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vraj/tr/vraj_x7e__x7e_h0_x5f_00_x5f_pwg00/3> a ontolex:LexicalSense ;
  skos:definition "3) о движении неодушевленных и бестелесных вещей: о туче\n<ls>MEGH. 27.</ls> {#kiMcitpaScAdvraja laGugatiH kiMcidevottareRa#}\n<ls n=\"MEGH.\">16.</ls> {#na vrajanti vimAnAni vihAyasi#} (<ab>st.</ab> следующего {#praBAM#} следует читать по новейшему <ab>Ausg.</ab> {#BayAt#})\n<ls>HARIV. 8225.</ls> {#yAnaM yadi gacCenna vrajecca#} двигаться вперед\n<ls>VARĀH. BṚH. S. 46,60.</ls> {#diSaH sarvAH (SElAH pakzavantaH)#}\n<ls>R. 5,7,41.</ls> {#vrajatyastaM raviH#}\n<ls>Spr. (II) 3731.</ls>\n<ls>VARĀH. BṚH. S. 26,3.</ls> {#haritam#} появляться на горизонте\n<ls n=\"VARĀH. BṚH. S.\">5,17.</ls> {#aDas#} о пище\n<ls>M. 11,153.</ls>\n[Page6-1489]\n{#sahEva mftyurvrajati#}\n<ls>Spr. 5218.</ls> {#vrajanto vizayAH#} уходить\n<ls n=\"Spr.\">(II) 668.</ls> {#yasminmano vrajati tatra gato 'yamAtmA#}\n<ls>VARĀH. BṚH. S. 75,3.</ls> об истечении времени: {#kaTaM vAsarARi vrajeyuH#}\n<ls>MEGH. 104.</ls> {#vrajatu tava nidAGaH#}\n<ls>ṚT. 1,28.</ls> {#kAle vrajati#}\n<ls>KĀM. NĪTIS. 12,16.</ls> ad <ls>ŚĀK. 193.</ls> <ls>Spr. 2924.</ls> <ls>KATHĀS. 23,87.</ls> <ls>PAÑCAT. 49,2.</ls> <ls n=\"PAÑCAT.\">117,9.</ls> <ls n=\"PAÑCAT.\">261,14.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3) von der {%Bewegung%} unbelebter und auch unkörperlicher Dinge: einer Wolke\n<ls>MEGH. 27.</ls> {#kiMcitpaScAdvraja laGugatiH kiMcidevottareRa#}\n<ls n=\"MEGH.\">16.</ls> {#na vrajanti vimAnAni vihAyasi#} (<ab>st.</ab> des folgenden {#praBAM#} ist mit der neueren <ab>Ausg.</ab> {#BayAt#} zu lesen)\n<ls>HARIV. 8225.</ls> {#yAnaM yadi gacCenna vrajecca#} {%sich vorwärts bewegen%}\n<ls>VARĀH. BṚH. S. 46,60.</ls> {#diSaH sarvAH (SElAH pakzavantaH)#}\n<ls>R. 5,7,41.</ls> {#vrajatyastaM raviH#}\n<ls>Spr. (II) 3731.</ls>\n<ls>VARĀH. BṚH. S. 26,3.</ls> {#haritam#} {%am Horizont erscheinen%}\n<ls n=\"VARĀH. BṚH. S.\">5,17.</ls> {#aDas#} von einer Speise\n<ls>M. 11,153.</ls>\n[Page6-1489]\n{#sahEva mftyurvrajati#}\n<ls>Spr. 5218.</ls> {#vrajanto vizayAH#} {%fortgehen%}\n<ls n=\"Spr.\">(II) 668.</ls> {#yasminmano vrajati tatra gato 'yamAtmA#}\n<ls>VARĀH. BṚH. S. 75,3.</ls> vom {%Verstreichen%} der Zeit: {#kaTaM vAsarARi vrajeyuH#}\n<ls>MEGH. 104.</ls> {#vrajatu tava nidAGaH#}\n<ls>ṚT. 1,28.</ls> {#kAle vrajati#}\n<ls>KĀM. NĪTIS. 12,16.</ls> ad <ls>ŚĀK. 193.</ls> <ls>Spr. 2924.</ls> <ls>KATHĀS. 23,87.</ls> <ls>PAÑCAT. 49,2.</ls> <ls n=\"PAÑCAT.\">117,9.</ls> <ls n=\"PAÑCAT.\">261,14.</ls>"@de ;
  pwglex:senseTag "3" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Перенос глагола движения на неодушевлённые объекты (туча, время, пища): «двигаться», «появляться», «протекать (о времени)»."@ru ;
