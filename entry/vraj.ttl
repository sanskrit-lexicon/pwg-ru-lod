  skos:definition "2) идти к женщине (<ab>acc.</ab>), т. е. <ab>v. a.</ab> сожительствовать с ней\n<ls>M. 3,45.</ls> <ls n=\"M.\">8,378.</ls> <ls n=\"M. 8,\">382. fg.</ls> <ls n=\"M. 8,\">385.</ls>\n<ls>SUŚR. 2,147,11.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) zu einem Weibe (<ab>acc.</ab>) {%gehen%} so <ab>v. a.</ab> {%ihm beiwohnen%}\n<ls>M. 3,45.</ls> <ls n=\"M.\">8,378.</ls> <ls n=\"M. 8,\">382. fg.</ls> <ls n=\"M. 8,\">385.</ls>\n<ls>SUŚR. 2,147,11.</ls>"@de ;
