<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vraj/tr/vraj_x7e__x7e_h0_x5f_zz_x5f_pw/PW_x2d_1> a ontolex:LexicalSense ;
  skos:definition "1〉 шествовать, идти, странствовать (<ls n=\"Chr.\">30,2</ls>), — пешком (также с {#padByAm#}, {#upAnadByAm#} в обуви) или при помощи средства передвижения ({#DuryEs#}, {#vfzasTitaH#}), бежать (о конях), двигаться (о неодушевленных предметах), пройти путем (<ab>Acc.</ab>), — путем (<ab>Instr.</ab>), преодолеть <ab>best.</ab> расстояние (<ab>Acc.</ab>), идти к или направляться в (<ab>Acc.</ab>, реже <ab>Loc.</ab>, *<ab>Dat.</ab>, {#aDas#}, {#UrDvam#}, {#anyatra#}, {#anyatas#}), достигать (<ab>Acc.</ab>). {#SaraRam#} прибегать к (<ab>Acc.</ab>), {#mUrDnA pAdO#} пасть к ногам кого-либо (<ab>Gen.</ab>), {#antam#} достигать конца (<ab>Gen.</ab>); *идти за чем-либо (<ab>Dat.</ab>), так <ab>v. a.</ab> чтобы принести это; *идти чтобы (<ab>Infin.</ab>, <ab>Dat.</ab> одного <ab>Nom.</ab> <ab>act.</ab> или отглагольного <lex>Adj.</lex> на {#aka#}, как {#kAraka#}, {#Bojaka#} <ls n=\"Chr.\">239,5</ls>). {#vrajita#} ушедший ({#anyena#} по другому пути)."@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 1〉 {%schreiten, gehen, wandern%} (<ls n=\"Chr.\">30,2</ls>), — {%zu Fusse%} (auch mit {#padByAm#}, {#upAnadByAm#} {%in Schuhen%}) oder mittelst eines Vehikels ({#DuryEs#}, {#vfzasTitaH#}), {%laufen%} (von Pferden), {%sich bewegen%} (von unbelebten Dingen), {%gehen%} einen Weg (<ab>Acc.</ab>), — eines Weges (<ab>Instr.</ab>), eine <ab>best.</ab> Strecke (<ab>Acc.</ab>) {%zurücklegen, hingehen zu%} oder {%nach%} (<ab>Acc.</ab>, seltener <ab>Loc.</ab>, *<ab>Dat.</ab>, {#aDas#}, {#UrDvam#}, {#anyatra#}, {#anyatas#}), {%gelangen zu%} (<ab>Acc.</ab>). {#SaraRam#} {%seine Zuflucht nehmen zu%} (<ab>Acc.</ab>), {#mUrDnA pAdO#} {%sich zu Jmds%} (<ab>Gen.</ab>) {%Füssen [Page6-186-c] werfen,%} {#antam#} {%anʼs Ende von%} (<ab>Gen.</ab>) {%gelangen; *gehen nach Etwas%} (<ab>Dat.</ab>), so <ab>v. a.</ab> {%um dieses zu holen; *gehen um zu%} (<ab>Infin.</ab>, <ab>Dat.</ab> eines <ab>Nom.</ab> <ab>act.</ab> oder ein verbales <lex>Adj.</lex> auf {#aka#}, wie {#kAraka#}, {#Bojaka#} <ls n=\"Chr.\">239,5</ls>). {#vrajita#} {%gegangen%} ({#anyena#} {%auf einem andern Wege%})."@de ;
  pwglex:senseTag "PW-1" ;
  pwglex:homonym "h0" ;
