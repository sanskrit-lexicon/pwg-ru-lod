<https://w3id.org/sanskrit-lexicon/repwg/entry/buD-2> a ontolex:LexicalEntry ;
  rdfs:label "budh"@sa-Latn ;
  dct:isPartOf <https://w3id.org/sanskrit-lexicon/repwg/lexicon/pwg-ru> ;
