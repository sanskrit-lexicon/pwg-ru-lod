  rdfs:label "vedānta"@sa-Latn ;
  dct:isPartOf <https://w3id.org/sanskrit-lexicon/repwg/lexicon/pwg-ru> ;
  ontolex:canonicalForm <https://w3id.org/sanskrit-lexicon/repwg/lemma/vedAnta> ;
