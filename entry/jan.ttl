  skos:definition "<div n=\"1\">— 3) {%производить на свет, рожать, порождать%}: {#paSustizWangarBaM DitvAnupaviSya vijAyate#}\n<ls>ŚAT. BR. 7,4,1,2.</ls> {#yatra^ vi\\jAya^te ya\\minya^pa\\rtuH#}\n<ls>AV. 3,28,1.</ls> {#yacCAlA^yAM vi\\jAya^te#}\n<ls n=\"AV.\">9,3,13.</ls> {#ajA^yamAno bahu\\DA vi jA^yate#}\n<ls>VS. 31,19.</ls> {#(aSvataryaH) na vijAyante#} {%не размножаются%}\n<ls>AIT. BR. 4,9.</ls> {#(ozaDayaH) ba\\HvIrvi jA^yante#}\n<ls>AV. 11,4,3.</ls> {#strI#}\n<ls>ŚAT. BR. 1,3,3,6.</ls> {#ajA triH saMvatsarasya vijAyate#}\n<ls n=\"ŚAT. BR.\">3,3,3,8.</ls> <ls n=\"ŚAT. BR.\">4,5,5,6.</ls> {#kAma\\mA vija^nito\\H saMBa^vema#}\n<ls>TS. 2,5,1,5.</ls> — {#tasmAtputraM vyajAyata#}\n<ls>R. 1,70,35.</ls> {#yakzI putraM vyajAyata#}\n<ls n=\"R. 1,\">27,8.</ls> <ls n=\"R. 1,\">39,17.</ls> <ls n=\"R.\">3,20,28.</ls> <ls n=\"R. 3,20,\">32.</ls> <ls>MBH. 1,2554.</ls> <ls n=\"MBH. 1,\">2621.</ls> <ls n=\"MBH. 1,\">3762.</ls> <ls n=\"MBH.\">3,8843.</ls> <ls>HARIV. 11535.</ls> <ls>BHĀG. P. 9,9,39.</ls> {#samAM samAM vijAyate#}\n<ls>P. 5,2,12.</ls>\n<ls>H. 1271.</ls> {#vijAtA#} {%родившая%}\n<ls>H. 539.</ls>\n<ls>an. 3,301.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3) {%zeugen, gebären, zur Welt bringen%}: {#paSustizWangarBaM DitvAnupaviSya vijAyate#}\n<ls>ŚAT. BR. 7,4,1,2.</ls> {#yatra^ vi\\jAya^te ya\\minya^pa\\rtuH#}\n<ls>AV. 3,28,1.</ls> {#yacCAlA^yAM vi\\jAya^te#}\n<ls n=\"AV.\">9,3,13.</ls> {#ajA^yamAno bahu\\DA vi jA^yate#}\n<ls>VS. 31,19.</ls> {#(aSvataryaH) na vijAyante#} {%pflanzen sich nicht fort%}\n<ls>AIT. BR. 4,9.</ls> {#(ozaDayaH) ba\\HvIrvi jA^yante#}\n<ls>AV. 11,4,3.</ls> {#strI#}\n<ls>ŚAT. BR. 1,3,3,6.</ls> {#ajA triH saMvatsarasya vijAyate#}\n<ls n=\"ŚAT. BR.\">3,3,3,8.</ls> <ls n=\"ŚAT. BR.\">4,5,5,6.</ls> {#kAma\\mA vija^nito\\H saMBa^vema#}\n<ls>TS. 2,5,1,5.</ls> — {#tasmAtputraM vyajAyata#}\n<ls>R. 1,70,35.</ls> {#yakzI putraM vyajAyata#}\n<ls n=\"R. 1,\">27,8.</ls> <ls n=\"R. 1,\">39,17.</ls> <ls n=\"R.\">3,20,28.</ls> <ls n=\"R. 3,20,\">32.</ls> <ls>MBH. 1,2554.</ls> <ls n=\"MBH. 1,\">2621.</ls> <ls n=\"MBH. 1,\">3762.</ls> <ls n=\"MBH.\">3,8843.</ls> <ls>HARIV. 11535.</ls> <ls>BHĀG. P. 9,9,39.</ls> {#samAM samAM vijAyate#}\n<ls>P. 5,2,12.</ls>\n<ls>H. 1271.</ls> {#vijAtA#} {%die geboren hat%}\n<ls>H. 539.</ls>\n<ls>an. 3,301.</ls>"@de ;
