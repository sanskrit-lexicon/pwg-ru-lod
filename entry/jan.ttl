  skos:definition "<div n=\"p\">— {#A#}\n<div n=\"1\"> 1) <ab>trans.</ab> {%порождать, производить на свет%}: {#pra\\jAmA ja^nayAvahE#}\n<ls>AV. 14,2,71.</ls> {%дать кому-л. родиться, стать причиной чьего-л. рождения%}: {#A na^H pra\\jAM ja^nayatu pra\\jApa^tiH#}\n<ls>ṚV. 10,85,43.</ls> {%делать плодородным, приумножать посредством порождения%}: {#A no\\ jane^ janaya#}\n<ls n=\"ṚV.\">1,113,19.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#A#}\n<div n=\"1\"> 1) <ab>trans.</ab> {%erzeugen%}: {#pra\\jAmA ja^nayAvahE#}\n<ls>AV. 14,2,71.</ls> {%Jmd geboren werden lassen%}: {#A na^H pra\\jAM ja^nayatu pra\\jApa^tiH#}\n<ls>ṚV. 10,85,43.</ls> {%fruchtbar machen, durch Zeugung mehren%}: {#A no\\ jane^ janaya#}\n<ls n=\"ṚV.\">1,113,19.</ls>"@de ;
