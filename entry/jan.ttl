<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/jan/tr/jan_x7e__x7e_h0_x5f_08_x5f_a_x5f_bi/2> a ontolex:LexicalSense ;
  skos:definition "2) <div n=\"1\">— рождаться, возникать: {#te kzipramevABijajYire#}\n<ls>R. 1,16,19.</ls> {#yadyonAvaBijAyate#}\n<ls>M. 2,247.</ls> {#sa vE taTA vakra evAByajAyat#}\n<ls>MBH. 3,10608.</ls> {#AkUtyAM ruceryajYo 'ByajAyata#}\n<ls>BHĀG. P. 1,3,12.</ls> {#hfdayABijAta#}\n<ls n=\"BHĀG. P.\">5,8,24.</ls> {#jAtasneho yatra tanvABijAtaH#}\n<ls n=\"BHĀG. P.\">3,25,31.</ls> {#tapasA cIyate brahma tato 'nnamaBijAyate . annAtprARaH#}\n<ls>MUṆḌ. UP. 1,1,8.</ls> {#tAmraM kArzRAyasaM cApi tEkzRyAdevAByajAyata#}\n<ls>R. 1,38,20.</ls> {#kAmAtkroDo 'BijAyate#}\n<ls>BHAG. 2,62.</ls> {#sarvezAM tatra BUtAnAM lomaharzo 'ByajAyata#}\n<ls>MBH. 8,2927.</ls> {#aBijAta#} врожденный, унаследованный: {#yattvasya sahajam — pitfpEtAmahaM balam . aBijAtabalaM nAma taccaturTabalaM smftam ..#}\n<ls n=\"MBH.\">5,1357.</ls> <lex>n.</lex> рождение: {#aBijAtakovidAH#} знатоки гороскопов\n<ls>BHĀG. P. 1,16,1.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) {%geboren werden, entstehen%}: {#te kzipramevABijajYire#}\n<ls>R. 1,16,19.</ls> {#yadyonAvaBijAyate#}\n<ls>M. 2,247.</ls> {#sa vE taTA vakra evAByajAyat#}\n<ls>MBH. 3,10608.</ls> {#AkUtyAM ruceryajYo 'ByajAyata#}\n<ls>BHĀG. P. 1,3,12.</ls> {#hfdayABijAta#}\n<ls n=\"BHĀG. P.\">5,8,24.</ls> {#jAtasneho yatra tanvABijAtaH#}\n<ls n=\"BHĀG. P.\">3,25,31.</ls> {#tapasA cIyate brahma tato 'nnamaBijAyate . annAtprARaH#}\n<ls>MUṆḌ. UP. 1,1,8.</ls> {#tAmraM kArzRAyasaM cApi tEkzRyAdevAByajAyata#}\n<ls>R. 1,38,20.</ls> {#kAmAtkroDo 'BijAyate#}\n<ls>BHAG. 2,62.</ls> {#sarvezAM tatra BUtAnAM lomaharzo 'ByajAyata#}\n<ls>MBH. 8,2927.</ls> {#aBijAta#} {%angeboren, ererbt%}: {#yattvasya sahajam — pitfpEtAmahaM balam . aBijAtabalaM nAma taccaturTabalaM smftam ..#}\n<ls n=\"MBH.\">5,1357.</ls> <lex>n.</lex> {%Geburt%}: {#aBijAtakovidAH#} {%Nativitätskundige%}\n<ls>BHĀG. P. 1,16,1.</ls>"@de ;
  pwglex:senseTag "2" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«рождаться, возникать» — пара синонимов равной кардинальности немецкому «geboren werden, entstehen»; для причастного значения «angeboren, ererbt» использованы два эквивалента «врождённый, унаследованный», отражающие немецкую запятую как перечисление взаимозаменяемых синонимов внутри одного смысла."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-01T07:50:46Z"^^xsd:dateTime ;
  dct:references <https://w3id.org/sanskrit-lexicon/repwg/citation/BHAG_x2e__x2d_2_x2c_62_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/BH_xc4__x80_G_x2e__x2d_P_x2e__x2d_1_x2c_16_x2c_1_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/BH_xc4__x80_G_x2e__x2d_P_x2e__x2d_1_x2c_3_x2c_12_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/BH_xc4__x80_G_x2e__x2d_P_x2e__x2d_3_x2c_25_x2c_31_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/BH_xc4__x80_G_x2e__x2d_P_x2e__x2d_5_x2c_8_x2c_24_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/MBH_x2e__x2d_3_x2c_10608_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/MBH_x2e__x2d_5_x2c_1357_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/MBH_x2e__x2d_8_x2c_2927_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/MU_xe1__xb9__x86__xe1__xb8__x8c__x2e__x2d_UP_x2e__x2d_1_x2c_1_x2c_8_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/M_x2e__x2d_2_x2c_247_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/R_x2e__x2d_1_x2c_16_x2c_19_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/R_x2e__x2d_1_x2c_38_x2c_20_x2e_> ;
