  skos:definition "{#anukampA#}¦ (как выше) <lex>f.</lex> сострадание, сочувствие <ls>AK. 1,1,7,18</ls>. <ls n=\"AK.\">3,4,32,5</ls>. <ls n=\"AK. 3,4,32,\">6</ls>. (<ls>COL. 3,4,28,5</ls>. <ls n=\"COL. 3,4,28,\">6</ls>). <ls>H. 369</ls>. С <ab>gen.</ab>: {#tezAmevAnukampArTam#} <ls>BHAG. 10,11</ls>. С <ab>loc.</ab>: {#mayyanukampayA#} <ls>RAGH. 2,63</ls>. Сочетается с <ab>obj.</ab>: {#BUtAnu˚#} <ls>R. GORR. 2,118,32</ls>. (<ls>SCHL. 2,109,31</ls>: {#BUtAnukampa#} <lex>m.</lex>) <ls>RAGH. 2,48</ls>. {#viprA˚#} <ls>R. 3,16,37</ls>."@ru ;
  pwglex:sourceGloss "{#anukampA#}¦ (wie eben) <lex>f.</lex> {%Mitleid, Mitgefühl%} <ls>AK. 1,1,7,18</ls>. <ls n=\"AK.\">3,4,32,5</ls>. <ls n=\"AK. 3,4,32,\">6</ls>. (<ls>COL. 3,4,28,5</ls>. <ls n=\"COL. 3,4,28,\">6</ls>). <ls>H. 369</ls>. mit dem <ab>gen.</ab>: {#tezAmevAnukampArTam#} <ls>BHAG. 10,11</ls>. mit dem <ab>loc.</ab>: {#mayyanukampayA#} <ls>RAGH. 2,63</ls>. mit dem <ab>obj.</ab> componirt: {#BUtAnu˚#} <ls>R. GORR. 2,118,32</ls>. (<ls>SCHL. 2,109,31</ls>: {#BUtAnukampa#} <lex>m.</lex>) <ls>RAGH. 2,48</ls>. {#viprA˚#} <ls>R. 3,16,37</ls>."@de ;
