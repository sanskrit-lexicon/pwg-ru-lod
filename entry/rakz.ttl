<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/rakz/tr/rakz_x7e__x7e_h0_x5f_14_x5f_vi/vi> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#vi#} {%оберегать, защищать, сохранять%}: {#sarva^M BU\\tam#}\n<ls>AV. 10,6,18.</ls> <ls n=\"AV.\">13,2,41.</ls> {#rAjA^ rA\\zwraM vi ra^kzati#}\n<ls n=\"AV.\">11,5,17.</ls> {#anyo'nyaM samupASritya virakzanti raRAjire (na tyakzyanti raRAjiram#} <ls>ed. Bomb.</ls>)\n<ls>MBH. 7,4410.</ls> {#droRaM ca ke vyarakzanta#}\n<ls n=\"MBH. 7,\">7329.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#vi#} {%behüten, beschützen, bewahren%}: {#sarva^M BU\\tam#}\n<ls>AV. 10,6,18.</ls> <ls n=\"AV.\">13,2,41.</ls> {#rAjA^ rA\\zwraM vi ra^kzati#}\n<ls n=\"AV.\">11,5,17.</ls> {#anyo'nyaM samupASritya virakzanti raRAjire (na tyakzyanti raRAjiram#} <ls>ed. Bomb.</ls>)\n<ls>MBH. 7,4410.</ls> {#droRaM ca ke vyarakzanta#}\n<ls n=\"MBH. 7,\">7329.</ls>"@de ;
  pwglex:senseTag "vi" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Три синонима равной частотности: «behüten» — оберегать (постоянная забота), «beschützen» — защищать (активное ограждение), «bewahren» — сохранять (удержание в исходном состоянии). Передаются тройным синонимическим рядом той же кардинальности."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
