<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/antar/dict/koch/1> a ontolex:LexicalSense ;
  skos:definition "अन्तर् /antar/ adv. 1) внутри, в 2) между, в середине чего-л. (Acc., Gen., Loc. ) 3) изнутри чего-л. (Gen., Abl. )"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/antar/dict/kna/2> a ontolex:LexicalSense ;
  skos:definition "अन्तर्\t/antar/\t\t/антар/\tantar adv. praep. и postpos., также въ сложн. сл. °antar, внутри, между, въ. — (лат. inter, нѣм. unter вм. under).\tс. 197"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/antar/dict/fri/3> a ontolex:LexicalSense ;
  skos:definition "antar adv.; внутри, внутрь"@ru ;
