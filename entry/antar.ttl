<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/antar/dict/fri/4> a ontolex:LexicalSense ;
  skos:definition "antar prep. + acc., loc., gen.; внутри, между, в, до"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
