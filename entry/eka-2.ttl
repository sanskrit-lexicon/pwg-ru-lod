<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/eka-2/dict/kna/2> a ontolex:LexicalSense ;
  skos:definition "एक\t/eka/\t\tЭка/\tēka одинъ, единый, одинокій, единственный; pl. ēkē нѣкоторые. — [ср. οἰνός, лат. ūnus, гот. ains „ein“, цсл. jed-inъ „одинъ“].\tс. 210"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/eka-2/dict/fri/3> a ontolex:LexicalSense ;
  skos:definition "eka num.; один, отдельный, единственный, тот же самый, уникальный, выдающийся"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
