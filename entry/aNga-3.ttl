<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/aNga-3/dict/koch/1> a ontolex:LexicalSense ;
  skos:definition "अङ्ग III /aṅga/ n. 1) тело 2) член, часть тела 3) вспомогательное средство 4) дополнение- приложение 5) грам. основа"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/aNga-3/dict/koch/2> a ontolex:LexicalSense ;
  skos:definition "अङ्ग I /aṅga/ как раз- только что"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/aNga-3/dict/koch/3> a ontolex:LexicalSense ;
  skos:definition "अङ्ग II /aṅga/ m. 1) nom. pr. Анга страна, расположенная на правом берегу Ганга, со столицей Чампа 2) pl. анга народ, населяющий вышеназванную страну"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/aNga-3/dict/kna/4> a ontolex:LexicalSense ;
  skos:definition "अङ्ग\t/aṅga/\t/aGga/\t/анга/\t1. aṅga выразит. частица: именно, только, же.\tс. 194"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/aNga-3/dict/kna/5> a ontolex:LexicalSense ;
  skos:definition "अङ्ग\t/aṅga/\t/aGga/\t/анга/\t2. aṅga (°aṅga bah., f. ī) n. часть, часть тѣла, членъ, тѣлосложеніе, тѣло; отдѣлъ, прибавленіе, pl. названіе извѣстныхъ ведійскихъ дополнительныхъ сочиненій.\tс. 194"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/aNga-3/dict/fri/6> a ontolex:LexicalSense ;
  skos:definition "I aṅga pcl.; ну, право"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "fri" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/aNga-3/dict/fri/7> a ontolex:LexicalSense ;
  skos:definition "II aṅga n.; орган, тело, часть, составная часть; основа слова"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
