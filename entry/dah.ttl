<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/dah/tr/dah_x7e__x7e_h0_x5f_16_x5f_vinis/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#vinis#} {%сжигать, испепелять огнем, уничтожать полностью%}: {#jagadvinirdahedetat#} ({#astram#})\n<ls>MBH. 1,5307.</ls>\n<ls>ARJ. 3,52.</ls> {#eza senAH — agnivatsamare tAta carizyati vinirdahan#}\n<ls>MBH. 5,5769.</ls> {#cakrAnalavinirdagDa#}\n<ls>HARIV. 5935.</ls>\n<ls>R. GORR. 1,29,11.</ls> <ls n=\"R. GORR.\">3,35,93.</ls> {#(enam) matpraBAvavinirdagDaM pataMgamiva vahninA#}\n<ls>MBH. 2,1492.</ls> {#brahmaSApavinirdagDa#}\n<ls n=\"MBH.\">16,279.</ls> <ls n=\"MBH.\">3,14829.</ls> <ls>MĀRK. P. 39,61.</ls> {#tayAjYAnaM vinirdahan#}\n<ls>BHĀG. P. 9,7,24.</ls>"@ru ;
