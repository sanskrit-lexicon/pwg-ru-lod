  skos:definition "<div n=\"p\">— {#apa#} {%сжигать, выжигать (прочь)%}: {#vIjAnyagnyapadagDAni naro hanti yaTA punaH#}\n<ls>MBH. 12,7705.</ls> {%изгонять жаром%}: {#viSvA^ a\\gne 'pa^ da\\HArA^tIH#}\n<ls>ṚV. 7,1,7.</ls>"@ru ;
