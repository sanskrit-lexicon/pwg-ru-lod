<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/dah/tr/dah_x7e__x7e_h0_x5f_09_x5f_a_x5f_bi/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#aBi#} {%поджигать, сжигать%}: {#sa yo vyasTA^da\\Bi dakza^du\\rvIm#}\n<ls>ṚV. 2,4,7.</ls> {#tamagnirvABidahet#}\n<ls>ŚAT. BR. 3,6,2,20.</ls> {#yasya somamaBidahet#}\n<ls>KĀṬH. 35,16.</ls> {#aBidagDa#}\n<ls>ŚĀṄKH. ŚR. 13,6,8.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#aBi#} {%anbrennen, verbrennen%}: {#sa yo vyasTA^da\\Bi dakza^du\\rvIm#}\n<ls>ṚV. 2,4,7.</ls> {#tamagnirvABidahet#}\n<ls>ŚAT. BR. 3,6,2,20.</ls> {#yasya somamaBidahet#}\n<ls>KĀṬH. 35,16.</ls> {#aBidagDa#}\n<ls>ŚĀṄKH. ŚR. 13,6,8.</ls>"@de ;
