<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/dah/tr/dah_x7e__x7e_h0_x5f_10_x5f_ava/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#ava#} {%выгорать, сгорать дотла%}: {#avA^daho di\\va A dasyu^mu\\ccA#}\n<ls>ṚV. 1,33,7.</ls> {#kAzWErbahuBiravadahya#}\n<ls>SUŚR. 2,35,19.</ls> {#vahninEvAvadahyate#}\n<ls n=\"SUŚR.\">313,15.</ls> {#avadagDa#}\n<ls>KAUŚ. 71.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#ava#} {%abbrennen, zusammenbrennen%}: {#avA^daho di\\va A dasyu^mu\\ccA#}\n<ls>ṚV. 1,33,7.</ls> {#kAzWErbahuBiravadahya#}\n<ls>SUŚR. 2,35,19.</ls> {#vahninEvAvadahyate#}\n<ls n=\"SUŚR.\">313,15.</ls> {#avadagDa#}\n<ls>KAUŚ. 71.</ls>"@de ;
