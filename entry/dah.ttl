<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/dah/tr/dah_x7e__x7e_h0_x5f_01_x5f_sec_x5f_1/caus_x2e__x2f_desid_x2e__x2f_intens_x2e__x20__xe2__x80__x94__x20_main> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— <ab>pass.</ab> {%быть сожженным, гореть, пылать, стоять в пламени%}: {#tatra dahyeta pApakft#} <ls>M. 8,372.</ls> <ls>MBH. 4,798.</ls> {#te dahyante sma vahninA#} <ls n=\"MBH.\">2,1140.</ls> <ls n=\"MBH.\">3,2935.</ls> {#dahyamAnAmivArkeRa#} <ls n=\"MBH. 4,\">2670.</ls> {#na ca dahyanti gacCantyaH sutaptErapi pAMSuBiH#} <ls n=\"MBH.\">13,1468.</ls> {#BfgurBfjyamAno na dehe#} <ls>NIR. 3,17.</ls> {#dahyante gfhAH#} <ls>AV. 12,4,3.</ls> {#diSaH#} <ls>ṢAḌV. BR. 5,9.</ls> {#tasminvane dahyamAne#} <ls>MBH. 1,8330.</ls> {#dahyatastasya — dAvasya#} <ls n=\"MBH. 1,\">8210.</ls> <ls n=\"MBH.\">3,2608.</ls> {%быть устраненным огнем, быть уничтоженным%} <ab>überh.</ab>: {#dahyante DmAyamAnAnAM DAtUnAM hi yaTA malAH . taTendriyARAM dahyante dozAH prARasya nigrahAt ..#} <ls>M. 6,71.</ls> {%гореть%} (о ранах) <ls>SUŚR. 1,103,17.</ls> {%быть снедаемым внутренним жаром, — томиться, изнывать%}: {#vizeRa nAgarAjasya dahyamAno divAniSam#} <ls>MBH. 3,2843.</ls> {#dahyamAna ivAgninA#} <ls n=\"MBH.\">2,1691.</ls> {#rAjA svatejoBiradahyatAntarBogIva mantrOzaDirudDavIryaH#} <ls>RAGH. 2,32.</ls> {#ADiBirdahyamAnasya#} <ls>MBH. 3,2754.</ls> {#kzutpipAsAByAM ca dahyamAnAntarbahiHSarIraH#} <ls>BHĀG. P. 5,26,14.</ls> {#dahyamAnaH sa Sokena#} <ls>MBH. 3,2647.</ls> {#Sokena dehe janatAtimAtram#} <ls>BHAṬṬ. 3,11.</ls> {#dehe cAtIva manyunA#} <ls n=\"BHAṬṬ.\">14,60.</ls> {#dahyamAnAM BfSaM bAlAm#} <ls>MBH. 3,2731.</ls> <ls n=\"MBH. 3,\">2913.</ls> <ls>R. 1,58,12.</ls> {#mano hi me dUyate dahyate ca#} <ls>DRAUP. 6,4.</ls> {#amarzavaSamApanno dahyAmi#} <ls>MBH. 2,1690.</ls> {#dahyantyaNgAni me#} <ls n=\"MBH.\">1,2061.</ls> {#tena me vyAkulaM cittaM hfdayaM dahyatIva ca#} <ls n=\"MBH. 1,\">5048.</ls> <ls>SĀV. 5,3.</ls> {#dahye 'haM maDuno lehErdAvErugrEryaTA giriH#} {%быть измученным —, изнуренным%} <ls>BHAṬṬ. 6,82.</ls> С <ab>transit.</ab> <ab>Bed.</ab> {%сгорать%}: {#(tAm) sahAnenAdya dahyema#} <ls>MBH. 4,799.</ls> — <ab>partic.</ab> {#dagDa#}"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— <ab>pass.</ab> {%verbrannt werden, verbrennen, brennen, in Flammen stehen%}: {#tatra dahyeta pApakft#} <ls>M. 8,372.</ls> <ls>MBH. 4,798.</ls> {#te dahyante sma vahninA#} <ls n=\"MBH.\">2,1140.</ls> <ls n=\"MBH.\">3,2935.</ls> {#dahyamAnAmivArkeRa#} <ls n=\"MBH. 4,\">2670.</ls> {#na ca dahyanti gacCantyaH sutaptErapi pAMSuBiH#} <ls n=\"MBH.\">13,1468.</ls> {#BfgurBfjyamAno na dehe#} <ls>NIR. 3,17.</ls> {#dahyante gfhAH#} <ls>AV. 12,4,3.</ls> {#diSaH#} <ls>ṢAḌV. BR. 5,9.</ls> {#tasminvane dahyamAne#} <ls>MBH. 1,8330.</ls> {#dahyatastasya — dAvasya#} <ls n=\"MBH. 1,\">8210.</ls> <ls n=\"MBH.\">3,2608.</ls> {%durch Feuer entfernt werden, getilgt werden%} <ab>überh.</ab>: {#dahyante DmAyamAnAnAM DAtUnAM hi yaTA malAH . taTendriyARAM dahyante dozAH prARasya nigrahAt ..#} <ls>M. 6,71.</ls> {%brennen%}, von Wunden <ls>SUŚR. 1,103,17.</ls> {%von innerer Gluth verzehrt werden, — vergehen, sich abhärmen%}: {#vizeRa nAgarAjasya dahyamAno divAniSam#} <ls>MBH. 3,2843.</ls> {#dahyamAna ivAgninA#} <ls n=\"MBH.\">2,1691.</ls> {#rAjA svatejoBiradahyatAntarBogIva mantrOzaDirudDavIryaH#} <ls>RAGH. 2,32.</ls> {#ADiBirdahyamAnasya#} <ls>MBH. 3,2754.</ls> {#kzutpipAsAByAM ca dahyamAnAntarbahiHSarIraH#} <ls>BHĀG. P. 5,26,14.</ls> {#dahyamAnaH sa Sokena#} <ls>MBH. 3,2647.</ls> {#Sokena dehe janatAtimAtram#} <ls>BHAṬṬ. 3,11.</ls> {#dehe cAtIva manyunA#} <ls n=\"BHAṬṬ.\">14,60.</ls> {#dahyamAnAM BfSaM bAlAm#} <ls>MBH. 3,2731.</ls> <ls n=\"MBH. 3,\">2913.</ls> <ls>R. 1,58,12.</ls> {#mano hi me dUyate dahyate ca#} <ls>DRAUP. 6,4.</ls> {#amarzavaSamApanno dahyAmi#} <ls>MBH. 2,1690.</ls> {#dahyantyaNgAni me#} <ls n=\"MBH.\">1,2061.</ls> {#tena me vyAkulaM cittaM hfdayaM dahyatIva ca#} <ls n=\"MBH. 1,\">5048.</ls> <ls>SĀV. 5,3.</ls> {#dahye 'haM maDuno lehErdAvErugrEryaTA giriH#} {%gequält —, mitgenommen werden%} <ls>BHAṬṬ. 6,82.</ls> Mit <ab>transit.</ab> <ab>Bed.</ab> {%verbrennen%}: {#(tAm) sahAnenAdya dahyema#} <ls>MBH. 4,799.</ls> — <ab>partic.</ab> {#dagDa#}"@de ;
