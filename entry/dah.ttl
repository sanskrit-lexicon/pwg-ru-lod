<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/dah/tr/dah_x7e__x7e_h0_x5f_zz_x5f_pw/2> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 2〉 {%нагревать, накалять%} <ls>ĀPAST. 1,17,10</ls>.\n<div n=\"p\">— С {#ava#} {%сгорать, спекаться от огня%}. {#avadagDa#} также {%поврежденный огнем%} <ls>CARAKA. 5,12</ls>.\n<div n=\"p\">— С {#A#} в {#Ada/hana AdagDvA#} <ls>PAÑCAT. 1,392</ls> ошибочно вм. {#adagDvA#}.\n<div n=\"m\">— <ab>Caus.</ab> <ab>Pass.</ab> {%обжигаться, сгорать%}.\n<div n=\"p\">— С {#aByA#} в {#aByAdAhya#} (<ls>Nachtr. 2</ls>).\n<div n=\"p\">— С {#upa#} {%подпаливать, поджигать%} <ls>{{MBH. 7,211,17->MBH. 12,211,17||20250606|Andhrabharati|https://github.com/sanskrit-lexicon/PWK/issues/84#issuecomment-2948415067|}}</ls>. {%поджигать, поднести огонь к%} (<ab>Acc.</ab>).\n<div n=\"p\">— С {#ni#} {%сжигать дотла, испепелять огнем%}. <ab>Pass.</ab> {%быть сожженным, сгорать%}.\n<div n=\"p\">— С {#nis#} {%выгорать, сгорать, быть испепеленным огнем, уничтожаться полностью%}. <ab>Pass.</ab> также {%съеживаться, увядать%}. {#tuzAreRa padminI#} <ls>VIKRAMĀṄKAC. 16,14</ls>.\n<div n=\"m\">— <ab>Caus.</ab> {%давать сжечь, велеть сжечь%}.\n<div n=\"p\">— С {#anunis#} {%сжигать один за другим, по очереди%}.\n<div n=\"p\">— С {#vinis#} {%сжигать, испепелять огнем, уничтожать полностью%}.\n<div n=\"p\">— С {#pari#} {%обжигать вокруг, охватывать пламенем, сжигать%}. <ab>Pass.</ab> {%гореть, пылать%}.\n<div n=\"p\">— С {#saMpari#} <ab>Pass.</ab> ({#˚dahyati#}) {%сгорать, изнывать от зноя%}.\n<div n=\"p\">— С {#pra#} {%сжигать, опалять, уничтожать%}. <ab>Pass.</ab> {%воспламеняться, [Page3-077-c] гореть, сгорать%}. {#pradagaDa#} {%сжигает, уничтожает%}.\n<div n=\"m\">— <ab>Caus.</ab> {%давать сжечь, велеть сжечь%}.\n<div n=\"p\">— С {#saMpra#} {%сжигать, уничтожать%}.\n<div n=\"p\">— С {#prati#}"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2〉 {%erhitzen, erwärmen%} <ls>ĀPAST. 1,17,10</ls>.\n<div n=\"p\">— Mit {#ava#} {%abbrennen, zusammenbrennen%}. {#avadagDa#} auch {%durch Feuer beschädigt%} <ls>CARAKA. 5,12</ls>.\n<div n=\"p\">— Mit {#A#} in {#Ada/hana AdagDvA#} <ls>PAÑCAT. 1,392</ls> fehlerhaft für {#adagDvA#}.\n<div n=\"m\">— <ab>Caus.</ab> <ab>Pass.</ab> {%sich verbrennen%}.\n<div n=\"p\">— Mit {#aByA#} in {#aByAdAhya#} (<ls>Nachtr. 2</ls>).\n<div n=\"p\">— Mit {#upa#} {%anbrennen%} <ls>{{MBH. 7,211,17->MBH. 12,211,17||20250606|Andhrabharati|https://github.com/sanskrit-lexicon/PWK/issues/84#issuecomment-2948415067|}}</ls>. {%Feuer anlegen an%} (<ab>Acc.</ab>).\n<div n=\"p\">— Mit {#ni#} {%niederbrennen, durch Feuer verzehren%}. <ab>Pass.</ab> {%verbrannt werden%}.\n<div n=\"p\">— Mit {#nis#} {%ausbrennen, verbrennen, durch Feuer verzehren, vollständig vernichten%}. <ab>Pass.</ab> auch {%zusammenschrumpfen, welk werden%}. {#tuzAreRa padminI#} <ls>VIKRAMĀṄKAC. 16,14</ls>.\n<div n=\"m\">— <ab>Caus.</ab> {%verbrennen lassen%}.\n<div n=\"p\">— Mit {#anunis#} {%nacheinander —, der Reihe nach verbrennen%}.\n<div n=\"p\">— Mit {#vinis#} {%verbrennen, durch Feuer verzehren, vollständig vernichten%}.\n<div n=\"p\">— Mit {#pari#} {%umbrennen, umglühen, verbrennen%}. <ab>Pass.</ab> {%brennen, glühen%}.\n<div n=\"p\">— Mit {#saMpari#} <ab>Pass.</ab> ({#˚dahyati#}) {%verbrennen, vor Glut vergehen%}.\n<div n=\"p\">— Mit {#pra#} {%verbrennen, versengen, vernichten%}. <ab>Pass.</ab> {%in Flammen gerathen, [Page3-077-c] brennen, verbrennen%}. {#pradagaDa#} {%verbrennt, vernichtet%}.\n<div n=\"m\">— <ab>Caus.</ab> {%verbrennen lassen%}.\n<div n=\"p\">— Mit {#saMpra#} {%verbrennen, vernichten%}.\n<div n=\"p\">— Mit {#prati#}"@de ;
