<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/dah/tr/dah_x7e__x7e_h0_x5f_19_x5f_pra/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#pra#} {%сжигать, уничтожать%}: {#pra su viSvA^nra\\kzaso\\ Dakzya^gne#}\n<ls>ṚV. 1,76,3.</ls> {#nEzA^M Si\\SnaM pra da^hati jA\\tave^dAH#}\n<ls>AV. 4,34,2.</ls> <ls n=\"AV. 4,\">36,1.</ls> <ls n=\"AV.\">10,8,39.</ls> <ls n=\"AV.\">13,1,29.</ls> {#prajAM ca paSUMSca pradahet#}\n<ls>ŚAT. BR. 14,2,2,45.</ls> <ls n=\"ŚAT. BR. 14,2,2,\">54.</ls> <ls n=\"ŚAT. BR.\">2,2,1,2.</ls> <ls n=\"ŚAT. BR. 2,\">6,3,15.</ls> <ls n=\"ŚAT. BR.\">11,4,2,16.</ls> {#sarvaM vE mAyaM praDakzyati#}\n<ls>TBR. 2,3,7,1.</ls>\n<ls>TS. 2,2,8,6.</ls> {#I\\Sva\\raM vE vra\\tamavi^sfzwaM pra\\daha^H#}\n<ls n=\"TS.\">1,7,6,6.</ls> {#tattvA mA praDAkzIriti#} (после\n<ls>ŚAṂK.</ls> перестановки лиц; следует читать <ab>viell.</ab> {#˚kzIditi#})\n<ls>CHĀND. UP. 4,1,2.</ls> {#prAdahan SaraRAnyanye prajAnAM jvalitolmukEH#}\n<ls>BHĀG. P. 7,2,15.</ls> {#na pAvakastvAM pradahizyati#}\n<ls>MBH. 1,2120.</ls> <ls n=\"MBH. 1,\">8362.</ls> {#pARqavAgnim — dIptaM pradahantamivAhitAn#}\n<ls n=\"MBH.\">4,1520.</ls> {#BImasenadavAgnestu mama putrAMstfRopamAn . praDakzyataH#} (следует читать так: <ab>st.</ab> {#praDakzataH#})\n<ls n=\"MBH.\">7,5277.</ls> <ls n=\"MBH.\">1,1762.</ls> <ls n=\"MBH.\">5,678.</ls> <ls n=\"MBH.\">7,6092.</ls> <ls n=\"MBH.\">16,274.</ls> {#sarvARi mEnyAni ca vAsudevaH praDakzyate sAyakavahnijAlEH#}\n<ls n=\"MBH.\">3,10274.</ls> — <ls>HARIV. 11601.</ls> <ls n=\"HARIV.\">13888.</ls> {#mAM SokAgniH — praDakzyati#}\n<ls>R. 2,24,8.</ls> <ls n=\"R. 2,\">94,15.</ls>\n<ls>R. GORR. 2,25,6.</ls> {#tatkulaM pradahati#}\n<ls>BHĀG. P. 1,7,48.</ls> <ls n=\"BHĀG. P. 1,7,\">31.</ls> <ls n=\"BHĀG. P.\">4,4,2.</ls> <ls n=\"BHĀG. P.\">9,5,12.</ls> {#keliH pradahati majjAM#} (следует читать так) {#SfNgAro 'sTIni#}"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#pra#} {%verbrennen, vernichten%}: {#pra su viSvA^nra\\kzaso\\ Dakzya^gne#}\n<ls>ṚV. 1,76,3.</ls> {#nEzA^M Si\\SnaM pra da^hati jA\\tave^dAH#}\n<ls>AV. 4,34,2.</ls> <ls n=\"AV. 4,\">36,1.</ls> <ls n=\"AV.\">10,8,39.</ls> <ls n=\"AV.\">13,1,29.</ls> {#prajAM ca paSUMSca pradahet#}\n<ls>ŚAT. BR. 14,2,2,45.</ls> <ls n=\"ŚAT. BR. 14,2,2,\">54.</ls> <ls n=\"ŚAT. BR.\">2,2,1,2.</ls> <ls n=\"ŚAT. BR. 2,\">6,3,15.</ls> <ls n=\"ŚAT. BR.\">11,4,2,16.</ls> {#sarvaM vE mAyaM praDakzyati#}\n<ls>TBR. 2,3,7,1.</ls>\n<ls>TS. 2,2,8,6.</ls> {#I\\Sva\\raM vE vra\\tamavi^sfzwaM pra\\daha^H#}\n<ls n=\"TS.\">1,7,6,6.</ls> {#tattvA mA praDAkzIriti#} (nach\n<ls>ŚAṂK.</ls> Vertauschung der Personen; <ab>viell.</ab> {#˚kzIditi#} zu lesen)\n<ls>CHĀND. UP. 4,1,2.</ls> {#prAdahan SaraRAnyanye prajAnAM jvalitolmukEH#}\n<ls>BHĀG. P. 7,2,15.</ls> {#na pAvakastvAM pradahizyati#}\n<ls>MBH. 1,2120.</ls> <ls n=\"MBH. 1,\">8362.</ls> {#pARqavAgnim — dIptaM pradahantamivAhitAn#}\n<ls n=\"MBH.\">4,1520.</ls> {#BImasenadavAgnestu mama putrAMstfRopamAn . praDakzyataH#} (so <ab>st.</ab> {#praDakzataH#} zu lesen)\n<ls n=\"MBH.\">7,5277.</ls> <ls n=\"MBH.\">1,1762.</ls> <ls n=\"MBH.\">5,678.</ls> <ls n=\"MBH.\">7,6092.</ls> <ls n=\"MBH.\">16,274.</ls> {#sarvARi mEnyAni ca vAsudevaH praDakzyate sAyakavahnijAlEH#}\n<ls n=\"MBH.\">3,10274.</ls> — <ls>HARIV. 11601.</ls> <ls n=\"HARIV.\">13888.</ls> {#mAM SokAgniH — praDakzyati#}\n<ls>R. 2,24,8.</ls> <ls n=\"R. 2,\">94,15.</ls>\n<ls>R. GORR. 2,25,6.</ls> {#tatkulaM pradahati#}\n<ls>BHĀG. P. 1,7,48.</ls> <ls n=\"BHĀG. P. 1,7,\">31.</ls> <ls n=\"BHĀG. P.\">4,4,2.</ls> <ls n=\"BHĀG. P.\">9,5,12.</ls> {#keliH pradahati majjAM#} (so zu lesen) {#SfNgAro 'sTIni#}"@de ;
