<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/dah/tr/dah_x7e__x7e_h0_x5f_11_x5f__x5f_a/1_x20__x28_corrigendum_x29_> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#A#} <ab>s.</ab> {#Adahana#} . Вм. {#prARAnAdagDvA#}\n<ls>PAÑCAT. I,392</ls> следует читать\n<ls>YĀJÑ. 1,340</ls> {#prARAnnAdagDvA#} . — <ab>caus.</ab> <ab>pass.</ab> {%сжигаться, обжигаться%}: {#sa yaTA tatra nAdAhyeta#}\n<ls>CHĀND. UP. 6,16,3.</ls> Ожидалось бы {#nAdahyeta#}."@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#A#} <ab>s.</ab> {#Adahana#} . Statt {#prARAnAdagDvA#}\n<ls>PAÑCAT. I,392</ls> ist mit\n<ls>YĀJÑ. 1,340</ls> {#prARAnnAdagDvA#} zu lesen. — <ab>caus.</ab> <ab>pass.</ab> {%sich verbrennen%}: {#sa yaTA tatra nAdAhyeta#}\n<ls>CHĀND. UP. 6,16,3.</ls> Man hätte {#nAdahyeta#} erwartet."@de ;
  pwglex:senseTag "1 (corrigendum)" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "reflexive sich verbrennen передано формой «сжигаться, обжигаться» — непереходное/возвратное значение, отличное от переходного «сжигать»."@ru ;
