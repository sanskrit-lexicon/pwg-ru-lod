  skos:definition "<div n=\"p\">— {#api#} {%поджигать, зажигать%} {#(agniH) zo\\qa\\Sa\\DA vf\\trasya^ Bo\\gAnapya^dahat#}\n<ls>TS. 2,1,4,6.</ls> {#pApmAnam#}\n<ls n=\"TS. 2,1,4,\">7.</ls> <ls>KĀṬH. 10,10. 21,8.</ls>"@ru ;
