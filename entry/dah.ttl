  pwglex:differentia "Основное значение каузатива/дезидератива/интенсива корня dah: пассивно-возвратное 'сгорать/гореть' (внешний огонь, ранение как 'жжение'), затем метафорический перенос на внутренний жар — 'изнывать, томиться' (ср. корпусные 'сжигаться/обжигаться' для этого возвратного круга значений, ветвь Vedic/Epic)."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
