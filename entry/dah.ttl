<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/dah/tr/dah_x7e__x7e_h0_x5f_17_x5f_pari/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#pari#} {%обжигать вокруг, охватывать жаром, сжигать%}: {#AgneyasvaBAvAtparidahati kaRWamuro hfdayaM ceti#}\n<ls>SUŚR. 1,155,21.</ls> {#kAsetsa pARquH paridahyamAnaH#}\n<ls n=\"SUŚR.\">2,503,1.</ls> {#dAvAgninA Sucivane paridahyamAne#}\n<ls>BHĀG. P. 2,7,29.</ls> {#gARqIvaM sraMsate hastAttvakcEva paridahyate#} {%горит, пылает%}\n<ls>BHAG. 1,30.</ls> {#diSi diSi paridagDA BUmayaH pAvakena#}\n<ls>ṚT. 1,24.</ls> {#saMhArakAle paridagDakAyA brahmARamAyAnti sadA prajA hi#}\n<ls>MBH. 12,10076.</ls>\n<ls>HARIV. 548.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#pari#} {%umbrennen, umglühen, verbrennen%}: {#AgneyasvaBAvAtparidahati kaRWamuro hfdayaM ceti#}\n<ls>SUŚR. 1,155,21.</ls> {#kAsetsa pARquH paridahyamAnaH#}\n<ls n=\"SUŚR.\">2,503,1.</ls> {#dAvAgninA Sucivane paridahyamAne#}\n<ls>BHĀG. P. 2,7,29.</ls> {#gARqIvaM sraMsate hastAttvakcEva paridahyate#} {%brennt, glüht%}\n<ls>BHAG. 1,30.</ls> {#diSi diSi paridagDA BUmayaH pAvakena#}\n<ls>ṚT. 1,24.</ls> {#saMhArakAle paridagDakAyA brahmARamAyAnti sadA prajA hi#}\n<ls>MBH. 12,10076.</ls>\n<ls>HARIV. 548.</ls>"@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "pari- = «вокруг»: umbrennen/umglühen переданы как «обжигать вокруг / охватывать жаром», сохраняя циркулярную семантику приставки, отличную от простого «сжигать» (третий член ряда)."@ru ;
