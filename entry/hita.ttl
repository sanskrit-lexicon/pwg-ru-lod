<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/hita/dict/koch/1> a ontolex:LexicalSense ;
  skos:definition "हित I /hita/ (pp. от धा ) 1. 1) поставленный 2) посаженный 3) находящийся в (Loc. ) 4) опрятный, аккуратный 5) благосклонный, добрый к (Dat., Loc, Gen., —о) 2. n. 1) добро 2) счастье, благо"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/hita/dict/koch/2> a ontolex:LexicalSense ;
  skos:definition "हित II /hita/ pp. от हि I"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/hita/dict/kna/3> a ontolex:LexicalSense ;
  skos:definition "हित\t/hita/\t\t/хита/\thita (pp. отъ dhā) порядочный, благопріятный, полезный, хорошій, добрый; — n. добро, благо.\tс. 286"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/hita/dict/fri/4> a ontolex:LexicalSense ;
  skos:definition "I hita (pp. < hi) ; посланный, приведенный в движение"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "fri" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/hita/dict/fri/5> a ontolex:LexicalSense ;
  skos:definition "II hita (pp. < I dhā) ; положенный, помещенный, подготовленный, установленный, подходящий, полезный, доброжелательный; n. благо, благодеяние, польза"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "fri" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/hita/dict/smirnov/6> a ontolex:LexicalSense ;
  skos:definition "(II-2) V, 25; VII, 22; XII, 4; XVI, 9; XVII, 15; XVIII, 64 (от dhā); прил. установленный, положенный, приятный, хороший; ср. р. хвала, благо, добро; с отрицанием враг, недруг и пр."@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "smirnov" .

