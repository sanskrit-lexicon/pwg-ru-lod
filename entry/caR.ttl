  skos:definition "<div n=\"p\">— <ab>intens.</ab> {%быстро двигаться, многократно двигаться, рыскать, обходить%}: {#ozWe^ ji\\hvA ca^rcarIti#}\n<ls>AV. 20,127,4.</ls> {#caYcUryate, caYcurIti, caYcUrti#}\n<ls>P. 7,4,87.</ls> <ls n=\"P. 7,4,\">88.</ls> <ls n=\"P.\">3,1,24</ls> ({#BAvagarhAyAm#}).\n<ls>VOP. 20,2.</ls> <ls n=\"VOP. 20,\">10.</ls> <ls n=\"VOP. 20,\">17.</ls> {#caYcUryete ramantO sma kiSorAviva caYcalO#}\n<ls>HARIV. 3481.</ls> {#caYcUrya#} (<ab>gerund.</ab>) {#girisAnuzu#}\n<ls>R. 4,29,22.</ls> {#caYcUryan#} <ab>partic.</ab>\n<ls>HARIV. 3602.</ls> {#yAnEH — caYcUryante sma sarvaSaH#}\n<ls>MBH. 1,7910.</ls> {#caYcUryante sma te vanam#}\n<ls>HARIV. 3726.</ls> {#BikzArTaM caYcUryante dvijErdiSaH#}\n<ls>MBH. 3,12850.</ls> {#caYcUryante#}\n(<ab>Sch.</ab>: = {#garhitaM caranti) 'Bito laNkAm#}\n<ls>BHAṬṬ. 18,25.</ls> {#prApya caYcUryamARAsO patIyantI raGUttamam#}\n<ls n=\"BHAṬṬ.\">4,19.</ls> <ab>Sch.</ab> : = {#garhitamAcarantI, garhitaM punaH punaScarantI#} {%извиваться и вращаться, дабы возбудить страсть мужчины.%}"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— <ab>intens.</ab> {%schnell sich bewegen, wiederholt sich bewegen, herumstreichen, durchstreichen%}: {#ozWe^ ji\\hvA ca^rcarIti#}\n<ls>AV. 20,127,4.</ls> {#caYcUryate, caYcurIti, caYcUrti#}\n<ls>P. 7,4,87.</ls> <ls n=\"P. 7,4,\">88.</ls> <ls n=\"P.\">3,1,24</ls> ({#BAvagarhAyAm#}).\n<ls>VOP. 20,2.</ls> <ls n=\"VOP. 20,\">10.</ls> <ls n=\"VOP. 20,\">17.</ls> {#caYcUryete ramantO sma kiSorAviva caYcalO#}\n<ls>HARIV. 3481.</ls> {#caYcUrya#} (<ab>gerund.</ab>) {#girisAnuzu#}\n<ls>R. 4,29,22.</ls> {#caYcUryan#} <ab>partic.</ab>\n<ls>HARIV. 3602.</ls> {#yAnEH — caYcUryante sma sarvaSaH#}\n<ls>MBH. 1,7910.</ls> {#caYcUryante sma te vanam#}\n<ls>HARIV. 3726.</ls> {#BikzArTaM caYcUryante dvijErdiSaH#}\n<ls>MBH. 3,12850.</ls> {#caYcUryante#}\n(<ab>Sch.</ab>: = {#garhitaM caranti) 'Bito laNkAm#}\n<ls>BHAṬṬ. 18,25.</ls> {#prApya caYcUryamARAsO patIyantI raGUttamam#}\n<ls n=\"BHAṬṬ.\">4,19.</ls> <ab>Sch.</ab> : = {#garhitamAcarantI, garhitaM punaH punaScarantI#} {%sich winden und drehen um des Mannes Leidenschaft zu erregen.%}"@de ;
