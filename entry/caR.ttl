  skos:definition "<div n=\"1\"> 1) {%двигаться, шевелиться, бродить, идти, ехать, странствовать%}; о людях, скоте, воде, кораблях, светилах <ab>u. s. w.</ab>: {#ya Aste\\ yaSca\\ cara^ti#}\n<ls>ṚV. 7,55,6.</ls> <ls n=\"ṚV.\">1,113,5.</ls> {#yasti^zWati\\ cara^ti#}\n<ls>AV. 4,16,2.</ls> <ls n=\"AV.\">7,108,2.</ls> {#de\\vAnA\\M spaSa^ i\\ha ye ca^ranti#}\n<ls>ṚV. 10,10,8.</ls> {#cara^nti\\ yanna\\dya^sta\\sTurApa^H#}\n<ls n=\"ṚV.\">5,47,5.</ls> {#nAva^H#}\n<ls n=\"ṚV.\">6,58,3.</ls> <ls>AV. 5,4,4.</ls> {#(didyut) kzma\\yA cara^ti#}\n<ls>ṚV. 7,46,3.</ls> <ls n=\"ṚV.\">9,41,3.</ls> {#Apo^ animi\\zaM cara^ntIH#}\n<ls n=\"ṚV.\">1,24,6.</ls> <ls n=\"ṚV. 1,\">61,12.</ls> {#vayA^Msi (antarikze)#}\n<ls>AV. 11,10,8.</ls> {#mf\\gAH (vane)#}\n<ls n=\"AV.\">12,1,49.</ls> {#gAva^H#}\n<ls>ṚV. 10,27,8.</ls>\n<ls>AV. 12,4,27.</ls> {#yadvirU\\pAca^ra\\M martye^zu#}\n<ls>ṚV. 10,95,16.</ls> {#sU\\ryA\\ca\\ndra\\masA^Bi\\cakze^ carato vitartu\\ram#}\n<ls n=\"ṚV.\">1,102,2.</ls> {#aDvAnam#}\n<ls n=\"ṚV. 1,\">113,3.</ls> {#cara^tpata\\tri#}\n<ls n=\"ṚV.\">3,54,8.</ls> {#cara^t Dru\\vam#}\n<ls n=\"ṚV.\">10,5,3.</ls> {#(vAyuH) yo de\\vAnA\\M cara^si prA\\RaTe^na#}\n<ls>VS. 11,39.</ls> {#UrDvABiSca tiraScIBiSca vidyudBirmahAhrAdAScaranti#}\n<ls>CHĀND. UP. 7,11,1.</ls> {#grAmeRa cacAra#}\n<ls>ŚAT. BR. 4,1,5,2.</ls> {#kimarTamacArIH#}\n<ls n=\"ŚAT. BR.\">14,6,10,1.</ls> {#yenEvArTena puruzaScarettaMhEva vadet#}\n<ls>CHĀND. UP. 5,11,6.</ls>\n[Page2-0953]\n{#indra iccarataH saKA . carEveti#}\n<ls>AIT. BR. 7,15.</ls> {#carAti carato BagaH#} <ab>ebend.</ab>\n<ls>KĀTY. ŚR. 8,6,38.</ls>\n<ls>ŚĀṄKH. ŚR. 14,50,4.</ls> {#sva\\sti te^ sUrya\\ cara^se\\#} (<ab>infin.</ab>) {#raTA^ya#}\n<ls>AV. 13,2,6.</ls>\n<ls>ṚV. 1,92,9.</ls> <ls n=\"ṚV.\">5,47,4.</ls> — {#kzitAvawasi rAjendra antarikze carAmyaham#}\n<ls>MBH. 1,3071.</ls> {#divA careyuH kAryArTaM cihnitA rAjaSAsanEH#}\n<ls>M. 10,55.</ls> {#stenAnAm — niBftaM caratAM kzitO#}\n<ls n=\"M.\">9,263.</ls> {#kaTamekA — carizyati vane#}\n<ls>MBH. 3,2355.</ls>