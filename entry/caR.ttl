  skos:definition "<div n=\"p\">— {#antar#} {%двигаться между, внутри%}: {#a\\ntardU\\to na roda^sI cara\\dvAk#}\n<ls>ṚV. 1,173,3.</ls> <ls n=\"ṚV.\">8,39,1.</ls> {#yayo^ra\\ntarhari\\Scara^t#}\n<ls n=\"ṚV.\">3,44,3.</ls> <ls n=\"ṚV. 3,\">55,8.</ls> <ls n=\"ṚV.\">1,95,10.</ls> <ls n=\"ṚV.\">6,27,7.</ls> <ls>AV. 11,4,20.</ls> <ls n=\"AV.\">13,1,40.</ls> {#candramAH sarvaBUtAnAmantaScarati sAkzivat#}\n<ls>MBH. 3,2989.</ls> {#sa ezo 'ntaScarate bahuDA jAyamAnaH#} {%он умножается внутри%} (<ab>vgl.</ab> <ab>simpl.</ab> <ab>u.</ab>\n3,b) <ls>MUṆḌ. UP. 2,2,6.</ls> {#pra\\jApa^tiScarati\\ garBe^ a\\ntaH#} {%находится во чреве матери%}\n<ls>VS. 31,19.</ls>"@ru ;
