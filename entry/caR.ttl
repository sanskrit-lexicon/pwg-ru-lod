<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/car/tr/car_x7e__x7e_h0_x5f_00_x5f_pwg01/4> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 4) {%жить, быть, находиться%}; употребляется о длительном состоянии и о подвижном или живом субъекте: {#aTa\\ SuzkA^syA cara#}\n<ls>AV. 6,139,2.</ls> {#a\\ga\\daSca^ra#}\n<ls n=\"AV.\">4,17,8.</ls> {#sa\\hasrA^yu\\H sukf^taScareyam#}\n<ls n=\"AV.\">17,1,27.</ls> {#sa idBo\\jo yo gf\\have\\ dadA\\tyanna^kAmAya\\ cara^te kf\\SAya^#}\n<ls>ṚV. 10,117,3.</ls> {#jA\\yAM ji^jYAse\\ mana^sA\\ cara^ntIm#}\n<ls>AV. 14,1,56.</ls> {#eka eva carennityam#}\n<ls>M. 6,42.</ls> {#tasmAccareTaH satataM kzamASIlo jitendriyaH#}\n<ls>MBH. 1,1734.</ls> {#svargaM prAptAScaranti sma devEH saha gatavyaTAH#}\n<ls n=\"MBH.\">3,1736.</ls> {#suKaM carati loke 'smin#}\n<ls>M. 2,163.</ls> {#svasti caranti#}\n<ls>BHĀG. P. 3,1,35.</ls> {%находиться, стоять, пребывать%} о светилах: {#ASlezAsu caran#}\n<ls>VARĀH. BṚH. S. 9,28.</ls> <ls n=\"VARĀH. BṚH. S.\">10,15.</ls> <ls n=\"VARĀH. BṚH. S. 10,\">18.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 4) {%leben, sein, sich befinden%}; von einem länger dauernden Zustande und von einem beweglichen oder lebenden Subjecte gebraucht: {#aTa\\ SuzkA^syA cara#}\n<ls>AV. 6,139,2.</ls> {#a\\ga\\daSca^ra#}\n<ls n=\"AV.\">4,17,8.</ls> {#sa\\hasrA^yu\\H sukf^taScareyam#}\n<ls n=\"AV.\">17,1,27.</ls> {#sa idBo\\jo yo gf\\have\\ dadA\\tyanna^kAmAya\\ cara^te kf\\SAya^#}\n<ls>ṚV. 10,117,3.</ls> {#jA\\yAM ji^jYAse\\ mana^sA\\ cara^ntIm#}\n<ls>AV. 14,1,56.</ls> {#eka eva carennityam#}\n<ls>M. 6,42.</ls> {#tasmAccareTaH satataM kzamASIlo jitendriyaH#}\n<ls>MBH. 1,1734.</ls> {#svargaM prAptAScaranti sma devEH saha gatavyaTAH#}\n<ls n=\"MBH.\">3,1736.</ls> {#suKaM carati loke 'smin#}\n<ls>M. 2,163.</ls> {#svasti caranti#}\n<ls>BHĀG. P. 3,1,35.</ls> {%sich befinden, stehen, sein%} von Gestirnen: {#ASlezAsu caran#}\n<ls>VARĀH. BṚH. S. 9,28.</ls> <ls n=\"VARĀH. BṚH. S.\">10,15.</ls> <ls n=\"VARĀH. BṚH. S. 10,\">18.</ls>"@de ;
  pwglex:senseTag "4" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«Жить» — о живых существах в длительном состоянии; «находиться» — о светилах и предметах; «прожить» (о периоде времени) — из корпусных данных."@ru ;
