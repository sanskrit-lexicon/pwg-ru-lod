  skos:definition "<div n=\"1\"> 1) {%заставлять бежать, обходить, пасти%}: {#yo (vaSAM) gozvacI^carat#}\n<ls>AV. 12,4,28.</ls> {#aSvam#}\n<ls>LĀṬY. 9,11,7.</ls>\n<ls>MBH. 14,2100.</ls>\n<ls>HARIV. 786.</ls> {#ceraturvatsayUTAni cArayantO#}\n<ls n=\"HARIV.\">3548.</ls> <ls n=\"HARIV.\">3172.</ls> <ls n=\"HARIV.\">3619.</ls> <ls n=\"HARIV.\">3729.</ls> <ls>R. 2,45,33.</ls> <ls>BHĀG. P. 3,2,27.</ls> <ls n=\"BHĀG. P. 3,2,\">29.</ls> {#nABaktaM cArayeccAram#} {%посылать%}\n<ls>MBH. 12,2705.</ls> {#sarvato dfzwiM cArayAmAsa#} {%давать взгляду блуждать повсюду%}\n<ls n=\"MBH.\">3,1498.</ls> <ls>R. 3,21,3.</ls> <ls n=\"R. 3,\">30,33.</ls> <ls n=\"R. 3,\">73,20.</ls> <ls n=\"R.\">4,51,37.</ls> <ls>BHĀG. P. 8,12,17.</ls> {#yErdvArEScArayannityaM paSyatyAtmAnamAtmani#} {%давать идти, отпускать%}\n<ls>MBH. 14,547.</ls> {%приводить в движение%}: {#krakacEScAritEH#}\n<ls>RĀJA-TAR. 4,653.</ls> {%заставлять обходить%}: {#(tam) cArayanti sma tAM purIm#}\n<ls>R. 5,49,14.</ls>\n<ls>MBH. 12,12663.</ls> {%прогонять%}: {#SakraM ca svarAjyAccArayAmAsa#}\n<ls n=\"MBH. 12,\">12944.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\"> 1) {%laufen —, herumgehen —, weiden lassen%}: {#yo (vaSAM) gozvacI^carat#}\n<ls>AV. 12,4,28.</ls> {#aSvam#}\n<ls>LĀṬY. 9,11,7.</ls>\n<ls>MBH. 14,2100.</ls>\n<ls>HARIV. 786.</ls> {#ceraturvatsayUTAni cArayantO#}\n<ls n=\"HARIV.\">3548.</ls> <ls n=\"HARIV.\">3172.</ls> <ls n=\"HARIV.\">3619.</ls> <ls n=\"HARIV.\">3729.</ls> <ls>R. 2,45,33.</ls> <ls>BHĀG. P. 3,2,27.</ls> <ls n=\"BHĀG. P. 3,2,\">29.</ls> {#nABaktaM cArayeccAram#} {%ausschicken%}\n<ls>MBH. 12,2705.</ls> {#sarvato dfzwiM cArayAmAsa#} {%das Auge überallhin gehen lassen%}\n<ls n=\"MBH.\">3,1498.</ls> <ls>R. 3,21,3.</ls> <ls n=\"R. 3,\">30,33.</ls> <ls n=\"R. 3,\">73,20.</ls> <ls n=\"R.\">4,51,37.</ls> <ls>BHĀG. P. 8,12,17.</ls> {#yErdvArEScArayannityaM paSyatyAtmAnamAtmani#} {%gehen lassen%}\n<ls>MBH. 14,547.</ls> {%in Bewegung setzen%}: {#krakacEScAritEH#}\n<ls>RĀJA-TAR. 4,653.</ls> {%durchwandern lassen%}: {#(tam) cArayanti sma tAM purIm#}\n<ls>R. 5,49,14.</ls>\n<ls>MBH. 12,12663.</ls> {%verjagen%}: {#SakraM ca svarAjyAccArayAmAsa#}\n<ls n=\"MBH. 12,\">12944.</ls>"@de ;
