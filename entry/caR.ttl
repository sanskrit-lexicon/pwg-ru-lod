  pwglex:sourceType "attested" ;
  pwglex:differentia "aufgehen / hervorgehen / sich erheben: triple synonym rendered as «восходить, исходить, подниматься» — восходить for celestial rising, исходить for emergence, подниматься for general ascent. ertönen = «звучать» (sound sub-sense within the same paragraph)."@ru ;
