  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Перифрастическая конструкция: глагол + причастие/прилагательное передаёт длящееся состояние или процесс; аналог вспомогательного глагола «быть» при длительном виде."@ru ;
