<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/car/tr/car_x7e__x7e_h0_x5f_52_x5f_anusam/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#anusam#}\n<div n=\"1\"> 1) следовать (за кем-л.), идти вдоль (чего-л.); посещать <ls>TS. 1,5,10,14.</ls> {#pf\\Ti\\vIm#} <ls>AV. 19,58,3.</ls> {#panTA^m#} <ls n=\"AV.\">18,3,4.</ls> {#paTyAm#} <ls>AIT. BR. 1,7.</ls> {#puRyAni tIrTARi nadIprasravaRAni#} <ls>MBH. 12,7002.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#anusam#}\n<div n=\"1\"> 1) {%nachfolgen, entlang gehen; besuchen%}\n<ls>TS. 1,5,10,14.</ls> {#pf\\Ti\\vIm#}\n<ls>AV. 19,58,3.</ls> {#panTA^m#}\n<ls n=\"AV.\">18,3,4.</ls> {#paTyAm#}\n<ls>AIT. BR. 1,7.</ls> {#puRyAni tIrTARi nadIprasravaRAni#}\n<ls>MBH. 12,7002.</ls>"@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«следовать» для nachfolgen (движение вслед за кем-л.), «идти вдоль» для entlang gehen (движение вдоль пути/русла), «посещать» для besuchen — три различных, но связанных действия, переданы отдельными глаголами по числу немецких синонимов."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-01T07:50:34Z"^^xsd:dateTime ;
  dct:references <https://w3id.org/sanskrit-lexicon/repwg/citation/AIT_x2e__x2d_BR_x2e__x2d_1_x2c_7_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/AV_x2e__x2d_18_x2c_3_x2c_4_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/AV_x2e__x2d_19_x2c_58_x2c_3_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/MBH_x2e__x2d_12_x2c_7002_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/TS_x2e__x2d_1_x2c_5_x2c_10_x2c_14_x2e_> ;
