  skos:definition "<div n=\"1\">— 4) {%вести себя, поступать%}: {#ahanyanuMcaredevam#}\n<ls>MBH. 3,1303. fg.</ls> {#anucarita#} <lex>n.</lex> {%образ жизни, происшествие, история%}: {#yasya kilAnucaritamupAkarRya#}\n<ls>BHĀG. P. 5,6,10.</ls> {#mahatAm#}\n<ls n=\"BHĀG. P.\">2,8,16.</ls> {#vaMSyAnucaritAni#}\n<ls n=\"BHĀG. P.\">3,7,25.</ls> {#avatArAnu˚#}\n<ls n=\"BHĀG. P.\">2,8,17.</ls> <ls n=\"BHĀG. P. 2,\">10,5.</ls> <ls n=\"BHĀG. P.\">8,23,30.</ls> — <ab>caus.</ab> {%заставить обойти —, объехать%}: {#evaMviDAnnfpo deSAngulmEH sTA varajaNgamEH . taskarapratizeDArTaM cArEScApyanucArayet ..#}\n<ls>M. 9,266.</ls> — <ab>intens.</ab>: {#a\\nu\\zwuBa\\manu^ carcU\\ryamA^Ra\\mindra\\M ni ci^kyuH ka\\vayo^ manI\\zAH#} {%поспешно направляться к (?%})\n<ls>ṚV. 10,124,9.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 4) {%sich verhalten, verfahren%}: {#ahanyanuMcaredevam#}\n<ls>MBH. 3,1303. fg.</ls> {#anucarita#} <lex>n.</lex> {%Wandel, Begebenheit, Geschichte%}: {#yasya kilAnucaritamupAkarRya#}\n<ls>BHĀG. P. 5,6,10.</ls> {#mahatAm#}\n<ls n=\"BHĀG. P.\">2,8,16.</ls> {#vaMSyAnucaritAni#}\n<ls n=\"BHĀG. P.\">3,7,25.</ls> {#avatArAnu˚#}\n<ls n=\"BHĀG. P.\">2,8,17.</ls> <ls n=\"BHĀG. P. 2,\">10,5.</ls> <ls n=\"BHĀG. P.\">8,23,30.</ls> — <ab>caus.</ab> {%durchwandern —, durchstreichen lassen%}: {#evaMviDAnnfpo deSAngulmEH sTA varajaNgamEH . taskarapratizeDArTaM cArEScApyanucArayet ..#}\n<ls>M. 9,266.</ls> — <ab>intens.</ab>: {#a\\nu\\zwuBa\\manu^ carcU\\ryamA^Ra\\mindra\\M ni ci^kyuH ka\\vayo^ manI\\zAH#} {%eilig zugehen auf (?%})\n<ls>ṚV. 10,124,9.</ls>"@de ;
