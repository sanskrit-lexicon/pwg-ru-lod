<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/car/tr/car_x7e__x7e_h0_x5f_23_x5f_up_x5f_a/2> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 2) {%быть готовым служить; подчиняться, покоряться%}: {#i\\ha tvA\\ BUryA ca^re\\dupa\\ tman#}\n<ls>ṚV. 4,4,9.</ls> {#mamedanu\\ kratu\\M pati^H sehA\\nAyA^ u\\pAca^ret#}\n<ls n=\"ṚV.\">10,159,2.</ls> {#upAcarati tatra sma DanAnAmISvaram#} {%служить, нести службу%}\n<ls>MBH. 2,408.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) {%dienstbereit sein; sich fügen%}: {#i\\ha tvA\\ BUryA ca^re\\dupa\\ tman#}\n<ls>ṚV. 4,4,9.</ls> {#mamedanu\\ kratu\\M pati^H sehA\\nAyA^ u\\pAca^ret#}\n<ls n=\"ṚV.\">10,159,2.</ls> {#upAcarati tatra sma DanAnAmISvaram#} {%Dienste thun%}\n<ls>MBH. 2,408.</ls>"@de ;
  pwglex:senseTag "2" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "не физическое перемещение, а социальная позиция услужения/покорности; «покоряться» vs «служить» — первое про подчинение воле, второе про исполнение обязанности, обе грани немецкого текста сохранены раздельно (запятая = взаимозаменяемые синонимы внутри одного значения)."@ru ;
