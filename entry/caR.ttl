  skos:definition "<div n=\"1\">— 2) подходить, чтобы прислуживать, помогать кому-либо, служить, прислуживать; с <ab>acc.</ab> лица: {#sa yo hEnaM SoBanenopacarati#}\n<ls>ŚAT. BR. 3,3,2,3.</ls> {#madantIBiH#}\n<ls n=\"ŚAT. BR. 3,\">4,3,10.</ls> {#yaTA copacaredenam#}\n<ls>M. 4,254.</ls>\n<ls>MBH. 1,4299.</ls> <ls n=\"MBH.\">3,14667.</ls>\n<ls>R. 1,9,69.</ls> {#upacIrRo gururmiTyA BavatA#}\n<ls>MBH. 7,9062.</ls> {#samamupacara Badre supriyaM vApriyaM vA#} (сказано публичной девушке)\n<ls>MṚCCH. 13,16. 120,23.</ls> {#yatnAdupacaryatAm#}\n<ls>ŚĀK. 43,12.</ls>\n<ls>RAGH. 5,62.</ls>\n<ls>KUMĀRAS. 1,61.</ls>\n<ls>DAŚAK. 59,8.</ls>\n<ls>BHĀG. P. 4,28,43.</ls> {#vidyADarIBirupacIrRavapuH#}\n<ls n=\"BHĀG. P.\">3,23,38.</ls> {#sa mocayitvA tAnaSvAnupacarya ca SAstrataH#}\n<ls>MBH. 3,2884.</ls> {#BartAram — upAcarat . upAyEH SvetakAkIyEH#}\n<ls n=\"MBH.\">1,1879.</ls> {#tatra dEvatakanyABirAsanenopacaryate#}\n<ls n=\"MBH.\">13,5284.</ls> {#kftrimasaMviDABiH#}\n<ls>RAGH. 14,17.</ls> {#snAnena BojanErvastrEH#}\n<ls>VID. 252.</ls> {#mitratvenopacaritasya#}\n<ls>DAŚAK.</ls> в <ls>BENF. Chr. 199,21.</ls> {#na yuktaM BavatAhamanftenopacaritum#}\n<ls>MBH. 1,769.</ls> {#anftenopacIrRo hi hanyAdeva#}\n<ls n=\"MBH.\">4,104.</ls> {#nikftyopacaranvaDyaH#}\n<ls n=\"MBH.\">3,467.</ls> <ab>med.</ab> <ls n=\"MBH.\">13,3037.</ls> <ls n=\"MBH. 13,\">3487.</ls> {#tErupacaryamARA hanyuH sametAnDftarAzwrasutAn#} поддерживаем\n<ls n=\"MBH.\">5,21.</ls> {#upacarita = varivasita#} <ab>u. s. w.</ab>\n<ls>AK. 3,2,51.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) {%hinzutreten um zu bedienen, Jmd an die Hand gehen, bedienen, aufwarten%}; mit dem <ab>acc.</ab> der Person: {#sa yo hEnaM SoBanenopacarati#}\n<ls>ŚAT. BR. 3,3,2,3.</ls> {#madantIBiH#}\n<ls n=\"ŚAT. BR. 3,\">4,3,10.</ls> {#yaTA copacaredenam#}\n<ls>M. 4,254.</ls>\n<ls>MBH. 1,4299.</ls> <ls n=\"MBH.\">3,14667.</ls>\n<ls>R. 1,9,69.</ls> {#upacIrRo gururmiTyA BavatA#}\n<ls>MBH. 7,9062.</ls> {#samamupacara Badre supriyaM vApriyaM vA#} (zu einem öffentlichen Mädchen gesprochen)\n<ls>MṚCCH. 13,16. 120,23.</ls> {#yatnAdupacaryatAm#}\n<ls>ŚĀK. 43,12.</ls>\n<ls>RAGH. 5,62.</ls>\n<ls>KUMĀRAS. 1,61.</ls>\n<ls>DAŚAK. 59,8.</ls>\n<ls>BHĀG. P. 4,28,43.</ls> {#vidyADarIBirupacIrRavapuH#}\n<ls n=\"BHĀG. P.\">3,23,38.</ls> {#sa mocayitvA tAnaSvAnupacarya ca SAstrataH#}\n<ls>MBH. 3,2884.</ls> {#BartAram — upAcarat . upAyEH SvetakAkIyEH#}\n<ls n=\"MBH.\">1,1879.</ls> {#tatra dEvatakanyABirAsanenopacaryate#}\n<ls n=\"MBH.\">13,5284.</ls> {#kftrimasaMviDABiH#}\n<ls>RAGH. 14,17.</ls> {#snAnena BojanErvastrEH#}\n<ls>VID. 252.</ls> {#mitratvenopacaritasya#}\n<ls>DAŚAK.</ls> in <ls>BENF. Chr. 199,21.</ls> {#na yuktaM BavatAhamanftenopacaritum#}\n<ls>MBH. 1,769.</ls> {#anftenopacIrRo hi hanyAdeva#}\n<ls n=\"MBH.\">4,104.</ls> {#nikftyopacaranvaDyaH#}\n<ls n=\"MBH.\">3,467.</ls> <ab>med.</ab> <ls n=\"MBH.\">13,3037.</ls> <ls n=\"MBH. 13,\">3487.</ls> {#tErupacaryamARA hanyuH sametAnDftarAzwrasutAn#} {%unterstützt%}\n<ls n=\"MBH.\">5,21.</ls> {#upacarita = varivasita#} <ab>u. s. w.</ab>\n<ls>AK. 3,2,51.</ls>"@de ;
