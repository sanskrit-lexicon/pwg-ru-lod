<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/car/tr/car_x7e__x7e_h0_x5f_23_x5f_up_x5f_a/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#upA#}\n<div n=\"1\"> 1) {%приходить, подходить (сюда)%}: {#upa^ naH pita\\vA ca^ra Si\\vaH Si\\vABi^rU\\tiBi^H#}\n<ls>ṚV. 1,187,3.</ls> <ls n=\"ṚV. 1,\">46,14.</ls> {#pratyaN#}\n<ls>ŚAT. BR. 2,1,4,19.</ls> <ls n=\"ŚAT. BR.\">4,2,4,22.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#upA#}\n<div n=\"1\"> 1) {%herbeikommen%}: {#upa^ naH pita\\vA ca^ra Si\\vaH Si\\vABi^rU\\tiBi^H#}\n<ls>ṚV. 1,187,3.</ls> <ls n=\"ṚV. 1,\">46,14.</ls> {#pratyaN#}\n<ls>ŚAT. BR. 2,1,4,19.</ls> <ls n=\"ŚAT. BR.\">4,2,4,22.</ls>"@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "прямое конкретное движение к говорящему/месту; из корпусного ряда — «идти», «двигаться» как ближайшие нейтральные соответствия, здесь сужены приставкой upa- до направленного 'подходить'."@ru ;
