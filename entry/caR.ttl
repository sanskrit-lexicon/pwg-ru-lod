  skos:definition "<div n=\"2\"> a) с <ab>instr.</ab> {%обращаться с чем-либо, заниматься чем-либо, обходиться с чем-либо%}: {#ya\\masya\\ yena^ ba\\linA\\ carA^mi#}\n<ls>AV. 6,117,1.</ls> {#aDe^nvA carati mA\\yayA^#}\n<ls>ṚV. 10,71,5.</ls> {#upAMSu vAcA carati#}, короче также без {#vAcA#}\n<ls>AIT. BR. 1,27.</ls>\n<ls>ŚAT. BR. 2,6,1,19.</ls> {#tira iva vE miTunena caryate#}\n<ls n=\"ŚAT. BR.\">1,9,2,5.</ls> {#yajYena#}\n<ls n=\"ŚAT. BR. 1,\">5,2,15.</ls> {#havizA#}\n<ls n=\"ŚAT. BR.\">11,1,8,4.</ls> {#yajurBiH#}\n<ls n=\"ŚAT. BR.\">4,6,9,20.</ls> {#ftugrahEH#}\n<ls n=\"ŚAT. BR. 4,\">3,1,3.</ls> {#vapayA#}\n<ls n=\"ŚAT. BR.\">3,8,2,29.</ls> <ls n=\"ŚAT. BR. 3,8,\">5,11.</ls> <ls>KĀTY. ŚR. 3,3,10.</ls> <ls n=\"KĀTY. ŚR.\">4,4,11.</ls> <ls n=\"KĀTY. ŚR.\">10,6,7.</ls> <ls>ĀŚV. GṚHY. 1. 11.</ls> {#caratAM niyamenEva#} {%тех, кто упражняет самообуздание%}\n<ls>R. 2,28,15.</ls> {#sa yatrEtatsvapnyayA carati#} {%пребывать во сне%}\n<ls>ŚAT. BR. 14,5,1,19.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"2\"> a) mit einem <ab>instr.</ab> {%mit Etwas verfahren, sich zu thun machen, Etwas behandeln%}: {#ya\\masya\\ yena^ ba\\linA\\ carA^mi#}\n<ls>AV. 6,117,1.</ls> {#aDe^nvA carati mA\\yayA^#}\n<ls>ṚV. 10,71,5.</ls> {#upAMSu vAcA carati#}, kürzer auch ohne {#vAcA#}\n<ls>AIT. BR. 1,27.</ls>\n<ls>ŚAT. BR. 2,6,1,19.</ls> {#tira iva vE miTunena caryate#}\n<ls n=\"ŚAT. BR.\">1,9,2,5.</ls> {#yajYena#}\n<ls n=\"ŚAT. BR. 1,\">5,2,15.</ls> {#havizA#}\n<ls n=\"ŚAT. BR.\">11,1,8,4.</ls> {#yajurBiH#}\n<ls n=\"ŚAT. BR.\">4,6,9,20.</ls> {#ftugrahEH#}\n<ls n=\"ŚAT. BR. 4,\">3,1,3.</ls> {#vapayA#}\n<ls n=\"ŚAT. BR.\">3,8,2,29.</ls> <ls n=\"ŚAT. BR. 3,8,\">5,11.</ls> <ls>KĀTY. ŚR. 3,3,10.</ls> <ls n=\"KĀTY. ŚR.\">4,4,11.</ls> <ls n=\"KĀTY. ŚR.\">10,6,7.</ls> <ls>ĀŚV. GṚHY. 1. 11.</ls> {#caratAM niyamenEva#} {%derer die Selbstbezähmung üben%}\n<ls>R. 2,28,15.</ls> {#sa yatrEtatsvapnyayA carati#} {%sich im Schlafe befinden%}\n<ls>ŚAT. BR. 14,5,1,19.</ls>"@de ;
