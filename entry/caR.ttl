<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/car/tr/car_x7e__x7e_h0_x5f_52_x5f_anusam/3> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 3) распространяться через что-л., — вплоть до, пронизывать; проходить насквозь: {#rohi^to raSmiBi\\rBUmi^M samu\\dramanu\\ saM ca^rat#} <ls>AV. 13,2,40.</ls> {#prARaH sarvARyaNgAnyanu saMcarati#} <ls>ŚAT. BR. 1,3,2,3.</ls> <ls n=\"ŚAT. BR.\">12,7,3,22.</ls> {#(puruzaH) kasya kAmAya SarIramanu saMcaret#} <ls n=\"ŚAT. BR.\">14,7,2,16.</ls> <ls n=\"ŚAT. BR.\">2,3,2,3.</ls> {%солнце%} {#imAM lokAMstantramivAnusaMcarati#} <ls n=\"ŚAT. BR.\">14,2,2,22.</ls> {#ye (sarpAH) divaM devImanusaMcaranti#} <ls>TBR. 3,1,1,7.</ls> {#imA~llokAnkAmAnnI kAmarUpyanusaMcaran#} <ls>TAITT. UP. 3,10,5.</ls> {#uBO lokO#} <ls>BṚH. ĀR. UP. 4,3,7.</ls> {#deSAnanusaMcarAmo vanAni ca kfcCrARi#} <ls>MBH. 3,1366.</ls> {#pfTivImanvasaMcarat#} (с переставленным augment'ом) <ls n=\"MBH.\">1,5515.</ls> {#yaTA mahAmatsya uBe kUle anusaMcarati#} {%простирается от одного берега до другого%} <ls>ŚAT. BR. 14,7,1,18.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3) {%sich verbreiten durch Etwas hin, — bis zu, durchdringen; durchwandern%}: {#rohi^to raSmiBi\\rBUmi^M samu\\dramanu\\ saM ca^rat#}\n<ls>AV. 13,2,40.</ls> {#prARaH sarvARyaNgAnyanu saMcarati#}\n<ls>ŚAT. BR. 1,3,2,3.</ls> <ls n=\"ŚAT. BR.\">12,7,3,22.</ls> {#(puruzaH) kasya kAmAya SarIramanu saMcaret#}\n<ls n=\"ŚAT. BR.\">14,7,2,16.</ls> <ls n=\"ŚAT. BR.\">2,3,2,3.</ls> {%die Sonne%} {#imAM lokAMstantramivAnusaMcarati#}\n<ls n=\"ŚAT. BR.\">14,2,2,22.</ls> {#ye (sarpAH) divaM devImanusaMcaranti#}\n<ls>TBR. 3,1,1,7.</ls> {#imA~llokAnkAmAnnI kAmarUpyanusaMcaran#}\n<ls>TAITT. UP. 3,10,5.</ls> {#uBO lokO#}\n<ls>BṚH. ĀR. UP. 4,3,7.</ls> {#deSAnanusaMcarAmo vanAni ca kfcCrARi#}\n<ls>MBH. 3,1366.</ls> {#pfTivImanvasaMcarat#} (mit versetztem Augment)\n<ls n=\"MBH.\">1,5515.</ls> {#yaTA mahAmatsya uBe kUle anusaMcarati#} {%von einem Ufer zum andern reicht%}\n<ls>ŚAT. BR. 14,7,1,18.</ls>"@de ;
  pwglex:senseTag "3" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«распространяться через» = sich verbreiten durch Etwas hin, «пронизывать» = durchdringen, «проходить насквозь» = durchwandern — три оттенка пространственного охвата, сохранены по числу немецких глаголов; «с переставленным augment'ом» — грамматическое примечание сохранено как есть."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
