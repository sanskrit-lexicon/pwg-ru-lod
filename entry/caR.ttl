  skos:definition "<div n=\"p\">— {#nyava#} {%проникать, вторгаться%}: {#pu\\rURi^ baBro\\ ni ca^ranti\\ mAmava^#}\n<ls>ṚV. 9,107,19.</ls>"@ru ;
