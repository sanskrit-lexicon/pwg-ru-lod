  skos:definition "<div n=\"p\">— {#ud#}\n<div n=\"1\"> 1) восходить, исходить, подниматься; о солнце\n<ls>ṚV. 4,25,4.</ls> <ls n=\"ṚV.\">7,66,16.</ls> <ls n=\"ṚV.\">10,37,5.</ls>\n<ls>VS. 36,24.</ls>\n<ls>AV. 11,4,21.</ls> {#a\\jarA^ iDA\\nAH#}\n<ls>ṚV. 7,3,3.</ls> <ls n=\"ṚV.\">8,40,8.</ls> {#U\\rDvo bi\\nduruda^carat#}\n<ls>AV. 10,10,19.</ls> {#vAzpaH, DUma uccarati#}\n<ls>P. 1,3,53</ls>, <ab>Sch.</ab>\n<ls>VOP. 23,45.</ls> {#yEzA hfdayAdUrDvaM nAqyuccarati#}\n<ls>ŚAT. BR. 14,6,11,3.</ls> {#sOdAminImuccarantIM yaTEva#}\n<ls>MBH. 3,10088.</ls> подниматься так <ab>v. a.</ab> звучать: {#vAk#}\n<ls>ŚAT. BR. 14,7,1,5.</ls> {#divyastUryaDvanirudacarat#}\n<ls>RAGH. 16,87.</ls> <ls n=\"RAGH.\">9,73.</ls> {#aSvatTatarostasmAduccacAra sarasvatI#}\n<ls>KATHĀS. 20,32.</ls>\n<ls>VID. 114.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#ud#}\n<div n=\"1\"> 1) {%aufgehen, hervorgehen, sich erheben%}; von der Sonne\n<ls>ṚV. 4,25,4.</ls> <ls n=\"ṚV.\">7,66,16.</ls> <ls n=\"ṚV.\">10,37,5.</ls>\n<ls>VS. 36,24.</ls>\n<ls>AV. 11,4,21.</ls> {#a\\jarA^ iDA\\nAH#}\n<ls>ṚV. 7,3,3.</ls> <ls n=\"ṚV.\">8,40,8.</ls> {#U\\rDvo bi\\nduruda^carat#}\n<ls>AV. 10,10,19.</ls> {#vAzpaH, DUma uccarati#}\n<ls>P. 1,3,53</ls>, <ab>Sch.</ab>\n<ls>VOP. 23,45.</ls> {#yEzA hfdayAdUrDvaM nAqyuccarati#}\n<ls>ŚAT. BR. 14,6,11,3.</ls> {#sOdAminImuccarantIM yaTEva#}\n<ls>MBH. 3,10088.</ls> {%sich erheben%} so <ab>v. a.</ab> {%ertönen%}: {#vAk#}\n<ls>ŚAT. BR. 14,7,1,5.</ls> {#divyastUryaDvanirudacarat#}\n<ls>RAGH. 16,87.</ls> <ls n=\"RAGH.\">9,73.</ls> {#aSvatTatarostasmAduccacAra sarasvatI#}\n<ls>KATHĀS. 20,32.</ls>\n<ls>VID. 114.</ls>"@de ;
