<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/car/tr/car_x7e__x7e_h0_x5f_52_x5f_anusam/2> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 2) {%идти навстречу (чему-л.), устремляться (к чему-л.)%}: {#sa\\mA\\naM yoni\\manu\\ saM ca^rete#} <ls>AV. 8,9,12.</ls> <ls>ṚV. 3,33,4.</ls> <ls n=\"ṚV.\">10,17,1.</ls> {#sa e\\tAmU\\timanu\\ sama^ca\\radyadveRo^H suzi\\ram#} <ls>TS. 5,1,1,4.</ls> {#vA\\tA\\gram#} <ls n=\"TS.\">1,7,7,2.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) {%zugehen auf, zustreben%}: {#sa\\mA\\naM yoni\\manu\\ saM ca^rete#}\n<ls>AV. 8,9,12.</ls>\n<ls>ṚV. 3,33,4.</ls> <ls n=\"ṚV.\">10,17,1.</ls> {#sa e\\tAmU\\timanu\\ sama^ca\\radyadveRo^H suzi\\ram#}\n<ls>TS. 5,1,1,4.</ls> {#vA\\tA\\gram#}\n<ls n=\"TS.\">1,7,7,2.</ls>"@de ;
  pwglex:senseTag "2" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«идти навстречу» = zugehen auf (направленное приближение), «устремляться» = zustreben (целенаправленное стремление) — сохранены оба оттенка синонимической пары."@ru ;
