<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/car/tr/car_x7e__x7e_h0_x5f_52_x5f_anusam/5> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 5) {%блуждать, скитаться%}: {#pfTivyAmanusaMcaranti#} <ls>MBH. 1,3606.</ls> — <ab>caus.</ab> {%переходить в, становиться (чем-л.)%}: {#tAMScAnusaMcArya (tAn#} <ab>d. i.</ab> {#devAn#}) <ls>MBH. 12,11208.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 5) {%herumirren%}: {#pfTivyAmanusaMcaranti#}\n<ls>MBH. 1,3606.</ls> — <ab>caus.</ab> {%übergehen in, werden zu%}: {#tAMScAnusaMcArya (tAn#} <ab>d. i.</ab> {#devAn#})\n<ls>MBH. 12,11208.</ls>"@de ;
  pwglex:senseTag "5" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "explanatory" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«блуждать/скитаться» — синонимическая пара для herumirren (беспорядочное движение без цели), по образцу корпусных кандидатов «бродить, скитаться»; вторая часть примечания повторяет формулу сенса 4 (übergehen in), поэтому переведена тем же оборотом «переходить в», плюс «становиться (чем-л.)» для werden zu."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-07-01T07:50:34Z"^^xsd:dateTime ;
  dct:references <https://w3id.org/sanskrit-lexicon/repwg/citation/MBH_x2e__x2d_12_x2c_11208_x2e_>, <https://w3id.org/sanskrit-lexicon/repwg/citation/MBH_x2e__x2d_1_x2c_3606_x2e_> ;
