<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/car/tr/car_x7e__x7e_h0_x5f_00_x5f_pwg01/3b> a ontolex:LexicalSense ;
  skos:definition "<div n=\"2\">— b) с <ab>partic.</ab>, иногда также с <ab>absolut.</ab> описательно; преимущественно о длящемся действии или состоянии: {#te nA^kapA\\laSca^rati vici\\nvan = vicinoti#}\n<ls>AV. 10,8,12.</ls> {#a\\gnAva\\gniSca^rati\\ pravi^zwaH#} <is>Agni</is> {%содержится в огне, заключено в <ab>d.</ab> F.%}\n<ls n=\"AV.\">4,39,9.</ls> <ls n=\"AV.\">3,10,4.</ls> <ls>VS. 2,30.</ls> <ls>TBR. 2,7,15,1.</ls> {#ye da\\syava^H pi\\tfzu\\ pravi^zwA jYA\\timu^KA ahu\\tAda\\Scara^nti#}\n[Page2-0954]\n<ls>AV. 18,2,28.</ls> {#eko^ vf\\trA ca^rasi ji\\GnamA^naH#}\n<ls>ṚV. 3,30,4.</ls> (<ls>TS. 2,4,13,1.</ls>) {#A\\mA pa\\kvaM ca^rati\\ biBra^tI gOH = biBarti#}\n<ls n=\"ṚV. 3,30,\">14.</ls> {#stomA^MScaranti suma\\tIri^yA\\nAH#}\n<ls n=\"ṚV.\">10,47,7.</ls> {#BizajyantO ceratuH#}\n<ls>ŚAT. BR. 4,1,5,8.</ls> {#te 'rcantaH SrAmyantaSceruH#}\n<ls n=\"ŚAT. BR.\">1,6,2,3.</ls> <ls n=\"ŚAT. BR.\">3,5,2,8.</ls> <ls n=\"ŚAT. BR.\">5,1,1,1.</ls> {#ja\\vo yaste^ vAji\\nnihi^to\\ guhA\\ yaH Sye\\ne parI^tto\\ aca^racca\\ vAte^#}\n<ls>VS. 9,9.</ls>\n<ls>ṚV. 3,38,4.</ls> <ls n=\"ṚV. 3,\">48,3.</ls> <ls n=\"ṚV. 3,\">54,2.</ls>\n<ls>AV. 11,5,1.</ls> <ls n=\"AV.\">12,4,37.</ls> {#i\\me ta^ indra\\ te va\\yaM ye tvA\\raBya\\ carA^masi#} {%мы те%}, <is>Indra</is>, {%Твои, кто неизменно держится Тебя%},\n<ls>ṚV. 1,57,4.</ls> {#meDA^yA\\tmAna^mA\\raBya^ carati\\ yo dI^kzi\\taH#}\n<ls>TS. 6,1,11,6.</ls> {#ceraturvatsayUTAni cArayantO#}\n<ls>HARIV. 3548.</ls> {#vihAya kAmAnyaH sarvAnpumAMScarati niHspfhaH#}\n<ls>BHAG. 2,71.</ls> {#sa svAminamavajYAya carecca niravagrahaH#}\n<ls>HIT. II,94.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"2\">— b) mit einem <ab>partic.</ab>, zuweilen auch mit einem <ab>absolut.</ab> umschreibend; meist von einer anhaltenden Thätigkeit oder einem solchen Zustande: {#te nA^kapA\\laSca^rati vici\\nvan = vicinoti#}\n<ls>AV. 10,8,12.</ls> {#a\\gnAva\\gniSca^rati\\ pravi^zwaH#} <is>Agni</is> {%steckt in dem Feuer, ist enthalten in <ab>d.</ab> F.%}\n<ls n=\"AV.\">4,39,9.</ls> <ls n=\"AV.\">3,10,4.</ls> <ls>VS. 2,30.</ls> <ls>TBR. 2,7,15,1.</ls> {#ye da\\syava^H pi\\tfzu\\ pravi^zwA jYA\\timu^KA ahu\\tAda\\Scara^nti#}\n[Page2-0954]\n<ls>AV. 18,2,28.</ls> {#eko^ vf\\trA ca^rasi ji\\GnamA^naH#}\n<ls>ṚV. 3,30,4.</ls> (<ls>TS. 2,4,13,1.</ls>) {#A\\mA pa\\kvaM ca^rati\\ biBra^tI gOH = biBarti#}\n<ls n=\"ṚV. 3,30,\">14.</ls> {#stomA^MScaranti suma\\tIri^yA\\nAH#}\n<ls n=\"ṚV.\">10,47,7.</ls> {#BizajyantO ceratuH#}\n<ls>ŚAT. BR. 4,1,5,8.</ls> {#te 'rcantaH SrAmyantaSceruH#}\n<ls n=\"ŚAT. BR.\">1,6,2,3.</ls> <ls n=\"ŚAT. BR.\">3,5,2,8.</ls> <ls n=\"ŚAT. BR.\">5,1,1,1.</ls> {#ja\\vo yaste^ vAji\\nnihi^to\\ guhA\\ yaH Sye\\ne parI^tto\\ aca^racca\\ vAte^#}\n<ls>VS. 9,9.</ls>\n<ls>ṚV. 3,38,4.</ls> <ls n=\"ṚV. 3,\">48,3.</ls> <ls n=\"ṚV. 3,\">54,2.</ls>\n<ls>AV. 11,5,1.</ls> <ls n=\"AV.\">12,4,37.</ls> {#i\\me ta^ indra\\ te va\\yaM ye tvA\\raBya\\ carA^masi#} {%wir sind es%}, <is>Indra</is>, {%die Deinen, die stets an Dich sich halten%},\n<ls>ṚV. 1,57,4.</ls> {#meDA^yA\\tmAna^mA\\raBya^ carati\\ yo dI^kzi\\taH#}\n<ls>TS. 6,1,11,6.</ls> {#ceraturvatsayUTAni cArayantO#}\n<ls>HARIV. 3548.</ls> {#vihAya kAmAnyaH sarvAnpumAMScarati niHspfhaH#}\n<ls>BHAG. 2,71.</ls> {#sa svAminamavajYAya carecca niravagrahaH#}\n<ls>HIT. II,94.</ls>"@de ;
  pwglex:senseTag "3b" ;
