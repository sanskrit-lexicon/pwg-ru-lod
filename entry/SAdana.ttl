<https://w3id.org/sanskrit-lexicon/repwg/entry/sADana> a ontolex:LexicalEntry ;
  rdfs:label "sādhana"@sa-Latn ;
  dct:isPartOf <https://w3id.org/sanskrit-lexicon/repwg/lexicon/pwg-ru> ;
  ontolex:canonicalForm <https://w3id.org/sanskrit-lexicon/repwg/lemma/sADana> ;
