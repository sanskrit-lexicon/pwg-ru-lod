  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/DI-3/dict/koch/2> a ontolex:LexicalSense ;
  skos:definition "धी II /dhī/ см. ध्या I"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/DI-3/dict/koch/3> a ontolex:LexicalSense ;
  skos:definition "धी III /dhī/ f. 1) мысль 2) взгляд 3) мнение 4) представление, понятие 5) ум, разум 6) знание 7) искусство 8) молитва 9) (—o) склонный к"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/DI-3/dict/kna/4> a ontolex:LexicalSense ;
  skos:definition "धी\t/dhī/\t/dhI/\t/дхи/\tdhī f. мысль, религіозное размышленіе, благоговѣніе, молитва.\tс. 233"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/DI-3/dict/fri/5> a ontolex:LexicalSense ;
  skos:definition "II dhī f.; мысль, размышление, молитва, песнопение, гимн, мышление, мудрость"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "fri" .

