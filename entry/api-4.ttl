<https://w3id.org/sanskrit-lexicon/repwg/entry/api-4> a ontolex:LexicalEntry ;
  rdfs:label "api"@sa-Latn ;
  dct:isPartOf <https://w3id.org/sanskrit-lexicon/repwg/lexicon/pwg-ru> ;
  ontolex:canonicalForm <https://w3id.org/sanskrit-lexicon/repwg/lemma/api> ;
  ontolex:sense <https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/koch/1>, <https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/kna/2>, <https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/fri/3>, <https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/fri/4>, <https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/smirnov/5> .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/koch/1> a ontolex:LexicalSense ;
  skos:definition "अपि° /api-/ 1. pref. с гл. выраж- положение вблизи или над чём-л., достижение чего-л., напр. अपिधा вкладывать- अपिबन्ध् привязывать 2. adv. 1) также, тоже 2) далее 3) даже 4) но, однако 5) после числ. все 3. в начале предлож. не... ли?, а может быть? 4. с местоим. и нареч. выступает как эмфатич. частица: अद्यापि как раз сегодня- ~ च, चापि далее- впредь- ये ऽपि. . . ते ऽपि также те, которые- वपि, ~ वा или также- или даже- न. . . नापि ни ... ни- ~ नाम (в начале предлож.) может быть, вероятно- यद्यपि если и, хотя- तथापि однако, всё-таки, тем не менее"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/kna/2> a ontolex:LexicalSense ;
  skos:definition "अपि\t/api/\t\t/апи/\tapi также, и, даже, же, далѣе;хотя; иногда совсѣмъ не переводится; pron. interr. съ api = indef.; — арі са далѣе, также; api nāma (въ нач. предложенія съ opt.) 169, 7 (съ послѣдующ. athavā однако) не .. ли? а можетъ быть ? — [ἐπί, ἐπι].\tс. 198"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/fri/3> a ontolex:LexicalSense ;
  skos:definition "api pcl., adv.; и, тоже, дальше, право, только; (арi часто употребляется в качестве эмфатической частицы, иногда выражает сомнение или неуверенность; в начале предложения может выступать в значении вопросительной частицы)"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "fri" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/fri/4> a ontolex:LexicalSense ;
  skos:definition "+api prep. + loc.; у, в"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "fri" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/api-4/dict/smirnov/5> a ontolex:LexicalSense ;
  skos:definition "(II-2) предл., нар. также, и, даже, далее, хотя; иногда совсем не переводится; api+cet если даже (IV, 36; IX, 30)."@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "smirnov" .

