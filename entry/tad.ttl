<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/tad/dict/koch/1> a ontolex:LexicalSense ;
  skos:definition "तद् I /tad/ pron. 1) Nm., Acc. sg. n. от त II - 2) (—о) заменяет местоим. 3 sg. - तद् . . . ~ тот... другой"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
