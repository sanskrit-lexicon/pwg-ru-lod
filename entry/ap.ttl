  skos:definition "<div n=\"p\">— {#pra#}\n<div n=\"1\"> 1) {%достигать, настигать; прибывать в какое-либо место; наталкиваться на кого-либо%} или {%что-либо, встречать кого-либо%} или {%что-либо%}: {#memaM prApa^t (vaDaH)#}\n<ls>AV. 1,30,1.</ls> <ls n=\"AV.\">17,1,28.</ls> <ls n=\"AV. 17,1,\">29.</ls> {#nEna\\M prApno^ti Sa\\paTa^H#}\n<ls n=\"AV.\">4,9,4.</ls> <ls n=\"AV.\">11,1,22.</ls> <ls n=\"AV.\">12,3,45.</ls> {#yadodaramannaM prApnoti#}\n<ls>ŚAT. BR. 8,6,2,13.</ls> {#yo vA anUcAno 'nUcAno 'nUktenEnAnprApnuyAt#}\n<ls n=\"ŚAT. BR.\">4,5,6,5.</ls> <ls n=\"ŚAT. BR.\">5,5,3,1.</ls> <ls n=\"ŚAT. BR.\">12,5,2,9. fgg.</ls> {#yaTo vAco nivartante . aprApya#} (<ab>sc.</ab> {#brahma) manasA saha . AnandaM brahmaRo vidvAn#}\n<ls>TAITT. UP. 2,9.</ls> {#prApa hAcAryakulam#}\n<ls>CHĀND. UP. 4,9,1.</ls> {#aprApya devAn#}\n<ls>BṚH. ĀR. UP. 8,9,1.</ls> {#yaTA mahAhradaM prApya kziptaM lozwaM vinaSyati#}\n<ls>M. 11,263.</ls> {#dAruRAmawavIM prApya#}\n<ls>N. 12,7.</ls> {#ASramaM tamahaM prApa#}\n<ls>DAŚ. 2,3.</ls> {#prApya godAvarIM nadIm#}\n<ls>R. 3,22,37.</ls> <ls n=\"R.\">1,1,86</ls> <ls n=\"R.\">2,54,8.</ls>\n<ls>ŚĀK. 55,21.</ls>\n<ls>RAGH. 1,48.</ls>\n<ls>VID. 81.</ls> <ls n=\"VID.\">186.</ls> <ls n=\"VID.\">223.</ls> <ls n=\"VID.\">246.</ls> <ls n=\"VID.\">282.</ls> {#aprApya nadIM parvataH#} {%гора по эту сторону реки%}\n<ls>P. 3,4,20</ls>, <ab>Sch.</ab>\n{#prApya Baratam#}\n<ls>R. 1,77,20.</ls>\n<ls>VID. 25.</ls> <ls n=\"VID.\">100.</ls>\n<ls>BHAṬṬ. 5,96.</ls> {#diSaH prApan#} {%они бежали во все стороны%}\n<ls>BHAṬṬ. 15,70.</ls> {#tena sa ca kawvervArO yaTApakve maDuraH sanraso 'pi na . prApyate#} ({%встречается, находится%}) {#hi#}\n<ls>YĀJÑ. 3,142.</ls> {#prApi mahAgiriH#}\n<ls>BHAṬṬ. 15,106.</ls>"@ru ;
