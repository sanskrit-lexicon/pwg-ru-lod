  skos:definition "<div n=\"p\">— {#saMpra#}\n<div n=\"1\"> 1) {%достигать, доходить до, встречать, наталкиваться на%}: {#etadvA etABirdevA AtaH saMprApnuvan#}\n<ls>ŚAT. BR. 9,2,3,13.</ls> <ls n=\"ŚAT. BR. 9,2,3,\">23.</ls> <ls n=\"ŚAT. BR. 9,2,3,\">29.</ls> {#saMprApyEnam (AtmAnam)#}\n<ls>MUṆḌ. UP. 3,2,5.</ls> {#pfzatkAH saMprApuH — Saravyam#}\n<ls>RAGH. 7,42.</ls> {#BaradvAjasya saMprApadASramam#}\n<ls>R. 6,109,1.</ls> {#pAraM saMprApa vidyAnAm#}\n<ls>KATHĀS. 2,2.</ls> <ls n=\"KATHĀS.\">20,39.</ls> {#jIvansaMprApsyasi kzmAntam#}\n<ls>PAÑCAT. III,49.</ls> <ls>VID. 23.</ls> {#saMprApTA vinayena#}\n<ls>BHAṬṬ. 6,68.</ls> {#saMprApta#} с <ab>pass.</ab> <ab>Bed.</ab>: {#vfdDavyAGreRa saMprAptaH paTiko sa mfto yaTA#}\n<ls>HIT. I,4.</ls> {#yo 'pi me#} ({%мной%}) {#nirjane 'raRye saMprApto 'yaM janArRavaH#}\n<ls>N. 13,16.</ls> {#asaMprApte karmaRi#} {%если объект не достигнут%}\n<ls>P. 2,3,12</ls>, <is>Vārtt</is>. 3. с <ab>act.</ab> <ab>Bed.</ab>: {#saMprApto 'haM tamASramam#}\n<ls>R. 3,42,6.</ls> <ls n=\"R. 3,\">18,2.</ls>\n<ls>MBH. 3,2852.</ls> {#tvaksaMprApta#} {%распространяющийся по коже%}\n<ls>SUŚR. 2,64,8.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#saMpra#}\n<div n=\"1\"> 1) {%erreichen, gelangen zu, antreffen%}: {#etadvA etABirdevA AtaH saMprApnuvan#}\n<ls>ŚAT. BR. 9,2,3,13.</ls> <ls n=\"ŚAT. BR. 9,2,3,\">23.</ls> <ls n=\"ŚAT. BR. 9,2,3,\">29.</ls> {#saMprApyEnam (AtmAnam)#}\n<ls>MUṆḌ. UP. 3,2,5.</ls> {#pfzatkAH saMprApuH — Saravyam#}\n<ls>RAGH. 7,42.</ls> {#BaradvAjasya saMprApadASramam#}\n<ls>R. 6,109,1.</ls> {#pAraM saMprApa vidyAnAm#}\n<ls>KATHĀS. 2,2.</ls> <ls n=\"KATHĀS.\">20,39.</ls> {#jIvansaMprApsyasi kzmAntam#}\n<ls>PAÑCAT. III,49.</ls> <ls>VID. 23.</ls> {#saMprApTA vinayena#}\n<ls>BHAṬṬ. 6,68.</ls> {#saMprApta#} mit <ab>pass.</ab> <ab>Bed.</ab>: {#vfdDavyAGreRa saMprAptaH paTiko sa mfto yaTA#}\n<ls>HIT. I,4.</ls> {#yo 'pi me#} ({%von mir%}) {#nirjane 'raRye saMprApto 'yaM janArRavaH#}\n<ls>N. 13,16.</ls> {#asaMprApte karmaRi#} {%wenn das Object nicht erreicht ist%}\n<ls>P. 2,3,12</ls>, <is>Vārtt</is>. 3. mit <ab>act.</ab> <ab>Bed.</ab>: {#saMprApto 'haM tamASramam#}\n<ls>R. 3,42,6.</ls> <ls n=\"R. 3,\">18,2.</ls>\n<ls>MBH. 3,2852.</ls> {#tvaksaMprApta#} {%sich auf die Haut erstreckend%}\n<ls>SUŚR. 2,64,8.</ls>"@de ;
