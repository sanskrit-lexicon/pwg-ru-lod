  skos:definition "<div n=\"p\">— {#vi#}, <ab>partic.</ab> {#vyApta#}\n<div n=\"1\"> 1) {%включенный, охваченный чем-либо другим%}\n<ls>BHĀṢĀP. 67.</ls> {#kftakatvamanityatvena vyAptam#}, так <ab>v. a.</ab> {%подпадает под понятие преходящести%}\n<ls>TARKAS. 41.</ls> — <ab>caus.</ab> {#vyApita#} {%наполненный, исполненный%}\n<ls>Spr. 3836.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#vi#}, <ab>partic.</ab> {#vyApta#}\n<div n=\"1\"> 1) {%in etwas Anderem eingeschlossen, einbegriffen%}\n<ls>BHĀṢĀP. 67.</ls> {#kftakatvamanityatvena vyAptam#} so <ab>v. a.</ab> {%fällt unter den Begriff der Vergänglichkeit%}\n<ls>TARKAS. 41.</ls> — <ab>caus.</ab> {#vyApita#} {%erfüllt%}\n<ls>Spr. 3836.</ls>"@de ;
