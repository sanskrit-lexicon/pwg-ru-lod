  skos:definition "<div n=\"1\"> 1) с <ab>conj.</ab> (<ab>aor.</ab> без аугмента в позднейшем языке)\n<ls>P. 3,3,175.</ls> <ls n=\"P.\">6,4,74.</ls>\n<ls>VOP. 25,27.</ls> {#mA no^ vaDIrindra\\ mA parA^ dAH#}\n<ls>ṚV. 1,104,8.</ls> <ls n=\"ṚV.\">7,1,11.</ls> <ls n=\"ṚV. 7,1,\">19.</ls> <ls n=\"ṚV. 7,1,\">21.</ls> <ls n=\"ṚV. 7,1,\">22.</ls> <ls n=\"ṚV. 7,\">4,6.</ls> {#mA te^ BUma parA\\dE#}\n<ls n=\"ṚV. 7,\">19,7.</ls> <ls n=\"ṚV. 7,\">21,5.</ls> {#mA tatka^rma\\ yaccaya^Dve#}\n<ls n=\"ṚV. 7,\">52,2.</ls> <ls>AIT. BR. 3,33.</ls> <ls>ŚAT. BR. 11,5,4,5.</ls> <ls n=\"ŚAT. BR.\">14,5,1,2.</ls> <ls n=\"ŚAT. BR. 14,\">9,1,10.</ls> {#mA divA svApsIH#}\n<ls>KAUŚ. 56.</ls>\n<ls>KAUṢ. UP. 4,3. fgg.</ls> {#mA devAnAM tantuSCedi#}\n<ls>ŚĀṄKH. ŚR. 10,18,5.</ls> {#mA dAH#}\n<ls>M. 2,114.</ls> <ls n=\"M.\">4,225.</ls> <ls n=\"M.\">8,15</ls> {#(vaDIt#} следует читать). ad\n<ls n=\"M.\">3,259</ls> (<ab>vgl.</ab> ad <ls>YĀJÑ. 1,245</ls>). <ls>N. 12,52.</ls> <ls n=\"N.\">14,3.</ls> <ls>HIḌ. 3,7. 10.</ls> <ls>MBH. 3,15681.</ls> <ls n=\"MBH. 3,\">15797.</ls> <ls n=\"MBH.\">5,6032</ls> {#(na#} <ls>ed. Calc.</ls>, {#mA#} <ls>ed. Bomb.</ls>).\n<ls n=\"MBH. 5,\">7290.</ls> <ls n=\"MBH.\">12,6732.</ls> <ls>DAŚ. 1,48.</ls> <ls n=\"DAŚ.\">2,35</ls> ({#mA mA gamaH#}).\n<ls>R. 1,64,5.</ls> <ls n=\"R.\">2,25,15.</ls>\n<ls>Spr. 2176.</ls> <ls n=\"Spr.\">2406.</ls> <ls n=\"Spr.\">3702.</ls> <ls n=\"Spr.\">3966.</ls>\n<ls>RAGH. 1,37.</ls> <ls n=\"RAGH.\">3,50.</ls>\n<ls>MEGH. 95.</ls> <ls n=\"MEGH.\">108.</ls> <ls n=\"MEGH.\">111.</ls> <ls n=\"MEGH.\">113.</ls>\n<ls>ŚĀK. 35.</ls> <ls n=\"ŚĀK.\">8,9.</ls> <ls n=\"ŚĀK.\">29,7.</ls>\n<ls>VIKR. 110.</ls>\n<ls>VID. 120.</ls> <ls n=\"VID.\">167.</ls> <ls n=\"VID.\">205.</ls> <ls n=\"VID.\">266.</ls>\n<ls>KATHĀS. 38,16.</ls>\n<ls>LA. (II) 92,4.</ls> {#mA na sAvIH#}\n<ls>BHAṬṬ. 9,50.</ls> <ls n=\"BHAṬṬ.\">15,12.</ls> {%чтобы не%}: {#mA vanaM CindDi savyAGraM mA vyAGrA nInaSanvanAt#}\n<ls>Spr. 4716.</ls> {#uttaratra gatisaMjYEva yaTA syAt upasargasaMjYA mA BUt#}\n<ls>P. 1,4,60</ls>, <ab>Sch.</ab>\n{#yaTA mA#} <ab>dass.</ab>: {#yaTA mA vo mftyuH parivyaTA iti#}\n<ls>PRAŚNOP. 6,6.</ls> {#kaTaM mA BUt = kaTaM na syAt#}\n<ls>KATHĀS. 42,114.</ls> {#kaTaM kamalanAlasya mA BUvanBaNgurA guRAH#}\n<ls>Spr. 121</ls> {#(nABUvan#} худшее чтение). {#mApagAH SOdrAnnyAyAt#}\n<ls>ŚĀṄKH. ŚR. 15,24,10</ls> ошибочно вм. {#nApAgAH#}, как\n<ls>AIT. BR. 7,17</ls> имеет. С <ab>conj.</ab> <ab>imperf.</ab>: {#mA cEnamaBiBAzaTAH#}\n<ls>R. 2,9,19.</ls> Иногда с <ab>aor.</ab> <ab>indic.</ab>: {#tanme mA vyanaSat#}\n<ls>KAUŚ. 56.</ls> {#mA vaH kzetre parabIjAnyavApsuH#} <ab>ved.</ab> цитата у\n<ab>Schol.</ab> к <ls>P. 6,4,75.</ls> {#mA vyagamat#}\n<ls>M. 3,259</ls> {#(vigamat#} <ab>v. l.</ab>) =\n<ls>YĀJÑ. 1,245.</ls> {#mA tvAM kAlo 'tyagAdayam#}\n<ls>MBH. 1,6196.</ls> <ls n=\"MBH.\">3,15689.</ls> <ls n=\"MBH.\">5,5984.</ls> {#mAsmatsakASe paruzARyavocaH#}\n<ls n=\"MBH.\">3,15689.</ls> {#mA nizAda pratizWAM tvamagamaH#}\n<ls>R. 1,2,18</ls> (<ls n=\"GORR. 1,2,\">17</ls> <ls>GORR.</ls>) = <ls>UTTARARĀMAC. 27,16.</ls>\n[Page5-0680]\nВ сочетании с {#arhasi#} <ab>st.</ab> {#na#} по метрическим соображениям: {#klEvyaM mA gantumarhasi#}\n<ls>R. GORR. 2,116,5.</ls>"@ru ;
