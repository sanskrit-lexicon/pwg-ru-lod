<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/yA/tr/y_x5f_a_x7e__x7e_h0_x5f_18_x5f_a_x5f_bi/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#aBi#}\n<div n=\"1\"> 1) {%adire, идти к, подходить к, подступать к —, приходить к —, направляться к, угрожающе обращаться против, встречать%}: {#a\\Bi spfDo^ yAsiza\\dvajra^bAhuH#}\n<ls>ṚV. 1,174,5.</ls>\n<ls>AV. 4,29,7.</ls> {#a\\nyatra\\ rAjYA^ma\\Bi yA^tu ma\\nyuH#}\n<ls n=\"AV.\">6,40,2.</ls> <ls n=\"AV.\">10,1,15.</ls> {#mf\\qata\\M mABi yA^tam#}\n<ls n=\"AV.\">11,2,1.</ls> <ls>KAUŚ. 14.</ls> — {#tatrEnaM nAgarAH sarve satkAreRAByayustadA#}\n<ls>MBH. 2,952.</ls> <ls n=\"MBH.\">3,2259.</ls> <ls n=\"MBH. 3,\">14443.</ls> <ls n=\"MBH.\">5,6099.</ls> <ls n=\"MBH.\">7,2630.</ls>\n<ls>HARIV. 11031.</ls>\n<ls>KATHĀS. 30,15.</ls> <ls n=\"KATHĀS.\">36,16.</ls> <ls n=\"KATHĀS.\">84,25.</ls>\n<ls>BHĀG. P. 4,23,36</ls> ({#anuyAti#} <ls>ed. Bomb.</ls>). {#kuverAdaBiyAsyamAnAt#} (<ab>pass.</ab>)\n<ls>RAGH. 5,30.</ls> {#Satrum#}\n<ls>MBH. 2,191.</ls> <ls n=\"MBH.\">4,2142.</ls> <ls n=\"MBH.\">5,7447.</ls> <ls n=\"MBH. 5,\">7483.</ls> {#ye ca — aBiyAtA DanaMjayam#}\n<ls n=\"MBH.\">6,5542.</ls> {#paracakrABiyAta#} (с <ab>pass.</ab> <ab>Bed.</ab>)\n<ls n=\"MBH.\">12,4729.</ls> {#rAzwraM tasyABiyAsyAmaH#}\n<ls n=\"MBH.\">4,978.</ls> {#samudram#}\n<ls>HARIV. 322.</ls> {#giriSrezWam#}\n<ls n=\"HARIV.\">6935.</ls> <ls>R. 2,50,16.</ls> {#gfham#}\n<ls>R. GORR. 2,3,28.</ls> <ls n=\"R. GORR. 2,\">47,6.</ls> <ls n=\"R. GORR. 2,\">73,7.</ls> <ls n=\"R. GORR. 2,73,\">8.</ls> <ls n=\"R. GORR.\">4,25,7.</ls> <ls n=\"R. GORR. 4,\">41,8.</ls> <ls n=\"R. GORR.\">5,73,2.</ls> <ls n=\"R. GORR.\">6,16,13.</ls> <ls>KIR. 5,1.</ls> <ls>BHĀG. P. 3,24,9.</ls> <ls n=\"BHĀG. P.\">5,13,6.</ls> {#BUyateH Sriyam#}\n<ls>RAGH. 9,30.</ls> {#svargam#} {%отправиться на небо%} в знач. <ab>v. a.</ab> {%умереть%}\n<ls>DAŚ. 2,55.</ls> {#saMketanam#} {%на свидание%}\n<ls>VET. in LA. (III) 20,14.</ls> без дополнения {%прибыть%}\n<ls>MBH. 5,7133.</ls> <ls n=\"MBH.\">12,4264.</ls>\n<ls>HARIV. 4993.</ls>\n<ls>R. 1,25,10.</ls> <ls n=\"R.\">2,71,21.</ls>\n<ls>R. GORR. 1,21,1.</ls>\n<ls>BHĀG. P. 1,9,37.</ls> <ls n=\"BHĀG. P.\">3,22,18.</ls> <ls n=\"BHĀG. P.\">8,11,13.</ls> <ls n=\"BHĀG. P.\">9,6,17.</ls> <ls n=\"BHĀG. P. 9,\">8,10.</ls> {#devavimAnAni — aBiyAtAni#}\n<ls>MBH. 3,1763.</ls> {%предпринять нападение%}\n<ls>KĀM. NĪTIS. 15,2. 13.</ls> {%прийти%}, о времени: {#kAlo 'BiyAtastriRavacaturyugavikalpitaH#} (точнее было бы {#atiyAtaH#} {%истекший%})\n<ls>BHĀG. P. 9,3,33.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#aBi#}\n<div n=\"1\"> 1) {%adire, zugehen auf, hingehen —, treten —, kommen —, sich hinbegeben zu, sich drohend wenden gegen, begegnen%}: {#a\\Bi spfDo^ yAsiza\\dvajra^bAhuH#}\n<ls>ṚV. 1,174,5.</ls>\n<ls>AV. 4,29,7.</ls> {#a\\nyatra\\ rAjYA^ma\\Bi yA^tu ma\\nyuH#}\n<ls n=\"AV.\">6,40,2.</ls> <ls n=\"AV.\">10,1,15.</ls> {#mf\\qata\\M mABi yA^tam#}\n<ls n=\"AV.\">11,2,1.</ls> <ls>KAUŚ. 14.</ls> — {#tatrEnaM nAgarAH sarve satkAreRAByayustadA#}\n<ls>MBH. 2,952.</ls> <ls n=\"MBH.\">3,2259.</ls> <ls n=\"MBH. 3,\">14443.</ls> <ls n=\"MBH.\">5,6099.</ls> <ls n=\"MBH.\">7,2630.</ls>\n<ls>HARIV. 11031.</ls>\n<ls>KATHĀS. 30,15.</ls> <ls n=\"KATHĀS.\">36,16.</ls> <ls n=\"KATHĀS.\">84,25.</ls>\n<ls>BHĀG. P. 4,23,36</ls> ({#anuyAti#} <ls>ed. Bomb.</ls>). {#kuverAdaBiyAsyamAnAt#} (<ab>pass.</ab>)\n<ls>RAGH. 5,30.</ls> {#Satrum#}\n<ls>MBH. 2,191.</ls> <ls n=\"MBH.\">4,2142.</ls> <ls n=\"MBH.\">5,7447.</ls> <ls n=\"MBH. 5,\">7483.</ls> {#ye ca — aBiyAtA DanaMjayam#}\n<ls n=\"MBH.\">6,5542.</ls> {#paracakrABiyAta#} (mit <ab>pass.</ab> <ab>Bed.</ab>)\n<ls n=\"MBH.\">12,4729.</ls> {#rAzwraM tasyABiyAsyAmaH#}\n<ls n=\"MBH.\">4,978.</ls> {#samudram#}\n<ls>HARIV. 322.</ls> {#giriSrezWam#}\n<ls n=\"HARIV.\">6935.</ls> <ls>R. 2,50,16.</ls> {#gfham#}\n<ls>R. GORR. 2,3,28.</ls> <ls n=\"R. GORR. 2,\">47,6.</ls> <ls n=\"R. GORR. 2,\">73,7.</ls> <ls n=\"R. GORR. 2,73,\">8.</ls> <ls n=\"R. GORR.\">4,25,7.</ls> <ls n=\"R. GORR. 4,\">41,8.</ls> <ls n=\"R. GORR.\">5,73,2.</ls> <ls n=\"R. GORR.\">6,16,13.</ls> <ls>KIR. 5,1.</ls> <ls>BHĀG. P. 3,24,9.</ls> <ls n=\"BHĀG. P.\">5,13,6.</ls> {#BUyateH Sriyam#}\n<ls>RAGH. 9,30.</ls> {#svargam#} {%zum Himmel gehen%} so <ab>v. a.</ab> {%sterben%}\n<ls>DAŚ. 2,55.</ls> {#saMketanam#} {%zu einem Stelldichein%}\n<ls>VET. in LA. (III) 20,14.</ls> ohne Object {%herbeikommen%}\n<ls>MBH. 5,7133.</ls> <ls n=\"MBH.\">12,4264.</ls>\n<ls>HARIV. 4993.</ls>\n<ls>R. 1,25,10.</ls> <ls n=\"R.\">2,71,21.</ls>\n<ls>R. GORR. 1,21,1.</ls>\n<ls>BHĀG. P. 1,9,37.</ls> <ls n=\"BHĀG. P.\">3,22,18.</ls> <ls n=\"BHĀG. P.\">8,11,13.</ls> <ls n=\"BHĀG. P.\">9,6,17.</ls> <ls n=\"BHĀG. P. 9,\">8,10.</ls> {#devavimAnAni — aBiyAtAni#}\n<ls>MBH. 3,1763.</ls> {%einen Angriff machen%}\n<ls>KĀM. NĪTIS. 15,2. 13.</ls> {%kommen%}, von der Zeit: {#kAlo 'BiyAtastriRavacaturyugavikalpitaH#} (genauer wäre {#atiyAtaH#} {%verstrichen%})\n<ls>BHĀG. P. 9,3,33.</ls>"@de ;
