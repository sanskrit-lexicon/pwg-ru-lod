  skos:definition "<div n=\"p\">— {#anupra#} {%следовать за кем-л. в пути%}\n<ls>TBR. 3,7,1,1.</ls> {%направляться по дороге к%}: {#AGAtamadyAnuprayAmi SAmitramAlabDumivADvare 'jaH#}\n<ls>MṚCCH. 161,12.</ls> {%выступать вслед за кем-л.%} (<ab>acc.</ab>) {%, сопровождать кого-л.%}: {#taM prayAntamanuprAyAt#}\n<ls>MBH. 5,2949.</ls>\n<ls>R. GORR. 2,33,7.</ls> {#pfzWato 'nuprayAtAni#} (mit <ab>act.</ab> <ab>Bed.</ab>)\n<ls n=\"R. GORR. 2,\">43,23</ls> (<ls n=\"SCHL. 2,\">45,22</ls> <ls>SCHL.</ls>). {#anuprayAta#} {%сопровождаемый%}\n<ls>KUMĀRAS. 3,23.</ls> <ls n=\"KUMĀRAS. 3,\">52.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#anupra#} {%auf dem Wege nachfolgen%}\n<ls>TBR. 3,7,1,1.</ls> {%den Weg einschlagen nach%}: {#AGAtamadyAnuprayAmi SAmitramAlabDumivADvare 'jaH#}\n<ls>MṚCCH. 161,12.</ls> {%nach Jmd%} (<ab>acc.</ab>) {%aufbrechen, Jmd begleiten%}: {#taM prayAntamanuprAyAt#}\n<ls>MBH. 5,2949.</ls>\n<ls>R. GORR. 2,33,7.</ls> {#pfzWato 'nuprayAtAni#} (mit <ab>act.</ab> <ab>Bed.</ab>)\n<ls n=\"R. GORR. 2,\">43,23</ls> (<ls n=\"SCHL. 2,\">45,22</ls> <ls>SCHL.</ls>). {#anuprayAta#} {%begleitet von%}\n<ls>KUMĀRAS. 3,23.</ls> <ls n=\"KUMĀRAS. 3,\">52.</ls>"@de ;
  pwglex:senseTag "main" ;
