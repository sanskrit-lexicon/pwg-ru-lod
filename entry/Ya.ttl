  skos:definition "<div n=\"1\">— 2) = {#yA#} {%ходить, идти, двигаться, ехать%}: {#yaM ca panTAnamAkramya prayAti manujeSvaraH#}\n<ls>R. 5,81,22.</ls> {#prajAsu kaH kena paTA prayAti#}\n<ls>ŚĀK. 153.</ls> {#(sAraNgaH) viyati bahutaraM stokamurvyAM prayAti#}\n<ls n=\"ŚĀK.\">7.</ls> {#rAtriMdivaM ganDavahaH prayAti#}\n<ls n=\"ŚĀK.\">101.</ls> {#iha turagaSatEH prayAntu mUrKAH#}\n<ls>Spr. 431.</ls> {#aprayAnt#} {%не движущийся%}\n<ls>MBH. 5,7178.</ls> {#prayAta#} ({%пришедший в движение%}) = {#prayAnt#} {%идущий, движущийся, летящий%}: {#prayAte tu raTe#}\n<ls>MBH. 3,2809.</ls> {#so 'paSyadDaMsayugalaM prayAtaM gagaRe niSi#}\n<ls>KATHĀS. 3,27.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) = {#yA#} {%wandeln, gehen, sich bewegen, fahren%}: {#yaM ca panTAnamAkramya prayAti manujeSvaraH#}\n<ls>R. 5,81,22.</ls> {#prajAsu kaH kena paTA prayAti#}\n<ls>ŚĀK. 153.</ls> {#(sAraNgaH) viyati bahutaraM stokamurvyAM prayAti#}\n<ls n=\"ŚĀK.\">7.</ls> {#rAtriMdivaM ganDavahaH prayAti#}\n<ls n=\"ŚĀK.\">101.</ls> {#iha turagaSatEH prayAntu mUrKAH#}\n<ls>Spr. 431.</ls> {#aprayAnt#} {%sich nicht bewegend%}\n<ls>MBH. 5,7178.</ls> {#prayAta#} ({%sich in Bewegung gesetzt habend%}) = {#prayAnt#} {%gehend, sich bewegend, fliegend%}: {#prayAte tu raTe#}\n<ls>MBH. 3,2809.</ls> {#so 'paSyadDaMsayugalaM prayAtaM gagaRe niSi#}\n<ls>KATHĀS. 3,27.</ls>"@de ;
