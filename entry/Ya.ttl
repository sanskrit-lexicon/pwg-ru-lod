  skos:definition "<div n=\"1\">— 2) {%умилостивлять, отвращать (зло)%}: {#tvaM no^ agne\\ varu^Rasya\\ ha^Lo 'va^ yAsisIzWAH#}\n? (<ls>VS. PRĀT. 3,82.</ls> <ls>P. 3,1,34</ls>, <is>Vārtt</is>). <ls>ṚV. 4,1,4.</ls> {#nU ci^tsu\\dAnu\\rava^ yAsadu\\grAn#}\n<ls n=\"ṚV.\">6,66,5.</ls> {#ava^ de\\vErde\\vakf^ta\\meno^ 'yAsizam#}\n<ls>VS. 3,48.</ls> {#a\\va\\yA\\tAm#}\n<ls>ṚV. 1,94,12</ls> считаем ошибочным <ab>st.</ab> {#a\\va\\yA\\tA#} <ab>nom. ag.</ab>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) {%abbitten, abwenden%}: {#tvaM no^ agne\\ varu^Rasya\\ ha^Lo 'va^ yAsisIzWAH#}\n? (<ls>VS. PRĀT. 3,82.</ls> <ls>P. 3,1,34</ls>, <is>Vārtt</is>). <ls>ṚV. 4,1,4.</ls> {#nU ci^tsu\\dAnu\\rava^ yAsadu\\grAn#}\n<ls n=\"ṚV.\">6,66,5.</ls> {#ava^ de\\vErde\\vakf^ta\\meno^ 'yAsizam#}\n<ls>VS. 3,48.</ls> {#a\\va\\yA\\tAm#}\n<ls>ṚV. 1,94,12</ls> halten wir für fehlerhaft <ab>st.</ab> {#a\\va\\yA\\tA#} <ab>nom. ag.</ab>"@de ;
  pwglex:senseTag "2" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Corpus evidence (искупительная жертва, искупление) directly supports this sense of propitiating / averting evil. 'Умилостивлять' (propitiate) preferred over plain 'искупать' as it covers both 'abbitten' and 'abwenden'."@ru ;
