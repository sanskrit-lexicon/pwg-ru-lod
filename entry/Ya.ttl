  skos:definition "<div n=\"p\">— {#vyapa#} {%уходить, удаляться, отступать%}: {#sa tvaM mA vyapayAH punaH#}\n<ls>MBH. 3,739.</ls> <ls n=\"MBH. 3,\">775</ls> (где {#vyapAyAt#} следует читать с <ls>ed. Bomb.</ls>).\n<ls n=\"MBH. 3,\">12165.</ls> <ls n=\"MBH.\">4,1900.</ls> <ls n=\"MBH.\">5,7200.</ls> {#raRAt#}\n<ls n=\"MBH. 3,\">7302.</ls> {#vyapayAtezu vAsAya sEnyezu#}\n<ls n=\"MBH.\">7,2478.</ls> <ls n=\"MBH.\">8,4045</ls> (<ab>med.</ab>). <ls>HARIV. 6427.</ls> {#ApadaH — vyapayAnti#} {%отступить%}\n<ls>R. ed. Bomb. 3,66,6</ls> ({#pratiyAnti#}\nGORR. <ls n=\"GORR. 3,\">71,5</ls>). {#taTEva gacCatastasya vyapayAdrajanI SivA#} {%миновало%}\n<ls>R. SCHL. 2,49,2.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#vyapa#} {%fortgehen, sich entfernen, sich zurückziehen%}: {#sa tvaM mA vyapayAH punaH#}\n<ls>MBH. 3,739.</ls> <ls n=\"MBH. 3,\">775</ls> (wo {#vyapAyAt#} mit der <ls>ed. Bomb.</ls> zu lesen ist).\n<ls n=\"MBH. 3,\">12165.</ls> <ls n=\"MBH.\">4,1900.</ls> <ls n=\"MBH.\">5,7200.</ls> {#raRAt#}\n<ls n=\"MBH. 3,\">7302.</ls> {#vyapayAtezu vAsAya sEnyezu#}\n<ls n=\"MBH.\">7,2478.</ls> <ls n=\"MBH.\">8,4045</ls> (<ab>med.</ab>). <ls>HARIV. 6427.</ls> {#ApadaH — vyapayAnti#} {%weichen%}\n<ls>R. ed. Bomb. 3,66,6</ls> ({#pratiyAnti#}\nGORR. <ls n=\"GORR. 3,\">71,5</ls>). {#taTEva gacCatastasya vyapayAdrajanI SivA#} {%verstrich%}\n<ls>R. SCHL. 2,49,2.</ls>"@de ;
