<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/yA/tr/y_x5f_a_x7e__x7e_h0_x5f_09_x5f_anu/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#anu#} {%идти к, направляться к; следовать за, идти вслед%}: {#anu^ de\\vAnra^Ti\\ro yA^si\\ sADa^n#}\n<ls>ṚV. 3,1,17.</ls> {#yasya^ pra\\yARa\\manva\\nya idya\\yuH#}\n<ls n=\"ṚV.\">5,81,3.</ls> {#yaH pf\\TUnya\\gnira^nu\\yAti\\ Barva^n#}\n<ls n=\"ṚV.\">6,6,2.</ls> <ls n=\"ṚV. 6,\">12,5.</ls> <ls>ŚAT. BR. 10,6,1,7.</ls> <ls>LĀṬY. 8,5,22.</ls> {#pUrvezAmAnupUrvyeRa yAtaM vartmAnuyAmahe#} {%идти следом%}\n<ls>MBH. 1,7246.</ls> {#anuyAhi sADupadavIm#}\n<ls>Spr. 1051.</ls> {#gaNgAM cEvAnuyAsyAmaH#} {%направиться к%}\n<ls>MBH. 1,4999.</ls> {#saMprati maYjulavaYjulasImani keliSayanamanuyAtam#} {%направившись к%}\n<ls>GĪT. 11,2.</ls> {#anuyayurgfhAn#} {%ходили из дома в дом%}\n<ls>HARIV. 3431.</ls> {#eka eva suhfdDarmo niDane 'pyanuyAti yaH#} {%следовать за, идти вслед%}\n<ls>Spr. 516.</ls> {#tvAmanuyAsyAmi#}\n<ls>MBH. 1,3355.</ls> <ls n=\"MBH.\">2,1606.</ls> <ls n=\"MBH.\">3,11920.</ls> <ls n=\"MBH. 3,\">15684.</ls> <ls n=\"MBH.\">4,537.</ls> <ls n=\"MBH. 4,\">655.</ls> <ls n=\"MBH. 4,\">1029.</ls> <ls n=\"MBH.\">7,71.</ls>\n<ls>HARIV. 4860.</ls>\n<ls>N. 9,7</ls> ({#anvagAt#}\n<ls>MBH. 3,2303</ls>). <ls>R. 1,2,24.</ls> <ls n=\"R. 1,\">24,6.</ls> <ls n=\"R. 1,\">60,31.</ls> <ls n=\"R. 1,\">73,37.</ls> <ls n=\"R.\">2,30,39.</ls> <ls n=\"R. 2,\">31,3.</ls> <ls n=\"R. 2,\">33,6.</ls> <ls n=\"R. 2,\">37,24.</ls> <ls n=\"R. 2,\">58,6.</ls> <ls n=\"R. 2,\">70,29.</ls> <ls n=\"R. 2,\">83,3.</ls> <ls n=\"R. 2,\">91,8.</ls> <ls>R. GORR. 1,75,30.</ls> <ls>MṚCCH. 131,22.</ls> <ls>ŚĀK. 28.</ls> <ls>RAGH. 9,34.</ls> <ls n=\"RAGH.\">10,50.</ls> <ls>KUMĀRAS. 4,21.</ls> <ls>KATHĀS. 82,52.</ls> <ls>RĀJA-TAR. 3,230.</ls> <ls>BHĀG. P. 1,4,5.</ls> <ls n=\"BHĀG. P.\">3,31,31.</ls> <ls n=\"BHĀG. P.\">9,6,53.</ls> <ab>med.</ab> <ls>MBH. 3,57</ls> (по чтению <ls>ed. Bomb.</ls>).\n<ls n=\"MBH.\">7,163.</ls> <ls n=\"MBH.\">10,142.</ls> {#tizWantamanutizWanti #}\n[Page6-0102]\n{# yAntaM yAnti#} ({#anu#} следует дополнить) {#divOkasaH#}\n<ls>MĀRK. P. 18,24.</ls> {#anuyAta#} с <ab>act.</ab> <ab>Bed.</ab>, {%secutus%}: {#mAM cAnuyAtA vijanaM tapovanam#}\n<ls>R. 2,54,13.</ls>\n<ls>R. GORR. 2,62,6.</ls> <ls n=\"R. GORR.\">4,9,11.</ls>\n<ls>KATHĀS. 51,44.</ls> с <ab>pass.</ab> <ab>Bed.</ab>, {%сопровождаемый%}\n<ls>MBH. 14,1184.</ls>\n<ls>HARIV. 2455.</ls> <ls n=\"HARIV.\">4988.</ls>\n<ls>RAGH. 12,104.</ls> <ls n=\"RAGH.\">14,29.</ls>\n<ls>KATHĀS. 10,208.</ls> <ls n=\"KATHĀS.\">14,11.</ls> <ls n=\"KATHĀS.\">18,11.</ls> <ls n=\"KATHĀS.\">46,248.</ls>\n<ls>RĀJA-TAR. 5,358.</ls> {#lokalocanamAnasAnuyAtA prAtizWata#}\n<ls>DAŚAK.</ls> в <ls>BENF. Chr. 190,17.</ls> {#kaPAnuyAta#}\n<ls>SUŚR. 2,361,15.</ls> {#BartAramanuyA#} так <ab>v. a.</ab> {%последовать за мужем в смерть, дать себя сжечь вместе с ним%}\n<ls>Spr. 3485.</ls>\n<ls>RĀJA-TAR. 5,225.</ls> {#BartAramanuyAtA#}\n<ls>MĀRK. P. 22,34.</ls> {%следовать%} так <ab>v. a.</ab> {%идти в ногу с кем-л., не отставать от кого-л.%}\n<ls>R. 3,44,30.</ls> {%подражать, воспроизводить, достигать, равняться%}: {#tezAM kaScaritaM SaktastvanuyAtum#}\n<ls>MĀRK. P. 133,9.</ls> {#na kilAnuyayustasya rAjAno rakzituryaSaH#}\n<ls>RAGH. 1,27.</ls> {#anuyAtalIla#}\n<ls n=\"RAGH.\">16,71.</ls> {#samatayA — anuyayO yamam#}\n<ls n=\"RAGH.\">9,6.</ls> {#anuyAtaH svavIryeRa vAsudevam#}\n<ls>MBH. 3,10890.</ls> с <ab>gen.</ab> лица: {#tezAM mahAtmanAM rAjYAM ko 'nuyAsyati madviDaH#}\n<ls>MĀRK. P. 120,7.</ls> {%следовать (чему-л.)%} так <ab>v. a.</ab> {%соблюдать%}: {#SakracCandAnuyAta/#}\n<ls n=\"MĀRK. P.\">1,39.</ls> {%достигать, обретать%}: {#sarvAnkAmAnanuyAto 'si#}\n<ls>MBH. 14,223.</ls> — В месте {#ozaDInAM SirAMsIva dvizacCIrzARi so 'nvayAt#}\n<ls>MBH. 4,1727</ls> следует, возможно, читать {#'nvacCAt#} {%отрубил%}.\n<ls>NĪLAK.</ls> понимает {#anvayAt#} как <ab>abl.</ab>, объясняя {#anukramAt#}."@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#anu#} {%hingehen zu, hinfahren; nachgehen, nachfolgen%}: {#anu^ de\\vAnra^Ti\\ro yA^si\\ sADa^n#}\n<ls>ṚV. 3,1,17.</ls> {#yasya^ pra\\yARa\\manva\\nya idya\\yuH#}\n<ls n=\"ṚV.\">5,81,3.</ls> {#yaH pf\\TUnya\\gnira^nu\\yAti\\ Barva^n#}\n<ls n=\"ṚV.\">6,6,2.</ls> <ls n=\"ṚV. 6,\">12,5.</ls> <ls>ŚAT. BR. 10,6,1,7.</ls> <ls>LĀṬY. 8,5,22.</ls> {#pUrvezAmAnupUrvyeRa yAtaM vartmAnuyAmahe#} {%nachwandeln%}\n<ls>MBH. 1,7246.</ls> {#anuyAhi sADupadavIm#}\n<ls>Spr. 1051.</ls> {#gaNgAM cEvAnuyAsyAmaH#} {%sich hinbegeben zu%}\n<ls>MBH. 1,4999.</ls> {#saMprati maYjulavaYjulasImani keliSayanamanuyAtam#} {%hingegangen zu%}\n<ls>GĪT. 11,2.</ls> {#anuyayurgfhAn#} {%gingen von Haus zu Haus%}\n<ls>HARIV. 3431.</ls> {#eka eva suhfdDarmo niDane 'pyanuyAti yaH#} {%nachgehen, folgen%}\n<ls>Spr. 516.</ls> {#tvAmanuyAsyAmi#}\n<ls>MBH. 1,3355.</ls> <ls n=\"MBH.\">2,1606.</ls> <ls n=\"MBH.\">3,11920.</ls> <ls n=\"MBH. 3,\">15684.</ls> <ls n=\"MBH.\">4,537.</ls> <ls n=\"MBH. 4,\">655.</ls> <ls n=\"MBH. 4,\">1029.</ls> <ls n=\"MBH.\">7,71.</ls>\n<ls>HARIV. 4860.</ls>\n<ls>N. 9,7</ls> ({#anvagAt#}\n<ls>MBH. 3,2303</ls>). <ls>R. 1,2,24.</ls> <ls n=\"R. 1,\">24,6.</ls> <ls n=\"R. 1,\">60,31.</ls> <ls n=\"R. 1,\">73,37.</ls> <ls n=\"R.\">2,30,39.</ls> <ls n=\"R. 2,\">31,3.</ls> <ls n=\"R. 2,\">33,6.</ls> <ls n=\"R. 2,\">37,24.</ls> <ls n=\"R. 2,\">58,6.</ls> <ls n=\"R. 2,\">70,29.</ls> <ls n=\"R. 2,\">83,3.</ls> <ls n=\"R. 2,\">91,8.</ls> <ls>R. GORR. 1,75,30.</ls> <ls>MṚCCH. 131,22.</ls> <ls>ŚĀK. 28.</ls> <ls>RAGH. 9,34.</ls> <ls n=\"RAGH.\">10,50.</ls> <ls>KUMĀRAS. 4,21.</ls> <ls>KATHĀS. 82,52.</ls> <ls>RĀJA-TAR. 3,230.</ls> <ls>BHĀG. P. 1,4,5.</ls> <ls n=\"BHĀG. P.\">3,31,31.</ls> <ls n=\"BHĀG. P.\">9,6,53.</ls> <ab>med.</ab> <ls>MBH. 3,57</ls> (nach der Lesart der <ls>ed. Bomb.</ls>).\n<ls n=\"MBH.\">7,163.</ls> <ls n=\"MBH.\">10,142.</ls> {#tizWantamanutizWanti #}\n[Page6-0102]\n{# yAntaM yAnti#} ({#anu#} zu ergänzen) {#divOkasaH#}\n<ls>MĀRK. P. 18,24.</ls