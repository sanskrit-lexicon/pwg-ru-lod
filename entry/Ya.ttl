  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Упасарга anu+pra = «вслед за»; auf dem Wege nachfolgen = следовать за; begleiten = сопровождать; begleitet von = сопровождаемый."@ru ;
