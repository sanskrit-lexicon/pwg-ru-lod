  skos:definition "<div n=\"p\">— {#saMpra#}\n<div n=\"1\"> 1) ({%вместе) отправляться, идти к%}\n<ls>ŚĀṄKH. ŚR. 2,16,1.</ls>\n<ls>MBH. 1,4645.</ls> <ls n=\"MBH.\">2,2517.</ls> {#tadanIkaM virAwasya SuSuBe — saMprayAntaM (= saMprayAt; saMprayAtaM#} <ls>ed. Bomb.</ls>) {#tadA rAjannirIkzantaM#} (<ab>d. i.</ab> {#nirIkzat = nirIkzamARan) gavAM padam#}\n<ls n=\"MBH.\">4,1034.</ls> <ls n=\"MBH.\">5,3463.</ls> <ls n=\"MBH. 5,\">5154.</ls> <ls>HARIV. 4461.</ls> <ls n=\"HARIV.\">10911.</ls> <ls n=\"HARIV.\">11071.</ls> <ls>R. GORR. 2,101,40.</ls> <ls n=\"R. GORR.\">5,35,27.</ls> <ls n=\"R. GORR.\">7,14,2.</ls> {#nahyahaM saMprayAsyAmi puram#}\n<ls>MBH. 3,15082.</ls> {#brahmaRaH sadanam#}\n<ls n=\"MBH.\">13,1851.</ls> {#naBastalam#}\n<ls>R. 3,60,1.</ls> <ls n=\"R.\">5,55,13</ls> <ls n=\"R.\">7,18,19.</ls> {#tato divAkaro rASiM saMprayAti ca karkawam#}\n<ls>Verz. d. Oxf. H. 46,a,42.</ls> {#(nadI) saMprayAtyuttarAnkurUn#}\n<ls>MBH. 6,278.</ls> {#saMprAyAdASramamaM prati#}\n<ls n=\"MBH.\">3,16857.</ls> {%двигаться%} (von Gestirnen): {#(paTA) yenAsO saMprayAsyati#}\n<ls>SŪRYAS. 6,16.</ls> {#naKarEH saMprayAtaH#} {%действуя ногтями, пользуясь ногтями%}\n<ls>MBH. 12,8863.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#saMpra#}\n<div n=\"1\"> 1) ({%zusammen) aufbrechen, hingehen zu%}\n<ls>ŚĀṄKH. ŚR. 2,16,1.</ls>\n<ls>MBH. 1,4645.</ls> <ls n=\"MBH.\">2,2517.</ls> {#tadanIkaM virAwasya SuSuBe — saMprayAntaM (= saMprayAt; saMprayAtaM#} <ls>ed. Bomb.</ls>) {#tadA rAjannirIkzantaM#} (<ab>d. i.</ab> {#nirIkzat = nirIkzamARan) gavAM padam#}\n<ls n=\"MBH.\">4,1034.</ls> <ls n=\"MBH.\">5,3463.</ls> <ls n=\"MBH. 5,\">5154.</ls> <ls>HARIV. 4461.</ls> <ls n=\"HARIV.\">10911.</ls> <ls n=\"HARIV.\">11071.</ls> <ls>R. GORR. 2,101,40.</ls> <ls n=\"R. GORR.\">5,35,27.</ls> <ls n=\"R. GORR.\">7,14,2.</ls> {#nahyahaM saMprayAsyAmi puram#}\n<ls>MBH. 3,15082.</ls> {#brahmaRaH sadanam#}\n<ls n=\"MBH.\">13,1851.</ls> {#naBastalam#}\n<ls>R. 3,60,1.</ls> <ls n=\"R.\">5,55,13</ls> <ls n=\"R.\">7,18,19.</ls> {#tato divAkaro rASiM saMprayAti ca karkawam#}\n<ls>Verz. d. Oxf. H. 46,a,42.</ls> {#(nadI) saMprayAtyuttarAnkurUn#}\n<ls>MBH. 6,278.</ls> {#saMprAyAdASramamaM prati#}\n<ls n=\"MBH.\">3,16857.</ls> {%sich bewegen%} (von Gestirnen): {#(paTA) yenAsO saMprayAsyati#}\n<ls>SŪRYAS. 6,16.</ls> {#naKarEH saMprayAtaH#} {%mit Nägeln zu Werke gehend, sich der Nägel bedienend%}\n<ls>MBH. 12,8863.</ls>"@de ;
