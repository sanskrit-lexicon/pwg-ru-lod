<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/yA/tr/y_x5f_a_x7e__x7e_h0_x5f_12_x5f_apa/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#apa#} {%уходить, удаляться, отступать, бежать, отходить от%} (<ab>abl.</ab>)\n<ls>AV. 6,73,3.</ls> <ls n=\"AV.\">19,56,6.</ls>\n<ls>MBH. 3,248.</ls> <ls n=\"MBH. 3,\">674.</ls> {#raRAt#}\n<ls n=\"MBH. 3,\">15214.</ls> <ls n=\"MBH. 3,\">15750.</ls> {#raTopasTAt#}\n<ls n=\"MBH.\">5,7219.</ls> {#BImAt#}\n<ls n=\"MBH.\">7,5806.</ls> <ls n=\"MBH. 7,\">6307.</ls> <ls>HARIV. 5684.</ls> <ls n=\"HARIV.\">10698.</ls> <ls n=\"HARIV.\">14015.</ls> {#apayAta jAlmAH#} {%прочь отсюда%}\n<ls>MṚCCH. 174,4.</ls>\n<ls>KATHĀS. 52,249.</ls> <ls n=\"KATHĀS.\">55,72.</ls> {#pArSvAnnApayAti sma me sadA#} {%не отходил от моего бока%}\n<ls n=\"KATHĀS.\">124,197.</ls> <ls>ŚIŚ. 9. 83.</ls> <ls>BHĀG. P. 4,29,76.</ls> <ls>PAÑCAT. 129,24.</ls> <ls n=\"PAÑCAT.\">232,7.</ls> {#nAtidUrApayAte tu raTe#}\n<ls>MBH. 3,720.</ls> {#apayAsyati mama SokaH#}\n<ls>ŚĀK. 96</ls>, <ab>v. l.</ab>\n<ls>Spr. 42.</ls> {#SApo 'payAtu te#}\n<ls>KATHĀS. 56,159.</ls> {#miDyAjYAnApAye dozA apayAnti#}\n<ls>SARVADARŚANAS. 116. 6.</ls> {#SezaM gfhezu saktasya pramattasyApayAti hi#}\n<ls>BHĀG. P. 7,6,8.</ls>\n<ls>MBH. 12,3470.</ls> {#na cAsya niyamAdbudDirapayAti mahAtmanaH#} {%не прекращает%}\n<ls n=\"MBH.\">9,2310.</ls> {#nApayAti#}\n<ls n=\"MBH.\">5,7486</ls> ошибочно вм. {#nopayAti#}, как читает <ls>ed. Bomb.</ls>."@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#apa#} {%fortgehen, sich entfernen, sich zurückziehen, fliehen, weichen von%} (<ab>abl.</ab>)\n<ls>AV. 6,73,3.</ls> <ls n=\"AV.\">19,56,6.</ls>\n<ls>MBH. 3,248.</ls> <ls n=\"MBH. 3,\">674.</ls> {#raRAt#}\n<ls n=\"MBH. 3,\">15214.</ls> <ls n=\"MBH. 3,\">15750.</ls> {#raTopasTAt#}\n<ls n=\"MBH.\">5,7219.</ls> {#BImAt#}\n<ls n=\"MBH.\">7,5806.</ls> <ls n=\"MBH. 7,\">6307.</ls> <ls>HARIV. 5684.</ls> <ls n=\"HARIV.\">10698.</ls> <ls n=\"HARIV.\">14015.</ls> {#apayAta jAlmAH#} {%schert euch%}\n<ls>MṚCCH. 174,4.</ls>\n<ls>KATHĀS. 52,249.</ls> <ls n=\"KATHĀS.\">55,72.</ls> {#pArSvAnnApayAti sma me sadA#} {%wich nicht von meiner Seite%}\n<ls n=\"KATHĀS.\">124,197.</ls> <ls>ŚIŚ. 9. 83.</ls> <ls>BHĀG. P. 4,29,76.</ls> <ls>PAÑCAT. 129,24.</ls> <ls n=\"PAÑCAT.\">232,7.</ls> {#nAtidUrApayAte tu raTe#}\n<ls>MBH. 3,720.</ls> {#apayAsyati mama SokaH#}\n<ls>ŚĀK. 96</ls>, <ab>v. l.</ab>\n<ls>Spr. 42.</ls> {#SApo 'payAtu te#}\n<ls>KATHĀS. 56,159.</ls> {#miDyAjYAnApAye dozA apayAnti#}\n<ls>SARVADARŚANAS. 116. 6.</ls> {#SezaM gfhezu saktasya pramattasyApayAti hi#}\n<ls>BHĀG. P. 7,6,8.</ls>\n<ls>MBH. 12,3470.</ls> {#na cAsya niyamAdbudDirapayAti mahAtmanaH#} {%lässt nicht ab von%}\n<ls n=\"MBH.\">9,2310.</ls> {#nApayAti#}\n<ls n=\"MBH.\">5,7486</ls> fehlerhaft für {#nopayAti#}, wie die <ls>ed. Bomb.</ls> liest."@de ;
