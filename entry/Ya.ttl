  skos:definition "<div n=\"p\">— {#pari#} {%обходить кругом, объезжать, странствовать по; прибывать%}: {#yABi\\H sUrya^M pariyA\\TaH pa^rA\\vati^#}\n<ls>ṚV. 1,112,13.</ls> {#dyAvA^pfTi\\vI yA^TanA\\ pari^#}\n<ls n=\"ṚV.\">5,55,7.</ls> <ls n=\"ṚV.\">10,49,7.</ls> {#raTa^H#}\n<ls n=\"ṚV.\">3,58,8.</ls> <ls n=\"ṚV.\">4,15,2.</ls> <ls n=\"ṚV.\">7,69,5.</ls> {#va\\rtira^SvinA\\ pari^ yAtamasma\\yU#}\n<ls n=\"ṚV.\">8,26,14.</ls> <ls n=\"ṚV.\">5,75,7.</ls> <ls n=\"ṚV.\">10,85,18.</ls> <ls>AV. 13,2,4.</ls> <ls n=\"AV. 13,2,\">6.</ls> <ls>KAUŚ. 16.</ls> <ls>LĀṬY. 3,10,4.</ls> <ls>MBH. 12,8019.</ls> {#SanEstadA pariyayO SvetASvaSca mahAraTaH#}\n<ls n=\"MBH.\">14,2135.</ls> {#samantAtpariyAto 'si#}\n<ls>R. GORR. 2,106,19.</ls> {#senAM kftsnAm#}\n<ls>MBH. 5,5701.</ls> {#mahIm#}\n<ls n=\"MBH.\">12,2527.</ls> {#purIm#}\n<ls>R. 6,31,3.</ls> {%стекать%}, от <is>Soma</is>\n<ls>ṚV. 9,82,2.</ls> <ls n=\"ṚV. 9,82,\">5.</ls> <ls n=\"ṚV. 9,\">83,5.</ls> {%пробегать%}: {#viSvA^ rU\\pA#}\n<ls n=\"ṚV.\">9,111,1.</ls> {%окружать, охватывать%}: {#a\\na\\ntErva\\DEH#}\n<ls n=\"ṚV.\">1,121,9.</ls> {%обращаться%} так <ab>v. a.</ab> {%оберегать%}: {#pari^ ha\\ tyadva\\rtiryA^To ri\\zaH#}\n<ls n=\"ṚV.\">6,63,2.</ls> {#a\\gniH sa\\hasrA\\ pari^ yAti\\ gonA^m#}\n<ls n=\"ṚV.\">10,80,5.</ls> {%обращаться%} так <ab>v. a.</ab> {%избегать%}: {#yayA^ pari\\yAsyaMha^H#}\n<ls n=\"ṚV.\">6,37,4.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#pari#} {%umherwandeln, umwandeln, umfahren, durchwandern; herbeikommen%}: {#yABi\\H sUrya^M pariyA\\TaH pa^rA\\vati^#}\n<ls>ṚV. 1,112,13.</ls> {#dyAvA^pfTi\\vI yA^TanA\\ pari^#}\n<ls n=\"ṚV.\">5,55,7.</ls> <ls n=\"ṚV.\">10,49,7.</ls> {#raTa^H#}\n<ls n=\"ṚV.\">3,58,8.</ls> <ls n=\"ṚV.\">4,15,2.</ls> <ls n=\"ṚV.\">7,69,5.</ls> {#va\\rtira^SvinA\\ pari^ yAtamasma\\yU#}\n<ls n=\"ṚV.\">8,26,14.</ls> <ls n=\"ṚV.\">5,75,7.</ls> <ls n=\"ṚV.\">10,85,18.</ls> <ls>AV. 13,2,4.</ls> <ls n=\"AV. 13,2,\">6.</ls> <ls>KAUŚ. 16.</ls> <ls>LĀṬY. 3,10,4.</ls> <ls>MBH. 12,8019.</ls> {#SanEstadA pariyayO SvetASvaSca mahAraTaH#}\n<ls n=\"MBH.\">14,2135.</ls> {#samantAtpariyAto 'si#}\n<ls>R. GORR. 2,106,19.</ls> {#senAM kftsnAm#}\n<ls>MBH. 5,5701.</ls> {#mahIm#}\n<ls n=\"MBH.\">12,2527.</ls> {#purIm#}\n<ls>R. 6,31,3.</ls> {%abrinnen%}, vom <is>Soma</is>\n<ls>ṚV. 9,82,2.</ls> <ls n=\"ṚV. 9,82,\">5.</ls> <ls n=\"ṚV. 9,\">83,5.</ls> {%durchlaufen%}: {#viSvA^ rU\\pA#}\n<ls n=\"ṚV.\">9,111,1.</ls> {%umringen, umgeben%}: {#a\\na\\ntErva\\DEH#}\n<ls n=\"ṚV.\">1,121,9.</ls> {%umgéhen%} so <ab>v. a.</ab> {%hüten%}: {#pari^ ha\\ tyadva\\rtiryA^To ri\\zaH#}\n<ls n=\"ṚV.\">6,63,2.</ls> {#a\\gniH sa\\hasrA\\ pari^ yAti\\ gonA^m#}\n<ls n=\"ṚV.\">10,80,5.</ls> {%umgéhen%} so <ab>v. a.</ab> {%vermeiden%}: {#yayA^ pari\\yAsyaMha^H#}\n<ls n=\"ṚV.\">6,37,4.</ls>"@de ;
