  skos:definition "<div n=\"1\">— 4) {%впадать в какое-л. состояние, положение, отношение; становиться причастным к чему-л.%}: {#nijAM gatim#}\n<ls>KATHĀS. 52,409.</ls> {#niDanam#}\n<ls>Spr. 3346.</ls> {#paritApaduHKam#}\n<ls n=\"Spr.\">2931.</ls> {#nidrAm#}\n<ls>ṚT. 4,14.</ls> {#kopasya vaSam#}\n<ls>VARĀH. BṚH. S. 68,110.</ls> {#nizWAm#}\n<ls>HARIV. 8464. fg.</ls> {#mudam#}\n<ls>MĀRK. P. 74,45.</ls>\n<ls>Spr. 618.</ls> {#BavaM yoniSatezu#}\n<ls>YĀJÑ. 3,131.</ls> {#saNgam#}\n<ls>ṚT. 4,3. 6,6.</ls> {#parABavam#}\n<ls>MBH. 4,902.</ls>\n<ls>Spr. 3241.</ls> {#udayam, kzayam#}\n<ls n=\"Spr.\">3783.</ls> <ls>MĀRK. P. 112,10.</ls> {#virAmam#}\n<ls>Spr. 2585.</ls> {#nASam#}\n<ls>VARĀH. BṚH. S. 84,1.</ls> {#samAptim#}\n<ls>Spr. 2460.</ls> {#paramAM vfdDim#}\n<ls n=\"Spr.\">3763.</ls> {#sOKyam#}\n<ls n=\"Spr.\">1391.</ls> <ls>ṚT. 6,4.</ls> {#mAnuzyam#}\n<ls>KATHĀS. 27,71.</ls> {#pAramezWyam#}\n<ls>BHĀG. P. 2,2,22.</ls> {#sTEryam#}\n<ls>MĀRK. P. 21,56.</ls> {#saMmUQatvam#}\n<ls>MAITRYUP. 3,2.</ls> {#vizamatvam#}\n<ls n=\"MAITRYUP.\">5,2.</ls> {#antyapakzisTAvaratAm#}\n<ls>YĀJÑ. 3,131.</ls> {#SlAGanIyatAm#}\n<ls>Spr. 167.</ls> {#devatvam#}\n<ls n=\"Spr.\">171.</ls> <ls n=\"Spr.\">500.</ls> <ls>KĀM. NĪTIS. 15,9.</ls> <ls>RĀJA-TAR. 1,283.</ls> <ls>MĀRK. P. 23,65.</ls> <ls>BHAṬṬ. 6,49.</ls> <ls>SARVADARŚANAS. 170,9.</ls>\n[Page6-0110]"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 4) {%in einen Zustand, eine Lage, ein Verhältniss gerathen, theilhaftig werden%}: {#nijAM gatim#}\n<ls>KATHĀS. 52,409.</ls> {#niDanam#}\n<ls>Spr. 3346.</ls> {#paritApaduHKam#}\n<ls n=\"Spr.\">2931.</ls> {#nidrAm#}\n<ls>ṚT. 4,14.</ls> {#kopasya vaSam#}\n<ls>VARĀH. BṚH. S. 68,110.</ls> {#nizWAm#}\n<ls>HARIV. 8464. fg.</ls> {#mudam#}\n<ls>MĀRK. P. 74,45.</ls>\n<ls>Spr. 618.</ls> {#BavaM yoniSatezu#}\n<ls>YĀJÑ. 3,131.</ls> {#saNgam#}\n<ls>ṚT. 4,3. 6,6.</ls> {#parABavam#}\n<ls>MBH. 4,902.</ls>\n<ls>Spr. 3241.</ls> {#udayam, kzayam#}\n<ls n=\"Spr.\">3783.</ls> <ls>MĀRK. P. 112,10.</ls> {#virAmam#}\n<ls>Spr. 2585.</ls> {#nASam#}\n<ls>VARĀH. BṚH. S. 84,1.</ls> {#samAptim#}\n<ls>Spr. 2460.</ls> {#paramAM vfdDim#}\n<ls n=\"Spr.\">3763.</ls> {#sOKyam#}\n<ls n=\"Spr.\">1391.</ls> <ls>ṚT. 6,4.</ls> {#mAnuzyam#}\n<ls>KATHĀS. 27,71.</ls> {#pAramezWyam#}\n<ls>BHĀG. P. 2,2,22.</ls> {#sTEryam#}\n<ls>MĀRK. P. 21,56.</ls> {#saMmUQatvam#}\n<ls>MAITRYUP. 3,2.</ls> {#vizamatvam#}\n<ls n=\"MAITRYUP.\">5,2.</ls> {#antyapakzisTAvaratAm#}\n<ls>YĀJÑ. 3,131.</ls> {#SlAGanIyatAm#}\n<ls>Spr. 167.</ls> {#devatvam#}\n<ls n=\"Spr.\">171.</ls> <ls n=\"Spr.\">500.</ls> <ls>KĀM. NĪTIS. 15,9.</ls> <ls>RĀJA-TAR. 1,283.</ls> <ls>MĀRK. P. 23,65.</ls> <ls>BHAṬṬ. 6,49.</ls> <ls>SARVADARŚANAS. 170,9.</ls>\n[Page6-0110]"@de ;
