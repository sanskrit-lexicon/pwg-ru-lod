  skos:definition "<div n=\"p\">— С {#vyava#}\n<div n=\"1\">— 1〉 срезать.\n<div n=\"1\">— 2〉 срезать, отделять, разлучать, — от (<ab>Abl.</ab>).\n<div n=\"1\">— 3〉 [Page2-244-c] разрывать, вырывать из <ab n=\"einander\">e.</ab>.\n<div n=\"1\">— 4〉 прерывать.\n<div n=\"1\">— 5〉 разграничивать, точно определять <ls>BHĀG. P. 4,29,45</ls>.\n<div n=\"1\">— 6〉 решаться на ({#prati#})."@ru ;
  pwglex:sourceGloss "<div n=\"p\">— Mit {#vyava#}\n<div n=\"1\">— 1〉 {%abschneiden%}.\n<div n=\"1\">— 2〉 {%abschneiden, abtrennen, scheiden, — von%} (<ab>Abl.</ab>).\n<div n=\"1\">— 3〉 [Page2-244-c] {%von einander reissen, aus <ab n=\"einander\">e.</ab> thun%}.\n<div n=\"1\">— 4〉 {%unterbrechen%}.\n<div n=\"1\">— 5〉 {%abgrenzen, genau bestimmen%} <ls>BHĀG. P. 4,29,45</ls>.\n<div n=\"1\">— 6〉 {%sich entscheiden zu%} ({#prati#})."@de ;
