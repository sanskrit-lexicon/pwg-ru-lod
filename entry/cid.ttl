<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/Cid/tr/_x5f_cid_x7e__x7e_h0_x5f_zz_x5f_pw/Mit_x20_vi_x20__x2b__x20_ud> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— С {#vi#}\n<div n=\"1\">— 1〉 разрывать, -ламывать, раскалывать.\n<div n=\"1\">— 2〉 разрывать, разлучать. {#vicCidya#} отделенный от (<ab>Abl.</ab>) <ab>Pass.</ab> отделяться <ls>AV. PRĀYAŚC. 6,5</ls>. {#vicCinna#} разорванный, разлученный, несвязный.\n<div n=\"1\">— 3〉 нарушать, прерывать. {#vicCidya#} с перебоями. {#vicCinna#} прерванный.\n<div n=\"1\">— 4〉 губить, уничтожать. {#vicCinna#} более не существующий.\n<div n=\"1\">— 5〉 раскалываться.\n<div n=\"1\">— 6〉 {#vicCinna#}\n<div n=\"2\">— a〉 *кривой.\n<div n=\"2\">— b〉 *умащенный ({#samAlabDa#})."@ru ;
  pwglex:sourceGloss "<div n=\"p\">— Mit {#vi#}\n<div n=\"1\">— 1〉 {%zerreissen, -brechen, spalten%}.\n<div n=\"1\">— 2〉 {%auseinanderreissen, trennen%}. {#vicCidya#} {%getrennt von%} (<ab>Abl.</ab>) <ab>Pass.</ab> {%sich abtrennen%} <ls>AV. PRĀYAŚC. 6,5</ls>. {#vicCinna#} {%auseinandergerissen, getrennt, nicht zusammenhängend%}.\n<div n=\"1\">— 3〉 {%stören, unterbrechen%}. {#vicCidya#} {%mit Unterbrechungen%}. {#vicCinna#} {%unterbrochen%}.\n<div n=\"1\">— 4〉 {%zu Grunde richten, zu Nichte machen%}. {#vicCinna#} {%nicht mehr vorhanden%}.\n<div n=\"1\">— 5〉 {%sich spalten%}.\n<div n=\"1\">— 6〉 {#vicCinna#}\n<div n=\"2\">— a〉 *{%krumm%}.\n<div n=\"2\">— b〉 *{%gesalbt%} ({#samAlabDa#})."@de ;
