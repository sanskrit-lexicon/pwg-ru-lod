  skos:definition "<div n=\"p\">— С {#A#}\n<div n=\"1\">— 1〉 обрывать, -резать, разрезать, -ламывать.\n<div n=\"1\">— 2〉 извлекать.\n<div n=\"1\">— 3〉 срезать —, вычитать —, удалять —, исключать от (<ab>Abl.</ab>).\n<div n=\"1\">— 4〉 вырывать <ls>KĀD. 2,88,14</ls>. отнимать, грабить.\n<div n=\"1\">— 5〉 прерывать.\n<div n=\"1\">— 6〉 удалять, уничтожать.\n<div n=\"1\">— 7〉 не замечать, не принимать во внимание."@ru ;
  pwglex:sourceGloss "<div n=\"p\">— Mit {#A#}\n<div n=\"1\">— 1〉 {%abreissen, -schneiden, zerschneiden, -brechen%}.\n<div n=\"1\">— 2〉 {%herausnehmen%}.\n<div n=\"1\">— 3〉 {%abschneiden —, abziehen —, entfernen —, ausschliessen von%} (<ab>Abl.</ab>).\n<div n=\"1\">— 4〉 {%entreissen%} <ls>KĀD. 2,88,14</ls>. {%wegnehmen, rauben%}.\n<div n=\"1\">— 5〉 {%unterbrechen%}.\n<div n=\"1\">— 6〉 {%entfernen, zu Nichte machen%}.\n<div n=\"1\">— 7〉 {%nicht beachten, keine Rücksicht nehmen auf%}."@de ;
