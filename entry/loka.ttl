  skos:definition "लोक\t/loka/\t\t/лока/\tlōka m. міръ, свѣтъ, coll. и pl. люди, М. 39 небеса. — [лат. lūcus, лит. laũkas].\tс. 261"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
