<https://w3id.org/sanskrit-lexicon/repwg/entry/smfti> a ontolex:LexicalEntry ;
  rdfs:label "smṛti"@sa-Latn ;
  dct:isPartOf <https://w3id.org/sanskrit-lexicon/repwg/lexicon/pwg-ru> ;
  ontolex:canonicalForm <https://w3id.org/sanskrit-lexicon/repwg/lemma/smfti> ;
