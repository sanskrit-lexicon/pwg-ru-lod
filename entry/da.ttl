  skos:definition "<div n=\"p\">— {#prati#}\n<div n=\"1\"> 1) {%приставлять, вновь приставлять, вставлять; восстанавливать; давать, возвращать%} (с <ab>loc.</ab> или <ab>dat.</ab>): {#yaTA BasattaH SiraH pratidaDyAt#} {%как если бы поставить голову на место срама%}\n<ls>ŚAT. BR. 1,9,2,3.</ls> <ls n=\"ŚAT. BR.\">3,4,1,26.</ls> {#tada^gne\\ cakzu\\H prati^ Dehi re\\Be#}\n<ls>ṚV. 10,87,12.</ls> {#jaNGA\\M sarta^ve pra\\tya^Dattam#}\n<ls n=\"ṚV.\">1,116,15.</ls> <ls n=\"ṚV. 1,\">118,8.</ls> <ls>ŚAT. BR. 4,1,5,15.</ls> <ls n=\"ŚAT. BR.\">14,1,1,18. fgg.</ls> <ab>med.</ab>\n<ls n=\"ŚAT. BR.\">7,4,2,5.</ls> — {#prati\\ yada^sya\\ vajra^M bA\\HvorDuH#}\n<ls>ṚV. 2,20,8.</ls> {#hastA^ya\\ vajra\\H prati^ DAyi#}\n<ls n=\"ṚV.\">8,59,2.</ls> {#Atmani hotA prARAnpratiDAya vAcaM visfjate#}\n<ls>AIT. BR. 2,21.</ls> {#rA\\jyame\\vAsminprati^daDAti#}\n<ls>TBR. 1,7,4,2.</ls> {#prati ma etadDatta yena me yUyamudakramizwa#}\n<ls>ŚAT. BR. 8,1,1,3.</ls> <ls n=\"ŚAT. BR. 8,\">2,1,12.</ls> <ls n=\"ŚAT. BR. 8,\">4,1,7.</ls>\n<ls>TS. 5,3,12,1.</ls> {#sa\\pta fza^ya\\H prati^hitA\\H SarI^re#}\n<ls>VS. 34,55.</ls> {#e\\taM vo\\ yuvA^na\\M prati^ daDmo\\#} (правильнее {#pari dadAmasi#}\n<ls>TS. 3,3,9,1</ls>) {#atra^#}\n<ls>AV. 9,4,24.</ls> {#so 'syAyamAtmA#} ({#ayamitara AtmA#} при\n<ls>ŚAṂK.</ls> к <ls>BṚH. ĀR. UP. p. 307</ls>) {#puRyeByaH karmaByaH pratiDIyate#} {%занимает его место в священных делах%}\n<ls>AIT. UP. 4,4.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#prati#}\n<div n=\"1\"> 1) {%ansetzen, wieder ansetzen, einsetzen; wiederherstellen; geben, wiedergeben%} (mit <ab>loc.</ab> oder <ab>dat.</ab>): {#yaTA BasattaH SiraH pratidaDyAt#} {%wie wenn man den Kopf an die Stelle der Scham setzte%}\n<ls>ŚAT. BR. 1,9,2,3.</ls> <ls n=\"ŚAT. BR.\">3,4,1,26.</ls> {#tada^gne\\ cakzu\\H prati^ Dehi re\\Be#}\n<ls>ṚV. 10,87,12.</ls> {#jaNGA\\M sarta^ve pra\\tya^Dattam#}\n<ls n=\"ṚV.\">1,116,15.</ls> <ls n=\"ṚV. 1,\">118,8.</ls> <ls>ŚAT. BR. 4,1,5,15.</ls> <ls n=\"ŚAT. BR.\">14,1,1,18. fgg.</ls> <ab>med.</ab>\n<ls n=\"ŚAT. BR.\">7,4,2,5.</ls> — {#prati\\ yada^sya\\ vajra^M bA\\HvorDuH#}\n<ls>ṚV. 2,20,8.</ls> {#hastA^ya\\ vajra\\H prati^ DAyi#}\n<ls n=\"ṚV.\">8,59,2.</ls> {#Atmani hotA prARAnpratiDAya vAcaM visfjate#}\n<ls>AIT. BR. 2,21.</ls> {#rA\\jyame\\vAsminprati^daDAti#}\n<ls>TBR. 1,7,4,2.</ls> {#prati ma etadDatta yena me yUyamudakramizwa#}\n<ls>ŚAT. BR. 8,1,1,3.</ls> <ls n=\"ŚAT. BR. 8,\">2,1,12.</ls> <ls n=\"ŚAT. BR. 8,\">4,1,7.</ls>\n<ls>TS. 5,3,12,1.</ls> {#sa\\pta fza^ya\\H prati^hitA\\H SarI^re#}\n<ls>VS. 34,55.</ls> {#e\\taM vo\\ yuvA^na\\M prati^ daDmo\\#} (richtiger {#pari dadAmasi#}\n<ls>TS. 3,3,9,1</ls>) {#atra^#}\n<ls>AV. 9,4,24.</ls> {#so 'syAyamAtmA#} ({#ayamitara AtmA#} bei\n<ls>ŚAṂK.</ls> zu <ls>BṚH. ĀR. UP. p. 307</ls>) {#puRyeByaH karmaByaH pratiDIyate#} {%tritt für die heiligen Werke an seine Stelle%}\n<ls>AIT. UP. 4,4.</ls>"@de ;
