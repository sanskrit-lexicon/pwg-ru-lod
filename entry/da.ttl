  skos:definition "<div n=\"p\">— {#upa#}\n<div n=\"1\"> 1) {%возлагать, накладывать, надевать, помещать в%}; <ab>act.</ab> <ab>med.</ab>: {#upaDehi bAhum#}\n<ls>NIR. 4,20.</ls>\n<ls>ĀŚV. GṚHY. 2,21.</ls> {#upa^ Datsva\\ hasta^m#}\n<ls>AV. 14,2,39.</ls> {#aDijAnu bAhumupaDAya#}\n<ls>ŚIŚ. 9,54.</ls> {#u\\BoBa^yAvi\\nnupa^ Dehi\\ daMzwrA^#}\n<ls>ṚV. 10,87,3.</ls> {#upa^ te 'DA\\M saha^mAnAm#}\n<ls n=\"ṚV. 10,\">145,6.</ls> {#izwakAm#}\n<ls>ŚAT. BR. 2,1,2,15.</ls>\n<ls>P. 4,4,125</ls>, <ab>Sch.</ab>\n{#ozaDIH#}\n<ls>ŚAT. BR. 7,2,3,1.</ls> <ls n=\"ŚAT. BR.\">6,2,1,17.</ls> {#a\\Msa\\DrIM Su\\dDAmupa^ Dehi nAri#} {%ставить на огонь%}\n<ls>AV. 11,1,23.</ls> {#kapAlAni#}\n<ls>ŚAT. BR. 2,6,1,4.</ls> <ls n=\"ŚAT. BR.\">3,5,4,22.</ls> {#pAtrI skyopahitA#} {%поставленный на%} <ab>S.</ab>\n<ls>KĀTY. ŚR. 2,3,28.</ls> {#(agnim) aDastAnnopadaDyAt#} {%не кладу под что-л.%}\n<ls>M. 4,54.</ls> {#upahitaM SiSirApagamaSriyA mukulajAlam — kiMSuke#}\n<ls>RAGH. 9,27.</ls> {#BIme copADitAnane#} {%вложил в%}\n<ls>BHAṬṬ. 15,47.</ls> {#hemnIvopahito maRIH#} {%вставленный в, оправленный в%}\n<ls>MBH. 5,3382.</ls> {#upahitanirmalavajravITikAyAm (saBAyAm)#}\n<ls>HARIV. 12705.</ls> {#puravanitAnAM manasi kusumaSarAsanamupadaDAnaH#} {%помещая бога любви в сердце%}\n<ls>BHĀG. P. 5,5,31.</ls> {#hfdi cEnAm (sarasvatIm) upaDAtumarhasi#} так <ab>v. a.</ab> {%принять близко к сердцу%}\n<ls>RAGH. 8,76.</ls> {%запрягать%} (коней): {#upa\\ tmani\\ daDA^no Du\\ryA\\3^\\SUn#}\n<ls>ṚV. 4,29,4.</ls> {#upahitasUkzmagranTinA skanDadeSe valkalena#} так <ab>v. a.</ab> {%приставленный%}\n<ls>ŚĀK. 18.</ls> {%возлагать на кого-л.%} так <ab>v. a.</ab> {%передавать кому-л. заботу о чем-л.%}: {#tadupahitakuwumbaH#}\n<ls>RAGH. 7,68.</ls> {#kriyAm#} {%прилагать усилия к чему-л.%}: {#kriyA hi vastUpahitA prasIdati#}\n<ls n=\"RAGH.\">3,29.</ls> {%поручить кому-л.%} так <ab>v. a.</ab> {%учить%}: {#miTaH strIzu nftyamupaDAya#}\n<ls n=\"RAGH.\">19,36.</ls>"@ru ;
