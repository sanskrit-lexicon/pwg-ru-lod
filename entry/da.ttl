  skos:definition "<div n=\"p\">— {#saMni#}\n<div n=\"1\"> 1) {%сложить вместе в%} или {%при, сохранить, положить, поместить в%}: {#tanUrvaruRasya gfhe saMnidaDAvahE#}\n<ls>AIT. BR. 1,24.</ls>\n<ls>TS. 1,5,1,1.</ls>\n<ls>TBR. 1,3,1,1.</ls>\n<ls>ŚAT. BR. 3,4,2,15.</ls> {#tena#} ({#AdityaH#}) {#sarvAnprARAnraSmizu saMniDatte#}\n<ls>PRAŚNOP. 1,6.</ls> {#tato vittaM viviDaM saMniDAya yaTotsAhaM kArayitvA ca koSam#} {%накапливать, собирать%}\n<ls>MBH. 14,290.</ls> {#meGezUrDvaM saMniDatte prARAnAM pavanaH patiH . tacca meGagataM vAri Sakro varzati#}\n<ls n=\"MBH.\">13,3235.</ls> {#saMnidaDyAt#}\n<ls>SUŚR. 1,164,7.</ls> {#dUrAdAhftya samiDaH saMnidaDyAdvihAyasi#}\n<ls>M. 2,186.</ls> {#saMnidaDustatra pARqavA hyAyuDAni#}\n<ls>MBH. 1,482.</ls> <ls n=\"MBH. 1,\">2984.</ls>\n<ls>R. 3,75,69.</ls> {#(karkawakam) karpUrapuwikAmaDye saMniDAya#}\n<ls>PAÑCAT. 265,5.</ls> {#dfzwim#} {%устремить взор на%} (<ab>loc.</ab>), <ab>med.</ab>\n<ls>RAGH. 13,44.</ls> {#hfdayasaMnihita#} {%вложенный в сердце, живущий в сердце%}\n<ls>ŚĀK. 67.</ls> {#hfdayaM saMniDAya#} {%сосредоточить сердце на одной точке, собраться с духом%}\n<ls>MUṆḌ. UP. 2,2,7.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#saMni#}\n<div n=\"1\"> 1) {%zusammen niederlegen in%} oder {%bei, aufheben, niederlegen, legen in%}: {#tanUrvaruRasya gfhe saMnidaDAvahE#}\n<ls>AIT. BR. 1,24.</ls>\n<ls>TS. 1,5,1,1.</ls>\n<ls>TBR. 1,3,1,1.</ls>\n<ls>ŚAT. BR. 3,4,2,15.</ls> {#tena#} ({#AdityaH#}) {#sarvAnprARAnraSmizu saMniDatte#}\n<ls>PRAŚNOP. 1,6.</ls> {#tato vittaM viviDaM saMniDAya yaTotsAhaM kArayitvA ca koSam#} {%aufspeichern, ansammeln%}\n<ls>MBH. 14,290.</ls> {#meGezUrDvaM saMniDatte prARAnAM pavanaH patiH . tacca meGagataM vAri Sakro varzati#}\n<ls n=\"MBH.\">13,3235.</ls> {#saMnidaDyAt#}\n<ls>SUŚR. 1,164,7.</ls> {#dUrAdAhftya samiDaH saMnidaDyAdvihAyasi#}\n<ls>M. 2,186.</ls> {#saMnidaDustatra pARqavA hyAyuDAni#}\n<ls>MBH. 1,482.</ls> <ls n=\"MBH. 1,\">2984.</ls>\n<ls>R. 3,75,69.</ls> {#(karkawakam) karpUrapuwikAmaDye saMniDAya#}\n<ls>PAÑCAT. 265,5.</ls> {#dfzwim#} {%das Auge heften auf%} (<ab>loc.</ab>), <ab>med.</ab>\n<ls>RAGH. 13,44.</ls> {#hfdayasaMnihita#} {%in's Herz gelegt, im Herzen wohnend%}\n<ls>ŚĀK. 67.</ls> {#hfdayaM saMniDAya#} {%das Herz auf einen Punkt richten, sich sammeln%}\n<ls>MUṆḌ. UP. 2,2,7.</ls>"@de ;
