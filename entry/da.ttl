  skos:definition "1〉 {%ставить, класть —, помещать —, вносить в, на или при%} (<ab>Loc.</ab>), зародыш {%помещать%} в женщину (<ab>Gen.</ab>) <ls n=\"Chr.\">71,9</ls>. Добродетели {%кому-либо%} (<ab>Loc.</ab>) {%прививать,%} взор, мысль, думы {%направлять на%} (<ab>Loc.</ab>), старание {%прилагать к%} ({#pratipAtram#}), вину {%на кого-либо%} (<ab>Loc.</ab>) {%перекладывать,%} страх {%кому-либо%} (<ab>Loc.</ab>) {%внушать%}. В позднейшем языке обычно <ab>Med.</ab> {#A/hita#} {%наложенный, помещенный внутрь%} (зародыш <ls n=\"Chr.\">73,6</ls>)."@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 1〉 {%hinstellen, legen —, setzen —, bringen in, an oder auf%} (<ab>Loc.</ab>), Leibesfrucht {%hineinlegen%} in ein Weib (<ab>Gen.</ab>) <ls n=\"Chr.\">71,9</ls>. Tugenden {%Jmd%} (<ab>Loc.</ab>) {%einimpfen,%} dem Blick, den Sinn, die Gedanken {%richten auf%} (<ab>Loc.</ab>), Sorgfalt {%verwenden auf%} ({#pratipAtram#}), eine Schuld {%auf Jmd%} (<ab>Loc.</ab>) {%wälzen,%} Furcht {%Jmd%} (<ab>Loc.</ab>) {%einjagen%}. In der späteren Sprache gewöhnlich <ab>Med.</ab> {#A/hita#} {%aufgelegt, hineingelegt%} (Leibesfrucht <ls n=\"Chr.\">73,6</ls>)."@de ;
