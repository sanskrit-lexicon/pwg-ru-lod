  skos:definition "<div n=\"1\">— 3) {%вбирать в себя%}: {#viSvaMBare devi mAmantarDAtumarhasi#}\n<ls>RAGH. 15,81.</ls> {%содержать в себе%}: {#SAstrametat . antarDAsyati tatsarvametadvaH kaTitaM mayA#}\n<ls>MBH. 12,12747.</ls> {%проявлять в глубине, в сердце, являть внутри%}: {#sEpAntardaDatI tamoviGawanAdAnandamAtmapraBam#}\n<ls>PRAB. 80,6.</ls> — {#antarhita#} <ab>partic.</ab>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3) {%in sich aufnehmen%}: {#viSvaMBare devi mAmantarDAtumarhasi#}\n<ls>RAGH. 15,81.</ls> {%in sich enthalten%}: {#SAstrametat . antarDAsyati tatsarvametadvaH kaTitaM mayA#}\n<ls>MBH. 12,12747.</ls> {%im Innern, im Herzen zur Erscheinung bringen, zeigen%}: {#sEpAntardaDatI tamoviGawanAdAnandamAtmapraBam#}\n<ls>PRAB. 80,6.</ls> — {#antarhita#} <ab>partic.</ab>"@de ;
