  skos:definition "<div n=\"1\">— 2) {%побуждать к%} (<ab>dat.</ab>): {#anu\\ pra ye^je\\ jana\\ ojo^ asya sa\\trA da^Dire\\ anu^ vI\\ryA^ya#}\n<ls>ṚV. 6,36,2.</ls>"@ru ;
