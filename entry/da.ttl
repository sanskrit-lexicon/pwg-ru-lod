  skos:definition "<div n=\"1\">— 3) {%надевать, накидывать на что-л.; обвивать, связывать%}; <ab>med.</ab>, реже <ab>act.</ab>: {#vAsa^sA#} <ls>AV. 7,37,1.</ls> {#ra\\Sa\\nABi^rda\\SaBi^ra\\Bya^DItAm#} <ls>ṚV. 10,4,6.</ls> {#tenA\\hami^ndrajA\\lenA\\mUntama^sA\\Bi da^DAmi\\ sarvA^n#} <ls>AV. 8,8,8.</ls> <ls n=\"AV.\">4,16,7.</ls> {#a\\Bi tvA^ jari\\mAhi^ta\\#} (по всей видимости, ошибочно вм. {#aDita) gAmu\\kzaRa^miva\\ rajjvA^#} <ls n=\"AV.\">3,11,8.</ls> {#a\\Bi taM nirf^tirDattA\\maSva^mivASvABi\\DAnyA^#} <ls n=\"AV.\">4,36,10.</ls> <ls n=\"AV.\">8,8,5.</ls> <ls n=\"AV.\">19,50,5.</ls> {#a\\Bi hi ra^Sa\\nayADi^ta#} <ls>VS. 21,46.</ls> <ls>ŚAT. BR. 11,3,1,1.</ls> <ls n=\"ŚAT. BR.\">14,2,1,8.</ls> {#aBi^hita#} {%привязанный, запряженный, впряженный%}: {#yatra\\ vahni^ra\\Bihi^to du\\drava^t#} <ls>ṚV. 5,50,4.</ls> <ls n=\"ṚV.\">10,85,11.</ls> <ls>AV. 6,63,3.</ls> <ls n=\"AV.\">9,3,8.</ls> <ls>ŚAT. BR. 3,2,4,18.</ls> <ls n=\"ŚAT. BR.\">6,3,1,26.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3) {%anlegen, umlegen mit Etwas; umwinden, binden%}; <ab>med.</ab>, seltener <ab>act.</ab>: {#vAsa^sA#} <ls>AV. 7,37,1.</ls> {#ra\\Sa\\nABi^rda\\SaBi^ra\\Bya^DItAm#} <ls>ṚV. 10,4,6.</ls> {#tenA\\hami^ndrajA\\lenA\\mUntama^sA\\Bi da^DAmi\\ sarvA^n#} <ls>AV. 8,8,8.</ls> <ls n=\"AV.\">4,16,7.</ls> {#a\\Bi tvA^ jari\\mAhi^ta\\#} (wohl fehlerhaft für {#aDita) gAmu\\kzaRa^miva\\ rajjvA^#} <ls n=\"AV.\">3,11,8.</ls> {#a\\Bi taM nirf^tirDattA\\maSva^mivASvABi\\DAnyA^#} <ls n=\"AV.\">4,36,10.</ls> <ls n=\"AV.\">8,8,5.</ls> <ls n=\"AV.\">19,50,5.</ls> {#a\\Bi hi ra^Sa\\nayADi^ta#} <ls>VS. 21,46.</ls> <ls>ŚAT. BR. 11,3,1,1.</ls> <ls n=\"ŚAT. BR.\">14,2,1,8.</ls> {#aBi^hita#} {%angebunden, angeschirrt, angespannt%}: {#yatra\\ vahni^ra\\Bihi^to du\\drava^t#} <ls>ṚV. 5,50,4.</ls> <ls n=\"ṚV.\">10,85,11.</ls> <ls>AV. 6,63,3.</ls> <ls n=\"AV.\">9,3,8.</ls> <ls>ŚAT. BR. 3,2,4,18.</ls> <ls n=\"ŚAT. BR.\">6,3,1,26.</ls>"@de ;
