  skos:definition "<div n=\"1\">— 2) {%накладывать%} (стрелу), {%прицеливаться%}: {#sa idaste^va\\ prati^ DAdasi\\zyan#}\n<ls>ṚV. 6,3,5.</ls> {#izu\\rna Danva\\nprati^DIyate#}\n<ls n=\"ṚV.\">9,69,1.</ls> <ls n=\"ṚV.\">1,155,2.</ls> {#mA Sa^kanprati\\DAmizu^m#}\n<ls>AV. 8,8,20.</ls> <ab>med.</ab> <ls>VS. 16,22.</ls> <ls>LĀṬY. 3,10,7. 8.</ls> {#pra/tihitA#} (с дополнением {#izu#}) {%наложенная стрела%}\n<ls>ṚV. 10,103,3.</ls>\n<ls>AV. 6,90,3.</ls> <ls n=\"AV.\">11,2,1.</ls>\n<ls>ŚĀṄKH. BR. 6,1.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) {%anlegen%} (den Pfeil), {%zielen%}: {#sa idaste^va\\ prati^ DAdasi\\zyan#}\n<ls>ṚV. 6,3,5.</ls> {#izu\\rna Danva\\nprati^DIyate#}\n<ls n=\"ṚV.\">9,69,1.</ls> <ls n=\"ṚV.\">1,155,2.</ls> {#mA Sa^kanprati\\DAmizu^m#}\n<ls>AV. 8,8,20.</ls> <ab>med.</ab> <ls>VS. 16,22.</ls> <ls>LĀṬY. 3,10,7. 8.</ls> {#pra/tihitA#} (mit Ergänzung von {#izu#}) {%der angelegte Pfeil%}\n<ls>ṚV. 10,103,3.</ls>\n<ls>AV. 6,90,3.</ls> <ls n=\"AV.\">11,2,1.</ls>\n<ls>ŚĀṄKH. BR. 6,1.</ls>"@de ;
