  pwglex:differentia "Дезидератив: выражает желание совершить действие, обозначенное корнем dhā («давать», «наделять», «помещать»). Оттенки различаются контекстом: «желать дать/доставить» (первый); «желать наделить/одарить» (второй); «желать приобрести для себя» (третий — атм., с возвратным значением); «желать собрать/раздобыть» (четвёртый)."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-06-29T12:31:01Z"^^xsd:dateTime ;
