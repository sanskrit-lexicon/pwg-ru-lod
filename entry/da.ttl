<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/DA/tr/_x5f_d_x5f_a_x7e__x7e_h0_x5f_zz_x5f_pw02/mit_x5f_T10_x5f_1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 1〉 опускать, класть [Page3-153-b], откладывать, укладывать, помещать, ставить — на, у или в (<ab>Loc.</ab>), вкладывать — в (<ab>Loc.</ab>, <ab>Loc.</ab> с {#anta/r#} или {#˚antar#}), класть что-либо перед кем-либо (<ab>Dat.</ab>). {#BUmO#} или {#avawe#} (<ls>R. 3,8,20</ls>) класть в землю, в яму, отсюда <ab>v. a.</ab> погребать; класть на голову (<ab>Loc.</ab>, в виде исключения также <ab>Instr.</ab>), а также <ab>v. a.</ab> высоко поднимать <ls n=\"Chr.\">152,12</ls>. {#manasi#} класть в сердце, отсюда <ab>v. a.</ab> думать про себя. <ab>Pass.</ab> также пребывать —, содержаться в (<ab>Loc.</ab>), переходить —, растворяться в (<ab>Loc.</ab>); {#ni/hita#} положенный <ab>u. s. w.</ab>, расположившийся (о войске), застрявший —, находящийся в (<ab>Loc.</ab> или в <ab>Comp.</ab> предшествующем) <ls>ĀPAST. 1,22,6</ls>."@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 1〉 {%niedersetzen, niederlegen, [Page3-153-b] ablegen, hinlegen, hinsetzen, hinstellen, — auf, an oder in%} (<ab>Loc.</ab>), {%hineinlegen, — in%} (<ab>Loc.</ab>, <ab>Loc.</ab> mit {#anta/r#} oder {#˚antar#}), {%Etwas vor Jmd%} (<ab>Dat.</ab>) {%hinlegen%}. {#BUmO#} oder {#avawe#} (<ls>R. 3,8,20</ls>) {%in die Erde, in eine Grube legen,%} so <ab>v. a.</ab> {%begraben;%} auf den Kopf (<ab>Loc.</ab>, ausnahmsweise auch <ab>Instr.</ab>) {%legen auch%} so <ab>v. a.</ab> {%hoch aufnehmen%} <ls n=\"Chr.\">152,12</ls>. {#manasi#} {%inʼs Herz legen,%} so <ab>v. a.</ab> {%bei sich denken%}. <ab>Pass.</ab> auch {%ruhen —, enthalten sein in%} (<ab>Loc.</ab>), {%übergehen —, sich auflösen in%} (<ab>Loc.</ab>) {#ni/hita#} {%niedergesetzt%} <ab>u. s. w.</ab>, {%gelagert (ein Heer), steckend —, befindlich in%} (<ab>Loc.</ab> oder im <ab>Comp.</ab> vorangehend) <ls>ĀPAST. 1,22,6</ls>."@de ;
  pwglex:senseTag "mit_T10_1" ;
