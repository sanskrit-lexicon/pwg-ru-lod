  skos:definition "<div n=\"p\">— {#upani#}\n<div n=\"1\"> 1) {%ставить рядом, помещать рядом%}: {#vedO pariDIMSca SakalAMScopanidaDati#}\n<ls>ŚAT. BR. 2,5,3,5.</ls> <ls n=\"ŚAT. BR.\">3,7,1,3.</ls> <ls n=\"ŚAT. BR. 3,7,\">2,1.</ls>\n<ls>PAÑCAV. BR. 21,2,9.</ls> {#nava SarAve SamIparRAni copanihitAni Bavanti#}\n<ls>ĀŚV. GṚHY. 1,7.</ls> <ab>med.</ab>: {#daRqam#}\n<ls>GOBH. 4,9,11.</ls> {%подносить кому-л.%} (кушанье <ab>u. s. w.</ab>): {#yaTA\\nyasmA^ upAna\\DAya^ . a\\nyasmE^ pra\\yacCa^ti#} {%как если бы он одному подносил, другому действительно давал%}\n<ls>TBR. 2,1,3,6.</ls> {#yaTA yasmA aSanamAharettasmA AhftyEvopanidaDyAdevaM tat#}\n<ls>ŚAT. BR. 2,3,1,17.</ls> {#neto 'nye (kulmAzAH) vidyante yacca ye ma ima upanihitAH#}\n<ls>CHĀND. UP. 1,10,2.</ls> <ab>med.</ab> <ls>LĀṬY. 4,11,17.</ls> {%приближать%}: {#karRayorupaniDAya#} (уста) {#meDA jananaM japati#}\n<ls>ĀŚV. GṚHY. 1,15</ls> (<ab>vgl.</ab> {#aBini#}). {%приводить, доставлять%}: {#vahati malayasamIre madanamupaniDAya#}\n<ls>GĪT. 5,2.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#upani#}\n<div n=\"1\"> 1) {%daneben setzen, — stellen%}: {#vedO pariDIMSca SakalAMScopanidaDati#}\n<ls>ŚAT. BR. 2,5,3,5.</ls> <ls n=\"ŚAT. BR.\">3,7,1,3.</ls> <ls n=\"ŚAT. BR. 3,7,\">2,1.</ls>\n<ls>PAÑCAV. BR. 21,2,9.</ls> {#nava SarAve SamIparRAni copanihitAni Bavanti#}\n<ls>ĀŚV. GṚHY. 1,7.</ls> <ab>med.</ab>: {#daRqam#}\n<ls>GOBH. 4,9,11.</ls> {%Jmd%} (eine Speise <ab>u. s. w.</ab>) {%vorsetzen%}: {#yaTA\\nyasmA^ upAna\\DAya^ . a\\nyasmE^ pra\\yacCa^ti#} {%wie wenn er dem Einen vorsetzt, dem Andern wirklich giebt%}\n<ls>TBR. 2,1,3,6.</ls> {#yaTA yasmA aSanamAharettasmA AhftyEvopanidaDyAdevaM tat#}\n<ls>ŚAT. BR. 2,3,1,17.</ls> {#neto 'nye (kulmAzAH) vidyante yacca ye ma ima upanihitAH#}\n<ls>CHĀND. UP. 1,10,2.</ls> <ab>med.</ab> <ls>LĀṬY. 4,11,17.</ls> {%nähern%}: {#karRayorupaniDAya#} (seinen Mund) {#meDA jananaM japati#}\n<ls>ĀŚV. GṚHY. 1,15</ls> (<ab>vgl.</ab> {#aBini#}). {%herbeiführen, herbeibringen%}: {#vahati malayasamIre madanamupaniDAya#}\n<ls>GĪT. 5,2.</ls>"@de ;
