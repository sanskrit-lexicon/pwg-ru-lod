<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/DA/tr/_x5f_d_x5f_a_x7e__x7e_h0_x5f_08_x5f_antar/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\"> 1) {%класть, ставить посередине, между%}: {#na tfRaM canAntarDAya#}\n<ls>ŚAT. BR. 4,3,4,13.</ls> <ls n=\"ŚAT. BR. 4,3,4,\">4.</ls>\n<ls>PĀR. GṚHY. 2,1.</ls> {#pARim#}\n<ls>KĀTY. ŚR. 7,9,4.</ls> <ls n=\"KĀTY. ŚR.\">9,7,4.</ls> {#udumbaraSAKAmantarDAyABiziYcati#}\n<ls>AIT. BR. 8,7.</ls> <ls n=\"AIT. BR. 8,\">13.</ls>\n<ls>ĀŚV. GṚHY. 1,10. 11.</ls> {#patnImantarDAya#} {%ставя посередине%}\n<ls>KĀTY. ŚR. 26,7,6.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\"> 1) {%dazwischenlegen, — setzen%}: {#na tfRaM canAntarDAya#}\n<ls>ŚAT. BR. 4,3,4,13.</ls> <ls n=\"ŚAT. BR. 4,3,4,\">4.</ls>\n<ls>PĀR. GṚHY. 2,1.</ls> {#pARim#}\n<ls>KĀTY. ŚR. 7,9,4.</ls> <ls n=\"KĀTY. ŚR.\">9,7,4.</ls> {#udumbaraSAKAmantarDAyABiziYcati#}\n<ls>AIT. BR. 8,7.</ls> <ls n=\"AIT. BR. 8,\">13.</ls>\n<ls>ĀŚV. GṚHY. 1,10. 11.</ls> {#patnImantarDAya#} {%dazwischenstellend%}\n<ls>KĀTY. ŚR. 26,7,6.</ls>"@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«Класть/ставить между, помещать посередине» — пространственное значение с antar, указывающим на промежуточное положение. Корпусный кандидат «покрыть» менее применим здесь."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
