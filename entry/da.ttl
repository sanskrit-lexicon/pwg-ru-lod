  skos:definition "<div n=\"1\">— 7) {%брать, принимать, получать%}; <ab>med.</ab>: {#A yadvajra^M daDi\\ze haste^#}\n<ls>ṚV. 7,28,2.</ls> {#A svaSvya\\M daDI^ta#}\n<ls n=\"ṚV.\">1,40,2.</ls> {#pi\\turnapA^ta\\mA da^DIta ve\\DAH#}\n<ls n=\"ṚV.\">10,10,1.</ls> {#(yajYaH) yamA ma^nu\\zvatpra\\divo^ daDi\\Dve#}\n<ls n=\"ṚV.\">4,34,3.</ls> {#imAM ca mAlAmADatsva#}\n<ls>R. 4,21,17.</ls>\n<ls>RAGH. 5,57.</ls>\n<ls>RĀJA-TAR. 4,36.</ls> {#pAtracIvaramADAya#}\n<ls>UPAG. AV. 7.</ls> {#garBam#} {%зачать, concipere%}: {#yaTe\\yaM pf^Ti\\vI BU\\tAnA\\M garBa^mAda\\De#}\n<ls>AV. 5,25,2.</ls>\n<ls>ṚV. 3,27,9.</ls> {#yaTA ca karkawI garBamADatte mftyumAtmanaH#}\n<ls>MBH. 4,272.</ls>\n<ls>RAGH. 2,75.</ls> {%зачать детей от женщины%}: {#vasudevaH sutAnazwAvAdaDe sahadevayA#}\n<ls>BHĀG. P. 9,24,51.</ls> {#takzapuzkaraSAlAdIndUrvAkzyAM vfka AdaDe#}\n<ls n=\"BHĀG. P. 9,24,\">42.</ls> {%принимать в себя, вбирать в себя%}: {#hantedamamftamantarAtmannAdaDAmahE#}\n<ls>ŚAT. BR. 2,2,2,10.</ls> {#jalamAdaDAnAm#} (<ab>v. l.</ab> {#AdadAnAm#})\n<ls>RAGH. 2,6.</ls> {#a\\mitrA^ hf\\tsvA da^DatAM Ba\\yam#}, отсюда <ab>v. a.</ab> {%испугаться%}\n<ls>AV. 8,8,2.</ls> {#kroDamAdaDe#}\n<ls>HARIV. 9283.</ls> {#AhitakroDA#}\n<ls>AMAR. 18.</ls> {#jinaSAsanamADAtum#} {%принять учение%}\n<ls>UPAG. AV. 2.</ls> {#vratamADAya#} {%принять на себя обет%} 20. <ab>act.</ab>: {#kapayo dUtavAkyAni SrutvEva BayamAdaDuH#} {%испугались%}\n<ls>R. 4,37,20.</ls> — {%взять при себе, хранить%}: {#AdaDate preNKamiSram#}\n<ls>ŚĀṄKH. ŚR. 18,24,3.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 7) {%nehmen, empfangen, erhalten%}; <ab>med.</ab>: {#A yadvajra^M daDi\\ze haste^#}\n<ls>ṚV. 7,28,2.</ls> {#A svaSvya\\M daDI^ta#}\n<ls n=\"ṚV.\">1,40,2.</ls> {#pi\\turnapA^ta\\mA da^DIta ve\\DAH#}\n<ls n=\"ṚV.\">10,10,1.</ls> {#(yajYaH) yamA ma^nu\\zvatpra\\divo^ daDi\\Dve#}\n<ls n=\"ṚV.\">4,34,3.</ls> {#imAM ca mAlAmADatsva#}\n<ls>R. 4,21,17.</ls>\n<ls>RAGH. 5,57.</ls>\n<ls>RĀJA-TAR. 4,36.</ls> {#pAtracIvaramADAya#}\n<ls>UPAG. AV. 7.</ls> {#garBam#} {%Leibesfrucht empfangen, concipere%}: {#yaTe\\yaM pf^Ti\\vI BU\\tAnA\\M garBa^mAda\\De#}\n<ls>AV. 5,25,2.</ls>\n<ls>ṚV. 3,27,9.</ls> {#yaTA ca karkawI garBamADatte mftyumAtmanaH#}\n<ls>MBH. 4,272.</ls>\n<ls>RAGH. 2,75.</ls> {%von der Frau Kinder empfangen%}: {#vasudevaH sutAnazwAvAdaDe sahadevayA#}\n<ls>BHĀG. P. 9,24,51.</ls> {#takzapuzkaraSAlAdIndUrvAkzyAM vfka AdaDe#}\n<ls n=\"BHĀG. P. 9,24,\">42.</ls> {%zu sich —, in sich aufnehmen%}: {#hantedamamftamantarAtmannAdaDAmahE#}\n<ls>ŚAT. BR. 2,2,2,10.</ls> {#jalamAdaDAnAm#} (<ab>v. l.</ab> {#AdadAnAm#})\n<ls>RAGH. 2,6.</ls> {#a\\mitrA^ hf\\tsvA da^DatAM Ba\\yam#} so <ab>v. a.</ab> {%erschrecken%}\n<ls>AV. 8,8,2.</ls> {#kroDamAdaDe#}\n<ls>HARIV. 9283.</ls> {#AhitakroDA#}\n<ls>AMAR. 18.</ls> {#jinaSAsanamADAtum#} {%die Lehre annehmen%}\n<ls>UPAG. AV. 2.</ls> {#vratamADAya#} {%ein Gelübde auf sich nehmen%} 20. <ab>act.</ab>: {#kapayo dUtavAkyAni SrutvEva BayamAdaDuH#} {%erschraken%}\n<ls>R. 4,37,20.</ls> — {%an sich nehmen, aufbewahren%}: {#AdaDate preNKamiSram#}\n<ls>ŚĀṄKH. ŚR. 18,24,3.</ls>"@de ;
