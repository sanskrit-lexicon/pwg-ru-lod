  skos:definition "<div n=\"p\">— {#api#} или {#pi#} (с <ls>MANU</ls> чаще, чем {#api#}) <div n=\"1\"> 1) {%вкладывать; подавать, отдавать%}: {#vE\\SvA\\na\\rasya\\ daMzwra^yora\\gnerapi^ daDAmi\\ tam#} <ls>AV. 4,36,2.</ls> <ls>VS. 11,77.</ls> <ls>ŚAT. BR. 12,7,3,20.</ls> {#ru\\drAya^ pa\\SUnapi^daDyAt#} <ls>TBR. 1,1,5,9.</ls> <ls>TS. 5,2,5,3.</ls> {#jA\\tAyE\\vAsmA\\ anna\\mapi^ daDAti#} <ls n=\"TS. 5,\">3,4,1.</ls> {#stanam#} <ls>ŚAT. BR. 2,2,1,1.</ls> {#mftyava AtmAnamapidaDAt#} <ls n=\"ŚAT. BR.\">13,3,5,2.</ls> {#brahma kzatrAyApidaDyuH#} <ls>PAÑCAV. BR. 18,10,8.</ls> {#de\\vA de\\vezva^daDu\\rapi\\ kratu^m#} приблизительно {%класть в%} или {%добавлять%} <ls>ṚV. 10,56,4.</ls> {#kra\\vyAdo^ vf\\ktvapi^ DatsvA\\san#} {%вложи в свои уста%} <ls n=\"ṚV. 10,\">87,2.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#api#} oder {#pi#} (von <ls>MANU</ls> an häufiger als {#api#}) <div n=\"1\"> 1) {%hineinstecken; darreichen, hingeben%}: {#vE\\SvA\\na\\rasya\\ daMzwra^yora\\gnerapi^ daDAmi\\ tam#} <ls>AV. 4,36,2.</ls> <ls>VS. 11,77.</ls> <ls>ŚAT. BR. 12,7,3,20.</ls> {#ru\\drAya^ pa\\SUnapi^daDyAt#} <ls>TBR. 1,1,5,9.</ls> <ls>TS. 5,2,5,3.</ls> {#jA\\tAyE\\vAsmA\\ anna\\mapi^ daDAti#} <ls n=\"TS. 5,\">3,4,1.</ls> {#stanam#} <ls>ŚAT. BR. 2,2,1,1.</ls> {#mftyava AtmAnamapidaDAt#} <ls n=\"ŚAT. BR.\">13,3,5,2.</ls> {#brahma kzatrAyApidaDyuH#} <ls>PAÑCAV. BR. 18,10,8.</ls> {#de\\vA de\\vezva^daDu\\rapi\\ kratu^m#} etwa {%legen in%} oder {%zulegen%} <ls>ṚV. 10,56,4.</ls> {#kra\\vyAdo^ vf\\ktvapi^ DatsvA\\san#} {%stecke in deinen Mund%} <ls n=\"ṚV. 10,\">87,2.</ls>"@de ;
