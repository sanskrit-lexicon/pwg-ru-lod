<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/naBas/dict/kna/2> a ontolex:LexicalSense ;
  skos:definition "नभस्\t/nabhas/\t\t/набхас/\tnabhas n. небо. — [νέφος, νεφέλη, лат. nebula, нѣм. Nebel, лит. debesis, цсл. nebo „небо“].\tс. 234"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

