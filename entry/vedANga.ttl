<https://w3id.org/sanskrit-lexicon/repwg/entry/vedANga> a ontolex:LexicalEntry ;
  rdfs:label "vedāṅga"@sa-Latn ;
  dct:isPartOf <https://w3id.org/sanskrit-lexicon/repwg/lexicon/pwg-ru> ;
