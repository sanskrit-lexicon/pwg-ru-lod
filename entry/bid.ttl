<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/Bid/tr/_x5f_bid_x7e__x7e_h0_x5f_23_x5f_sam/2> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 2) {%сводить вместе, приводить в соприкосновение, соединять, смешивать%}: {#na saMBi^natti\\ tasmA\\dasa^MBinnAH prA\\RAH#}\n<ls>TS. 6,2,11,2.</ls> {#asa^MBinda\\nnava^dyati#}\n<ls n=\"TS. 6,\">4,1,1.</ls> <ls n=\"TS. 6,\">5,9,3.</ls> <ls>TBR. 3,7,5,6.</ls> {#pf\\Ta\\mA\\trAdvedI\\ asa^MBinne BavataH#} {%отстоять на%} <is>Pṛtha</is> {%друг от друга%}\n<ls n=\"TBR.\">1,6,4,2.</ls> {#yadvA urvarayorasaMBinnaM Bavati Kila iti vE tadAcakzate#} {%то, что (невспаханное) лежит между двумя полями%}\n<ls>ŚAT. BR. 8,3,4,1.</ls>\n<ls>ŚĀṄKH. BR. 30,8.</ls>\n<ls>KĀṬH. 25,9.</ls>\n<ls>KĀTY. ŚR. 1,9,6.</ls> {#uparavAnakzRayA saMBindyAt#}\n<ls n=\"KĀTY. ŚR.\">8,5,11.</ls> <ls>KAUŚ. 27. 50.</ls> {#saMBinnasarvANgaM kUrmam#} {%стянутый, сомкнутый%}\n<ls>MBH. 4,794.</ls> {#snigDakuntalasaMBinnakirIwamukuwojjvala#} {%плотно прилегающий%}\n<ls>PAÑCAR. 3,11,18.</ls> {#kadambasaMBinnaH pavanaH#} {%вошедший в соприкосновение%}\n<ls>BHAṬṬ. 7,5.</ls> {#saMBinno mAruto yasya marmasTAnAni kfntati#} так <ab>v. a.</ab> {%компактный%}\n<ls>MĀRK. P. 43,14</ls> = <ls>VĀYU-P.</ls> in <ls>Verz. d. Oxf. H. 51,b,6.</ls> {#saMBinna#} {%связанный%} neben {#viBinna#} als <ab>Beiw.</ab> <is>Śiva's</is>\n<ls>MBH. 12,10374.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) {%zusammenbringen, in Berührung bringen, verbinden, vermengen%}: {#na saMBi^natti\\ tasmA\\dasa^MBinnAH prA\\RAH#}\n<ls>TS. 6,2,11,2.</ls> {#asa^MBinda\\nnava^dyati#}\n<ls n=\"TS. 6,\">4,1,1.</ls> <ls n=\"TS. 6,\">5,9,3.</ls> <ls>TBR. 3,7,5,6.</ls> {#pf\\Ta\\mA\\trAdvedI\\ asa^MBinne BavataH#} {%stehen um ein%} <is>Pṛtha</is> {%von einander ab%}\n<ls n=\"TBR.\">1,6,4,2.</ls> {#yadvA urvarayorasaMBinnaM Bavati Kila iti vE tadAcakzate#} {%was%} (ungepflügt) {%zwischen zwei Aeckern liegt%}\n<ls>ŚAT. BR. 8,3,4,1.</ls>\n<ls>ŚĀṄKH. BR. 30,8.</ls>\n<ls>KĀṬH. 25,9.</ls>\n<ls>KĀTY. ŚR. 1,9,6.</ls> {#uparavAnakzRayA saMBindyAt#}\n<ls n=\"KĀTY. ŚR.\">8,5,11.</ls> <ls>KAUŚ. 27. 50.</ls> {#saMBinnasarvANgaM kUrmam#} {%zusammengezogen%}\n<ls>MBH. 4,794.</ls> {#snigDakuntalasaMBinnakirIwamukuwojjvala#} {%dicht anliegend%}\n<ls>PAÑCAR. 3,11,18.</ls> {#kadambasaMBinnaH pavanaH#} {%in Berührung gekommen%}\n<ls>BHAṬṬ. 7,5.</ls> {#saMBinno mAruto yasya marmasTAnAni kfntati#} so <ab>v. a.</ab> {%compact%}\n<ls>MĀRK. P. 43,14</ls> = <ls>VĀYU-P.</ls> in <ls>Verz. d. Oxf. H. 51,b,6.</ls> {#saMBinna#} {%verbunden%} neben {#viBinna#} als <ab>Beiw.</ab> <is>Śiva's</is>\n<ls>MBH. 12,10374.</ls>"@de ;
