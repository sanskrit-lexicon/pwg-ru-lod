<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/Bid/tr/_x5f_bid_x7e__x7e_h0_x5f_17_x5f_pra/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#pra#}\n<div n=\"1\"> 1) {%раскалывать, расщеплять, разрезать%}: {#pra va\\kzaRA^ aBina\\tparva^tAnAm#}\n<ls>ṚV. 1,32,1.</ls> {#df\\|A ci\\tsa pra Be^dati#}\n<ls n=\"ṚV.\">5,86,1.</ls> {#mfDaH#}\n<ls>VS. 5,37.</ls> {#yaTA\\ vE lANga^leno\\rvarA^M praBi\\ndanti^#} {%подобно тому как плугом вспарывают поле%}\n<ls>TS. 6,6,7,4.</ls>\n<ls>ŚAT. BR. 3,4,4,6.</ls> <ls n=\"ŚAT. BR. 3,4,4,\">8.</ls> {#mamorumetya prabiBeda kIwaH#}\n<ls>MBH. 8,1966.</ls> {#SarEH praBindanniva pARqaveyO#}\n<ls n=\"MBH. 8,\">4299.</ls> <ls>HARIV. 16286.</ls> {#praBinnavEdUryaniBEstfRANkurEH#}\n<ls>ṚT. 2,5.</ls> {#praBinnAnkarakAn#} {%разломанный%}\n<ls>R. 5,14,51.</ls> {#vAyupraBinnAmiva DUmareKAm#} {%пробитый, прерванный%}\n<ls n=\"R. 5,\">11,24.</ls> {%прокалывать, открывать%}: {#pra te^ Binadmi\\ meha^na\\M vartra^M veSa\\ntyA i^va#}\n<ls>AV. 1,3,7.</ls> {#praBinnAmiva vistIrRAM vAzImapahftotpalAm#}\n<ls>R. GORR. 2,125,15.</ls> <ab>pass.</ab> {%трескаться, рассыпаться%}: {#dantAH praBidyante#}\n<ls>ŚAT. BR. 11,4,1,5.</ls> <ls n=\"ŚAT. BR. 11,4,1,\">12.</ls> {%раскрываться, распускаться%}: {#praBinnakamalodara#} {%раскрывшийся, расцветший%}\n<ls>SĀH. D. 10,8.</ls> {#yadA sarve praBidyante hfdayasyeha granTayaH#}\n<ls>KĀTHOP. 6. 15.</ls> {#(granTayaH) praBinnAH sravanti#} {%раскрываться и течь%}\n<ls>SUŚR. 1,287,15.</ls> {#praBinnaM prasrutaM ca yat (SoRitam)#} {%проступающий сквозь отверстия%}\n<ls n=\"SUŚR.\">253,18.</ls> {#praBinnaviw#} так <ab>v. a.</ab> {%aperiens, evacuans%}\n<ls n=\"SUŚR.\">199,6.</ls> {#praBinnaprasrutANga#} (так следует читать) {%чьи члены мокнут и источают влагу%}\n<ls n=\"SUŚR.\">120,4.</ls> {#praBinnakarawa#} о слоне, {%у которого открылись и источают жидкость виски%} (в период течки)\n<ls>MBH. 1,7671.</ls> <ls n=\"MBH.\">12,4280.</ls>\n<ls>R. GORR. 2,28,8.</ls> <ls n=\"R. GORR.\">6,18,3.</ls> {#praBinnakarawAmuKa#}\n<ls>MBH. 3,441.</ls> <ls n=\"MBH. 3,\">8704.</ls> <ls n=\"MBH.\">4,757.</ls> <ls n=\"MBH. 4,\">1030.</ls> <ls n=\"MBH.\">14,2183.</ls> {#praBinna#} говорится исключительно о {%гонном%} слоне\n<ls>AK. 2,8,2,4.</ls>\n<ls>H. 1220.</ls>\n<ls>HALĀY. 2,65.</ls>\n<ls>DRAUP. 5,5.</ls>\n<ls>MBH. 1,7074.</ls> <ls n=\"MBH. 1,\">8013.</ls> <ls n=\"MBH.\">4,585.</ls> <ls n=\"MBH.\">13,641.</ls> <ls n=\"MBH. 13,\">4848.</ls>\n<ls>R. GORR. 2,20,4.</ls> <ls n=\"R. GORR.\">6,4,10.</ls>\n<ls>KUMĀRAS. 5,80.</ls>\n<ls>Spr. 673.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#pra#}\n<div n=\"1\"> 1) {%spalten, zerspalten, schlitzen%}: {#pra va\\kzaRA^ aBina\\tparva^tAnAm#}\n<ls>ṚV. 1,32,1.</ls> {#df\\|A ci\\tsa pra Be^dati#}\n<ls n=\"ṚV.\">5,86,1.</ls> {#mfDaH#}\n<ls>VS. 5,37.</ls> {#yaTA\\ vE lANga^leno\\rvarA^M praBi\\ndanti^#} {%wie man mit dem Pfluge den Acker aufreisst%}\n<ls>TS. 6,6,7,4.</ls>\n<ls>ŚAT. BR. 3,4,4,6.</ls> <ls n=\"ŚAT. BR. 3,4,4,\">8.</ls> {#mamorumetya prabiBeda kIwaH#}\n<ls>MBH. 8,1966.</ls> {#SarEH praBindanniva pARqaveyO#}\n<ls n=\"MBH. 8,\">4299.</ls> <ls>HARIV. 16286.</ls> {#praBinnavEdUryaniBEstfRANkurEH#}\n<ls>ṚT. 2,5.</ls> {#praBinnAnkarakAn#} {%zerbrochen%}\n<ls>R. 5,14,51.</ls> {#vAyupraBinnAmiva DUmareKAm#} {%durchbrochen, unterbrochen%}\n<ls n=\"R. 5,\">11,24.</ls> {%durchstechen, öffnen%}: {#pra te^ Binadmi\\ meha^na\\M vartra^M veSa\\ntyA i^va#}\n<ls>AV. 1,3,7.</ls> {#praBinnAmiva vistIrRAM vAzImapahftotpalAm#}\n<ls>R. GORR. 2,125,15.</ls> <ab>pass.</ab> {%zerspringen, zerbröckeln%}: {#dantAH praBidyante#}\n<ls>ŚAT. BR. 11,4,1,5.</ls> <ls n=\"ŚAT. BR. 11,4,1,\">12.</ls> {%aufgehen, sich lösen%}: {#praBinnakamalodara#} {%aufgegangen, aufgeblüht%}\n<ls>SĀH. D. 10,8.</ls> {#yadA sarve praBidyante hfdayasyeha granTayaH#}\n<ls>KĀTHOP. 6. 15.</ls> {#(granTayaH) praBinnAH sravanti#} {%gehen auf und fliessen%}\n<ls>SUŚR. 1,287,15.</ls> {#praBinnaM prasrutaM ca yat (SoRitam)#} {%durch Oeffnungen hervordringend%}\n<ls n=\"SUŚR.\">253,18.</ls> {#praBinnaviw#} so <ab>v. a.</ab> {%aperiens, evacuans%}\n<ls n=\"SUŚR.\">199,6.</ls> {#praBinnaprasrutANga#} (so ist zu lesen) {%dessen Glieder nässen und fliessen%}\n<ls n=\"SUŚR.\">120,4.</ls> {#praBinnakarawa#} von einem Elephanten, {%dessen Schläfen sich geöffnet haben und fliessen%} (während der Brunstzeit)\n<ls>MBH. 1,7671.</ls> <ls n=\"MBH.\">12,4280.</ls>\n<ls>R. GORR. 2,28,8.</ls> <ls n=\"R. GORR.\">6,18,3.</ls> {#praBinnakarawAmuKa#}\n<ls>MBH. 3,441.</ls> <ls n=\"MBH. 3,\">8704.</ls> <ls n=\"MBH.\">4,757.</ls> <ls n=\"MBH. 4,\">1030.</ls> <ls n=\"MBH.\">14,2183.</ls> {#praBinna#} allein von einem {%brünstigen%} Elephanten gesagt\n<ls>AK. 2,8,2,4.</ls>\n<ls>H. 1220.</ls>\n<ls>HALĀY. 2,65.</ls>\n<ls>DRAUP. 5,5.</ls>\n<ls>MBH. 1,7074.</ls> <ls n=\"MBH. 1,\">8013.</ls> <ls n=\"MBH.\">4,585.</ls> <ls n=\"MBH.\">13,641.</ls> <ls n=\"MBH. 13,\">4848.</ls>\n<ls>R. GORR. 2,20,4.</ls> <ls n=\"R. GORR.\">6,4,10.</ls>\n<ls>KUMĀRAS. 5,80.</ls>\n<ls>Spr. 673.</ls>"@de ;
