<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/Bid/tr/_x5f_bid_x7e__x7e_h0_x5f_00_x5f_pwg01/3> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 3) {%раскалывать%}, тем самым <ab>v. a.</ab> {%раскрывать; заставлять расцвести%}; <ab>pass.</ab> {%раскрываться%}: {#KAnImAni BittvA#}\n<ls>MAITRYUP. 2,6.</ls> {#biBide niviqo 'pi muzwiH#}\n<ls>RAGH. 9,58.</ls> {#aBidyetAmakziRI#}\n<ls>BHĀG. P. 3,26,55.</ls> {#navozasA BinnamivEkapaNkajam#} {%расцветший%}\n<ls>ŚĀK. 175.</ls>\n<ls>KUMĀRAS. 1,32.</ls> {#ketakEH sUciBinnEH#}\n<ls>MEGH. 24.</ls> {#BittvA sadyaH kisalayapuwAndevadrumARAm#}\n<ls n=\"MEGH.\">106.</ls> {#Binna#} = {#Pulla#}\n<ls>H. an. 2,277.</ls>\n<ls>MED. n. 14.</ls> {#Binnakarawa#} о слоне, {%у которого виски%} (в период течки) {%раскрылись и источают жидкость%}\n<ls>MBH. 3,16039.</ls> {#madaBinnagaRqakarawa#}\n<ls>Spr. 2399.</ls> {#Binna#} (<ab>vgl.</ab> {#praBinna)#} употребляется исключительно о {%слоне в течке%}: {#madavegaBinnA mattA yaTA hEmavatA gajAH#}\n<ls>MBH. 1,7006.</ls>\n<ls>Spr. 2529</ls> (<ab>Conj.</ab>). В месте {#BinneBamOktikApUrRapARiH siMhaH#}\n<ls>RĀJA-TAR. 4,176</ls> {#Binna#} означает, однако, не {%в течке%}, а {%растерзанный.%}"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3) {%spalten%} so <ab>v. a.</ab> {%öffnen; blühen machen%}; <ab>pass.</ab> {%sich öffnen%}: {#KAnImAni BittvA#}\n<ls>MAITRYUP. 2,6.</ls> {#biBide niviqo 'pi muzwiH#}\n<ls>RAGH. 9,58.</ls> {#aBidyetAmakziRI#}\n<ls>BHĀG. P. 3,26,55.</ls> {#navozasA BinnamivEkapaNkajam#} {%aufgeblüht%}\n<ls>ŚĀK. 175.</ls>\n<ls>KUMĀRAS. 1,32.</ls> {#ketakEH sUciBinnEH#}\n<ls>MEGH. 24.</ls> {#BittvA sadyaH kisalayapuwAndevadrumARAm#}\n<ls n=\"MEGH.\">106.</ls> {#Binna#} = {#Pulla#}\n<ls>H. an. 2,277.</ls>\n<ls>MED. n. 14.</ls> {#Binnakarawa#} von einem Elephanten, {%dessen Schläfen sich%} (während der Brunstzeit) {%geöffnet haben und fliessen%}\n<ls>MBH. 3,16039.</ls> {#madaBinnagaRqakarawa#}\n<ls>Spr. 2399.</ls> {#Binna#} (<ab>vgl.</ab> {#praBinna)#} allein von einem {%brünstigen%} Elephanten gebraucht: {#madavegaBinnA mattA yaTA hEmavatA gajAH#}\n<ls>MBH. 1,7006.</ls>\n<ls>Spr. 2529</ls> (<ab>Conj.</ab>). in der Stelle {#BinneBamOktikApUrRapARiH siMhaH#}\n<ls>RĀJA-TAR. 4,176</ls> bedeutet aber {#Binna#} nicht {%brünstig%}, sondern {%zerfleischt.%}"@de ;
