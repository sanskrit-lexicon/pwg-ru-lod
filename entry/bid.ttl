<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/Bid/tr/_x5f_bid_x7e__x7e_h0_x5f_zz_x5f_pw00/4> a ontolex:LexicalSense ;
  skos:definition "4〉 расщеплять, то есть <ab>v. a.</ab> открывать; заставлять цвести; <ab>Pass.</ab> открываться, течь свободно (о воде), разливаться, выходить из берегов. {#Binna#} открытый, расцветший. {#˚karawa#} или {#˚gaRqakarawa#} <lex>Adj.</lex> об слоне, у которого виски в период течки открылись и источают жидкость; также {#Binna#} само по себе в том же значении <ab>Bed.</ab>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 4〉 {%spalten,%} so <ab>v. a.</ab> {%öffen; blühen machen;%} <ab>Pass.</ab> {%sich öffnen, freien Lauf haben%} (Wasser), {%sich ergiessen, über die Ufer treten%}. {#Binna#} {%geöffnet, aufgeblüht%}. {#˚karawa#} oder {#˚gaRqakarawa#} <lex>Adj.</lex> von einem Elephanten, {%dessen Schläfen zur Brunstzeit sich geöffnet haben und fliessen;%} auch {#Binna#} allein in derselben <ab>Bed.</ab>"@de ;
  pwglex:senseTag "4" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Значение раскрытия, в том числе цветения и разлива воды; специфически применяется к мадже слона в период гона."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-06-30T05:05:09Z"^^xsd:dateTime ;
  prov:wasAttributedTo <https://w3id.org/sanskrit-lexicon/repwg/prov/export-lod> .

