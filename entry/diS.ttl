  skos:definition "<div n=\"1\"> 1) {%показывать что-либо, указывать%}: {#deSayanniva panTAnam#} <ls>R. 3,78,13.</ls> <ls>MBH. 6,121.</ls> {%указывать%} так <ab>v. a.</ab> {%учить, сообщать%}: {#yadApi BagavAnDarmaM deSayati#} <ls>SADDH. P. 4,4,b.</ls> {#Bagavato DarmaM deSayamAnasya#} 5, {%а. указывать%} так <ab>v. a.</ab> {%признавать, исповедовать%}: {#atyayamatyayato deSaya#} <ls>BURN. Intr. 299.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\"> 1) {%Etwas zeigen, anweisen%}: {#deSayanniva panTAnam#} <ls>R. 3,78,13.</ls> <ls>MBH. 6,121.</ls> {%anweisen%} so <ab>v. a.</ab> {%lehren, mittheilen%}: {#yadApi BagavAnDarmaM deSayati#} <ls>SADDH. P. 4,4,b.</ls> {#Bagavato DarmaM deSayamAnasya#} 5, {%a. anzeigen%} so <ab>v. a.</ab> {%bekennen, beichten%}: {#atyayamatyayato deSaya#} <ls>BURN. Intr. 299.</ls>"@de ;
  pwglex:senseTag "caus-1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "Каузатив развивает три нюанса: (a) конкретное «показывать», (b) «учить / сообщать» (указание переходит в передачу знания), (c) «признавать / исповедовать» (публичное указание на вину)."@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
