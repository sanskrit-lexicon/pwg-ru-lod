  skos:definition "<div n=\"1\">— 2) {%указывать, обозначать, называть, определять%}: {#panTAnamfziRoddizwam#}\n<ls>R. 2,56,4.</ls> {#praTamoddizwamAspadam#}\n<ls>KUMĀRAS. 6,35.</ls> {#karaRaM vAnyaduddaSet#}\n<ls>M. 8,52.</ls> {#itarezu tvapANktyezu yaToddizwezu#}\n<ls>M. 3,182.</ls> {#yadanyadapi noddizwaM tatrApi kriyatAM matiH#}\n<ls>R. 4,44,127.</ls> {#yaToddizwavyApArA#}\n<ls>ŚĀK. 94,7.</ls> {#pUrvoddizwa#}\n<ls>MEGH. 31.</ls> {#kAle sAMvatsaroddizwe#}\n<ls>VARĀH. BṚH. S. 52,98.</ls> <ls n=\"VARĀH. BṚH. S.\">87,22.</ls> {#uddizwapratinirdizwa#} <ab>Schol.</ab> к <ls>KĀTY. ŚR. 106,21.</ls> <ls n=\"KĀTY. ŚR.\">107,4.</ls>\n{#tatrApi SudDiruddizwA#}\n<ls>MĀRK. P. 35,50.</ls> {%говорить о%}\n<ls>R. GORR. 1,64,16.</ls> {#kaTaM mAmevoddiSati#}\n<ls>ŚĀK. 94,1.</ls> {%говорить о ком-л.%} (<ab>acc.</ab>), {%возвещать, предсказывать%}: {#tvaM sADuBiruddizwaH praTamameva cakravartinaM putraM janayizyasIti#}\n<ls>ŚĀK. 71,11.</ls> {%обозначать как, подразумевать под чем-л.%} (<ab>acc.</ab>) {%что-л.%} (<ab>acc.</ab>): {#ekAdaSendriyabaDA saha budDibaDEraSaktiruddizwA#}\n<ls>SĀṂKHYAK. 49.</ls> {#krAntiSca gatiruddizwA#}\n<ls>MĀRK. P. 26,17.</ls> <ab>praed.</ab> в <ab>loc.</ab>: {#aneqamUka uddizwaH SaWe#}\n<ls>MED. k. 223. n. 231.</ls> {%обозначать —, определять в качестве%}: {#vidyADarAMstAMstAnvarAnuddiSato bahUn . pituH#}\n<ls>KATHĀS. 26,63.</ls>"@ru ;
