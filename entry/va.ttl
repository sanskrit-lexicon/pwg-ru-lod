  skos:definition "<div n=\"p\">— {#A#} {%веять сюда, навевать%}: {#dvAvi\\mO vAtO^ vA\\ta\\ A sinDo\\rA pa^rA\\vata^H . dakza^M ta a\\nya A vA^tu#}\n<ls>ṚV. 10,137,2.</ls> <ls n=\"ṚV. 10,137,\">3.</ls> {#vAta\\ A vA^tu Beza\\jam#}\n<ls n=\"ṚV. 10,\">186,1.</ls> {#AvAnAvAnmAtariSvA#}\n<ls>KIR. 5,36.</ls> {#yatrAmodamupAdAya mArga AvAti mArutaH#}\n<ls>BHĀG. P. 8,15,18.</ls> {#AvavurvAyavo GorAH#}"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#A#} {%herwehen%}: {#dvAvi\\mO vAtO^ vA\\ta\\ A sinDo\\rA pa^rA\\vata^H . dakza^M ta a\\nya A vA^tu#}\n<ls>ṚV. 10,137,2.</ls> <ls n=\"ṚV. 10,137,\">3.</ls> {#vAta\\ A vA^tu Beza\\jam#}\n<ls n=\"ṚV. 10,\">186,1.</ls> {#AvAnAvAnmAtariSvA#}\n<ls>KIR. 5,36.</ls> {#yatrAmodamupAdAya mArga AvAti mArutaH#}\n<ls>BHĀG. P. 8,15,18.</ls> {#AvavurvAyavo GorAH#}"@de ;
