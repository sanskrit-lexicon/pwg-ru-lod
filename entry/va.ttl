  skos:definition "<div n=\"p\">— {#vi#} {%развевать, разгонять дуновением; продувать насквозь%}: {#vi vA^ta vAhi\\ yadrapa^H#}\n<ls>ṚV. 10,137,3.</ls> {#miha\\M na vAto\\ vi ha^ vAti\\ BUma^#}\n<ls n=\"ṚV. 10,\">31,9.</ls> <ls n=\"ṚV.\">1,28,6.</ls> {#vya^vAtte\\ jyoti^raBUt#}\n<ls>AV. 8,1,21.</ls> {#i\\me vE sa\\hAstA\\M te vA\\yurvya^vAt#}\n<ls>TS. 3,4,3,1.</ls>\n<ls>ŚAT. BR. 4,1,3,7.</ls> <ls n=\"ŚAT. BR. 4,1,3,\">10.</ls>\n<ls>KĀṬH. 13,2. 27,3.</ls> {#tato lokAnvivAtyasO (vAyuH)#}\n<ls>MBH. 12,13379.</ls> {%веять в разные стороны%}: {#vizvagvAtASca vivavuH#}\n<ls n=\"MBH.\">6,732.</ls> {#vAyurvivAti hfdayAni harannarARAm#}\n<ls>ṚT. 6,22.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#vi#} {%verwehen, auseinanderblasen; durchwehen%}: {#vi vA^ta vAhi\\ yadrapa^H#}\n<ls>ṚV. 10,137,3.</ls> {#miha\\M na vAto\\ vi ha^ vAti\\ BUma^#}\n<ls n=\"ṚV. 10,\">31,9.</ls> <ls n=\"ṚV.\">1,28,6.</ls> {#vya^vAtte\\ jyoti^raBUt#}\n<ls>AV. 8,1,21.</ls> {#i\\me vE sa\\hAstA\\M te vA\\yurvya^vAt#}\n<ls>TS. 3,4,3,1.</ls>\n<ls>ŚAT. BR. 4,1,3,7.</ls> <ls n=\"ŚAT. BR. 4,1,3,\">10.</ls>\n<ls>KĀṬH. 13,2. 27,3.</ls> {#tato lokAnvivAtyasO (vAyuH)#}\n<ls>MBH. 12,13379.</ls> {%nach verschiedenen Richtungen hin wehen%}: {#vizvagvAtASca vivavuH#}\n<ls n=\"MBH.\">6,732.</ls> {#vAyurvivAti hfdayAni harannarARAm#}\n<ls>ṚT. 6,22.</ls>"@de ;
