  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "anu- = «вслед, следом»; в приложении к ветру: «дуть следом, раздувать». «Anfachen» = раздувать пламя — передаётся «раздувать огонь» как наиболее конкретным глоссом."@ru ;
