  skos:definition "<div n=\"m\">— <ab>Vgl.</ab> {#anirvARa#}.\n<div n=\"m\">— <ab>Caus.</ab> {#nirvApayati#}\n<div n=\"1\">— 1〉 {%гасить%} (<ab>trans.</ab>).\n<div n=\"1\">— 2〉 {%тушить, освобождать от жара —, от зноя, охлаждать%}.\n<div n=\"1\">— 3〉 {%унимать, успокаивать, освежать%}. {#vEram#} {%унять свою месть%} <ls>DH. V. 7,7</ls>.\n<div n=\"1\">— 4〉 {%слепить%} (глаза).\n<div n=\"1\">— 5〉 {%приводить к%} <is>Nirvāṇa</is> <ls>LALIT. 376,8</ls>."@ru ;
  pwglex:sourceGloss "<div n=\"m\">— <ab>Vgl.</ab> {#anirvARa#}.\n<div n=\"m\">— <ab>Caus.</ab> {#nirvApayati#}\n<div n=\"1\">— 1〉 {%auslöschen%} (<ab>trans.</ab>).\n<div n=\"1\">— 2〉 {%ablöschen, von der Gluth%} —, [Page6-052-a] {%von der Hitze befreien, abkühlen%}.\n<div n=\"1\">— 3〉 {%stillen, zur Ruhe bringen, erquicken%}. {#vEram#} {%seine Rache stillen%} <ls>DH. V. 7,7</ls>.\n<div n=\"1\">— 4〉 {%blenden%} (die Augen).\n<div n=\"1\">— 5〉 {%zum%} <is>Nirvāṇa</is> {%führen%} <ls>LALIT. 376,8</ls>."@de ;
  pwglex:senseTag "mit_ni2_caus" ;
  pwglex:homonym "h0" ;
