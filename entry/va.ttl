<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vA/tr/v_x5f_a_x7e__x7e_h1_x5f_02_x5f_anu/anu_x2b_v_xc4__x81__x3a__x20_anblasen_x2f_anfachen_x2f_weiterwehen> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#anu#} {%раздувать, раздувать огонь, продолжать веять%}: {#Ada^sya\\ vAto\\ anu^ vAti So\\cirastu\\rna SaryA^m#}\n<ls>ṚV. 1,148,4.</ls> <ls n=\"ṚV.\">4,7,10.</ls> <ls n=\"ṚV.\">7,3,3.</ls> <ls n=\"ṚV.\">10,142,4.</ls> {#vAyurasya kAmAnanuvAti#}"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#anu#} {%anblasen, anfachen, weiterwehen%}: {#Ada^sya\\ vAto\\ anu^ vAti So\\cirastu\\rna SaryA^m#}\n<ls>ṚV. 1,148,4.</ls> <ls n=\"ṚV.\">4,7,10.</ls> <ls n=\"ṚV.\">7,3,3.</ls> <ls n=\"ṚV.\">10,142,4.</ls> {#vAyurasya kAmAnanuvAti#}"@de ;
  pwglex:senseTag "anu+vā: anblasen/anfachen/weiterwehen" ;
