  pwglex:sourceType "attested" ;
  pwglex:differentia "apa- = «прочь»; «ausdünsten» = выделять пары, испарять. Смысл родственен основному 3) (Gerüche aushauchen), но подчёркивает удаление запаха/пара прочь от источника."@ru ;
