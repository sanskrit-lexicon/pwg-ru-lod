  skos:definition "<div n=\"p\">— <ab>desid.</ab> {#vivAsati#} среди {#paricaraRakarmARaH#} <ls>NAIGH. 3,5.</ls> с {#A#} <ab>act.</ab> <ab>med.</ab> стараться завоевать, привлечь к себе; воздавать почести; прельщать: {#a\\gniM de\\vavI^taye#} <ls>ṚV. 1,12,9.</ls> <ls n=\"ṚV. 1,\">84,9.</ls> {#madA^ya\\ hotA vi^vAsate vAm#} <ls n=\"ṚV. 1,\">117,1.</ls> <ls n=\"ṚV. 1,\">152,6.</ls> <ls n=\"ṚV. 1,\">173,1.</ls> {#roda^sI#} <ls n=\"ṚV.\">7,72,3.</ls> <ls n=\"ṚV. 7,\">100,1.</ls> <ls n=\"ṚV.\">8,49,5.</ls> <ls n=\"ṚV.\">9,86,14.</ls> <ls>VS. 6,23.</ls> {#ekA^yu\\ragre\\ viSa^ A\\vivA^sati#} <ls>ṚV. 1,31,5.</ls> <ls>AV. 6,21,1</ls>; <ab>vgl.</ab> <ls>SV. I,4,2,4,3.</ls> {#A\\vivA^sanparA\\vato\\ aTo^ arvA\\vata^H su\\taH . indrA^ya sicyate\\ maDu^#} <ls>ṚV. 9,39,5.</ls> {#nama^sA#} <ls n=\"ṚV.\">5,83,1.</ls> <ls n=\"ṚV.\">6,16,46.</ls> {#sumnE^H#} <ls n=\"ṚV.\">1,41,8.</ls> <ls n=\"ṚV.\">10,93,2.</ls> {#A\\NgU\\zEH#} <ls n=\"ṚV.\">7,94,11.</ls> {#ha\\vizA^#} <ls n=\"ṚV.\">1,58,1.</ls> <ls n=\"ṚV.\">2,26,3.</ls> {#gI\\rBiH#} <ls n=\"ṚV.\">7,6,2.</ls> <ls n=\"ṚV.\">8,15,1.</ls> {#u\\kTeBi^H#} <ls n=\"ṚV.\">5,45,4.</ls> {#DI\\tiBi^H#} <ls n=\"ṚV.\">6,61,2.</ls> {#su\\zwu\\tyA#} <ls n=\"ṚV.\">8,16,3.</ls> {#vaca^sA#} <ls n=\"ṚV.\">6,62,5.</ls> {#ha\\vasA^#} <ls n=\"ṚV. 6,\">66,11.</ls> {#mano\\ yo a^sya Go\\ramA\\vivA^sAt#} <ls n=\"ṚV.\">7,20,6.</ls> <ls n=\"ṚV.\">1,119,9.</ls> {#su\\mnam#} <ls n=\"ṚV.\">2,11,16.</ls> <ls n=\"ṚV. 2,\">33,6.</ls> <ls n=\"ṚV.\">6,60,11.</ls> {#A\\vivA^santI yu\\va\\tirma^nI\\zA#} <ls n=\"ṚV.\">5,47,1.</ls> {#tava\\ praRI^tI\\ tava^ SUra\\ Sarma\\nnA vi^vAsanti ka\\vaya^H suya\\jYAH#} <ls n=\"ṚV.\">3,51,7.</ls> {#kf\\taM ci\\deno\\ nama\\sA vi^vAse#} я стараюсь умиротворить <ls n=\"ṚV.\">6,51,8.</ls> = {#varjayAmi, vinASayAmi#} <ls>SĀY.</ls>"@ru ;
