  skos:definition "<div n=\"p\">— {#aByA#} приближаться с враждебным умыслом: {#pa\\rA\\Sa\\ro ha^vi\\rmaTI^nAma\\ByA\\3^\\ vivA^satAm#} <ls>ṚV. 7,104,21.</ls> = {#AgacCatAm#} <ls>SĀY.</ls>, по <ls>DURGA</ls> тех почитателей, которые <is>Yātu</is>, то есть ложных почитателей."@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#aByA#} {%in feindlicher Absicht sich nähern%}: {#pa\\rA\\Sa\\ro ha^vi\\rmaTI^nAma\\ByA\\3^\\ vivA^satAm#}\n<ls>ṚV. 7,104,21.</ls> = {#AgacCatAm#}\n<ls>SĀY.</ls>, nach <ls>DURGA</ls> {%derjenigen Verehrer, welche%} <is>Yātu</is> {%sind%}, also {%der falschen Verehrer.%}"@de ;
