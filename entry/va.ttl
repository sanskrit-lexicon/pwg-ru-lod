<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vA/tr/v_x5f_a_x7e__x7e_h4_x5f_09_x5f_pra/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#pra#} {%ткать к чему-л., приткать%}\n<ls>ṚV. 10,130,1.</ls> {#di\\Sye^va\\ diSa\\M prava^yati\\ tasmA^ddi\\Si dikprotA^#}\n<ls>TS. 5,7,9,4.</ls> {#hiraRyam#}\n<ls>ŚAT. BR. 5,3,5,15.</ls>\n<ls>KĀTY. ŚR. 15,5,4.</ls> {#tasminyajurmayaM pravayanti#}\n<ls>KAUṢ. UP. 2,6.</ls> {#rajjUH#} {%прикреплять, привязывать%}\n<ls>ŚĀṄKH. ŚR. 17,3,7.</ls> {#˚vAya#}\n<ls>P. 6,1,41</ls>, <ab>Schol.</ab> <ls>VOP. 26,217.</ls> {#prota#} {%нанизанный на, воткнутый в, торчащий в%}; = {#uta#}\n<ls>H. 1487.</ls> = {#gumPita#}\n<ls>H. an. 2,181.</ls> = {#Kacita#}\n<ls>MED. t. 37.</ls> {#maRiH sUtra iva protaH#}\n<ls>MBH. 3,1142.</ls> <ls n=\"MBH.\">8,1829.</ls> {#mayi sarvamidaM protaM sUtre maRigaRA iva#}\n<ls>BHAG. 7,7.</ls> {#sUtraprotA dArumayIva yozA#} so <ab>v. a.</ab> {%марионетка (кукла на проволоке)%}\n<ls>MBH. 5,951.</ls> <ls n=\"MBH. 5,\">1446.</ls> {#SUle#} {%воткнутый, насаженный на кол%}\n<ls n=\"MBH.\">1,2421.</ls> <ls n=\"MBH. 1,\">4316.</ls> <ls>MĀRK. P. 16,27.</ls> {#SUla˚#}\n<ls>HARIV. 14579.</ls> {#SUlAgra˚#}\n<ls n=\"HARIV.\">14856.</ls> {#SUlAntaH#}\n<ls>RĀJA-TAR. 2,87.</ls> {#SUlikA˚#}\n<ls>SUŚR. 1,230,15.</ls> {#SfNga˚#}\n<ls>HARIV. 15438.</ls> {#Salya˚#}\n<ls>RAGH. 9,75.</ls> {#prAsa˚#}\n<ls>KATHĀS. 21,15.</ls> <ab>Schol.</ab> к <ls>ŚĀK. 32.</ls> {#hfdaye protaH SaraH#}\n<ls>MBH. 5,852.</ls> {#rOpyANkuramuKaprotamuktAsaMtati#}\n<ls>KATHĀS. 18,47.</ls> {#protaSUle Srute tasmin#}\n<ls>RĀJA-TAR. 2,80.</ls> {#protaGane vizARe#}\n<ls>KUMĀRAS. 7,49.</ls> {#karAn — SaSinastarucCidraprotAn#} {%торчащий в%}\n<ls>Spr. 3866.</ls> {#izIkAtUlamagnO protam#} {%воткнутый в%}\n<ls>CHĀND. UP. 5,24,3.</ls> {#yasminsarvamidaM protaM brahma sTAvarajaNgamam#} {%заключенный в%}\n<ls>MṚTYUL. UP.</ls> in <ls>Ind. St. 9,20.</ls> <ls>ŚAT. BR. 14,6,6,1.</ls> <ls>AṢṬĀV. 1,15.</ls> <ls>BHĀG. P. 3,15,6.</ls> {#otaprotamidaM yasmiMstantuzvaNga yaTA pawaH#}\n<ls n=\"BHĀG. P.\">10,15,35.</ls> <ls n=\"BHĀG. P.\">9,9,7.</ls> <ls>MBH. 5,1789.</ls> {#etABiH sarvamidamotaM protaM ca#} {%пронизанный%}\n<ls>MAITRYUP. 6,3.</ls> <ls>NṚS. TĀP. UP.</ls> in <ls>Ind. St. 9,158. fg.</ls> {#prota#} {%тканая вещь, тканое одеяние%}, <lex>m.</lex>\n<ls>H. 667.</ls> <lex>n.</lex> <ls>H. an.</ls> <ls>MED.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#pra#} {%daran weben%}\n<ls>ṚV. 10,130,1.</ls> {#di\\Sye^va\\ diSa\\M prava^yati\\ tasmA^ddi\\Si dikprotA^#}\n<ls>TS. 5,7,9,4.</ls> {#hiraRyam#}\n<ls>ŚAT. BR. 5,3,5,15.</ls>\n<ls>KĀTY. ŚR. 15,5,4.</ls> {#tasminyajurmayaM pravayanti#}\n<ls>KAUṢ. UP. 2,6.</ls> {#rajjUH#} {%daran knüpfen%}\n<ls>ŚĀṄKH. ŚR. 17,3,7.</ls> {#˚vAya#}\n<ls>P. 6,1,41</ls>, <ab>Schol.</ab> <ls>VOP. 26,217.</ls> {#prota#} {%gereiht auf, gesteckt an, steckend an, in%}; = {#uta#}\n<ls>H. 1487.</ls> = {#gumPita#}\n<ls>H. an. 2,181.</ls> = {#Kacita#}\n<ls>MED. t. 37.</ls> {#maRiH sUtra iva protaH#}\n<ls>MBH. 3,1142.</ls> <ls n=\"MBH.\">8,1829.</ls> {#mayi sarvamidaM protaM sUtre maRigaRA iva#}\n<ls>BHAG. 7,7.</ls> {#sUtraprotA dArumayIva yozA#} so <ab>v. a.</ab> {%Drahtpuppe%}\n<ls>MBH. 5,951.</ls> <ls n=\"MBH. 5,\">1446.</ls> {#SUle#} {%gesteckt, gespiesst%}\n<ls n=\"MBH.\">1,2421.</ls> <ls n=\"MBH. 1,\">4316.</ls> <ls>MĀRK. P. 16,27.</ls> {#SUla˚#}\n<ls>HARIV. 14579.</ls> {#SUlAgra˚#}\n<ls n=\"HARIV.\">14856.</ls> {#SUlAntaH#}\n<ls>RĀJA-TAR. 2,87.</ls> {#SUlikA˚#}\n<ls>SUŚR. 1,230,15.</ls> {#SfNga˚#}\n<ls>HARIV. 15438.</ls> {#Salya˚#}\n<ls>RAGH. 9,75.</ls> {#prAsa˚#}\n<ls>KATHĀS. 21,15.</ls> <ab>Schol.</ab> zu <ls>ŚĀK. 32.</ls> {#hfdaye protaH SaraH#}\n<ls>MBH. 5,852.</ls> {#rOpyANkuramuKaprotamuktAsaMtati#}\n<ls>KATHĀS. 18,47.</ls> {#protaSUle Srute tasmin#}\n<ls>RĀJA-TAR. 2,80.</ls> {#protaGane vizARe#}\n<ls>KUMĀRAS. 7,49.</ls> {#karAn — SaSinastarucCidraprotAn#} {%steckend in%}\n<ls>Spr. 3866.</ls> {#izIkAtUlamagnO protam#} {%gesteckt in%}\n<ls>CHĀND. UP. 5,24,3.</ls> {#yasminsarvamidaM protaM brahma sTAvarajaNgamam#} {%enthalten in%}\n<ls>MṚTYUL. UP.</ls> in <ls>Ind. St. 9,20.</ls> <ls>ŚAT. BR. 14,6,6,1.</ls> <ls>AṢṬĀV. 1,15.</ls> <ls>BHĀG. P. 3,15,6.</ls> {#otaprotamidaM yasmiMstantuzvaNga yaTA pawaH#}\n<ls n=\"BHĀG. P.\">10,15,35.</ls> <ls n=\"BHĀG. P.\">9,9,7.</ls> <ls>MBH. 5,1789.</ls> {#etABiH sarvamidamotaM protaM ca#} {%durchzogen%}\n<ls>MAITRYUP. 6