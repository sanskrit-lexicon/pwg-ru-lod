<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vA/tr/v_x5f_a_x7e__x7e_h1_x5f_03_x5f_apa/apa_x2b_v_xc4__x81_> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#apa#} {%испарять, улетучиваться%}: {#yadUva^Dyamu\\dara^syApa\\vAti^#}\n<ls>ṚV. 1,162,10.</ls>"@ru ;
