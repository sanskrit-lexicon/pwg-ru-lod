  pwglex:homonym "h1" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "ā- = «сюда, к говорящему»; «herwehen» = ветер дует в направлении к субъекту. Корпусные кандидаты «усладить, выручить» (n=2) слишком малочисленны и, по-видимому, отражают переносные контексты; предпочтительно буквальное значение по немецкому glossу."@ru ;
