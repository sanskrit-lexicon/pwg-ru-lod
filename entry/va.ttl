<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vA/tr/v_x5f_a_x7e__x7e_h0_x5f_zz_x5f_pw00/mit_x5f_ni2_x5f_4> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 4〉 {#nirvARa#}\n<div n=\"2\">— a〉 {%угасший;%} о солнце так <ab>v. a.</ab> {%зашедший%} <ls>Spr. 1276</ls>.\n<div n=\"2\">— b〉 {%тот, у кого угас огонь жизни, совершенно успокоившийся, освобожденный от уз существования%}.\n<div n=\"2\">— c〉 *{%неподвижный%}."@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 4〉 {#nirvARa#}\n<div n=\"2\">— a〉 {%erloschen;%} von der Sonne so <ab>v. a.</ab> {%untergegangen%} <ls>Spr. 1276</ls>.\n<div n=\"2\">— b〉 {%bei dem das Lebenslicht erloschen ist, vollkommen beruhigt, erlöst von den Banden des Lebens%}.\n<div n=\"2\">— c〉 *{%unbeweglich%}."@de ;
  pwglex:senseTag "mit_ni2_4" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "mixed" ;
