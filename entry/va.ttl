<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/vA/tr/v_x5f_a_x7e__x7e_h1_x5f_04_x5f_a_x5f_bi/abhi_x2b_v_xc4__x81_> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#aBi#} {%обвевать, навевать (ветром в сторону кого-л.)%}: {#SaM na^ izi\\ro a\\Bi vA^tu\\ vAta^H#}\n<ls>ṚV. 7,35,4.</ls> <ls n=\"ṚV.\">10,169,1.</ls>\n{#pUtirenAnaBivavO#}\n<ls>ŚAT. BR. 4,1,3,6.</ls>\n<ls>KĀṬH. 31,3.</ls> {#suKo vAto 'BivAti mAm#}\n<ls>MBH. 4,2238.</ls> {#purABivAti mAruto yamasya yaH puraHsaraH#}\n<ls n=\"MBH.\">12,12080.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#aBi#} {%anwehen, herwehen%}: {#SaM na^ izi\\ro a\\Bi vA^tu\\ vAta^H#}\n<ls>ṚV. 7,35,4.</ls> <ls n=\"ṚV.\">10,169,1.</ls>\n{#pUtirenAnaBivavO#}\n<ls>ŚAT. BR. 4,1,3,6.</ls>\n<ls>KĀṬH. 31,3.</ls> {#suKo vAto 'BivAti mAm#}\n<ls>MBH. 4,2238.</ls> {#purABivAti mAruto yamasya yaH puraHsaraH#}\n<ls n=\"MBH.\">12,12080.</ls>"@de ;
