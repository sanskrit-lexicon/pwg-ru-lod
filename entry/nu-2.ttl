<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/nu-2/dict/koch/1> a ontolex:LexicalSense ;
  skos:definition "नु I /nu/ (Р. pr. /nauti/—II- /nuvati/—VI- U. pr. /navati/ /navate/—I- fut. /naviṣyati/- pf. /nunāva/- aor. /anūnot/, /anūṣi/ /anāvīt/- pp. /nuta/ ) восхвалять"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/nu-2/dict/koch/2> a ontolex:LexicalSense ;
  skos:definition "नु III /nu/ m. 1) оружие 2) время"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/nu-2/dict/koch/3> a ontolex:LexicalSense ;
  skos:definition "नु II /nu/ adv. 1) теперь, сейчас, только что 2) ещё 3) конечно- пожалуй- ननु никак (нет), никогда- नुचिद् а) только что б) отныне, начиная с этого момента в) навсегда г) никогда- नु ... नु или ... или"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/nu-2/dict/kna/4> a ontolex:LexicalSense ;
  skos:definition "नु\t/nu/\t\t/ну/\tnu (и nū) ну, теперь, же, пожалуй (особ. при вопросахъ). — [νύ, νύν, νῦν, лат. nunc, nū-dius, гот. nu „nun“, лит. nu, цсл, ny-nĕ „нынѣ“].\tс. 236"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

