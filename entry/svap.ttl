<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/svap/dict/kna/2> a ontolex:LexicalSense ;
  skos:definition "स्वप्\t/svap/\t\t/свап/\tsvap (svapiti 2, pp. supta, inf. svaptum) спать, pp. заснулъ, спящій. — pra засыпать, pp. = supta. — (лат. sōpiō, цсл. sъpati „спать“].\tс. 284"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

