<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/hUti/tr/h_x5f_uti/1> a ontolex:LexicalSense ;
  skos:definition "{#hUti#}¦ (от <hom>1.</hom> {#hU#}) <lex>f.</lex> зов, оклик <ls>AK. 1,1,5,9</ls>. <ls n=\"AK. 1,\">3,3,8</ls>. <ls>H. 261</ls>. <ls n=\"H.\">334</ls>. обозначение, имя: {#dvIpa˚#} <ls>BHĀG. P. 5,20,8</ls>.\n<div n=\"v\">— <ab>Vgl.</ab> {#deva˚, dyumna˚, puru˚, pUrva˚, Bara˚, yAma˚, rudra˚, sa˚, su˚, hariheti˚#}."@ru ;
  pwglex:sourceGloss "{#hUti#}¦ (von <hom>1.</hom> {#hU#}) <lex>f.</lex> {%Ruf, Anruf%} <ls>AK. 1,1,5,9</ls>. <ls n=\"AK. 1,\">3,3,8</ls>. <ls>H. 261</ls>. <ls n=\"H.\">334</ls>. {%Benennung, Name%}: {#dvIpa˚#} <ls>BHĀG. P. 5,20,8</ls>.\n<div n=\"v\">— <ab>Vgl.</ab> {#deva˚, dyumna˚, puru˚, pUrva˚, Bara˚, yAma˚, rudra˚, sa˚, su˚, hariheti˚#}."@de ;
