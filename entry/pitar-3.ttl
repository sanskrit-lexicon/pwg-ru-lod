  skos:definition "पितर्\t/pitar/\t\t/питар/\tpitar m. отецъ, du. родители, pl. предки, тѣни усопшихъ. — [πατήρ, лат. pater, гот. fadar „Vater\"].\tс. 241"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

