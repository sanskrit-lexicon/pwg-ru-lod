<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/menA/tr/men_x5f_a/1a> a ontolex:LexicalSense ;
  skos:definition "<div n=\"2\"> а〉 {%жена, женщина%} <ls>NAIGH. 3,29</ls>. <ls>NIR. 3,21</ls>. {#Bago\\ na mene^ para\\me vyo^ma\\nnaDA^raya\\droda^sI#} <ls>ṚV. 1,62,7</ls>. {#mene^ iva ta\\nvA\\3^\\ SumBa^mAne#} <ls n=\"ṚV.\">2,39,2</ls>. {#u\\Be Ba\\dre jo^zayete\\ na mene^#} <ls n=\"ṚV.\">1,95,6</ls>. {%самка (о животном)%}: {#menA\\maSva^sya#} <ls n=\"ṚV. 1,\">121,2</ls>. {#goH#} <ls n=\"ṚV.\">10,111,3</ls>. <ab>Vgl.</ab> {#amena#}."@ru ;
  pwglex:sourceGloss "<div n=\"2\"> a〉 {%Weib%} <ls>NAIGH. 3,29</ls>. <ls>NIR. 3,21</ls>. {#Bago\\ na mene^ para\\me vyo^ma\\nnaDA^raya\\droda^sI#} <ls>ṚV. 1,62,7</ls>. {#mene^ iva ta\\nvA\\3^\\ SumBa^mAne#} <ls n=\"ṚV.\">2,39,2</ls>. {#u\\Be Ba\\dre jo^zayete\\ na mene^#} <ls n=\"ṚV.\">1,95,6</ls>. {%das weibliche Thier%}: {#menA\\maSva^sya#} <ls n=\"ṚV. 1,\">121,2</ls>. {#goH#} <ls n=\"ṚV.\">10,111,3</ls>. <ab>Vgl.</ab> {#amena#}."@de ;
  pwglex:senseTag "1a" ;
  pwglex:homonym "h?" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "«жена/женщина» — референт человек; «самка» — то же слово, но референт — животное (das weibliche Thier), различение по указанию источника"@ru ;
