<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/menA/tr/men_x5f_a/1c> a ontolex:LexicalSense ;
  skos:definition "<div n=\"2\">— c〉 по <ab>Comm.</ab> <ab>N. pr.</ab> — собственное имя женщины, дочери <is>Vṛṣaṇaśva</is> <ls>ṚV. 1,51,3</ls>. Легенду <ab>s.</ab> см. у <ls>SĀY.</ls> к <ab>d. St.</ab> <ls>ŚAT. BR. 3,3,4,18</ls>. <ls>TAITT. ĀR. 1,12,3</ls>. <ls>LĀṬY. 1,3,17</ls>. <ab>N. pr.</ab> — супруги <is>Himavant</is> <ls>HARIV. 941</ls>. <ls n=\"HARIV.\">943</ls>. <ls n=\"HARIV.\">1551</ls>. <ls>R. 1,36,14</ls> (<ls n=\"R. 1,\">37,15 GORR.</ls>). <ls>KUMĀRAS. 1,18</ls>. <ls n=\"KUMĀRAS.\">5,3</ls>. <ls n=\"KUMĀRAS. 5,\">5</ls>. <ls>VP. 84</ls>. <ls n=\"VP.\">85, N. 11</ls>. <ls>BHĀG. P. 4,7,58</ls>. <ls>MĀRK. P. 52,13</ls>. <ls n=\"MĀRK. P. 52,\">31</ls>. <ls>PAÑCAR. 2,6,19</ls>. <ls>Verz. d. Oxf. H. 39,a,29</ls>. <ab>Inschr.</ab> в <ls>Journ. of the Am. Or. S. 6,506, Śl. 22</ls>."@ru ;
  pwglex:sourceGloss "<div n=\"2\">— c〉 nach den <ab>Comm.</ab> <ab>N. pr.</ab> eines Weibes, der Tochter des <is>Vṛṣaṇaśva</is> <ls>ṚV. 1,51,3</ls>. die Legende <ab>s.</ab> bei <ls>SĀY.</ls> zu <ab>d. St.</ab> <ls>ŚAT. BR. 3,3,4,18</ls>. <ls>TAITT. ĀR. 1,12,3</ls>. <ls>LĀṬY. 1,3,17</ls>. <ab>N. pr.</ab> der Gattin des <is>Himavant</is> <ls>HARIV. 941</ls>. <ls n=\"HARIV.\">943</ls>. <ls n=\"HARIV.\">1551</ls>. <ls>R. 1,36,14</ls> (<ls n=\"R. 1,\">37,15 GORR.</ls>). <ls>KUMĀRAS. 1,18</ls>. <ls n=\"KUMĀRAS.\">5,3</ls>. <ls n=\"KUMĀRAS. 5,\">5</ls>. <ls>VP. 84</ls>. <ls n=\"VP.\">85, N. 11</ls>. <ls>BHĀG. P. 4,7,58</ls>. <ls>MĀRK. P. 52,13</ls>. <ls n=\"MĀRK. P. 52,\">31</ls>. <ls>PAÑCAR. 2,6,19</ls>. <ls>Verz. d. Oxf. H. 39,a,29</ls>. <ab>Inschr.</ab> in <ls>Journ. of the Am. Or. S. 6,506, Śl. 22</ls>."@de ;
