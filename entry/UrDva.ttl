  skos:definition "ऊर्ध्व\t/ūrdhva/\t/Urdhva/\t/урдхва/\tūrdhva обращенный вверхъ; acc. adv. вверхъ. — [ὀρθός, лат. arduus].\tс. 209"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

