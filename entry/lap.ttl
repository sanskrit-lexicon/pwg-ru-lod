<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/lap/dict/kna/2> a ontolex:LexicalSense ;
  skos:definition "लप्\t/lap/\t\t/лап/\tlap (lapati; c. lāpayati) болтать, сѣтовать. — ā id., бесѣдовать; c. заставлять говорить. — vi сѣтовать. — [„лепетъ, лепетать“].\tс. 260"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/lap/dict/smirnov/3> a ontolex:LexicalSense ;
