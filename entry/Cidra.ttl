  skos:definition "छिद्र\t/chidra/\t\t/чхидра/\tchidra n. щель, дыра; пробѣлъ, недостатокъ, слабая сторона. — [отъ chid, ср. лит. skëdra].\tс. 222"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "kna" .

