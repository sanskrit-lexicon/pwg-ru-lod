  skos:definition "अनुबन्ध /anubandha/ m. 1) повязывание 2) совпадение 3) повторение 4) грам. глухой звук 5) филос. необходимая составная часть, элемент 6) грам. индикатор (буква или слог в назв. грам. термина, указывает на специфику грам. формы) 7) причина"@ru ;
  pwglex:evidenceGrade gr:dict-attested ;
  dct:source "koch" .

