  skos:definition "<div n=\"1\">— 9) проводить, проживать, коротать (время): {#cAndrAyaRErnayetkAlam#}\n<ls>YĀJÑ. 3,50.</ls> {#rAtrim#}\n<ls n=\"YĀJÑ. 3,\">312.</ls> <ls>MEGH. 2.</ls> <ls n=\"MEGH.\">39.</ls> <ls n=\"MEGH.\">87.</ls> <ls>ŚĀK. 193.</ls> <ls>RAGH. 1,33.</ls> <ls n=\"RAGH. 1,\">95.</ls> <ls>Spr. 229.</ls> <ls n=\"Spr.\">374.</ls> <ls n=\"Spr.\">378.</ls> <ls n=\"Spr.\">592.</ls> <ls n=\"Spr.\">594.</ls> <ls>KATHĀS. 4,42.</ls> <ls n=\"KATHĀS.\">5,81.</ls> <ls>VID. 123.</ls> <ls n=\"VID.\">275.</ls> <ls>RĀJA-TAR. 4,556.</ls> <ls>PAÑCAT. 43,2.</ls> <ls n=\"PAÑCAT.\">49,5.</ls> {#sa ca vakabAlakAnajAtapakzAnapi sadEva BakzayankAlaM nayati#}\n<ls n=\"PAÑCAT.\">98,10.</ls> <ls>HIT. 37,20.</ls> <ls>BHĀG. P. 2,3,17.</ls> <ls n=\"BHĀG. P.\">4,8,74.</ls> <ls n=\"BHĀG. P. 4,\">12,14.</ls> <ls n=\"BHĀG. P.\">6,19,20.</ls> <ls>PRAB. 68,15.</ls> <ls>DAŚAK.</ls> в <ls>BENF. Chr. 184,4. 200,16.</ls> <ls>BHAṬṬ. 7,13.</ls> <ls n=\"BHAṬṬ.\">8,26.</ls> <ab>med.</ab> : {#yOvanaM ye nayante#}\n<ls>BHARTṚ. Suppl. 25.</ls> {#kAlaM nayamAnA#}\n<ls>PAÑCAT. 60,25.</ls> {#sa evaM svAntaraM ninye yugAnAmekasaptatim#}\n<ls>BHĀG. P. 3,22,36.</ls>"@ru ;
