<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/nI/tr/n_x5f_i_x7e__x7e_h0_x5f_44_x5f_samupa/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#samupa#} приводить, привлекать: {#fzIMSca samupAnayat#}\n<ls>MBH. 1,4319.</ls> <ls n=\"MBH.\">2,1237.</ls> {#mantraM samupanItena suhfdA#} привлеченный к, присоединенный к\n<ls>R. 5,86,18.</ls> доставлять\n<ls>MBH. 4,1320.</ls> {#anye praDAnavAsasI samupanIyetAm#}\n<ls>MṚCCH. 88,8.</ls> {#(taM badDvA) gOtamyAH samupAnayat#}\n<ls>MBH. 13,18.</ls> вести к, направлять к: {#(aSvam) ASramatoraRamUlaM samupanayet#}\n<ls>VARĀH. BṚH. S. 43 (34),17.</ls> привлекать, так <ab>v. a.</ab> вызывать, производить: {#jagatkzayaM samupanayan#}\n<ls>HARIV. 10532.</ls> притягивать к себе, брать с собой: {#(aSvAn) javanAnASugAMSca karArTaM samupAnayat#}\n<ls>MBH. 2,1036.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#samupa#} {%herbeiführen, heranziehen%}: {#fzIMSca samupAnayat#}\n<ls>MBH. 1,4319.</ls> <ls n=\"MBH.\">2,1237.</ls> {#mantraM samupanItena suhfdA#} {%hinzugezogen zu%}\n<ls>R. 5,86,18.</ls> {%herbeibringen%}\n<ls>MBH. 4,1320.</ls> {#anye praDAnavAsasI samupanIyetAm#}\n<ls>MṚCCH. 88,8.</ls> {#(taM badDvA) gOtamyAH samupAnayat#}\n<ls>MBH. 13,18.</ls> {%hinführen zu%}: {#(aSvam) ASramatoraRamUlaM samupanayet#}\n<ls>VARĀH. BṚH. S. 43 (34),17.</ls> {%herbeiziehen%} so <ab>v. a.</ab> {%verursachen%}: {#jagatkzayaM samupanayan#}\n<ls>HARIV. 10532.</ls> {%an sich ziehen, mit sich nehmen%}: {#(aSvAn) javanAnASugAMSca karArTaM samupAnayat#}\n<ls>MBH. 2,1036.</ls>"@de ;
  pwglex:senseTag "1" ;
  pwglex:homonym "h0" ;
  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "herbeiführen/heranziehen = приводить/привлекать (движение к субъекту); hinführen zu = направлять к (к цели); verursachen = вызывать (причинно-следственное, переносное употребление); an sich ziehen = притягивать к себе (аккумулятивный смысл)"@ru ;
  pwglex:evidenceGrade gr:machine-preview ;
  pwglex:model "claude-sonnet-5" ;
  prov:generatedAtTime "2026-06-29T12:37:39Z"^^xsd:dateTime ;
