  skos:definition "<div n=\"p\">— {#samud#}\n<div n=\"1\"> 1) {%поднимать, воздвигать%} (<ab>eig.</ab> и <ab>übertr.</ab>): {#paramezWI tvapAM maDye taTAsannAmavekzya gAm . kaTamenAM samunnezya iti daDyO DiyA ciram ..#}\n<ls>BHĀG. P. 3,13,16.</ls> {#tasya (ripoH) saMSamanAyASu tatkulInaM samunnayet#}\n<ls>KĀM. NĪTIS. 8,66. 9,70.</ls> {#samunnItA (mati)#}\n<ls>MBH. 14,638.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#samud#}\n<div n=\"1\"> 1) {%emporheben%} (<ab>eig.</ab> und <ab>übertr.</ab>): {#paramezWI tvapAM maDye taTAsannAmavekzya gAm . kaTamenAM samunnezya iti daDyO DiyA ciram ..#}\n<ls>BHĀG. P. 3,13,16.</ls> {#tasya (ripoH) saMSamanAyASu tatkulInaM samunnayet#}\n<ls>KĀM. NĪTIS. 8,66. 9,70.</ls> {#samunnItA (mati)#}\n<ls>MBH. 14,638.</ls>"@de ;
