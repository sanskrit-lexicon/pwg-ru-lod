<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/nI/tr/n_x5f_i_x7e__x7e_h0_x5f_45_x5f_ni/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#ni#}\n<div n=\"1\"> 1) {%вести туда, направлять%}: {#di\\zwaM no\\ atra^ ja\\rase\\ ni ne^zat#}\n<ls>AV. 12,3,55.</ls> {#(mAm) tatra sarasi ninayatam#}\n<ls>PAÑCAT. 76,19.</ls> {#kzetrajYa etAM (budDiM) ninayettamAtmani#}\n<ls>BHĀG. P. 2,2,16</ls> {%нести туда, выносить%}: {#dAsIkumBaM vahirgrAmAnninayeran#} (<ab>v. l.</ab> {#ninayeyuH#})\n<ls>YĀJÑ. 3,295.</ls> {%приносить, приносить сюда%}: {#ninayerannavaM Gawam#} 296. {%вести к, побуждать к%}: {#ni mA\\tarA^ nayati\\ reta^se Bu\\je#}\n<ls>ṚV. 1,155,3.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#ni#}\n<div n=\"1\"> 1) {%hinführen%}: {#di\\zwaM no\\ atra^ ja\\rase\\ ni ne^zat#}\n<ls>AV. 12,3,55.</ls> {#(mAm) tatra sarasi ninayatam#}\n<ls>PAÑCAT. 76,19.</ls> {#kzetrajYa etAM (budDiM) ninayettamAtmani#}\n<ls>BHĀG. P. 2,2,16</ls> {%hintragen, hinaustragen%}: {#dAsIkumBaM vahirgrAmAnninayeran#} (<ab>v. l.</ab> {#ninayeyuH#})\n<ls>YĀJÑ. 3,295.</ls> {%herbeitragen, herbeiholen%}: {#ninayerannavaM Gawam#} 296. {%führen zu, veranlassen zu%}: {#ni mA\\tarA^ nayati\\ reta^se Bu\\je#}\n<ls>ṚV. 1,155,3.</ls>"@de ;
  pwglex:senseTag "1" ;
