  skos:definition "<div n=\"p\">— {#anUd#} <ab>act.</ab> <ab>med.</ab> {%черпать вслед за кем-л., наполнять (сосуд) вслед%}: {#hotu^Scama\\samanU^nnayante#} {%после наполнения чаши%}\n<ls>H.</ls> {%наполняют свои%}\n<ls>TBR. 1,4,5,2.</ls>\n<ls>ŚAT. BR. 4,4,2,17.</ls> <ls>KĀTY. ŚR. 10,6,20.</ls> <ls n=\"KĀTY. ŚR. 10,\">9,31.</ls>"@ru ;
