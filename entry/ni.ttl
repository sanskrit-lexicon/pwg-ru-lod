  pwglex:equivalenceType "equivalent" ;
  pwglex:sourceType "attested" ;
  pwglex:differentia "hinführen = вести туда (к цели); hintragen/hinaustragen = нести туда/выносить (перемещение предмета); herbeitragen/herbeiholen = приносить сюда, приводить; führen zu/veranlassen zu = вести к, побуждать (причинно-следственный/каузативный смысл)"@ru ;
