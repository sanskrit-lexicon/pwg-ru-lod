  skos:definition "<div n=\"1\">— 7) {%выяснять, докапываться до чего-л., выслеживать, выводить (умозаключение)%}: {#tasya padamunnIya#}\n<ls>MBH. 3,12444.</ls> {#tato rAjYAM carErAptEH pravfttirudanIyata#}\n<ls n=\"MBH.\">1,7366.</ls> <ls>RĀJA-TAR. 4,353.</ls> <ls n=\"RĀJA-TAR.\">6,6.</ls> {#upalabDamupalakzaRaM yena tasyAH kopanAyAH sarasamunnIyate mArgaH#}\n<ls>VIKR. 57,11.</ls> {#prakftipratyayAdyarTEH saMkIrRe liNgamunnayet#}\n<ls>AK. 3,3,1.</ls> {#sA tu tAvatonnItamadaBiprAyA#}\n<ls>DAŚAK.</ls> в <ls>BENF. Chr. 200,4.</ls> {#uBayorBAvamunnIya#}\n<ls>SĀH. D. 37,14.</ls> {#iti pratiSabdAdunnIyate#}\n<ls>KULL.</ls> к <ls>M. 1,1</ls> (<ab>S.</ab> 5, <ab>Z.</ab> 4). {#prAqvivAko vakzyamARena SapaTena satyamunnayet#} <ab>ders.</ab> к <ls>M. 8,109.</ls>\n<ls n=\"M. 8,\">252.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 7) {%herausbringen, hinter Etwas kommen, ausspüren, erschliessen%}: {#tasya padamunnIya#}\n<ls>MBH. 3,12444.</ls> {#tato rAjYAM carErAptEH pravfttirudanIyata#}\n<ls n=\"MBH.\">1,7366.</ls> <ls>RĀJA-TAR. 4,353.</ls> <ls n=\"RĀJA-TAR.\">6,6.</ls> {#upalabDamupalakzaRaM yena tasyAH kopanAyAH sarasamunnIyate mArgaH#}\n<ls>VIKR. 57,11.</ls> {#prakftipratyayAdyarTEH saMkIrRe liNgamunnayet#}\n<ls>AK. 3,3,1.</ls> {#sA tu tAvatonnItamadaBiprAyA#}\n<ls>DAŚAK.</ls> in <ls>BENF. Chr. 200,4.</ls> {#uBayorBAvamunnIya#}\n<ls>SĀH. D. 37,14.</ls> {#iti pratiSabdAdunnIyate#}\n<ls>KULL.</ls> zu <ls>M. 1,1</ls> (<ab>S.</ab> 5, <ab>Z.</ab> 4). {#prAqvivAko vakzyamARena SapaTena satyamunnayet#} <ab>ders.</ab> zu <ls>M. 8,109.</ls>\n<ls n=\"M. 8,\">252.</ls>"@de ;
