  skos:definition "<div n=\"1\">— 2) принимать к себе, брать к себе, — об учителе, принимающем ученика для обучения; <ab>med.</ab>\n<ls>P. 1,3,36.</ls>\n<ls>VOP. 23,8.</ls> {#A\\cA\\rya^ upa\\naya^mAno brahmacA\\riRa^m#}\n<ls>AV. 11,5,3.</ls> {#ehyupehi taTeti taM hopaninye#}\n<ls>ŚAT. BR. 11,5,3,13.</ls> <ls n=\"ŚAT. BR. 11,\">5,4,1.</ls> <ls n=\"ŚAT. BR. 11,5,4,\">16.</ls> <ls n=\"ŚAT. BR.\">14,1,1,22. fgg.</ls>\n<ls>ĀŚV. GṚHY. 1,20.</ls>\n<ls>KAUŚ. 17.</ls>\n<ls>CHĀND. UP. 4,4,5.</ls>\n<ls>BHAṬṬ. 1,15.</ls> <ab>act.</ab> <ls>PĀR. GṚHY. 2,2.</ls> <ls>ĀŚV. GṚHY. 1,19.</ls> <ls>GOBH. 3,1,11.</ls> <ls>KAUŚ. 55.</ls> <ls>ŚĀṄKH. GṚHY. 2,1. 2.</ls> <ls>SUŚR. 1,6,11.</ls> {#upanIya#}\n<ls>CHĀND. UP. 5,11,7.</ls>\n<ls>M. 2,69.</ls> <ls n=\"M. 2,\">140.</ls> {#upanIyamAna#}\n<ls>BHĀG. P. 8,18,14.</ls> {#upanIta#}\n<ls n=\"BHĀG. P. 8,18,\">17.</ls> <ls>M. 2,49.</ls> <ls>RAGH. 3,29.</ls>"@ru ;
