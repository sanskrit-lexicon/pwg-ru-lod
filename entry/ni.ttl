<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/nI/tr/n_x5f_i_x7e__x7e_h0_x5f_36_x5f_ud/1> a ontolex:LexicalSense ;
  skos:definition "<div n=\"p\">— {#ud#}\n<div n=\"1\"> 1) {%вести вверх, поднимать наверх, выносить, возносить; помогать выбраться, поддерживать, возвышать, спасать%}: {#nI\\cA santa\\muda^nayaH parA\\vfja^m#}\n<ls>ṚV. 2,13,12.</ls> {#uttUrva^yARaM Dfza\\tA ni^neTa#}\n<ls n=\"ṚV.\">6,18,13.</ls> {#utsUrya^M nayaTo\\ jyoti^zA sa\\ha#}\n<ls n=\"ṚV. 6,\">72,2.</ls> <ls n=\"ṚV.\">10,137,1.</ls> {#kiM svidAdityamunnayati#}\n<ls>MBH. 3,17330. fg.</ls> {#retoDAH putra unnayati naradeva yamakzayAt#}\n<ls>MBH. 1,3103</ls> = <ls>HARIV. 1725.</ls> {#unnezyati vrajamataH#}\n<ls>BHĀG. P. 2,7,29.</ls> {#urvIm — rasAyA lIlayonnItAm#}\n<ls n=\"BHĀG. P.\">3,13,46.</ls> {#svadaMzwronnItaDaro varAhaH#}\n<ls n=\"BHĀG. P.\">6,8,13.</ls> {%поднимать%} (<is>Yūpa</is>)\n<ls>ṚV. 3,8,4.</ls> <ls n=\"ṚV. 3,8,\">9.</ls> {#agrezu stanAnunnayanti#}\n<ls>ŚAT. BR. 6,5,2,16.</ls>\n<ls>KĀTY. ŚR. 16,3,27.</ls> {#maharziBirunnIyamAnam — aDvaraDvajam#}\n<ls>BHĀG. P. 4,3,10.</ls> {#tadAnanaM suBru — unnIya me darSaya#}\n<ls n=\"BHĀG. P. 4,\">25,31.</ls> {#UrDvaM prARamunnayatyapAnaM pratyagasyati#}\n<ls>KATHOP. 5,3.</ls> {#(anilam) tasmAdBruvorantaramunnayeta#}\n<ls>BHĀG. P. 2,2,21.</ls> {#kzi\\Romi\\ brahma^RA\\mitrA\\nunna^yAmi\\ #}\n[Page4-0274]\n{# svA~ a\\ham#}\n<ls>VS. 11,82.</ls> {#udinna^yAti sukf\\tasya^ lokam#}\n<ls>AV. 6,119,1.</ls> <ls n=\"AV.\">2,9,1.</ls> {#ma\\nyorudi\\maM na^yAmi#}\n<ls n=\"AV.\">1,10,1.</ls> {#dru\\haH#}\n<ls n=\"AV.\">7,103,1.</ls> {#ude^namutta\\raM na^ya#}\n<ls n=\"AV.\">6,5,1.</ls> <ls>ŚAT. BR. 2,1,4,23.</ls> <ls n=\"ŚAT. BR.\">6,5,2,3.</ls> {#taM DIrAsaH kavaya unnayanti#}\n<ls>PĀR. GṚHY. 2,2.</ls> {#arcakAnunnItavantam#}\n<ls>VOP. 5,26.</ls> {%извлекать%}\n<ls>KĀTY. ŚR. 9,3,10.</ls> {%надевать, класть сверху%}: {#pumAMsamunnayetprAjYaH Sayana tapta Ayase#}\n<ls>MBH. 12,6105.</ls> По <ls>P. 1,3,36</ls> и <ls>VOP. 23,28</ls> {#nI#} в <ab>Bed.</ab> {#utsaYjana#} (P.) или {#utkzepa#} (<ls>VOP.</ls>) всегда выступает как <ab>med.</ab>;\nв схолиях в качестве примера приводится {#daRqamunnayate#} {%он поднимает посох%}."@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#ud#}\n<div n=\"1\"> 1) {%hinauf —, heraufführen, herausbringen, in die Höhe bringen, aufrichten; heraushelfen, aufhelfen, emporbringen, erretten%}: {#nI\\cA santa\\muda^nayaH parA\\vfja^m#}\n<ls>ṚV. 2,13,12.</ls> {#uttUrva^yARaM Dfza\\tA ni^neTa#}\n<ls n=\"ṚV.\">6,18,13.</ls> {#utsUrya^M nayaTo\\ jyoti^zA sa\\ha#}\n<ls n=\"ṚV. 6,\">72,2.</ls> <ls n=\"ṚV.\">10,137,1.</ls> {#kiM svidAdityamunnayati#}\n<ls>MBH. 3,17330. fg.</ls> {#retoDAH putra unnayati naradeva yamakzayAt#}\n<ls>MBH. 1,3103</ls> = <ls>HARIV. 1725.</ls> {#unnezyati vrajamataH#}\n<ls>BHĀG. P. 2,7,29.</ls> {#urvIm — rasAyA lIlayonnItAm#}\n<ls n=\"BHĀG. P.\">3,13,46.</ls> {#svadaMzwronnItaDaro varAhaH#}\n<ls n=\"BHĀG. P.\">6,8,13.</ls> {%aufrichten%} (den <is>Yūpa</is>)\n<ls>ṚV. 3,8,4.</ls> <ls n=\"ṚV. 3,8,\">9.</ls> {#agrezu stanAnunnayanti#}\n<ls>ŚAT. BR. 6,5,2,16.</ls>\n<ls>KĀTY. ŚR. 16,3,27.</ls> {#maharziBirunnIyamAnam — aDvaraDvajam#}\n<ls>BHĀG. P. 4,3,10.</ls> {#tadAnanaM suBru — unnIya me darSaya#}\n<ls n=\"BHĀG. P. 4,\">25,31.</ls> {#UrDvaM prARamunnayatyapAnaM pratyagasyati#}\n<ls>KATHOP. 5,3.</ls> {#(anilam) tasmAdBruvorantaramunnayeta#}\n<ls>BHĀG. P. 2,2,21.</ls> {#kzi\\Romi\\ brahma^RA\\mitrA\\nunna^yAmi\\ #}\n[Page4-0274]\n{# svA~ a\\ham#}\n<ls>VS. 11,82.</ls> {#udinna^yAti sukf\\tasya^ lokam#}\n<ls>AV. 6,119,1.</ls> <ls n=\"AV.\">2,9,1.</ls> {#ma\\nyorudi\\maM na^yAmi#}\n<ls n=\"AV.\">1,10,1.</ls> {#dru\\haH#}\n<ls n=\"AV.\">7,103,1.</ls> {#ude^namutta\\raM na^ya#}\n<ls n=\"AV.\">6,5,1.</ls> <ls>ŚAT. BR. 2,1,4,23.</ls> <ls n=\"ŚAT. BR.\">6,5,2,3.</ls> {#taM DIrAsaH kavaya unnayanti#}\n<ls>PĀR. GṚHY. 2,2.</ls> {#arcakAnunnItavantam#}\n<ls>VOP. 5,26.</ls> {%herausholen%}\n<ls>KĀTY. ŚR. 9,3,10.</ls> {%aufsetzen, auflegen%}: {#pumAMsamunnayetprAjYaH Sayana tapta Ayase#}\n<ls>MBH. 12,6105.</ls> Nach <ls>P. 1,3,36</ls> und <ls>VOP. 23,28</ls> erscheint {#nI#} in der <ab>Bed.</ab> {#utsaYjana#} (P.) oder {#utkzepa#} (<ls>VOP.</ls>) stets als <ab>med.</ab>;\nals Beispiel wird in den Scholien {#daRqamunnayate#} {%er erhebt den Stock%} aufgeführt."@de ;
