<https://w3id.org/sanskrit-lexicon/repwg/sense/entry/nI/tr/n_x5f_i_x7e__x7e_h0_x5f_16_x5f_a_x5f_bi/2> a ontolex:LexicalSense ;
  skos:definition "<div n=\"1\">— 2) сопровождать жестами, изображать пантомимой, ставить на сцене: {#gItAni ramyARi jaguH prahfzwAH kAntABinItAni manoharARi#}\n<ls>HARIV. 8448.</ls> {#vacanamaBinayantyA#}\n<ls>MĀLAV. 26.</ls> {#pUrvAnuBUtasuKasmftimaBinayan#}\n<ab>Schol.</ab> в <ab>Einl.</ab> к <ls>CAURAP.</ls> {#taduktamaBinIyABiyuktEH#}\n<ls>VEDĀNTAS.</ls> (<ls>ed. Calc. 1829</ls>) 25,3. = {#aBinayamaNgacezwAviSezaM kftvA#}\n<ab>Schol.</ab> 119,10. {#KaqgapatanaM hastAdaBinayan#}\n<ls>MṚCCH 170,14.</ls> {#Srutim#}\n<ls>ŚĀK. 31,8.</ls> {#kusumAvacayam#}\n<ls n=\"ŚĀK.\">43,1.</ls> {#bAlasparSam#}\n<ls n=\"ŚĀK.\">103,19</ls>, <ab>v. l.</ab> {#AliNganam#}\n<ls>ŚĀK. CH. 85,1.</ls> {#durnimittam#}\n<ls n=\"ŚĀK. CH.\">97,2.</ls> {#sparSasuKam#}\n<ls>PRAB. 11,15.</ls> {#romAYcam#}\n<ls n=\"PRAB.\">57,6.</ls> {#yaTArasam#}\n<ls>MĀLAV. 20,20.</ls> {#DUrtasamAgamanAma nAwakam#}\n<ls>DHŪRTAS. 67,13. 68,16.</ls>\n<ls>PRAB. 3,17.</ls> <ls>Verz. d. Oxf. H. No. 273.</ls> {#anaBinItam#} <lex>adv.</lex>: {#akziBruvOzWahastEranaBinItam (paWet)#} без мимики глазами, бровями, губами и руками\n<ls>SUŚR. 1,13,6.</ls> Сюда относится, по-видимому, также {#kaTAyA[H] svaBinItatA#} исполнение с хорошей мимикой\n<ab>Schol.</ab> к <ls>BHAṬṬ.</ls> у <ls>GOLDST.</ls> <ab>u.</ab> {#aBinIta#}; {%its easy understanding%}\n<ls>GOLDST.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 2) {%mit Geberden begleiten, pantomimisch darstellen, auf dem Theater aufführen%}: {#gItAni ramyARi jaguH prahfzwAH kAntABinItAni manoharARi#}\n<ls>HARIV. 8448.</ls> {#vacanamaBinayantyA#}\n<ls>MĀLAV. 26.</ls> {#pUrvAnuBUtasuKasmftimaBinayan#}\n<ab>Schol.</ab> in der <ab>Einl.</ab> zu <ls>CAURAP.</ls> {#taduktamaBinIyABiyuktEH#}\n<ls>VEDĀNTAS.</ls> (<ls>ed. Calc. 1829</ls>) 25,3. = {#aBinayamaNgacezwAviSezaM kftvA#}\n<ab>Schol.</ab> 119,10. {#KaqgapatanaM hastAdaBinayan#}\n<ls>MṚCCH 170,14.</ls> {#Srutim#}\n<ls>ŚĀK. 31,8.</ls> {#kusumAvacayam#}\n<ls n=\"ŚĀK.\">43,1.</ls> {#bAlasparSam#}\n<ls n=\"ŚĀK.\">103,19</ls>, <ab>v. l.</ab> {#AliNganam#}\n<ls>ŚĀK. CH. 85,1.</ls> {#durnimittam#}\n<ls n=\"ŚĀK. CH.\">97,2.</ls> {#sparSasuKam#}\n<ls>PRAB. 11,15.</ls> {#romAYcam#}\n<ls n=\"PRAB.\">57,6.</ls> {#yaTArasam#}\n<ls>MĀLAV. 20,20.</ls> {#DUrtasamAgamanAma nAwakam#}\n<ls>DHŪRTAS. 67,13. 68,16.</ls>\n<ls>PRAB. 3,17.</ls> <ls>Verz. d. Oxf. H. No. 273.</ls> {#anaBinItam#} <lex>adv.</lex>: {#akziBruvOzWahastEranaBinItam (paWet)#} {%ohne Geberdenspiel mit Augen, Brauen, Lippen und Händen%}\n<ls>SUŚR. 1,13,6.</ls> Hierher gehört wohl auch {#kaTAyA[H] svaBinItatA#} {%ein Vortrag mit gutem Geberdenspiel%}\n<ab>Schol.</ab> zu <ls>BHAṬṬ.</ls> bei <ls>GOLDST.</ls> <ab>u.</ab> {#aBinIta#}; {%its easy understanding%}\n<ls>GOLDST.</ls>"@de ;
