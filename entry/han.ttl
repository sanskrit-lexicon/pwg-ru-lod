  skos:definition "<div n=\"1\">— 7) <ab>partic.</ab> {#saMhata#}\n<div n=\"2\"> a) {%наложенный друг на друга, соединенный, замкнутый, сталкивающийся, смежный, тесно связанный%}\n<ls>AK. 3,4,12,47.</ls>\n<ls>H. an. 3,307.</ls>\n<ls>MED. t. 165.</ls>\n[Page7-1512]\n{#saMhatO pARI DArayan#}\n<ls>ĀŚV. ŚR. 1,1,23.</ls>\n<ls>M. 4,82.</ls>\n<ls>AK. 2,6,2,36.</ls> {#juhoti saMhatena#} (<ab>sc.</ab> {#aYjalinA#})\n<ls>PĀR. GṚHY. 1,6.</ls> {#saMhatAYjali#} <lex>adj.</lex>\n<ls>HARIV. 12251.</ls>\n<ls>R. 3,19,10.</ls> <ls n=\"R. 3,\">21,6.</ls> <ls n=\"R.\">4,13,23.</ls> <ls n=\"R. 4,13,\">25.</ls> <ls n=\"R.\">6,111,49.</ls>\n<ls>BHĀG. P. 4,1,26.</ls> <ls n=\"BHĀG. P. 4,\">12,21.</ls> <ls n=\"BHĀG. P.\">10,86,25.</ls> пальцы\n<ls>KAUŚ. 4.</ls> {#saMhatoru#}\n<ls>MBH. 4,253.</ls> {#UrU susaMhatO#}\n<ls>R. 5,2,18.</ls> {#saMhatavfttoru#}\n<ls n=\"R.\">6,9,12.</ls> {#caraRO#}\n<ls n=\"R.\">3,52,33.</ls> {#˚BrU#}\n<ls>MBH. 5,2036.</ls> {#BrukuwIsaMhataBrU#}\n<ls n=\"MBH.\">3,15703.</ls> {#˚BrukuwImuKa#}\n<ls n=\"MBH. 3,\">11187.</ls> <ls>VARĀH. BṚH. S. 61,10. fg.</ls> {#arA raTanABO#}\n<ls>MUṆḌ. UP. 2,2,6.</ls> {#leKA#}\n<ls>GOBH. 1,1,9.</ls> {#ayugma˚#}\n<ls n=\"GOBH.\">7,10.</ls> {#trInpiRqAnsaMhatAnnidaDAti#} {%соединенный, образующий груду%}\n<ls>KAUŚ. 88.</ls> {#upalAH#}\n<ls>MBH. 3,1719.</ls> {#drumavalkEH saMhatEH#}\n<ls>R. 5,44,12.</ls>\n<ls>M. 5,115.</ls>\n<ls>YĀJÑ. 1,184.</ls>\n<ls>MĀRK. P. 35,8.</ls> {#saMhatAnyoDayedalpAn#}\n<ls>M. 7,91.</ls> {#meGAH#} {%связный, последовательный%}\n<ls>VARĀH. BṚH. S. 22,8.</ls> {#saMhatamUrtayaH payodAH#}\n<ls n=\"VARĀH. BṚH. S.\">19,8.</ls> {#dIpaH saMhatamUrtiH#}\n<ls n=\"VARĀH. BṚH. S.\">69,15.</ls> {#dUta eva hi saMDatte Binattyeva ca saMhatAn#}\n<ls>M. 7,66.</ls> {#fzayaH#}\n<ls>ṚV. ANUKR. 9,66.</ls> <ls>Ind. St. 10,410.</ls> <ls>KAP. 1,67. 141.</ls> <ls>KĀM. NĪTIS. 4,65.</ls> {#ekEkaSaH saMhatA vA#}\n<ls n=\"KĀM. NĪTIS.\">6,9. 8,18. fg. 9,77. 17,40. 19,59.</ls> <ls>MṚCCH. 76,9.</ls> <ls>ṚT. 1,20.</ls> <ls>Spr. (II) 1171.</ls>