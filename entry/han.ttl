  skos:definition "<div n=\"2\">— c) {%пораженный%} (недугом), {%постигнутый бедой, сильно пострадавший, поврежденный, испорченный, запятнанный%}: {#rakzAMsi devEH#}\n<ls>ŚAT. BR. 7,3,2,6.</ls> {#grAmaScOrEH#}\n<ls>Spr. (II) 5466.</ls> {#vastra#}\n<ls>MĀRK. P. 34,55.</ls> <ls n=\"MĀRK. P.\">35,26.</ls> <ls n=\"MĀRK. P.\">97,27. fg.</ls>\n<ls>VARĀH. BṚH. S. 15,32.</ls> {#svara#}\n<ls>SUŚR. 1,239,11.</ls> {#cakzus#}\n<ls>MĀLATĪM. 160,18.</ls> {#˚pAdendriya#}\n<ls>SARVADARŚANAS. 78,11.</ls> {#anupahatakarRendriyatA#}\n<ls>Lot. de la b. l. 603.</ls> {#guruSApena kriyA#}\n<ls>MBH. 1,4665.</ls>\n<ls>HARIV. 5594.</ls> {#dEvopahatakarman#}\n<ls>R. 1,58,23</ls> (<ls n=\"GORR. 1,\">60,26</ls> <ls>GORR.</ls>). {#CAyA mama#}\n<ls n=\"R.\">2,69,20.</ls> {#indurgraheRopahatadyutiH#}\n<ls>R. GORR. 2,39,37.</ls> <ls n=\"R. GORR. 2,\">40,11.</ls> <ls n=\"R. GORR. 2,\">81,8.</ls> {#malopahataprasAde darpaRatale#}\n<ls>ŚĀK. 191.</ls>\n<ls>KIR. 5,48.</ls>\n<ls>Spr. (II) 2103</ls>, <ab>v. l.</ab> {#puMstva#}\n<ls>VARĀH. BṚH. S. 16,32.</ls>\n<ls>BHĀG. P. 5,6,11.</ls> <ls n=\"BHĀG. P.\">8,24,46.</ls> {#tattvonmezopahatatamas#}\n<ls>PRAB. 118,4.</ls> {#BUtopahatacittA#}\n[Page7-1505]\n<ls>R. 2,58,30.</ls>\n<ls>R. GORR. 2,9,9.</ls> {#guruSApAt#}\n<ls n=\"R. GORR.\">1,62,18.</ls> {#SvaBraSarkarASma˚sikatABiranupahatA BUmiH#}\n<ls>SUŚR. 1,134,19.</ls> {#GuRopahata#}\n<ls n=\"SUŚR.\">29,5.</ls> {#ucCizwopahata#}\n<ls>MAITRYUP. 6,9.</ls> {#apANktyopahatA paNktiH#}\n<ls>M. 3,183.</ls> {#niHSvAsopahata#} 19. {#darpaRaH sabAzpaniHSvAsamArutopahataH#}\n<ls>VARĀH. BṚH. S. 5,50.</ls> <ls n=\"VARĀH. BṚH. S.\">19,9.</ls> <ls n=\"VARĀH. BṚH. S.\">59,3.</ls> <ls n=\"VARĀH. BṚH. S.\">60,6.</ls> {#mUzikopahatavastra#}\n<ls>Verz. d. Oxf. H. 86,b,15.</ls> <ls>KULL.</ls> к <ls>M. 5,115.</ls> {#stanO SucA#} {%слезами%}\n<ls>BHĀG. P. 4,26,25.</ls> <ls n=\"BHĀG. P.\">10,60,27.</ls> {#ruditopahata#}\n<ls>MBH. 9,2425.</ls> {#aSrUpahata#}\n<ls>VIKR. 127.</ls> {#kaSmalopahata#}\n<ls>R. 1,65,9.</ls> {#timirAdyupahata