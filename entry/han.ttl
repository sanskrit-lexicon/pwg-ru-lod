  skos:definition "<div n=\"p\">— {#vipra#}, <ab>partic.</ab> {#˚hata#} {%пораженный, сраженный, потрепанный%}: войско\n<ls>MBH. 7,1581.</ls> <ls n=\"MBH.\">8,2386.</ls> {#ambuvarzeRa gAvaH#}\n<ls>HARIV. 3913.</ls> {#vAriviprahatAnIva paNkajAni#}\n<ls n=\"HARIV.\">5697.</ls> <ls>MBH. 7,3236.</ls> {#a˚#} {%нехоженый%}: лес\n<ls>R. 1,26,12.</ls> путь\n<ls n=\"R.\">3,74,4.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#vipra#}, <ab>partic.</ab> {#˚hata#} {%geschlagen, getroffen, mitgenommen%}: ein Heer\n<ls>MBH. 7,1581.</ls> <ls n=\"MBH.\">8,2386.</ls> {#ambuvarzeRa gAvaH#}\n<ls>HARIV. 3913.</ls> {#vAriviprahatAnIva paNkajAni#}\n<ls n=\"HARIV.\">5697.</ls> <ls>MBH. 7,3236.</ls> {#a˚#} {%unbetreten%}: Wald\n<ls>R. 1,26,12.</ls> Weg\n<ls n=\"R.\">3,74,4.</ls>"@de ;
