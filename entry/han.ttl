  skos:definition "<div n=\"1\">— 5) {%отражать кого-л.%} или {%что-л., отбивать, защищаться против%}\n<ls>RAGH. 9,60.</ls>\n<ls>KATHĀS. 18,150.</ls> <ls n=\"KATHĀS.\">114,108.</ls> <ls n=\"KATHĀS.\">121,207.</ls>\n<ls>BHĀG. P. 10,77,2.</ls> {#SarErvarzaM pratijaGne#}\n<ls>MBH. 1,8278.</ls> {#asnARi pratyaGnan#}\n<ls n=\"MBH.\">3,12233.</ls> <ls n=\"MBH.\">1,1472.</ls> <ls n=\"MBH.\">4,1684.</ls> <ls n=\"MBH.\">7,8677</ls> ({#˚hanya#} оба <ab>Ausgg.</ab>).\n<ls>KATHĀS. 48,75.</ls> <ls n=\"KATHĀS.\">50,13.</ls> <ls n=\"KATHĀS. 50,\">65.</ls> <ls n=\"KATHĀS.\">115,21.</ls> <ls n=\"KATHĀS. 115,\">63.</ls> <ls n=\"KATHĀS. 115,\">66.</ls> {#pratiGnatIva praBayA praBAmarkasya#}\n<ls>MBH. 2,81.</ls>\n<ls>Ind. St. 10,281.</ls> {%держать в стороне, отгонять%}: {#duHsvapnam#}\n<ls>MBH. 13,4171.</ls>\n<ls>KATHĀS. 36,67.</ls> {#DarmaH pApena pratihanyate svidutAho DarmaH pratihanti pApam#}\n<ls>MBH. 5,1597.</ls> <ls n=\"MBH. 5,\">1599.</ls> {#SradDA pratihanyate#}\n<ls>KĀŚ.</ls> к <ls>P. 1,4,66.</ls> {%задерживать, останавливать%}: {#vegaM samare hayasAdinAm#}\n<ls>MBH. 6,4783.</ls> {#agnivegavahaH prARo gudAnte pratihanyate#}\n<ls n=\"MBH.\">12,6878.</ls> <ls>SUŚR. 1,117,11.</ls> {#Cardim#}\n<ls n=\"SUŚR.\">267,11. fg.</ls> {#viGnEH pratihanyamAnAH#}\n<ls>Spr. (II) 4342.</ls> {#prakftiH sA mama parA na kvacitpratihanyate#} (так <ls>ed. Bomb.</ls>)\n<ls>MBH. 13,6329.</ls> {#SAstre budDirna pratihanyate#}\n<ls>P. 1,3,38</ls>, <ab>Schol.</ab> {#yadezAM sarvakftyezu (˚kAmezu#}\n<ls>GORR.</ls>) {#mano na pratihanyate#}\n<ls>R. 2,52,24</ls> (<ls n=\"GORR. 2,\">49,18</ls> <ls>GORR.</ls>). {#yOvarAjyABizecanam#} {%расстраивать, срывать%}\n<ls>R. GORR. 2,20,25.</ls> {#pratihaMsi mamAjYAm#}\n<ls n=\"R. GORR.\">7,59,14.</ls>"@ru ;
