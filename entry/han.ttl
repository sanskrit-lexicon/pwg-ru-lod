  skos:definition "<div n=\"1\">— 6) <ab>absol.</ab> {#saMhatya#} {%объединяясь, сообща, совместно, вместе%}: {#jIvAmaH#}\n<ls>MBH. 5,922.</ls> {#sa saMhatya nihantvyaH#}\n<ls n=\"MBH.\">13,3097.</ls> {#kurvate yAtrAH#}\n<ls n=\"MBH.\">14,1061.</ls> <ls>R. GORR. 2,67,19.</ls> <ls n=\"R. GORR.\">3,16,18.</ls> <ls>VARĀH. BṚH. S. 89,18.</ls> <ls>BHĀG. P. 3,20,14.</ls> {#dvaMdvena saMhatya ca yuDyamAnAH#}\n<ls n=\"BHĀG. P.\">8,10,34.</ls> {#kAriRaH#}\n<ls n=\"BHĀG. P.\">11,24,9.</ls> {#˚kAritvAt#}\n<ab>Schol.</ab> к <ls>KAP. 1,104.</ls> <ls>SĀH. D. 9,9.</ls> {#a˚#}\n<ls>BHĀG. P. 3,26,50.</ls> {#pApEH sahAyEH saMhatya#} {%совместно с%}\n<ls>MBH. 5,4398.</ls> {#saMhatyAnyo'nyam#}\n<ls>BHĀG. P. 1,7,30.</ls> <ls n=\"BHĀG. P.\">2,5,33.</ls>"@ru ;
