  skos:definition "1) велеть убить; убивать, умерщвлять; наказывать, карать <ab>überh.</ab>: {#kaM GAtayati hanti kam#}\n<ls>BHAG. 2,21.</ls>\n<ls>BHĀG. P. 6,18,41.</ls> <ls n=\"BHĀG. P.\">10,73,31.</ls> {#tAnrAjeBena GAtayet#}\n<ls>M. 8,34.</ls> <ls n=\"M.\">9,224.</ls> <ls n=\"M. 9,\">270. fg.</ls> {#viviDErdaRqEH#}\n<ls n=\"M. 9,\">275.</ls> <ls>YĀJÑ. 1,337.</ls> <ls n=\"YĀJÑ. 1,\">358.</ls> <ls n=\"YĀJÑ.\">2,270.</ls> <ls>MBH. 2,975. fg.</ls> <ls n=\"MBH.\">5,6095.</ls> <ls n=\"MBH. 5,\">7023.</ls> <ls n=\"MBH. 5,\">7442.</ls> <ls>R. 4,53,12.</ls> <ls n=\"R. 4,53,\">14.</ls> <ls n=\"R.\">5,62,5.</ls> <ls n=\"R. 5,62,\">6.</ls> <ls>MṚCCH. 123,19.</ls> <ls>Spr. (II) 1305</ls>, <ab>v. l.</ab> <ls n=\"Spr. (II)\">5696.</ls> <ls n=\"Spr. (II)\">6196.</ls> <ls>KATHĀS. 18,273.</ls> <ls>RĀJA-TAR. 1,27.</ls> <ls n=\"RĀJA-TAR.\">6,322.</ls> <ls>BHĀG. P. 1,8,5.</ls> <ls n=\"BHĀG. P.\">3,3,11.</ls> <ls n=\"BHĀG. P.\">5,26,12.</ls> <ls n=\"BHĀG. P. 5,26,\">25.</ls> <ls>DAŚAK. 89,11.</ls> <ls>LA. (III) 7,19. 91,10.</ls> {#ajIGanat#}\n<ls>MBH. 7,8786.</ls>\n<ls>BHĀG. P. 3,3,10.</ls> {#mA jIGanaH prajAH sarvAH putrAnBrAtFMstaTEva ca#}\n<ls>MBH. 5,4199.</ls> <ab>med.</ab>: {#GAtayAmahe#}\n<ls>BHĀG. P. 10,50,49.</ls> {#GAtayAna#}\n<ls>MBH. 13,3608.</ls> {#aGAtayiTAs#}\n<ls n=\"MBH.\">1,3335.</ls> <ab>partic.</ab> {#GAtita#}\n<ls>YĀJÑ. 2,271.</ls> <ls n=\"YĀJÑ.\">3,246.</ls>\n<ls>MĀRK. P. 112,21. fg.</ls>\n<ls>KATHĀS. 5,67.</ls>\n<ls>BHĀG. P. 6,18,36.</ls>\n<ls>PAÑCAT. I,444</ls> = <ls n=\"PAÑCAT. I,\">457.</ls> велеть убить кого-л., так <ab>v. a.</ab> сообщать об убийстве кого-л.\n[Page7-1498]\n<ls>P. 3,1,26</ls>, <is>Vārtt</is>. 2, <ab>Schol.</ab>"@ru ;
  pwglex:sourceGloss "<div n=\"1\"> 1) {%tödten lassen; tödten, umbringen; züchtigen, bestrafen%} <ab>überh.</ab>: {#kaM GAtayati hanti kam#}\n<ls>BHAG. 2,21.</ls>\n<ls>BHĀG. P. 6,18,41.</ls> <ls n=\"BHĀG. P.\">10,73,31.</ls> {#tAnrAjeBena GAtayet#}\n<ls>M. 8,34.</ls> <ls n=\"M.\">9,224.</ls> <ls n=\"M. 9,\">270. fg.</ls> {#viviDErdaRqEH#}\n<ls n=\"M. 9,\">275.</ls> <ls>YĀJÑ. 1,337.</ls> <ls n=\"YĀJÑ. 1,\">358.</ls> <ls n=\"YĀJÑ.\">2,270.</ls> <ls>MBH. 2,975. fg.</ls> <ls n=\"MBH.\">5,6095.</ls> <ls n=\"MBH. 5,\">7023.</ls> <ls n=\"MBH. 5,\">7442.</ls> <ls>R. 4,53,12.</ls> <ls n=\"R. 4,53,\">14.</ls> <ls n=\"R.\">5,62,5.</ls> <ls n=\"R. 5,62,\">6.</ls> <ls>MṚCCH. 123,19.</ls> <ls>Spr. (II) 1305</ls>, <ab>v. l.</ab> <ls n=\"Spr. (II)\">5696.</ls> <ls n=\"Spr. (II)\">6196.</ls> <ls>KATHĀS. 18,273.</ls> <ls>RĀJA-TAR. 1,27.</ls> <ls n=\"RĀJA-TAR.\">6,322.</ls> <ls>BHĀG. P. 1,8,5.</ls> <ls n=\"BHĀG. P.\">3,3,11.</ls> <ls n=\"BHĀG. P.\">5,26,12.</ls> <ls n=\"BHĀG. P. 5,26,\">25.</ls> <ls>DAŚAK. 89,11.</ls> <ls>LA. (III) 7,19. 91,10.</ls> {#ajIGanat#}\n<ls>MBH. 7,8786.</ls>\n<ls>BHĀG. P. 3,3,10.</ls> {#mA jIGanaH prajAH sarvAH putrAnBrAtFMstaTEva ca#}\n<ls>MBH. 5,4199.</ls> <ab>med.</ab>: {#GAtayAmahe#}\n<ls>BHĀG. P. 10,50,49.</ls> {#GAtayAna#}\n<ls>MBH. 13,3608.</ls> {#aGAtayiTAs#}\n<ls n=\"MBH.\">1,3335.</ls> <ab>partic.</ab> {#GAtita#}\n<ls>YĀJÑ. 2,271.</ls> <ls n=\"YĀJÑ.\">3,246.</ls>\n<ls>MĀRK. P. 112,21. fg.</ls>\n<ls>KATHĀS. 5,67.</ls>\n<ls>BHĀG. P. 6,18,36.</ls>\n<ls>PAÑCAT. I,444</ls> = <ls n=\"PAÑCAT. I,\">457.</ls> {%Jmd tödten lassen%} so <ab>v. a.</ab> {%über Jmdes%}\n[Page7-1498]\n{%Ermordung berichten%}\n<ls>P. 3,1,26</ls>, <is>Vārtt</is>. 2, <ab>Schol.</ab>"@de ;
