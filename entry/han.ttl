  skos:definition "<div n=\"p\">— {#pra#}, когда {#na#} корня переходит в {#Ra#}\n<ls>P. 8,4,22. fg.</ls> <is>Vārtt</is>. 1 к <ls n=\"P. 8,4,\">2.</ls> <ls>VOP. 8,22.</ls> <ls n=\"VOP.\">9,7.</ls> <ls n=\"VOP. 9,\">10.</ls> {%бить, ударять%}: <is>Soma</is>\n<ls>ṚV. 9,69,2.</ls> {#tuzAn#}\n<ls>ŚAT. BR. 1,1,4,21.</ls> {#uraH#} (другого) {#kaWoramuzwinA#}\n<ls>BHĀG. P. 3,19,15.</ls> с <ab>gen.</ab>\n<ls>P. 2,3,56.</ls> {%наносить удар по%}: {#Suna^H#}\n<ls>TBR. 3,8,4,1.</ls>\n<ls>ŚAT. BR. 3,8,1,15.</ls> <ls n=\"ŚAT. BR.\">4,6,8,7.</ls> {#prajaGnire#} без <ab>obj.</ab>\n<ls>MBH. 8,1206.</ls> {#prAGAnizata rakzAMsi yena#} {%были убиты%}\n<ls>BHAṬṬ. 9,102.</ls> {#apraGnatyaH (ApaH)#} приблизительно {%не продвигая дальше%}\n<ls>ŚAT. BR. 13,8,1,4.</ls> — <ab>partic.</ab> {#prahata = AvidDa#}\n<ls>TRIK. 3,3,214.</ls> = {#vyutpanna = kzuRRa#}\n<ls>H. 345.</ls>\n<ls>MED. t. 121.</ls> <ls>HALĀY. 2,197.</ls> = {#vitata#}\n<ls>MED.</ls> {%пораженный, сраженный%}: {#˚raTanarASvakuYjara#}\n<ls>MBH. 8,1210.</ls> {#izuBiH#}\n<ls n=\"MBH.\">7,3236.</ls> {#prahatasya mayA tasya lANgUlena mahAgireH#}\n<ls>R. 5,56,42.</ls> {#anekaprahataM cakram#}\n<ls>HARIV. 15040</ls> ({#anekamahataM#} новейшая <ab>Ausg.</ab>). {%ударенный%}: барабан\n<ab>u. s. w.</ab> <ls>MEGH. 65.</ls> <ls>RAGH. 19,14.</ls> <ls>KATHĀS. 10,171.</ls> <ls n=\"KATHĀS.\">107,49.</ls> <ls n=\"KATHĀS.\">109,152.</ls> <ls n=\"KATHĀS.\">118,39.</ls> {%изрубленный, разбитый%}: {#gadA#}\n<ls>BHĀG. P. 10,72,38.</ls> {#kzurapraprahatatanutra#}\n<ls>Spr. (II) 6519.</ls> {%надрубленный%} или {%срубленный%}: {#candanataruH paraSuprahataH#}\n<ls n=\"Spr. (II)\">401.</ls> {#kzetrAdyaprahatam#} так <ab>v. a.</ab> {%невспаханный%}\n<ls>H. 940.</ls> {%убитый%}\n<ls>KĀM. NĪTIS. 13,68</ls> (<ab>vgl.</ab> <ls n=\"KĀM. NĪTIS. 13,\">78</ls>). <ls>PAÑCAR. 4,3,117.</ls> <lex>n.</lex> {%удар%}: {#jaNGA˚#} <is>gaṇa</is> {#akzadyUtAdi#}\nк <ls>P. 4,4,19.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"p\">— {#pra#}, wann das {#na#} der Wurzel in {#Ra#} übergeht\n<ls>P. 8,4,22. fg.</ls> <is>Vārtt</is>. 1 zu <ls n=\"P. 8,4,\">2.</ls> <ls>VOP. 8,22.</ls> <ls n=\"VOP.\">9,7.</ls> <ls n=\"VOP. 9,\">10.</ls> {%schlagen%}: den <is>Soma</is>\n<ls>ṚV. 9,69,2.</ls> {#tuzAn#}\n<ls>ŚAT. BR. 1,1,4,21.</ls> {#uraH#} (eines Andern) {#kaWoramuzwinA#}\n<ls>BHĀG. P. 3,19,15.</ls> mit <ab>gen.</ab>\n<ls>P. 2,3,56.</ls> {%losschlagen auf%}: {#Suna^H#}\n<ls>TBR. 3,8,4,1.</ls>\n<ls>ŚAT. BR. 3,8,1,15.</ls> <ls n=\"ŚAT. BR.\">4,6,8,7.</ls> {#prajaGnire#} ohne <ab>obj.</ab>\n<ls>MBH. 8,1206.</ls> {#prAGAnizata rakzAMsi yena#} {%getödtet wurden%}\n<ls>BHAṬṬ. 9,102.</ls> {#apraGnatyaH (ApaH)#} etwa {%nicht weiter treibend%}\n<ls>ŚAT. BR. 13,8,1,4.</ls> — <ab>partic.</ab> {#prahata = AvidDa#}\n<ls>TRIK. 3,3,214.</ls> = {#vyutpanna = kzuRRa#}\n<ls>H. 345.</ls>\n<ls>MED. t. 121.</ls> <ls>HALĀY. 2,197.</ls> = {#vitata#}\n<ls>MED.</ls> {%geschlagen, getroffen%}: {#˚raTanarASvakuYjara#}\n<ls>MBH. 8,1210.</ls> {#izuBiH#}\n<ls n=\"MBH.\">7,3236.</ls> {#prahatasya mayA tasya lANgUlena mahAgireH#}\n<ls>R. 5,56,42.</ls> {#anekaprahataM cakram#}\n<ls>HARIV. 15040</ls> ({#anekamahataM#} die neuere <ab>Ausg.</ab>). {%angeschlagen%}: Trommel\n<ab>u. s. w.</ab> <ls>MEGH. 65.</ls> <ls>RAGH. 19,14.</ls> <ls>KATHĀS. 10,171.</ls> <ls n=\"KATHĀS.\">107,49.</ls> <ls n=\"KATHĀS.\">109,152.</ls> <ls n=\"KATHĀS.\">118,39.</ls> {%zerhauen, zerschlagen%}: {#gadA#}\n<ls>BHĀG. P. 10,72,38.</ls> {#kzurapraprahatatanutra#}\n<ls>Spr. (II) 6519.</ls> {%angehauen%} oder {%abgehauen%}: {#candanataruH paraSuprahataH#}\n<ls n=\"Spr. (II)\">401.</ls> {#kzetrAdyaprahatam#} so <ab>v. a.</ab> {%ungepflügt%}\n<ls>H. 940.</ls> {%erschlagen%}\n<ls>KĀM. NĪTIS. 13,68</ls> (<ab>vgl.</ab> <ls n=\"KĀM. NĪTIS. 13,\">78</ls>). <ls>PAÑCAR. 4,3,117.</ls> <lex>n.</lex> {%Schlag%}: {#jaNGA˚#} <is>gaṇa</is> {#akzadyUtAdi#}\nzu <ls>P. 4,4,19.</ls>"@de ;
