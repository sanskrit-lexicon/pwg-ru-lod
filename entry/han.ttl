  skos:definition "<div n=\"1\">— 3) <ab>partic.</ab> {#˚hata = AvidDa#}\n<ls>MED. dh. 28.</ls>\n<div n=\"2\"> a) {%отбитый, отогнанный, прогнанный%}: {#payodA vAyuvegaparAhatAH#}\n<ls>MBH. 3,12889.</ls> {#dEvaM matpOruzaparAhatam#}\n<ls>R. GORR. 2,20,28.</ls> {%отвращенный%}: {#kawAkzaparAhataM vadanapaNkajam#}\n<ls>MĀLATĪM. 140,15.</ls>\n<div n=\"2\">— b) {%находящийся в противоречии%}: {#paraspara˚#}\n<ls>AK. 1,1,5,20.</ls>\n<ls>H. 265.</ls>"@ru ;
  pwglex:sourceGloss "<div n=\"1\">— 3) <ab>partic.</ab> {#˚hata = AvidDa#}\n<ls>MED. dh. 28.</ls>\n<div n=\"2\"> a) {%ab-, weggeschlagen, vertrieben%}: {#payodA vAyuvegaparAhatAH#}\n<ls>MBH. 3,12889.</ls> {#dEvaM matpOruzaparAhatam#}\n<ls>R. GORR. 2,20,28.</ls> {%abgewandt%}: {#kawAkzaparAhataM vadanapaNkajam#}\n<ls>MĀLATĪM. 140,15.</ls>\n<div n=\"2\">— b) {%im Widerspruch stehend%}: {#paraspara˚#}\n<ls>AK. 1,1,5,20.</ls>\n<ls>H. 265.</ls>"@de ;
  pwglex:senseTag "3" ;
  pwglex:homonym "h0" ;
